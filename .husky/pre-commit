#!/usr/bin/env bash
# MedCasts pre-commit hook.
#
# Runs astro check on staged .astro/.ts/.tsx files (under astro/) and
# re-runs the existing tsc on staged Next-side files. Skips on no-op
# commits and on staged files outside src/.
#
# Install once with:
#   git config core.hooksPath .husky
# (or `npx husky init` if you've added the husky package)
set -e

ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
ASTRO_FILES=$(echo "$STAGED" | grep -E '^astro/.*\.(astro|ts|tsx)$' || true)
NEXT_FILES=$(echo "$STAGED" | grep -E '^src/.*\.(ts|tsx)$' || true)

if [ -n "$ASTRO_FILES" ]; then
  echo "› running astro check (staged in astro/)"
  (cd "$ROOT/astro" && npx astro check) || {
    echo "✗ astro check failed — fix the errors before committing."
    exit 1
  }
fi

if [ -n "$NEXT_FILES" ]; then
  echo "› running tsc (staged in src/)"
  (cd "$ROOT" && npx tsc --noEmit) || {
    echo "✗ tsc failed — fix the type errors before committing."
    exit 1
  }
fi

echo "✓ pre-commit ok"
