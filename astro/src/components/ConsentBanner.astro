---
// GDPR cookie consent banner. Sits bottom-right (bottom-center on mobile),
// hidden once `mc-consent` cookie is set. Uses the same cookie name as the
// Next.js admin (src/lib/consent.ts) so consent crosses both apps.
//
// The companion script in BaseLayout listens for `mc:consent` and dispatches
// the same event so analytics/tracking scripts can opt in/out reactively.
import { localizedPath, defaultLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<div
  id="mc-consent-banner"
  data-mc-consent-banner
  class="hidden"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
>
  <div class="mc-consent-card">
    <div class="mc-consent-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <div class="mc-consent-body">
      <p class="mc-consent-title">We use cookies to improve your experience</p>
      <p class="mc-consent-blurb">
        Necessary cookies keep the site working. Optional analytics help us make it better.
        See our <a href={localizedPath(locale, "/privacy-policy")}>privacy policy</a>.
      </p>
      <div class="mc-consent-actions">
        <button type="button" class="mc-consent-btn-secondary" data-mc-consent="necessary">
          Necessary only
        </button>
        <button type="button" class="mc-consent-btn-primary" data-mc-consent="all">
          Accept all
        </button>
      </div>
    </div>
    <button
      type="button"
      class="mc-consent-close"
      aria-label="Close (necessary cookies only)"
      data-mc-consent="necessary"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
</div>

<style>
  #mc-consent-banner {
    position: fixed;
    inset-inline-start: 12px;
    inset-inline-end: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 80;
    pointer-events: none;
  }
  @media (min-width: 720px) {
    #mc-consent-banner {
      inset-inline-start: auto;
      inset-inline-end: 16px;
      bottom: 16px;
      max-width: 420px;
    }
  }

  .mc-consent-card {
    position: relative;
    pointer-events: auto;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 16px 40px -12px rgba(11, 15, 28, 0.18);
    transform: translateY(8px);
    opacity: 0;
    animation: mc-consent-in 280ms cubic-bezier(0.22, 0.61, 0.36, 1) 200ms forwards;
  }
  @keyframes mc-consent-in {
    to { transform: translateY(0); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mc-consent-card { animation: none; transform: none; opacity: 1; }
  }

  .mc-consent-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-accent-soft, rgba(10, 93, 84, 0.12));
    color: var(--color-accent, var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .mc-consent-body { flex: 1; min-width: 0; }
  .mc-consent-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .mc-consent-blurb {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin-top: 4px;
  }
  .mc-consent-blurb a {
    color: var(--color-accent, var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .mc-consent-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .mc-consent-btn-secondary,
  .mc-consent-btn-primary {
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 9999px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .mc-consent-btn-secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border);
  }
  .mc-consent-btn-secondary:hover {
    border-color: var(--color-ink);
  }
  .mc-consent-btn-primary {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .mc-consent-btn-primary:hover {
    background: var(--color-accent, var(--color-accent));
    border-color: var(--color-accent, var(--color-accent));
  }

  .mc-consent-close {
    position: absolute;
    top: 8px;
    inset-inline-end: 8px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-subtle);
    background: transparent;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
  .mc-consent-close:hover {
    color: var(--color-ink);
    background: var(--color-subtle, rgba(11, 15, 28, 0.04));
  }
</style>

<script is:inline>
  (() => {
    const COOKIE = "mc-consent";

    function getCookie(name) {
      const m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
      return m ? decodeURIComponent(m[1]) : null;
    }
    function setCookie(name, value, days) {
      const d = new Date();
      d.setTime(d.getTime() + days * 864e5);
      const secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie = name + "=" + encodeURIComponent(value) + "; expires=" + d.toUTCString() + "; path=/; SameSite=Lax" + secure;
    }

    const banner = document.getElementById("mc-consent-banner");
    if (!banner) return;

    // Show only if no consent recorded yet
    if (!getCookie(COOKIE)) {
      banner.classList.remove("hidden");
    }

    banner.addEventListener("click", (e) => {
      const btn = e.target && e.target.closest && e.target.closest("[data-mc-consent]");
      if (!btn) return;
      const value = btn.getAttribute("data-mc-consent");
      if (value !== "all" && value !== "necessary") return;
      setCookie(COOKIE, value, 365);
      banner.classList.add("hidden");
      window.dispatchEvent(new CustomEvent("mc:consent", { detail: value }));
      // Reload so server-rendered analytics gates pick up the new cookie
      // (only if user opted into "all" — necessary mode doesn't need a reload).
      if (value === "all") {
        setTimeout(() => location.reload(), 80);
      }
    });
  })();
</script>
