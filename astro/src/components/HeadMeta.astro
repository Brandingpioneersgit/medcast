---
import { hreflangMap, localeUrl, toOgLocale, SITE_NAME, SITE_URL } from "@/lib/seo";
import { locales, defaultLocale, type Locale } from "@/lib/i18n";

interface Props {
  title: string;
  description: string;
  path: string;
  locale: Locale;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** Restrict hreflang alternates to these locales (+ x-default). Default: all locales. */
  translatedLocales?: Locale[];
  /**
   * Query string to preserve on canonical + hreflang URLs when the page state
   * depends on filters or pagination. Include the leading `?`. Pass only for
   * filter states that should self-canonicalise (e.g. `?country=india`);
   * leave undefined for root listings so canonical stays clean.
   */
  pathQuery?: string;
  /**
   * When set, canonical link + og:url point at this path instead of `path`.
   * Use to consolidate cannibalising variants onto a single authority page
   * (e.g. /treatment/[slug]/[country] → /treatment/[slug]). hreflang still
   * uses `path` so locale switchers continue to work.
   */
  canonicalPath?: string;
  /** Override the og:image alt text (defaults to page title). */
  imageAlt?: string;
  /** ISO date string for article published/modified times. */
  publishedAt?: string;
  modifiedAt?: string;
  /** Author display name (article type pages). */
  author?: string;
}

const {
  title,
  description,
  path,
  locale,
  image,
  type = "website",
  noindex = false,
  translatedLocales,
  pathQuery,
  canonicalPath,
  imageAlt,
  publishedAt,
  modifiedAt,
  author,
} = Astro.props;

const fullTitle = `${title} | ${SITE_NAME}`;
const qs = pathQuery && pathQuery.length > 0
  ? (pathQuery.startsWith("?") ? pathQuery : `?${pathQuery}`)
  : "";
const canonical = `${localeUrl(locale, canonicalPath ?? path)}${qs}`;
const fullMap = hreflangMap(path);
const langs: Record<string, string> = {};
if (translatedLocales && translatedLocales.length > 0) {
  for (const l of translatedLocales) langs[l] = `${fullMap[l]}${qs}`;
  langs["x-default"] = `${fullMap[defaultLocale]}${qs}`;
} else {
  for (const [code, href] of Object.entries(fullMap)) langs[code] = `${href}${qs}`;
}
const ogImage =
  image ?? `${SITE_URL}/og?title=${encodeURIComponent(title)}&locale=${locale}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{Object.entries(langs).map(([code, href]) => (
  <link rel="alternate" hreflang={code} href={href} />
))}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={toOgLocale(locale)} />
{locales.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={toOgLocale(l)} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:site" content="@medcasts" />
{type === "article" && publishedAt && (
  <meta property="article:published_time" content={publishedAt} />
)}
{type === "article" && modifiedAt && (
  <meta property="article:modified_time" content={modifiedAt} />
)}
{type === "article" && author && (
  <meta property="article:author" content={author} />
)}
<meta name="theme-color" content="#0A5D54" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="MedCasts" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Blog`} href="/blog/rss.xml" />
