---
import { localizedPath, type Locale } from "@/lib/i18n";
import { bindChromeT } from "@/lib/chrome-i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = bindChromeT(locale);
---

<!-- Sticky chat + urgency FAB -->
<div
  id="mc-fab"
  class="fixed z-50 flex flex-col gap-3"
  style="bottom: 24px; inset-inline-end: 24px;"
  aria-label="Quick actions"
>
  <!-- Urgency nudge — fades in after 30s -->
  <div
    data-fab-urgency
    hidden
    class="paper"
    style="padding: 14px 18px; max-width: 240px; box-shadow: var(--shadow-lg); border-radius: var(--radius-lg);"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-start gap-2.5">
      <span class="inline-block w-2 h-2 rounded-full shrink-0 mt-1.5" style="background: #10B981;" aria-hidden="true"></span>
      <div>
        <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-subtle);">
          {t("fab.coordinatorOnline")}
        </div>
        <p class="serif mt-1" style="font-size: 13.5px; line-height: 1.4; color: var(--color-ink);">
          {t("fab.coordinatorPitch")}
        </p>
        <a
          href={localizedPath(locale, "/contact")}
          class="mono mt-2 inline-block"
          style="font-size: 10.5px; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase;"
        >
          {t("fab.getQuote")}
        </a>
        <p class="mt-2" style="font-size: 11px; color: var(--color-ink-subtle);">
          {t("fab.noWhatsapp")}
          <a
            href="mailto:medcastsdigital@gmail.com?subject=Quote%20request"
            style="color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px;"
          >
            {t("fab.emailUs")}
          </a>
        </p>
      </div>
    </div>
  </div>

  <!-- WhatsApp FAB -->
  <a
    href="https://wa.me/918006210000"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t("m.whatsapp")}
    class="inline-flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full shrink-0 transition-transform hover:scale-110 focus:scale-110"
    style="background: #25D366; color: #FFF; box-shadow: 0 4px 16px rgba(37,211,102,.35);"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>

<!-- Scroll-depth CTA — fires at 60% scroll on long pages -->
<div
  data-scroll-cta
  hidden
  class="fixed inset-x-0 z-40 pointer-events-none scroll-cta-wrap"
  style="bottom: 0;"
>
  <div class="mx-auto max-w-[1440px] px-7 pb-4 pointer-events-auto">
    <div
      class="paper scroll-cta-panel flex items-center justify-between gap-4 flex-wrap"
      style="padding: 14px 20px; border-radius: var(--radius-xl) var(--radius-xl) 0 0; box-shadow: var(--shadow-lg); max-width: 600px; margin-left: auto;"
      role="complementary"
      aria-label={t("fab.midPageAria")}
    >
      <div class="min-w-0">
        <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent);">
          {t("fab.readyForQuote")}
        </div>
        <p class="serif" style="font-size: 14px; color: var(--color-ink-muted);">
          {t("fab.threeQuotes")}
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href={localizedPath(locale, "/contact")}
          class="inline-flex items-center gap-2 font-semibold"
          style="background: var(--color-ink); color: var(--color-bg); padding: 10px 18px; border-radius: 9999px; font-size: 13px;"
        >
          {t("fab.getQuoteShort")}
        </a>
        <button
          type="button"
          data-scroll-cta-close
          aria-label={t("fab.dismiss")}
          class="mono inline-flex items-center justify-center"
          style="width: 44px; height: 44px; font-size: 20px; line-height: 1; color: var(--color-ink-subtle); background: none; border: none; cursor: pointer; padding: 0;"
        >×</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* On phones, lift scroll-CTA to the start side so it doesn't fight the WhatsApp FAB. */
  @media (max-width: 640px) {
    .scroll-cta-wrap > div { padding-inline-end: 80px; }
    .scroll-cta-panel { margin-left: 0 !important; margin-right: auto; max-width: calc(100vw - 96px) !important; }
  }
  /* When the mobile quote bar is mounted, lift the FAB + scroll-CTA above it so they don't collide. */
  @media (max-width: 1023.98px) {
    body.has-quote-bar #mc-fab { bottom: calc(86px + env(safe-area-inset-bottom, 0px)); }
    body.has-quote-bar .scroll-cta-wrap { bottom: 76px !important; }
    /* Hide the WhatsApp FAB on mobile when the bottom bar already exposes it */
    body.has-quote-bar #mc-fab > a[href*="wa.me"] { display: none; }
    /* And the urgency nudge — the bar provides the same nudge persistently */
    body.has-quote-bar [data-fab-urgency] { display: none !important; }
  }
</style>

<script is:inline>
  (() => {
    var path = location.pathname;
    var blocked = /\/(portal|privacy-policy|terms|editorial-policy)\b|\/(404|500)$/.test(path);
    if (blocked) return;

    var fabUrgency = document.querySelector('[data-fab-urgency]');
    if (fabUrgency) {
      // Show urgency nudge after 30s of page inactivity
      var urgencyTimer = setTimeout(function () {
        fabUrgency.removeAttribute('hidden');
      }, 30000);
      // Hide if user scrolls or interacts
      document.addEventListener('scroll', function () { clearTimeout(urgencyTimer); }, { once: true });
      document.addEventListener('pointerdown', function () { clearTimeout(urgencyTimer); }, { once: true });
    }

    // Scroll-depth CTA at 60%
    var scrollCTA = document.querySelector('[data-scroll-cta]');
    var scrollCTAShown = false;
    var scrollThreshold = 0.6;
    if (scrollCTA) {
      function checkScroll() {
        if (scrollCTAShown) return;
        var docH = document.documentElement.scrollHeight - window.innerHeight;
        if (docH <= 0) return;
        var pct = window.scrollY / docH;
        if (pct >= scrollThreshold) {
          scrollCTAShown = true;
          scrollCTA.removeAttribute('hidden');
        }
      }
      window.addEventListener('scroll', checkScroll, { passive: true });
      var closeBtn = scrollCTA.querySelector('[data-scroll-cta-close]');
      if (closeBtn) closeBtn.addEventListener('click', function () {
        scrollCTA.setAttribute('hidden', '');
        scrollCTAShown = true; // don't re-show
      });
    }
  })();
</script>
