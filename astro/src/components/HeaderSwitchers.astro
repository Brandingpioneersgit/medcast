---
import { locales as LOCALES, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;

const CURRENCIES = [
  { code: "USD", label: "US Dollar", symbol: "$" },
  { code: "EUR", label: "Euro", symbol: "€" },
  { code: "GBP", label: "British Pound", symbol: "£" },
  { code: "INR", label: "Indian Rupee", symbol: "₹" },
  { code: "AED", label: "UAE Dirham", symbol: "د.إ" },
  { code: "SAR", label: "Saudi Riyal", symbol: "﷼" },
  { code: "TRY", label: "Turkish Lira", symbol: "₺" },
  { code: "RUB", label: "Russian Rouble", symbol: "₽" },
  { code: "BDT", label: "Bangladeshi Taka", symbol: "৳" },
];

const LOCALE_LABELS: Record<Locale, { label: string; flag: string }> = {
  en: { label: "English", flag: "🇺🇸" },
  ar: { label: "العربية", flag: "🇸🇦" },
  ru: { label: "Русский", flag: "🇷🇺" },
  fr: { label: "Français", flag: "🇫🇷" },
  pt: { label: "Português", flag: "🇵🇹" },
  bn: { label: "বাংলা", flag: "🇧🇩" },
  tr: { label: "Türkçe", flag: "🇹🇷" },
  hi: { label: "हिन्दी", flag: "🇮🇳" },
};

// Read current currency from cookie so the trigger label is correct on first paint
// (the JS hydration fix is still there for cookie changes after navigation).
const CURRENCY_SYMBOLS: Record<string, string> = {
  USD: "$", EUR: "€", GBP: "£", INR: "₹", AED: "د.إ",
  SAR: "﷼", TRY: "₺", RUB: "₽", BDT: "৳",
};
const cookieCurrency = (Astro.cookies.get("mc-currency")?.value ?? "USD") as string;
const initialCurrencyLabel = `${cookieCurrency} ${CURRENCY_SYMBOLS[cookieCurrency] ?? "$"}`;

// Strip leading locale segment so we can rebuild with a different one.
// Astro is configured with prefixDefaultLocale: true, so EVERY locale URL is prefixed.
function buildLocaleUrl(target: Locale): string {
  const parts = pathname.split("/").filter(Boolean);
  const rest = parts.length > 0 && (LOCALES as readonly string[]).includes(parts[0])
    ? parts.slice(1).join("/")
    : parts.join("/");
  return `/${target}${rest ? "/" + rest : "/"}`;
}

const menuStyle =
  "position: absolute; inset-block-start: calc(100% + 8px); inset-inline-end: 0; min-width: 220px; max-height: 340px; overflow-y: auto; background: var(--color-paper); color: var(--color-ink); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-md, 0 8px 24px rgba(0,0,0,0.15)); padding: 6px; z-index: 60;";
const itemStyle =
  "display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; border-radius: 6px; font-size: 13px; cursor: pointer; background: transparent; border: 0; width: 100%; text-align: start; font-family: inherit; color: inherit;";
---

{/* Currency switcher */}
<div class="relative" data-mc-switcher="currency">
  <button
    type="button"
    class="opacity-80 hover:opacity-100 inline-flex items-center gap-1"
    style="background: transparent; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer;"
    aria-haspopup="menu"
    aria-expanded="false"
    data-mc-switcher-trigger
  >
    <span data-currency-label>{initialCurrencyLabel}</span>
    <svg width="9" height="9" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.7;" aria-hidden="true">
      <path d="M1 1l4 4 4-4" />
    </svg>
  </button>
  <div style={menuStyle} role="menu" data-mc-switcher-menu hidden>
    <div
      class="mono"
      style="padding: 6px 10px; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-subtle);"
    >Currency</div>
    {CURRENCIES.map((c) => (
      <button
        type="button"
        role="menuitem"
        data-set-currency={c.code}
        style={itemStyle}
      >
        <span style="font-weight: 500;">{c.code} <span style="color: var(--color-ink-subtle); font-weight: 400; margin-inline-start: 4px;">{c.symbol}</span></span>
        <span style="color: var(--color-ink-subtle); font-size: 11.5px;">{c.label}</span>
      </button>
    ))}
  </div>
</div>

<span class="opacity-40">·</span>

{/* Language switcher */}
<div class="relative" data-mc-switcher="locale">
  <button
    type="button"
    class="opacity-80 hover:opacity-100 inline-flex items-center gap-1.5 uppercase tracking-wider"
    style="background: transparent; border: 0; padding: 0; color: inherit; font-size: 11px; cursor: pointer;"
    aria-haspopup="menu"
    aria-expanded="false"
    data-mc-switcher-trigger
  >
    <span aria-hidden="true">{LOCALE_LABELS[locale].flag}</span>
    <span>{locale}</span>
    <svg width="9" height="9" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.7;" aria-hidden="true">
      <path d="M1 1l4 4 4-4" />
    </svg>
  </button>
  <div style={menuStyle} role="menu" data-mc-switcher-menu hidden>
    <div
      class="mono"
      style="padding: 6px 10px; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-subtle);"
    >Language</div>
    {LOCALES.map((l) => {
      const active = l === locale;
      return (
        <a
          href={buildLocaleUrl(l)}
          role="menuitem"
          style={`${itemStyle} text-decoration: none; ${active ? "background: var(--color-accent-soft); color: var(--color-accent-strong);" : ""}`}
        >
          <span class="inline-flex items-center gap-2">
            <span aria-hidden="true">{LOCALE_LABELS[l].flag}</span>
            <span style="font-weight: 500;">{LOCALE_LABELS[l].label}</span>
          </span>
          <span style="color: var(--color-ink-subtle); font-size: 10.5px; text-transform: uppercase;">{l}</span>
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  (() => {
    function getCookie(name) {
      var m = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/[.$?*|{}()[\]\\\/+^]/g, "\\$&") + "=([^;]*)"));
      return m ? decodeURIComponent(m[1]) : null;
    }
    function setCookie(name, value, days) {
      var d = new Date();
      d.setTime(d.getTime() + days * 864e5);
      var secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie = name + "=" + encodeURIComponent(value) + "; expires=" + d.toUTCString() + "; path=/; SameSite=Lax" + secure;
    }

    var CURRENCY_SYMBOLS = {
      USD: "$", EUR: "€", GBP: "£", INR: "₹", AED: "د.إ",
      SAR: "﷼", TRY: "₺", RUB: "₽", BDT: "৳",
    };

    // Reflect actual cookie on the trigger label on first paint (in case the
    // server-rendered label diverges, e.g. when the page was served from cache).
    var currentCurrency = getCookie("mc-currency") || "USD";
    document.querySelectorAll("[data-currency-label]").forEach(function (el) {
      var sym = CURRENCY_SYMBOLS[currentCurrency] || "$";
      el.textContent = currentCurrency + " " + sym;
    });

    // Custom dropdown — replaces the previous <details>/<summary> mechanism
    // which had inconsistent click targeting on iOS Safari.
    var switchers = document.querySelectorAll("[data-mc-switcher]");
    function closeAll(except) {
      switchers.forEach(function (sw) {
        if (sw === except) return;
        var menu = sw.querySelector("[data-mc-switcher-menu]");
        var trig = sw.querySelector("[data-mc-switcher-trigger]");
        if (menu) menu.setAttribute("hidden", "");
        if (trig) trig.setAttribute("aria-expanded", "false");
        sw.removeAttribute("data-mc-open");
      });
    }
    switchers.forEach(function (sw) {
      var trig = sw.querySelector("[data-mc-switcher-trigger]");
      var menu = sw.querySelector("[data-mc-switcher-menu]");
      if (!trig || !menu) return;
      trig.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = sw.getAttribute("data-mc-open") === "true";
        closeAll(sw);
        if (isOpen) {
          menu.setAttribute("hidden", "");
          trig.setAttribute("aria-expanded", "false");
          sw.removeAttribute("data-mc-open");
        } else {
          menu.removeAttribute("hidden");
          trig.setAttribute("aria-expanded", "true");
          sw.setAttribute("data-mc-open", "true");
        }
      });
    });

    document.addEventListener("click", function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      // Currency item click → set cookie + soft refresh.
      // Strategy: fetch the current URL (server reads the new cookie via
      // document.cookie before the browser ships it on the next request),
      // parse the response, and swap the <body>. Wrapped in a View
      // Transition where supported for a smooth fade. Falls back to a hard
      // reload on any error so currency change is never silently broken.
      var currencyBtn = target.closest("[data-set-currency]");
      if (currencyBtn) {
        e.preventDefault();
        var code = currencyBtn.getAttribute("data-set-currency");
        if (!code) return;
        setCookie("mc-currency", code, 180);
        var apply = function () {
          fetch(location.href, { credentials: "same-origin", cache: "no-store" })
            .then(function (r) { return r.text(); })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, "text/html");
              if (!doc.body) throw new Error("no body");
              document.body.replaceWith(doc.body);
              // Re-trigger any island scripts that wire up on DOMContentLoaded.
              window.dispatchEvent(new Event("astro:after-swap"));
            })
            .catch(function () { location.reload(); });
        };
        if (typeof document.startViewTransition === "function") {
          document.startViewTransition(apply);
        } else {
          apply();
        }
        return;
      }

      // Outside-click — close any open switcher
      var insideSwitcher = false;
      switchers.forEach(function (sw) {
        if (sw.contains(target)) insideSwitcher = true;
      });
      if (!insideSwitcher) closeAll(null);
    });

    // Esc closes
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAll(null);
    });
  })();
</script>
