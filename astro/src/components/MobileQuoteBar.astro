---
import { localizedPath, type Locale } from "@/lib/i18n";
import { whatsappFor, type WhatsAppContext } from "@/lib/whatsapp";
import { bindChromeT } from "@/lib/chrome-i18n";

interface Props {
  locale: Locale;
  /** Build the WhatsApp message for the entity in view. */
  whatsapp: WhatsAppContext;
  /**
   * Where the "Get quote" button points. If omitted, falls back to /contact
   * with the entity slug pre-filled (when present).
   */
  quoteHref?: string;
  /** Short label above the buttons — e.g. hospital or treatment name. */
  label?: string;
  /** Sub-label — e.g. "from $4,800" or "9-min reply". */
  sublabel?: string;
}

const { locale, whatsapp, quoteHref: quoteHrefProp, label, sublabel } = Astro.props;

const quoteHref = quoteHrefProp ?? (() => {
  const params = new URLSearchParams();
  if (whatsapp.page === "hospital" && whatsapp.slug) params.set("hospital", whatsapp.slug);
  else if (whatsapp.page === "doctor" && whatsapp.slug) params.set("doctor", whatsapp.slug);
  else if (whatsapp.page === "treatment" && whatsapp.slug) params.set("treatment", whatsapp.slug);
  else if (whatsapp.page === "country" && whatsapp.slug) params.set("country", whatsapp.slug);
  else if (whatsapp.page === "specialty" && whatsapp.slug) params.set("specialty", whatsapp.slug);
  const qs = params.toString();
  return localizedPath(locale, qs ? `/contact?${qs}` : "/contact");
})();

const waHref = whatsappFor(whatsapp);
const t = bindChromeT(locale);
---

<div
  class="mc-quote-bar lg:hidden"
  role="region"
  aria-label={t("m.quickActions")}
>
  <div class="mc-quote-bar-inner">
    {(label || sublabel) && (
      <div class="min-w-0 flex-1">
        {label && (
          <div class="serif truncate" style="font-size: 13.5px; line-height: 1.2; color: var(--color-ink); font-weight: 500;">
            {label}
          </div>
        )}
        {sublabel && (
          <div class="mono uppercase truncate" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); margin-top: 2px;">
            {sublabel}
          </div>
        )}
      </div>
    )}
    <div class="flex items-center gap-2 shrink-0">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center"
        style="background: #25D366; color: #FFF; height: 44px; width: 44px; border-radius: 9999px;"
        aria-label={t("m.whatsapp")}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
      <a
        href={quoteHref}
        class="inline-flex items-center justify-center font-semibold whitespace-nowrap"
        style="background: var(--color-ink); color: var(--color-bg); padding: 12px 18px; border-radius: 9999px; font-size: 13.5px;"
      >
        {t("m.getQuote")}
      </a>
    </div>
  </div>
</div>

<style>
  .mc-quote-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -8px 24px rgba(14, 23, 19, 0.08);
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
    backdrop-filter: blur(8px);
  }
  .mc-quote-bar-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
  }
  /* Push page bottom up so content isn't hidden behind the bar. */
  body.has-quote-bar { padding-bottom: 76px; }
</style>

<script is:inline>
  (() => {
    if (window.matchMedia && window.matchMedia("(min-width: 1024px)").matches) return;
    document.body.classList.add("has-quote-bar");
  })();
</script>
