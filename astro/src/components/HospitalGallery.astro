---
// HospitalGallery — 4-photo hero strip with a click-to-zoom lightbox.
// When `images` (hospital_images rows) is populated we render those.
// When empty (current state for ~all hospitals), synthesize 3 supporting
// photos from the specialty pool so the hero feels like a real facility
// instead of a single stock placeholder. Cover always anchors slot 0.
import { hospitalCover } from "@/lib/images";

interface ImageRow {
  url: string;
  altText?: string | null;
  category?: string | null;
}

interface Props {
  hospital: {
    id: number;
    slug: string;
    name: string;
    coverImageUrl?: string | null;
  };
  countrySlug?: string | null;
  topSpecialtySlug?: string | null;
  cityName?: string | null;
  images?: ImageRow[];
}

const { hospital, countrySlug, topSpecialtySlug, cityName, images = [] } = Astro.props;

// Build 4 photo URLs. Slot 0 = cover. Slots 1-3 = real images if present,
// otherwise synthesized from the specialty pool by varying the seed.
const cover = hospitalCover({
  coverImageUrl: hospital.coverImageUrl,
  countrySlug,
  topSpecialtySlug,
  id: hospital.id,
  slug: hospital.slug,
});

type Slot = { url: string; alt: string; label: string };

const slots: Slot[] = [
  { url: cover, alt: `${hospital.name} exterior${cityName ? `, ${cityName}` : ""}`, label: "Exterior" },
];

const SUPPLEMENT_LABELS = ["Patient room", "Operating suite", "Intl lounge"];

// Use any real hospital_images first.
for (const img of images.slice(0, 3)) {
  slots.push({
    url: img.url,
    alt: img.altText ?? `${hospital.name} ${img.category ?? "interior"}`,
    label: (img.category ?? "Interior").replace(/_/g, " "),
  });
}

// Pad to 4 with synthesized specialty photos (seed varies so each thumb differs).
let synthIdx = 0;
while (slots.length < 4) {
  const seedSuffix = ["int", "or", "lounge"][synthIdx] ?? "x";
  const url = hospitalCover({
    coverImageUrl: null,
    countrySlug,
    topSpecialtySlug,
    id: hospital.id,
    slug: `${hospital.slug}-${seedSuffix}`,
  });
  slots.push({
    url,
    alt: `${hospital.name} ${SUPPLEMENT_LABELS[synthIdx] ?? "interior"}`,
    label: SUPPLEMENT_LABELS[synthIdx] ?? "Interior",
  });
  synthIdx++;
}
---

<div
  class="mc-gallery"
  data-gallery
  data-gallery-name={hospital.name}
  style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 8px; max-height: 420px; border-radius: var(--radius-lg); overflow: hidden;"
>
  {/* Slot 0 — large cover */}
  <button
    type="button"
    class="mc-gallery-cell mc-gallery-trigger"
    data-gallery-index="0"
    style="position: relative; aspect-ratio: 4/3; overflow: hidden; border: 0; padding: 0; background: transparent; cursor: zoom-in;"
    aria-label={`Open ${hospital.name} gallery`}
  >
    <img
      src={slots[0].url}
      alt={slots[0].alt}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      width="800"
      height="600"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
    <span
      class="mono"
      style="position: absolute; bottom: 12px; inset-inline-start: 14px; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(251,248,241,.95); text-shadow: 0 1px 8px rgba(14,23,19,0.5); padding: 4px 9px; background: rgba(14,23,19,0.45); border-radius: 9999px; backdrop-filter: blur(6px);"
    >
      {slots[0].label}
    </span>
  </button>

  {/* Slots 1-3 — column of three thumbs */}
  <div style="display: grid; grid-template-rows: 1fr 1fr 1fr; gap: 8px;">
    {slots.slice(1, 4).map((s, i) => (
      <button
        type="button"
        class="mc-gallery-cell mc-gallery-trigger"
        data-gallery-index={i + 1}
        style="position: relative; overflow: hidden; border: 0; padding: 0; background: transparent; cursor: zoom-in;"
        aria-label={`Open ${hospital.name} gallery — ${s.label}`}
      >
        <img
          src={s.url}
          alt={s.alt}
          loading="lazy"
          decoding="async"
          width="400"
          height="240"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
        <span
          class="mono"
          style="position: absolute; bottom: 8px; inset-inline-start: 10px; font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(251,248,241,.95); text-shadow: 0 1px 6px rgba(14,23,19,0.5); padding: 3px 7px; background: rgba(14,23,19,0.4); border-radius: 9999px;"
        >
          {s.label}
        </span>
        {i === 2 && (
          <span
            class="mono"
            style="position: absolute; top: 8px; inset-inline-end: 10px; font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(251,248,241,.95); text-shadow: 0 1px 6px rgba(14,23,19,0.5); padding: 3px 7px; background: rgba(10,93,84,0.85); border-radius: 9999px;"
          >
            View {slots.length} photos
          </span>
        )}
      </button>
    ))}
  </div>
</div>

{/* Lightbox — single instance per page, fed by clicks on .mc-gallery-trigger */}
<dialog
  id="mc-lightbox"
  style="border: 0; padding: 0; background: rgba(14,23,19,0.92); max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; backdrop-filter: blur(8px);"
>
  <div style="position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
    <img
      id="mc-lightbox-img"
      src=""
      alt=""
      style="max-width: 92vw; max-height: 88vh; object-fit: contain; box-shadow: 0 20px 60px rgba(0,0,0,0.6);"
    />
    <button
      type="button"
      id="mc-lightbox-prev"
      aria-label="Previous photo"
      style="position: absolute; top: 50%; transform: translateY(-50%); inset-inline-start: 18px; width: 44px; height: 44px; border-radius: 9999px; border: 0; background: rgba(251,248,241,0.92); color: var(--color-ink, #0E1713); font-size: 22px; cursor: pointer; display: flex; align-items: center; justify-content: center;"
    >‹</button>
    <button
      type="button"
      id="mc-lightbox-next"
      aria-label="Next photo"
      style="position: absolute; top: 50%; transform: translateY(-50%); inset-inline-end: 18px; width: 44px; height: 44px; border-radius: 9999px; border: 0; background: rgba(251,248,241,0.92); color: var(--color-ink, #0E1713); font-size: 22px; cursor: pointer; display: flex; align-items: center; justify-content: center;"
    >›</button>
    <button
      type="button"
      id="mc-lightbox-close"
      aria-label="Close gallery"
      style="position: absolute; top: 18px; inset-inline-end: 18px; width: 40px; height: 40px; border-radius: 9999px; border: 0; background: rgba(251,248,241,0.92); color: var(--color-ink, #0E1713); font-size: 18px; cursor: pointer;"
    >×</button>
    <div
      id="mc-lightbox-caption"
      class="mono"
      style="position: absolute; bottom: 22px; inset-inline-start: 50%; transform: translateX(-50%); color: rgba(251,248,241,.92); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 14px; background: rgba(14,23,19,0.55); border-radius: 9999px; backdrop-filter: blur(6px);"
    ></div>
  </div>
</dialog>

<script is:inline define:vars={{ slots }}>
  (function () {
    const dialog = document.getElementById("mc-lightbox");
    if (!dialog || typeof dialog.showModal !== "function") return;
    const img = document.getElementById("mc-lightbox-img");
    const cap = document.getElementById("mc-lightbox-caption");
    let idx = 0;
    function paint() {
      const s = slots[idx];
      if (!s) return;
      img.src = s.url;
      img.alt = s.alt;
      cap.textContent = `${idx + 1} / ${slots.length} · ${s.label}`;
    }
    function open(at) {
      idx = at;
      paint();
      dialog.showModal();
    }
    function close() {
      try { dialog.close(); } catch (_) {}
    }
    function step(d) {
      idx = (idx + d + slots.length) % slots.length;
      paint();
    }
    document.querySelectorAll("[data-gallery-index]").forEach((el) => {
      el.addEventListener("click", () => open(parseInt(el.getAttribute("data-gallery-index") || "0", 10)));
    });
    document.getElementById("mc-lightbox-close")?.addEventListener("click", close);
    document.getElementById("mc-lightbox-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("mc-lightbox-next")?.addEventListener("click", () => step(1));
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowLeft") step(-1);
      else if (e.key === "ArrowRight") step(1);
    });
  })();
</script>

<style>
  @media (max-width: 720px) {
    .mc-gallery {
      grid-template-columns: 1fr !important;
      max-height: none !important;
    }
    .mc-gallery > div {
      grid-template-rows: auto !important;
      grid-template-columns: 1fr 1fr 1fr !important;
    }
  }
  .mc-gallery-trigger img {
    transition: transform 0.4s ease;
  }
  .mc-gallery-trigger:hover img {
    transform: scale(1.03);
  }
</style>
