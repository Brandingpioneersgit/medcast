---
// Reusable cross-link block for thin pages (forms, legal, trust, CTA hubs).
// Renders a 2-3 column grid of internal-link cards with eyebrow + label + hint.
// Caller passes a curated list of items; the component handles localizedPath
// so callers stay terse.
import { localizedPath, defaultLocale, type Locale } from "@/lib/i18n";

interface Item {
  /** Path relative to locale root, e.g. "/specialty/cardiac-surgery". */
  href: string;
  /** Short label rendered as the card heading. */
  label: string;
  /** One-sentence hint rendered below the label. Optional. */
  hint?: string;
  /** Optional eyebrow/category label (e.g. "Specialty", "Destination"). */
  eyebrow?: string;
  /** If true, href is treated as absolute and NOT prefixed with locale. */
  external?: boolean;
}

interface Props {
  locale?: Locale;
  /** Section eyebrow above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading: string;
  /** Optional sub-heading / lede paragraph. */
  lede?: string;
  /** 6-12 items recommended. */
  items: Item[];
  /** Grid min-column width (default 240px). */
  minColumn?: number;
}

const {
  locale = defaultLocale,
  eyebrow,
  heading,
  lede,
  items,
  minColumn = 240,
} = Astro.props;

if (!items || items.length === 0) return null;
---

<section
  aria-labelledby="explore-grid-heading"
  style="padding: 56px 28px; border-top: 1px solid var(--color-border-soft); background: var(--color-bg);"
>
  <div class="mx-auto" style="max-width: 1080px;">
    {eyebrow && (
      <div
        class="mono uppercase"
        style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);"
      >
        {eyebrow}
      </div>
    )}
    <h2
      id="explore-grid-heading"
      class="display mt-2"
      style="font-size: 32px; letter-spacing: -0.02em; line-height: 1.1;"
    >
      {heading}
    </h2>
    {lede && (
      <p
        class="serif mt-3"
        style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted); max-width: 640px;"
      >
        {lede}
      </p>
    )}
    <ul
      class="grid mt-7"
      style={`grid-template-columns: repeat(auto-fit, minmax(${minColumn}px, 1fr)); gap: 14px; list-style: none; padding: 0; margin: 0;`}
    >
      {items.map((it) => (
        <li>
          <a
            href={it.external ? it.href : localizedPath(locale, it.href)}
            class="paper"
            style="display: block; padding: 18px 20px; height: 100%; text-decoration: none; color: var(--color-ink); transition: transform 0.18s ease, border-color 0.18s ease;"
          >
            {it.eyebrow && (
              <div
                class="mono uppercase"
                style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);"
              >
                {it.eyebrow}
              </div>
            )}
            <div
              class="serif"
              style={`font-size: 17px; line-height: 1.3; letter-spacing: -0.005em; ${it.eyebrow ? "margin-top: 6px;" : ""}`}
            >
              {it.label}
            </div>
            {it.hint && (
              <div
                style="font-size: 13px; line-height: 1.45; color: var(--color-ink-muted); margin-top: 6px;"
              >
                {it.hint}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  a.paper:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent) !important;
  }
</style>
