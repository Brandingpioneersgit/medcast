---
// WhatsApp call-to-action shown under a doctor (listing cards + profile).
// The link opens WhatsApp to the MedCasts care-team number with a message
// pre-filled naming the specific doctor — so the patient reaches the team
// while the thread reads as "about Dr. X". Brand-green + WhatsApp glyph.
import { whatsappFor } from "@/lib/whatsapp";

interface Props {
  doctorName: string;
  doctorSlug?: string;
  hospitalName?: string | null;
  specialtyName?: string | null;
  variant?: "card" | "panel";
}
const {
  doctorName,
  doctorSlug,
  hospitalName = null,
  specialtyName = null,
  variant = "card",
} = Astro.props;

const href = whatsappFor({
  page: "doctor",
  doctorName,
  slug: doctorSlug,
  hospitalName: hospitalName ?? undefined,
  specialtyName: specialtyName ?? undefined,
});

const name = doctorName.trim();
const titled = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(name) ? name : `Dr. ${name}`;
const label = variant === "panel" ? `Message ${titled} on WhatsApp` : `Message ${titled}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener nofollow"
  class:list={["wa-doc", `wa-doc--${variant}`]}
  aria-label={`Message ${titled} on WhatsApp`}
>
  <svg class="wa-doc-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 005.71 1.447h.006c6.585 0 11.946-5.335 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"/>
  </svg>
  <span class="wa-doc-label">{label}</span>
  {variant === "panel" && (
    <span class="wa-doc-sub">Typical reply ~9 min · MedCasts care team</span>
  )}
</a>

<style>
  .wa-doc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #25D366;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.2;
    transition: background 140ms ease, transform 120ms ease, box-shadow 140ms ease;
  }
  .wa-doc:hover { background: #1da851; }
  .wa-doc:active { transform: scale(0.985); }
  .wa-doc-icon { flex-shrink: 0; }
  .wa-doc-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Compact pill under a directory card. */
  .wa-doc--card {
    width: 100%;
    padding: 9px 12px;
    font-size: 12.5px;
    border-radius: 9999px;
  }
  .wa-doc--card .wa-doc-icon { width: 15px; height: 15px; }

  /* Full-width button for the doctor profile booking panel. */
  .wa-doc--panel {
    flex-wrap: wrap;
    column-gap: 9px;
    row-gap: 1px;
    width: 100%;
    padding: 12px 20px;
    font-size: 14.5px;
    border-radius: 9999px;
    box-shadow: 0 3px 12px rgba(37, 211, 102, 0.3);
  }
  .wa-doc--panel:hover { box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4); }
  .wa-doc--panel .wa-doc-icon { width: 19px; height: 19px; }
  .wa-doc-sub {
    flex-basis: 100%;
    text-align: center;
    font-weight: 500;
    font-size: 10.5px;
    opacity: 0.9;
  }
</style>
