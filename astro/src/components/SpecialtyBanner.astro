    fg: "#F6F1E6",
    motif: "arc",
  },
  dental: {
    icon: Smile,
    gradient: "linear-gradient(135deg, #0A5D54 0%, #073D37 60%, #0E1713 100%)",
    halo: "rgba(246, 241, 230, 0.22)",
