---
// Branded specialty banner — replaces generic stock photos with a custom
// gradient + lucide icon illustration that matches the medcasts palette.
// Used on /specialty/[slug], /specialties, /treatment/[slug] heroes, and
// home page specialty cards.

import {
  HeartPulse,
  Bone,
  Dna,
  Brain,
  HeartHandshake,
  Stethoscope,
  Sparkles,
  Baby,
  Eye,
  Smile,
  Scale,
  Droplets,
  Flower2,
  Ear,
  Activity,
} from "lucide-react";

interface Props {
  slug?: string | null;
  name?: string | null;
  /** CSS aspect ratio expression. Defaults to 16/10 — matches PhotoBlock default. */
  aspect?: string;
  label?: string;
  rounded?: boolean;
  class?: string;
}

const {
  slug,
  name,
  aspect = "16/10",
  label,
  rounded = true,
  class: className = "",
} = Astro.props;

type Theme = {
  icon: any;
  // CSS gradient string
  gradient: string;
  // Soft accent for halo behind icon
  halo: string;
  // Visible text/icon color
  fg: string;
  // Pattern hint — "arc" | "dots" | "lines"
  motif: "arc" | "dots" | "lines";
};

// Per-specialty theming. Gradients pulled from the brand palette
// (forest teal, deep ink, accent mist, saffron, coral, ocean).
const THEMES: Record<string, Theme> = {
