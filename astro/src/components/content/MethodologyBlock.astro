---
/**
 * EEAT signal block — methodology + reviewer attribution + last-updated stamp.
 *
 * Sits at the bottom of YMYL pages (treatment, condition, hospital, doctor,
 * cost, visa, glossary, qa) to give Google explicit signals on:
 *   E - Experience: who built this list and how
 *   E - Expertise: who reviewed it (attribution)
 *   A - Authoritativeness: data sources cited
 *   T - Trustworthiness: corrections email, last-reviewed date, conflict-of-interest stance
 */

import { localizedPath, defaultLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
  reviewerName?: string | null;
  reviewerCredentials?: string | null;
  reviewerSlug?: string | null;
  lastReviewed?: Date | string | null;
  /** What dataset this page draws from — keeps the methodology specific */
  dataSources?: string[];
  /** Optional: short note on how this entity-type list is curated */
  curationNote?: string;
}

const {
  locale = defaultLocale,
  reviewerName,
  reviewerCredentials,
  reviewerSlug,
  lastReviewed,
  dataSources = [],
  curationNote,
} = Astro.props;

const medicalBoardHref = localizedPath(locale, "/medical-board");

function fmtDate(d: Date | string | null | undefined): string | null {
  if (!d) return null;
  const date = typeof d === "string" ? new Date(d) : d;
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const reviewedDate = fmtDate(lastReviewed);
---

<section
  aria-labelledby="methodology-heading"
  style="padding: 56px 28px; border-top: 1px solid var(--color-border-soft); background: var(--color-bg);"
>
  <div class="mx-auto max-w-[1080px]">
    <div
      class="grid gap-8"
      style="grid-template-columns: 1fr;"
    >
      {/* Left — methodology */}
      <div>
        <p
          class="mono uppercase"
          style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
        >
          How this page is built
        </p>
        <h2
          id="methodology-heading"
          class="serif mt-3"
          style="font-size: 22px; line-height: 1.25; font-weight: 500; color: var(--color-ink); letter-spacing: -0.01em;"
        >
          Methodology and editorial standards
        </h2>

        {curationNote && (
          <p class="serif mt-4" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">
            {curationNote}
          </p>
        )}

        <ul class="mt-5 grid gap-2" style="grid-template-columns: 1fr;">
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mono tnum mt-0.5" style="font-size: 11px; color: var(--color-accent); min-width: 22px;">01</span>
            <span style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
              <strong style="color: var(--color-ink); font-weight: 500;">Hospital data</strong> — accreditation status, bed capacity, founding year, and pricing are verified against primary sources (JCI, NABH, ISO registries; ministry-of-health licence registers; hospital-issued quote sheets) at minimum every 90 days.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mono tnum mt-0.5" style="font-size: 11px; color: var(--color-accent); min-width: 22px;">02</span>
            <span style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
              <strong style="color: var(--color-ink); font-weight: 500;">Surgeon credentials</strong> — board certification, fellowship training, and named-procedure volume are sourced from the surgeon's institutional bio, the relevant national medical council registry, and peer-reviewed publication record (where available).
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mono tnum mt-0.5" style="font-size: 11px; color: var(--color-accent); min-width: 22px;">03</span>
            <span style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
              <strong style="color: var(--color-ink); font-weight: 500;">Pricing bands</strong> — drawn from real itemised quotes our partner hospitals issue to international patients, never from advertised marketing rates. Updates when a hospital re-issues its package; outliers are flagged.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mono tnum mt-0.5" style="font-size: 11px; color: var(--color-accent); min-width: 22px;">04</span>
            <span style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
              <strong style="color: var(--color-ink); font-weight: 500;">Clinical descriptions</strong> — written by the editorial team and reviewed against current peer-reviewed guidelines (ESC, AHA, NCCN, ESMO, NICE, depending on specialty) before publication.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mono tnum mt-0.5" style="font-size: 11px; color: var(--color-accent); min-width: 22px;">05</span>
            <span style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
              <strong style="color: var(--color-ink); font-weight: 500;">Conflict-of-interest stance</strong> — MedCasts earns coordination fees from hospitals only on confirmed bookings, never per click or per quote. Page rankings are not influenced by hospital payments.
            </span>
          </li>
        </ul>

        {dataSources.length > 0 && (
          <div class="mt-6">
            <div
              class="mono uppercase"
              style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); margin-bottom: 8px;"
            >
              Data sources for this page
            </div>
            <div class="flex flex-wrap gap-1.5">
              {dataSources.map((src) => (
                <span
                  class="mono"
                  style="font-size: 11px; padding: 3px 10px; border: 1px solid var(--color-border-soft); border-radius: 9999px; color: var(--color-ink-muted);"
                >
                  {src}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Right — reviewer + last reviewed + corrections */}
      <aside>
        <div
          class="paper"
          style="padding: 22px 24px;"
        >
          {(reviewerName || reviewerCredentials) && (
            <>
              <div
                class="mono uppercase"
                style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
              >
                Medically reviewed by
              </div>
              <div class="serif mt-2" style="font-size: 17px; line-height: 1.3; color: var(--color-ink); letter-spacing: -0.005em; font-weight: 500;">
                {reviewerSlug ? (
                  <a href={`${medicalBoardHref}#${reviewerSlug}`} style="color: inherit; text-decoration-color: var(--color-border);">
                    {reviewerName}
                  </a>
                ) : (
                  reviewerName
                )}
              </div>
              {reviewerCredentials && (
                <div class="mono mt-1" style="font-size: 11.5px; color: var(--color-ink-muted); letter-spacing: 0.02em;">
                  {reviewerCredentials}
                </div>
              )}
              <a
                href={medicalBoardHref}
                class="mono uppercase mt-3 inline-block"
                style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);"
              >
                See full panel →
              </a>
            </>
          )}

          {!reviewerName && (
            <>
              <div
                class="mono uppercase"
                style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
              >
                Reviewed by
              </div>
              <div class="serif mt-2" style="font-size: 16px; line-height: 1.4; color: var(--color-ink); letter-spacing: -0.005em;">
                MedCasts editorial panel
              </div>
              <a
                href={medicalBoardHref}
                class="mono uppercase mt-3 inline-block"
                style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);"
              >
                See full panel →
              </a>
            </>
          )}

          {reviewedDate && (
            <div
              class="mt-5 pt-5"
              style="border-top: 1px solid var(--color-border-soft);"
            >
              <div
                class="mono uppercase"
                style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
              >
                Last reviewed
              </div>
              <time
                class="mono tnum mt-1 block"
                style="font-size: 13px; color: var(--color-ink);"
                datetime={typeof lastReviewed === "string" ? lastReviewed : lastReviewed?.toISOString()}
              >
                {reviewedDate}
              </time>
            </div>
          )}

          <div
            class="mt-5 pt-5"
            style="border-top: 1px solid var(--color-border-soft);"
          >
            <div
              class="mono uppercase"
              style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
            >
              Found an error?
            </div>
            <p class="serif mt-2" style="font-size: 13px; line-height: 1.5; color: var(--color-ink-muted);">
              Email the editorial desk and we'll review and revise — corrections are logged publicly.
            </p>
            <a
              href="mailto:corrections@medcasts.com"
              class="mono mt-2 inline-block"
              style="font-size: 12px; color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px;"
            >
              corrections@medcasts.com
            </a>
          </div>
        </div>

        <p
          class="mt-5"
          style="font-size: 12px; line-height: 1.55; color: var(--color-ink-subtle); font-style: italic;"
        >
          This page is an editorial overview, not personal medical advice. Always confirm the surgical plan and risk profile for your specific case with your treating clinician before booking travel.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  @media (min-width: 880px) {
    section[aria-labelledby="methodology-heading"] > div > div {
      grid-template-columns: 1.5fr 1fr;
    }
  }
</style>
