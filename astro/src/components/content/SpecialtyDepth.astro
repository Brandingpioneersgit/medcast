---
/**
 * Specialty depth — explains sub-specialties, how outcomes are measured,
 * and what a credible specialist looks like for this field.
 *
 * Adds ~350-450 words of expert-flavoured content per specialty page.
 */

interface Props {
  specialtyName: string;
  specialtySlug: string;
}

const { specialtyName, specialtySlug } = Astro.props;

type Profile = {
  /** Sub-specialties patients should be aware of when shortlisting */
  subSpecialties: { name: string; blurb: string }[];
  /** How outcomes are measured / reported in this field */
  outcomeMeasures: string[];
  /** What separates a senior specialist from a generalist */
  credibleSignals: string[];
  /** Common patient mistake when shortlisting */
  watchOut: string;
};

const PROFILES: Record<string, Profile> = {
  "cardiac-surgery": {
    subSpecialties: [
      { name: "Adult cardiac surgery", blurb: "CABG, valve repair/replacement, aortic root reconstruction, and re-do operations on prior bypass patients." },
      { name: "Paediatric & congenital", blurb: "Tetralogy of Fallot, transposition repairs, single-ventricle staged palliation — credentialled at a different centre tier from adult cardiac." },
      { name: "Minimally-invasive cardiac surgery (MICS)", blurb: "Mini-thoracotomy CABG, robotic mitral repair, percutaneous valve programs (TAVI/TAVR, MitraClip)." },
      { name: "Heart transplant + mechanical assist", blurb: "Orthotopic transplant, LVAD destination therapy, dual-organ programs (heart-kidney, heart-liver). Ultra-low-volume globally." },
    ],
    outcomeMeasures: [
      "30-day mortality, stratified by EuroSCORE II or STS risk score so the headline number isn't gamed by case selection.",
      "Stroke rate, mediastinitis rate, and reoperation-for-bleeding rate — public reporting in many EU/US registries.",
      "Re-admission within 90 days — sometimes a better quality signal than mortality for low-risk procedures.",
      "Long-term graft patency at 5 / 10 years for CABG (LIMA-to-LAD especially), and freedom-from-reintervention for valve repairs.",
    ],
    credibleSignals: [
      "Volume — at least 200-300 cardiac procedures per year for a senior surgeon, weighted toward the specific procedure you need.",
      "Society membership — STS, EACTS, ASE, AATS — and recent peer-reviewed publications.",
      "Multidisciplinary heart team — credible programs run weekly cardiology + surgery + imaging combined review for high-risk cases.",
      "Re-do volume — the surgeon's experience with second-time-on operations is the cleanest proxy for technical chops.",
    ],
    watchOut: "Avoid centres that quote a single mortality number without specifying the procedure mix or risk stratification — that statistic is meaningless without context.",
  },
  oncology: {
    subSpecialties: [
      { name: "Surgical oncology", blurb: "Solid-tumour resection — breast, GI, GU, head-and-neck, sarcoma, hepatobiliary. Sub-specialised by organ system at credible centres." },
      { name: "Medical oncology", blurb: "Chemotherapy, immunotherapy, targeted therapy regimens — increasingly biomarker-driven (HER2, EGFR, BRCA, PD-L1, MSI)." },
      { name: "Radiation oncology", blurb: "External beam (IMRT, VMAT, SBRT), brachytherapy, proton therapy where available, stereotactic radiosurgery for CNS." },
      { name: "Haematology / BMT", blurb: "Leukaemia, lymphoma, myeloma; allogeneic and autologous stem-cell transplant; CAR-T cell therapy at top-tier centres only." },
      { name: "Paediatric oncology", blurb: "Neuroblastoma, Wilms', osteosarcoma, paediatric leukaemia/lymphoma — credentialled separately from adult." },
    ],
    outcomeMeasures: [
      "5-year overall survival, stratified by stage at diagnosis — the only meaningful comparator.",
      "Disease-free survival and time-to-recurrence for curative-intent treatment.",
      "R0 resection rate (negative margins) for surgical oncology.",
      "Treatment-related mortality and major-toxicity rate for systemic therapy.",
      "Multidisciplinary tumour-board review rate — a credibility signal in itself.",
    ],
    credibleSignals: [
      "Genuine multidisciplinary tumour boards held weekly with surgery, medical onc, radiation onc, pathology, and radiology in one room.",
      "In-house molecular pathology — every cancer should be sequenced for actionable mutations before systemic therapy starts.",
      "Active enrolment in clinical trials (NCCN, ESMO, regional cooperative groups) — not a marketing line, look it up on clinicaltrials.gov.",
      "Pathology second-read on outside biopsies as default policy, not on request.",
    ],
    watchOut: "If a centre offers immunotherapy or targeted therapy without first sequencing the tumour, that's a red flag — it means they're treating empirically rather than precisely.",
  },
  orthopedics: {
    subSpecialties: [
      { name: "Joint replacement (arthroplasty)", blurb: "Hip, knee, shoulder primary and revision; cemented vs cementless; ceramic vs metal-on-poly bearings." },
      { name: "Spine surgery", blurb: "Decompression, fusion, disc replacement, deformity correction — sub-specialised between neurosurgical and orthopaedic spine teams." },
      { name: "Sports medicine + arthroscopy", blurb: "ACL/PCL/meniscus, rotator-cuff repair, hip arthroscopy, ankle ligament reconstruction." },
      { name: "Trauma + complex reconstruction", blurb: "Polytrauma, pelvic and acetabular fractures, limb-salvage, Ilizarov." },
      { name: "Hand + microsurgery", blurb: "Replantation, brachial-plexus, peripheral-nerve repairs — distinct credentialling pathway." },
    ],
    outcomeMeasures: [
      "Implant survival at 10 / 15 / 20 years (national joint registries publish this — UK NJR, Australian AOANJRR, Swedish Hip).",
      "Functional outcome scores (Oxford, KOOS, HOOS, ASES) measured pre-op and at 1 / 5 years.",
      "Surgical site infection rate — should be below 1% for elective primary joint.",
      "Revision rate, stratified by primary diagnosis (osteoarthritis vs rheumatoid vs trauma).",
      "Length of stay and discharge-to-home rate — proxies for protocol maturity.",
    ],
    credibleSignals: [
      "Volume — a senior arthroplasty surgeon should be doing 200+ primary joints per year; revision specialists 50+ revisions.",
      "Implant traceability — the centre should be able to tell you the brand, model, batch, and expected lifespan of every component.",
      "Enhanced-recovery protocol (ERAS) — same-day or next-day mobilisation, multimodal analgesia, no opioid-default discharge plans.",
      "Subspecialty fellowship (joint replacement, spine, sports, hand) — generalist orthopaedic surgeons are still common in some markets.",
    ],
    watchOut: "Robotic and computer-navigated arthroplasty is increasingly common but doesn't independently predict better outcomes — surgeon volume and revision rate matter more.",
  },
  "fertility-ivf": {
    subSpecialties: [
      { name: "Standard IVF", blurb: "Ovarian stimulation, oocyte retrieval, fertilisation (conventional or ICSI), embryo culture, transfer, freezing." },
      { name: "Pre-implantation genetic testing (PGT-A, PGT-M)", blurb: "Aneuploidy screening or single-gene mutation testing on day-5 blastocysts before transfer." },
      { name: "Donor cycles", blurb: "Egg, sperm, or embryo donation — regulatory frameworks vary widely (Spain, Cyprus, Czech Republic, parts of India differ on anonymity, age caps, and donor compensation)." },
      { name: "Surrogacy programs", blurb: "Increasingly restricted globally — open in some US states, Georgia, parts of Mexico, and Ukraine pre-war; check legal status carefully." },
      { name: "Fertility preservation", blurb: "Oncofertility (egg/sperm/embryo banking before chemotherapy), social egg freezing." },
    ],
    outcomeMeasures: [
      "Live birth rate per embryo transfer (NOT per cycle — clinics inflate the latter).",
      "Stratified by maternal age band: <35, 35-37, 38-40, 41-42, >42.",
      "Cumulative live birth rate per egg-retrieval cycle (counts subsequent frozen-embryo transfers from the same retrieval).",
      "Multiple-pregnancy rate — should be <10%; high rates indicate poor embryo selection.",
      "OHSS (ovarian hyperstimulation) rate — credible centres run almost-zero severe OHSS via antagonist protocols + agonist trigger.",
    ],
    credibleSignals: [
      "Embryologist-to-cycle ratio in the lab matters more than the surgeon's reputation — check who runs the lab.",
      "ESHRE or RCOG-aligned protocols and reporting; centres that publish their data publicly are usually the better ones.",
      "Real-time air-quality monitoring and dual-camera embryo time-lapse incubators (EmbryoScope, GERI, MIRI TLI) at top labs.",
      "PGT-A done in-house or via a top reference lab (Igenomix, Cooper Genomics) — turn-around < 14 days.",
    ],
    watchOut: "Live-birth-rate marketing claims should be ESHRE-format (per-transfer, age-stratified) — anything else (per cycle, per pregnancy) is misleading.",
  },
  neurosurgery: {
    subSpecialties: [
      { name: "Brain tumour surgery", blurb: "Glioma, meningioma, metastasis, pituitary; awake-craniotomy programs; intra-operative MRI suites." },
      { name: "Cerebrovascular", blurb: "Aneurysm clipping, AVM resection, bypass surgery, carotid endarterectomy." },
      { name: "Spine neurosurgery", blurb: "Decompression, fusion, intramedullary tumour, spinal cord stimulator implantation." },
      { name: "Functional + epilepsy", blurb: "DBS for Parkinson's, epilepsy surgery, intracranial monitoring." },
      { name: "Paediatric neurosurgery", blurb: "Hydrocephalus shunting, craniosynostosis, paediatric tumours, spina bifida — separate fellowship pathway." },
    ],
    outcomeMeasures: [
      "30-day mortality and major-morbidity rate, stratified by procedure and patient risk.",
      "Functional independence at 90 days (mRS, KPS) for tumour and vascular cases.",
      "Re-operation rate within 30 days.",
      "CSF-leak rate for cranial-base and spinal procedures.",
      "Tumour resection extent (gross-total vs subtotal) verified by post-op imaging.",
    ],
    credibleSignals: [
      "Awake-craniotomy capability for eloquent-area tumours — not all centres have it, and those that do select cases differently.",
      "Intra-operative MRI or fluorescence-guided resection (5-ALA for high-grade glioma).",
      "Active neuro-tumour-board review with neurosurgery, neuro-oncology, radiation, neuropath.",
      "Volume — senior tumour surgeons typically do 100+ craniotomies/year; cerebrovascular specialists 50+ aneurysms.",
    ],
    watchOut: "Stereotactic radiosurgery (Gamma Knife, CyberKnife) is indication-specific — it's a great tool for some metastases and small AVMs but isn't a substitute for surgical resection of operable lesions.",
  },
  ophthalmology: {
    subSpecialties: [
      { name: "Cataract surgery + refractive lens exchange", blurb: "Phacoemulsification, premium IOLs (toric, multifocal, EDOF), refractive lens exchange." },
      { name: "Cornea + refractive surgery", blurb: "LASIK, SMILE, PRK, corneal cross-linking, transplant (DMEK, DSAEK, PK)." },
      { name: "Retina + vitreous", blurb: "Vitrectomy, retinal detachment repair, anti-VEGF therapy for AMD/DME, paediatric retinal." },
      { name: "Glaucoma", blurb: "Trabeculectomy, MIGS (minimally-invasive glaucoma surgery), tube shunts, laser." },
      { name: "Paediatric + strabismus", blurb: "Squint correction, congenital cataract, paediatric refractive — distinct fellowship." },
    ],
    outcomeMeasures: [
      "Post-op refractive accuracy (% within 0.5 D of target) for cataract and refractive surgery.",
      "Endophthalmitis rate — should be < 0.05% for elective intraocular surgery.",
      "Re-treatment / enhancement rate for refractive surgery.",
      "Best-corrected visual acuity gain at 1, 3, and 12 months post-op.",
    ],
    credibleSignals: [
      "Surgeon volume — phaco surgeons should be doing 1000+ procedures/year; refractive 500+ LASIK/SMILE.",
      "Diagnostic depth — high-end OCT, biometry (IOLMaster 700), corneal topography, ultrawide-field retinal imaging.",
      "Premium IOL portfolio breadth — being able to recommend the right lens, not just the one stocked.",
      "Outcomes audited and published — centres that share their refractive-accuracy data publicly are usually the better ones.",
    ],
    watchOut: "Heavy SMILE / refractive surgery marketing tends to focus on dry-eye risk profile while underplaying enhancement rates — ask for both numbers.",
  },
};

const fallback: Profile = {
  subSpecialties: [
    { name: `${specialtyName} sub-specialties`, blurb: `${specialtyName} typically branches into several sub-fields by anatomy, technique, or patient population. The right surgeon for your case is sub-specialty matched, not just board-certified in the general field.` },
  ],
  outcomeMeasures: [
    "Procedure-specific mortality / major-morbidity rate.",
    "Re-operation or re-admission rate within 30 / 90 days.",
    "Patient-reported outcome measures (PROMs) at standard intervals.",
    "Length of stay and discharge-to-home rate.",
  ],
  credibleSignals: [
    "High annual procedure volume in your specific operation, not just the broader specialty.",
    "Subspecialty fellowship training — surgeon volume and case mix matter more than overall years in practice.",
    "Active multidisciplinary review for complex cases.",
    "Publicly reported outcomes (national registries, peer-reviewed publications).",
  ],
  watchOut: "Hospital reputation and surgeon credentials are independent — the best hospital may have junior surgeons on weekend rotation; ask who is operating, not just where.",
};

const p = PROFILES[specialtySlug] ?? fallback;
---

<section
  aria-labelledby="specialty-depth-heading"
  style="padding: 64px 28px; border-top: 1px solid var(--color-border-soft);"
>
  <div class="mx-auto max-w-[1080px]">
    <p
      class="mono uppercase"
      style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);"
    >
      Specialty depth
    </p>
    <h2
      id="specialty-depth-heading"
      class="display display-tight mt-3"
      style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.05; font-weight: 400; letter-spacing: -0.025em;"
    >
      How to <span class="italic-display">shortlist</span> a credible {specialtyName.toLowerCase()} specialist
    </h2>
    <p class="serif mt-5" style="font-size: 16.5px; line-height: 1.55; color: var(--color-ink-muted); max-width: 70ch;">
      A board certification in {specialtyName.toLowerCase()} is the floor, not the ceiling. Senior practice in this field is sub-specialised — the right surgeon for your case is the one whose volume, fellowship, and audit data line up with the specific operation you need.
    </p>

    {/* Sub-specialties */}
    <div class="mt-10">
      <div
        class="mono uppercase"
        style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding-bottom: 12px; border-bottom: 1px solid var(--color-ink);"
      >
        Sub-specialties to be aware of
      </div>
      <ul>
        {p.subSpecialties.map((s) => (
          <li class="grid items-start gap-5 py-4" style="grid-template-columns: 220px 1fr; border-bottom: 1px solid var(--color-border-soft);">
            <div class="serif" style="font-size: 16px; font-weight: 500; color: var(--color-ink); letter-spacing: -0.005em;">
              {s.name}
            </div>
            <p style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
              {s.blurb}
            </p>
          </li>
        ))}
      </ul>
    </div>

    {/* Outcomes */}
    <div class="mt-10 grid gap-x-12 gap-y-8" style="grid-template-columns: 1fr;">
      <div>
        <div
          class="mono uppercase"
          style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding-bottom: 12px; border-bottom: 1px solid var(--color-ink);"
        >
          How outcomes get measured
        </div>
        <ul class="mt-3">
          {p.outcomeMeasures.map((m) => (
            <li class="flex items-start gap-3 py-2.5">
              <span class="mt-1 shrink-0" aria-hidden="true" style="width: 4px; height: 4px; border-radius: 50%; background: var(--color-accent);"></span>
              <span style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink);">{m}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div
          class="mono uppercase"
          style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding-bottom: 12px; border-bottom: 1px solid var(--color-ink);"
        >
          What a credible specialist looks like
        </div>
        <ul class="mt-3">
          {p.credibleSignals.map((s) => (
            <li class="flex items-start gap-3 py-2.5">
              <span class="mt-1 shrink-0" aria-hidden="true" style="width: 4px; height: 4px; border-radius: 50%; background: var(--color-accent);"></span>
              <span style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink);">{s}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="paper mt-10" style="padding: 22px 26px; border-left: 3px solid var(--color-coral, #B6463E);">
      <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-coral, #B6463E);">
        Watch out
      </p>
      <p class="serif mt-2" style="font-size: 15px; line-height: 1.55; color: var(--color-ink);">
        {p.watchOut}
      </p>
    </aside>
  </div>
</section>

<style>
  @media (min-width: 880px) {
    section[aria-labelledby="specialty-depth-heading"] > div > .grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>
