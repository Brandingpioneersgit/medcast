---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Price from "@/components/Price.astro";
import { formatUsd } from "@/lib/currency";
import { getDoctorBySlug } from "@/lib/queries";
import { sql as rawSql } from "@/lib/db";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { relatedToDoctor } from "@/lib/related";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { doctorJsonLd, breadcrumbJsonLd, localeUrl, SITE_URL, withProvenance } from "@/lib/seo";
import LastUpdated from "@/components/LastUpdated.astro";
import ContactDoctor from "@/components/ContactDoctor.tsx";
import WhatsAppDoctorCta from "@/components/WhatsAppDoctorCta.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import { whatsappFor } from "@/lib/whatsapp";
import { doctorPortrait } from "@/lib/images";
import { pageImageFor } from "@/lib/page-images";
import {
  Award,
  ChevronRight,
  Globe as GlobeIcon,
  MapPin,
  Users,
  Video,
} from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/doctor/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const [doctorRaw, portraitOverride] = await Promise.all([
  getDoctorBySlug(slug),
  pageImageFor("doctor", slug, "cover"),
]);
if (!doctorRaw) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const td = getTranslator(locale, "doctor");

const specialtyIds = (doctorRaw.specialties ?? []).map((ds) => ds.specialty.id);

const [doctorMap, hospitalTMap, specialtyMap, relatedDoctors] = await Promise.all([
  getContent("doctor", doctorRaw.id, locale),
  doctorRaw.hospital
    ? getContent("hospital", doctorRaw.hospital.id, locale)
    : Promise.resolve({} as Record<string, string>),
  getContentBatch("specialty", specialtyIds, locale),
  relatedToDoctor(doctorRaw.id, 6, locale).catch(() => []),
]);

const doctor = applyTranslated(doctorRaw, doctorMap, [
  "name",
  "title",
  "bio",
  "qualifications",
]);
const hospital = doctorRaw.hospital
  ? applyTranslated(doctorRaw.hospital, hospitalTMap, ["name"])
  : null;
const docSpecialties = (doctorRaw.specialties ?? []).map((ds) => ({
  ...ds,
  specialty: applyTranslated(ds.specialty, specialtyMap[ds.specialty.id] ?? {}, ["name"]),
}));
const expertise = doctorRaw.expertise ?? [];

// Pull specialty content_sections — primary specialty drives "questions to ask"
const primarySpecialtyId = doctorRaw.specialties?.[0]?.specialty?.id ?? null;
let primarySpecSections: any = null;
let primarySpecName: string | null = null;
if (primarySpecialtyId) {
  const r = await rawSql`SELECT content_sections, slug FROM specialties WHERE id = ${primarySpecialtyId} LIMIT 1`;
  primarySpecSections = r[0]?.content_sections ?? null;
  primarySpecName = docSpecialties[0]?.specialty?.name ?? null;
}

function parseLanguages(raw: unknown): string[] {
  if (Array.isArray(raw)) return raw.filter((x): x is string => typeof x === "string");
  if (typeof raw === "string") {
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed.filter((x): x is string => typeof x === "string") : [];
    } catch { return []; }
  }
  return [];
}
const languages = parseLanguages(doctor.languagesSpoken);

const cityName = hospital?.city?.name ?? null;
const countryName = hospital?.city?.country?.name ?? null;
const citySlug = doctorRaw.hospital?.city?.slug ?? null;
const countrySlug = doctorRaw.hospital?.city?.country?.slug ?? null;
const hospSlug = doctorRaw.hospital?.slug ?? null;
const hospName = hospital?.name ?? null;
const primarySpecSlug = docSpecialties[0]?.specialty?.slug ?? null;
const primarySpecNameForLink = docSpecialties[0]?.specialty?.name ?? null;

type ExploreItem = { eyebrow?: string; label: string; href: string; hint?: string };
const exploreItems: ExploreItem[] = [
  ...(hospSlug && hospName ? [{ eyebrow: td("exploreEyebrowHospital"), label: td("exploreHospitalLabel").replace("{name}", hospName), href: `/hospital/${hospSlug}`, hint: td("exploreHospitalHint") }] : []),
  ...(primarySpecSlug && primarySpecNameForLink ? [{ eyebrow: td("exploreEyebrowSpecialty"), label: td("exploreSpecialtyLabel").replace("{name}", primarySpecNameForLink), href: `/specialty/${primarySpecSlug}`, hint: td("exploreSpecialtyHint").replace("{name}", primarySpecNameForLink.toLowerCase()) }] : []),
  ...(primarySpecSlug && primarySpecNameForLink ? [{ eyebrow: td("exploreEyebrowSurgeons"), label: td("exploreOtherSurgeonsLabel").replace("{name}", primarySpecNameForLink.toLowerCase()), href: `/surgeons/${primarySpecSlug}`, hint: td("exploreOtherSurgeonsHint") }] : []),
  ...(primarySpecSlug && countrySlug && primarySpecNameForLink && countryName ? [{ eyebrow: td("exploreEyebrowSurgeons"), label: td("exploreSurgeonsCountryLabel").replace("{spec}", primarySpecNameForLink).replace("{country}", countryName), href: `/surgeons/${primarySpecSlug}/${countrySlug}`, hint: td("exploreSurgeonsCountryHint").replace("{country}", countryName) }] : []),
  ...(citySlug && cityName ? [{ eyebrow: td("exploreEyebrowDestination"), label: td("exploreCityHospitalsLabel").replace("{city}", cityName), href: `/hospitals/city/${citySlug}`, hint: td("exploreCityHospitalsHint") }] : []),
  ...(countrySlug && countryName ? [{ eyebrow: td("exploreEyebrowDestination"), label: td("exploreCountryHubLabel").replace("{country}", countryName), href: `/country/${countrySlug}`, hint: td("exploreCountryHubHint").replace("{country}", countryName) }] : []),
  { eyebrow: td("exploreEyebrowCompare"), label: td("exploreDoctorComparison"), href: "/compare/doctors", hint: td("exploreDoctorComparisonHint") },
  { eyebrow: td("exploreEyebrowCompare"), label: td("exploreHospitalComparison"), href: "/compare/hospitals", hint: td("exploreHospitalComparisonHint") },
  { eyebrow: td("exploreEyebrowTool"), label: td("exploreMatchMe"), href: "/match-me", hint: td("exploreMatchMeHint") },
  { eyebrow: td("exploreEyebrowTool"), label: td("exploreCostCalculator"), href: "/calculator", hint: td("exploreCostCalculatorHint") },
  { eyebrow: td("exploreEyebrowReference"), label: td("exploreGlossary"), href: "/glossary", hint: td("exploreGlossaryHint") },
  { eyebrow: td("exploreEyebrowTrust"), label: td("exploreEditorialPolicy"), href: "/editorial-policy", hint: td("exploreEditorialPolicyHint") },
];

const whatsappUrl = whatsappFor({
  page: "doctor",
  slug,
  doctorName: doctor.name,
  hospitalName: hospital?.name ?? undefined,
  specialtyName: docSpecialties[0]?.specialty.name,
  cityName: cityName ?? undefined,
  countryName: countryName ?? undefined,
});

const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(doctor.name);
const titlePrefix = nameHasTitle ? "" : (doctor.title ?? "Dr.");
const fullName = titlePrefix ? `${titlePrefix} ${doctor.name}` : doctor.name;

// Parse `qualifications` into discrete credential pills, tagged by kind.
type Cred = { label: string; tone: "primary" | "muted"; kind: string };
const creds: Cred[] = [];
{
  const rawQuals = (doctor.qualifications ?? "").trim();
  if (rawQuals) {
    const seen = new Set<string>();
    const parts = rawQuals
      .split(/[,;·•|/]| · /)
      .map((p) => p.trim())
      .filter((p) => p.length > 0 && p.length <= 80);
    for (const p of parts) {
      const norm = p.toLowerCase().replace(/\s+/g, " ");
      if (seen.has(norm)) continue;
      seen.add(norm);
      const isFellow = /\bfellow|fellowship|frcs|facs|facc|fasn|fascrs|fnasc|frcp|frcr|fcps\b/i.test(p);
      const isBoard = /\bboard|diplomate|board[-\s]?certif|abms|specialist registration\b/i.test(p);
      const isCore = isFellow || isBoard || /\b(md|mbbs|do|phd|dnb|ms|mch|md\.|mbbs\.)\b/i.test(p);
      creds.push({
        label: p,
        tone: isCore ? "primary" : "muted",
        kind: isFellow ? "Fellowship" : isBoard ? "Board" : isCore ? "Degree" : "Member",
      });
    }
  }
}
const cleanDocName = doctor.name.replace(/^Dr\.?\s*/i, "");
const pubmedQuery = encodeURIComponent(`${cleanDocName}[Author]`);
const currentYear = new Date().getFullYear();
const pubmedUrl = `https://pubmed.ncbi.nlm.nih.gov/?term=${pubmedQuery}&filter=years.${currentYear - 10}-${currentYear}`;
const scholarUrl = `https://scholar.google.com/scholar?q=${encodeURIComponent(`"${cleanDocName}"`)}+${encodeURIComponent(docSpecialties[0]?.specialty.name ?? "")}`;
const orcidUrl = `https://orcid.org/orcid-search/search?searchQuery=${encodeURIComponent(cleanDocName)}`;
const researchLinks = [
  { label: "PubMed", sub: td("pubmedSub"), url: pubmedUrl },
  { label: "Google Scholar", sub: td("scholarSub"), url: scholarUrl },
  { label: "ORCID", sub: td("orcidSub"), url: orcidUrl },
];

// Local-SEO title: "{Dr.} — {Specialty} in {City}, {Country}" — matches
// long-tail queries like "cardiac surgeon in mumbai" and locks the geo trio
// into the result snippet. Falls back gracefully when fields are missing.
const primarySpecialtyName = docSpecialties[0]?.specialty?.name ?? null;
const localGeoSuffix = [cityName, countryName].filter(Boolean).join(", ");
const seoTitle = (() => {
  if (primarySpecialtyName && localGeoSuffix)
    return `${fullName} — ${primarySpecialtyName} in ${localGeoSuffix}`;
  if (localGeoSuffix) return `${fullName} — ${localGeoSuffix}`;
  if (hospital) return `${fullName} — ${hospital.name}`;
  return fullName;
})();
const seoDescription = (() => {
  // On non-default locales, the translated bio is the most natural SEO blurb.
  if (locale !== "en" && doctor.bio) {
    return doctor.bio.replace(/\s+/g, " ").trim().slice(0, 160);
  }
  const role = primarySpecialtyName ? `${primarySpecialtyName} specialist` : "Specialist";
  const at = hospital ? ` at ${hospital.name}` : "";
  const where = localGeoSuffix ? `, ${localGeoSuffix}` : "";
  const yrs = doctor.experienceYears ? `${doctor.experienceYears}+ yrs experience. ` : "";
  const cred = doctor.qualifications ? `${doctor.qualifications.split(/[,;·•|/]/)[0].trim()}. ` : "";
  return `${role}${at}${where}. ${cred}${yrs}Book a consultation or free second opinion.`.slice(0, 160);
})();
const path = `/doctor/${slug}`;
const url = localeUrl(locale, path);

const physicianLd = doctorJsonLd({
  name: fullName,
  qualifications: doctor.qualifications,
  imageUrl: portraitOverride?.url ?? doctor.imageUrl,
  hospitalName: hospital?.name ?? "",
  hospitalUrl: hospital ? localeUrl(locale, `/hospital/${hospital.slug}`) : undefined,
  hospitalWebsite: doctorRaw.hospital?.website ?? null,
  url,
  rating: doctor.rating,
  reviewCount: doctor.reviewCount,
  specialties: docSpecialties.map((ds) => ds.specialty.name),
  expertise: expertise.map((e: { expertiseArea: string }) => e.expertiseArea),
  city: cityName,
  country: countryName,
});

const jsonLd = withProvenance(
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url,
    mainEntity: physicianLd,
  },
  { dateModified: doctorRaw.updatedAt, dateCreated: doctorRaw.createdAt },
);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("doctors"), url: localeUrl(locale, "/doctors") },
  ...(countrySlug && countryName
    ? [{ name: countryName, url: localeUrl(locale, `/doctors/country/${countrySlug}`) }]
    : []),
  ...(citySlug && cityName
    ? [{ name: cityName, url: localeUrl(locale, `/city/${citySlug}`) }]
    : []),
  ...(hospSlug && hospName
    ? [{ name: hospName, url: localeUrl(locale, `/hospital/${hospSlug}`) }]
    : []),
  { name: fullName, url },
]);

// Career-timeline entries computed in frontmatter (keeps template simple).
type TimelineEntry = { year: string; title: string; body: string };
const timelineEntries: TimelineEntry[] = (() => {
  const yrs = doctor.experienceYears ?? 0;
  const patients = doctor.patientsTreated ?? 0;
  const thisYear = new Date().getFullYear();
  const start = thisYear - yrs;
  const mid = start + Math.floor(yrs / 2);
  const out: TimelineEntry[] = [];
  if (yrs > 0) {
    out.push({
      year: String(start),
      title: td("beganPractice"),
      body: td("beganPracticeBody"),
    });
  }
  if (yrs > 5) {
    out.push({
      year: String(mid),
      title: td("midCareerMilestone"),
      body: patients > 0
        ? td("midCareerPatients").replace("{n}", Math.floor(patients / 2).toLocaleString())
        : td("midCareerComplex"),
    });
  }
  out.push({
    year: String(thisYear),
    title: hospital ? td("currentlyAt").replace("{name}", hospital.name) : td("today"),
    body: patients > 0
      ? td("patientsTreatedCareer").replace("{n}", patients.toLocaleString())
      : td("acceptingPatients"),
  });
  return out;
})();

const untranslated = isUntranslated(locale, doctorMap);
const isThin = !doctor.bio || doctor.bio.trim().length < 120;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      image={doctor.imageUrl ?? undefined}
      noindex={untranslated || isThin}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/doctors")} class="hover:text-accent">{tc("doctors")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{fullName}</span>
      </div>
    </nav>

    {/* Hero — 3-col editorial: portrait | info | booking panel */}
    <section style="padding: 48px 28px; background: var(--color-paper); border-bottom: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.5fr_1fr] lg:gap-[40px] items-start">
          {/* Portrait — capped width on small screens so the 4/5 aspect doesn't blow up */}
          <div
            class="mc-doctor-portrait paper-flat relative overflow-hidden mx-auto lg:mx-0 w-full"
            style="aspect-ratio: 4/5; border-radius: var(--radius-lg);"
          >
            <img
              src={doctorPortrait({ imageUrl: doctor.imageUrl, id: doctor.id, override: portraitOverride?.url }, 600)}
              alt={portraitOverride?.altText ?? fullName}
              width="480"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            {/* tonal warm-tint to keep portraits in the parchment palette */}
            <div
              aria-hidden="true"
              class="absolute inset-0 pointer-events-none"
              style="background:
                linear-gradient(180deg, rgba(246,241,230,0.06) 0%, rgba(246,241,230,0) 30%),
                linear-gradient(180deg, rgba(14,23,19,0) 65%, rgba(14,23,19,0.20) 100%);"
            />
          </div>

          {/* Info */}
          <div>
            {doctor.qualifications && (
              <div class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
                {doctor.qualifications.split(",").slice(0, 2).join(" · ")}
              </div>
            )}
            <h1
              class="display display-tight mt-3"
              style="font-size: clamp(2.5rem, 5.5vw, 3.75rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;"
            >
              {(() => {
                const parts = fullName.split(/\s+/);
                const last = parts[parts.length - 1];
                const rest = parts.slice(0, -1).join(" ");
                return (
                  <>{rest} <span style="font-style: italic;">{last}</span></>
                );
              })()}
            </h1>
            {doctor.title && (
              <div style="font-size: 17px; color: var(--color-ink-muted); margin-top: 10px;">
                {doctor.qualifications ? `${doctor.qualifications} · ` : ""}{doctor.title}
              </div>
            )}

            {doctor.rating && Number(doctor.rating) > 0 && (
              <div class="flex items-center gap-3 mt-3.5">
                <span class="inline-flex items-center gap-0.5" aria-label={`${doctor.rating} of 5`}>
                  {[0,1,2,3,4].map((i) => (
                    <svg width="14" height="14" viewBox="0 0 16 16" fill={i < Math.round(Number(doctor.rating)) ? "var(--color-saffron)" : "none"} stroke="var(--color-saffron)" stroke-width="1.6">
                      <path d="M8 1.5l2.12 4.3 4.74.69-3.43 3.35.81 4.72L8 12.31l-4.24 2.23.81-4.72L1.14 6.47l4.74-.69L8 1.5z" />
                    </svg>
                  ))}
                </span>
                <span class="tnum" style="font-size: 14px;">
                  {Number(doctor.rating).toFixed(1)}
                  {doctor.reviewCount && doctor.reviewCount > 0 && (
                    <span style="color: var(--color-ink-subtle);"> · {doctor.reviewCount.toLocaleString()} reviews</span>
                  )}
                </span>
              </div>
            )}

            {/* Stat ribbon — 4-up */}
            <div
              class="grid mt-7 py-5"
              style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
            >
              {[
                doctor.experienceYears != null && { l: td("yearsPractising"), v: `${doctor.experienceYears}` },
                doctor.patientsTreated != null && { l: td("patientsTreated"), v: doctor.patientsTreated > 1000 ? `${Math.floor(doctor.patientsTreated / 1000)}k+` : doctor.patientsTreated.toLocaleString() },
                doctor.rating && Number(doctor.rating) > 0 && { l: td("rating"), v: `${Number(doctor.rating).toFixed(1)}/5` },
                doctor.consultationFeeUsd != null && { l: td("consultation"), v: await formatUsd(Astro.cookies, Number(doctor.consultationFeeUsd)) },
              ].filter(Boolean).map((s: any, i: number) => (
                <div style={`padding-inline: 18px; ${i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}`}>
                  <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{s.l}</div>
                  <div class="display tnum" style="font-size: 26px; margin-top: 4px;">{s.v}</div>
                </div>
              ))}
            </div>

            {/* Expertise pills */}
            {(expertise.length > 0 || docSpecialties.length > 0) && (
              <div class="mt-6">
                <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                  {expertise.length > 0 ? td("expertiseLabel") : td("specialtiesLabel")}
                </div>
                <div class="flex flex-wrap gap-1.5 mt-2.5">
                  {(expertise.length > 0 ? expertise.slice(0, 8) : docSpecialties.slice(0, 8)).map((item: any) => (
                    <span
                      class="inline-flex items-center"
                      style="padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; background: var(--color-accent-soft); color: var(--color-accent-strong); line-height: 1.4;"
                    >
                      {item.expertiseArea ?? item.specialty?.name ?? ""}
                    </span>
                  ))}
                </div>
              </div>
            )}
            <div class="mt-4"><LastUpdated updated={doctorRaw.updatedAt} locale={locale} /></div>
          </div>

          {/* Booking panel — real flow at /book/[doctorSlug], not fake slot pills */}
          <aside>
            <div class="paper" style="padding: 22px;">
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                {td("bookConsultationEyebrow")}
              </div>
              <div class="display mt-2" style="font-size: 22px; letter-spacing: -0.02em; line-height: 1.2;">
                {td("coordinatorConfirmsPrefix")}<span class="serif" style="font-style: italic;">{td("within24Hours")}</span>
              </div>
              <p class="serif mt-3" style="font-size: 13.5px; line-height: 1.5; color: var(--color-ink-muted);">
                {td("bookingPanelBody").replace("{firstName}", doctor.name.split(/\s+/).slice(0, 1).join(" "))}
              </p>

              <div class="mt-4 grid grid-cols-3 gap-1.5">
                <a
                  href={localizedPath(locale, `/book/${doctor.slug}?type=in-person`)}
                  class="text-center text-[12px] font-medium"
                  style="padding: 10px 6px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface-elevated); color: var(--color-ink);"
                >{td("inPerson")}</a>
                <a
                  href={localizedPath(locale, `/book/${doctor.slug}?type=video`)}
                  class="text-center text-[12px] font-medium"
                  style={`padding: 10px 6px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface-elevated); color: var(--color-ink); ${doctor.availableForVideoConsult ? "" : "opacity: 0.45; pointer-events: none;"}`}
                  aria-disabled={!doctor.availableForVideoConsult ? "true" : undefined}
                >{td("video")}</a>
                <a
                  href={localizedPath(locale, `/book/${doctor.slug}?type=phone`)}
                  class="text-center text-[12px] font-medium"
                  style="padding: 10px 6px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface-elevated); color: var(--color-ink);"
                >{td("phone")}</a>
              </div>

              <a
                href={localizedPath(locale, `/book/${doctor.slug}`)}
                class="inline-flex items-center justify-center gap-2 w-full mt-3.5 font-semibold"
                style="background: var(--color-accent); color: #FFF; padding: 14px 22px; font-size: 15px; border-radius: 9999px;"
              >
                {doctor.consultationFeeUsd != null ? (
                  <>Book consultation · ${doctor.consultationFeeUsd}</>
                ) : (
                  <>{tc("bookConsultation")}</>
                )}
              </a>

              <div class="mt-2">
                <WhatsAppDoctorCta
                  variant="panel"
                  doctorName={doctor.name}
                  doctorSlug={doctor.slug}
                  hospitalName={hospital?.name ?? null}
                  specialtyName={primarySpecName ?? null}
                />
              </div>

              {doctor.availableForVideoConsult && (
                <p class="mt-3 flex items-center gap-1.5" style="font-size: 12px; color: var(--color-accent);">
                  <Video className="h-3.5 w-3.5" />
                  {td("videoConsultAvailable")}
                </p>
              )}

              <div class="mt-4 pt-4" style="border-top: 1px dashed var(--color-border);">
                <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{td("orFree")}</div>
                <div class="mt-1.5" style="font-size: 13.5px;">
                  {td("uploadReportsBody").replace("{name}", fullName.split(/\s+/).slice(0, 2).join(" "))}
                </div>
                <a
                  href={localizedPath(locale, "/second-opinion")}
                  class="inline-flex items-center justify-center gap-1.5 w-full mt-3 font-medium"
                  style="background: var(--color-surface-elevated); color: var(--color-ink); border: 1px solid var(--color-border); padding: 9px 14px; font-size: 13px; border-radius: 9999px;"
                >
                  {td("getFreeSecondOpinion")}
                </a>
              </div>

              {languages.length > 0 && (
                <div class="mt-4 pt-4" style="border-top: 1px solid var(--color-border);">
                  <p class="mono flex items-center gap-1.5 mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                    <GlobeIcon className="h-3.5 w-3.5" />
                    {td("speaks")}
                  </p>
                  <p style="color: var(--color-ink-muted); font-size: 13.5px;">{languages.join(", ")}</p>
                </div>
              )}
            </div>
          </aside>
        </div>
      </div>
    </section>

    {/* Below-hero: bio + hospital + expertise content */}
    <section class="mx-auto max-w-7xl px-6 pt-12 md:pt-14 pb-8">
      <div class="grid gap-10 md:grid-cols-[1fr_22rem]">
        <div>
          {hospital && (
            <div class="rounded-xl border p-5" style="border-color: var(--color-border); background: var(--color-surface-muted);">
              <p class="mono mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{td("practicesAt")}</p>
              <a
                href={localizedPath(locale, `/hospital/${hospital.slug}`)}
                class="inline-flex items-center gap-2 font-display text-xl text-ink hover:text-accent transition-colors"
              >
                {hospital.name}
                <ChevronRight className="h-4 w-4 mirror-x" />
              </a>
              {(cityName || countryName) && (
                <p class="mt-1 text-sm text-ink-muted flex items-center gap-1.5">
                  <MapPin className="h-3.5 w-3.5" />
                  {cityName}{countryName && `, ${countryName}`}
                </p>
              )}
            </div>
          )}

          {doctor.bio && (
            <div class="mt-8 prose-editorial">
              <h2 class="font-display text-2xl">{td("aboutHeading").replace("{name}", doctor.name.split(" ").slice(0, 2).join(" "))}</h2>
              <p>{doctor.bio}</p>
            </div>
          )}

          {/* Credentials & research */}
          {creds.length > 0 && (
            <div class="mt-10">
              <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
                {td("credentialsEyebrow")}
              </p>
              <h2 class="display mb-5" style="font-size: 26px; letter-spacing: -0.015em;">
                {td("verifiableHeading")}
                <span style="font-style: italic; font-weight: 300;"> {td("trainingWord")}</span>
              </h2>
              <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr]">
                <div>
                  <p class="mono uppercase mb-3" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    {td("qualifications")}
                  </p>
                  <ul class="flex flex-wrap gap-2">
                    {creds.map((c) => (
                      <li
                        class="inline-flex items-center gap-1.5"
                        style={c.tone === "primary"
                          ? "padding: 6px 12px; border-radius: 9999px; background: var(--color-accent-soft); color: var(--color-accent-strong, var(--color-accent)); font-size: 12px; line-height: 1.3;"
                          : "padding: 6px 12px; border-radius: 9999px; border: 1px solid var(--color-border); color: var(--color-ink-muted); font-size: 12px; line-height: 1.3;"}
                      >
                        <svg width="9" height="9" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                          <path d="M3 8l3 3 7-7" />
                        </svg>
                        <span>{c.label}</span>
                        <span class="mono uppercase" style="font-size: 8.5px; letter-spacing: 0.1em; opacity: 0.55; padding-inline-start: 4px;">{c.kind}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                    {td("crossCheckedNote")}
                  </p>
                </div>
                <div class="paper" style="padding: 18px 20px;">
                  <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                    {td("publicationsEyebrow")}
                  </p>
                  <div class="serif mt-2" style="font-size: 16px; line-height: 1.3; font-weight: 500;">
                    {td("lookUpResearch").replace("{name}", doctor.name.split(" ").slice(0, 2).join(" "))}
                  </div>
                  <p class="serif mt-2" style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
                    {td("neutralIndexNote")}
                  </p>
                  <ul class="mt-3.5 space-y-1.5">
                    {researchLinks.map((l) => (
                      <li>
                        <a
                          href={l.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center justify-between gap-3 group"
                          style="padding: 8px 12px; border-radius: 9999px; border: 1px solid var(--color-border);"
                        >
                          <span class="min-w-0">
                            <span class="serif" style="font-size: 13.5px; font-weight: 500; color: var(--color-ink);">{l.label}</span>
                            <span class="mono uppercase ms-2" style="font-size: 9px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">{l.sub}</span>
                          </span>
                          <span class="mono uppercase shrink-0 group-hover:text-accent transition-colors" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">{td("openLink")}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )}

          {/* Linked specialty-hub tags (if >8, expose more here) */}
          {docSpecialties.length > 8 && (
            <div class="mt-10">
              <h2 class="font-display text-2xl mb-4">{td("specialtyHubs")}</h2>
              <ul class="flex flex-wrap gap-2">
                {docSpecialties.map((ds) => (
                  <li>
                    <a
                      href={localizedPath(locale, `/specialty/${ds.specialty.slug}`)}
                      class="inline-flex items-center rounded-full bg-accent-soft text-accent px-3 py-1.5 text-sm font-medium hover:bg-accent hover:text-accent-contrast transition-colors"
                    >
                      {ds.specialty.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Career at a glance */}
          {(doctor.experienceYears || doctor.patientsTreated) && (
            <div class="mt-12">
              <p
                class="mono uppercase mb-3"
                style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);"
              >
                {td("timelineEyebrow")}
              </p>
              <h2 class="display mb-6" style="font-size: 26px; letter-spacing: -0.015em;">
                {td("careerAtGlance")}
              </h2>
              <ol class="paper overflow-hidden" style="padding: 0;">
                {timelineEntries.map((entry, i) => (
                  <li
                    class="grid items-start gap-4 p-5 md:p-6"
                    style={i > 0
                      ? "grid-template-columns: 80px 1fr; border-top: 1px solid var(--color-border-soft);"
                      : "grid-template-columns: 80px 1fr;"}
                  >
                    <div
                      class="mono tnum"
                      style="font-size: 13px; color: var(--color-ink-subtle); letter-spacing: 0.05em;"
                    >
                      {entry.year}
                    </div>
                    <div>
                      <div
                        class="serif font-medium"
                        style="font-size: 18px; color: var(--color-ink); letter-spacing: -0.005em;"
                      >
                        {entry.title}
                      </div>
                      <div class="mt-1 text-[14px]" style="color: var(--color-ink-muted);">
                        {entry.body}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
              {hospital && (
                <a
                  href={localizedPath(locale, `/hospital/${hospital.slug}`)}
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold hover:opacity-80"
                  style="color: var(--color-accent);"
                >
                  {td("viewHospital").replace("{name}", hospital.name)}
                  <ChevronRight className="h-4 w-4 mirror-x" />
                </a>
              )}
            </div>
          )}

          {/* Contact doctor — inline lead form with doctor context */}
          <div class="mt-12">
            <ContactDoctor
              client:visible
              doctorSlug={doctor.slug}
              doctorName={fullName}
              hospitalName={hospital?.name ?? null}
              specialtyName={docSpecialties[0]?.specialty.name ?? null}
              locale={locale}
            />
          </div>
        </div>

        {/* Secondary side column — currently at / share */}
        <aside class="md:sticky md:top-24 md:self-start">
          {hospital && (
            <div class="paper" style="padding: 22px;">
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{td("currentlyAtLabel")}</div>
              <div class="serif mt-2" style="font-size: 22px; font-weight: 500;">{hospital.name}</div>
              <div style="font-size: 13px; color: var(--color-ink-subtle); margin-top: 4px;">
                {cityName}{countryName && `, ${countryName}`}
              </div>
              <a
                href={localizedPath(locale, `/hospital/${hospital.slug}`)}
                class="inline-flex items-center justify-center gap-1.5 w-full mt-4 font-medium"
                style="background: transparent; color: var(--color-ink); border: 1px solid var(--color-ink); padding: 9px 14px; font-size: 13px; border-radius: 9999px;"
              >
                {td("viewHospitalLink")}
              </a>
            </div>
          )}
        </aside>
      </div>
    </section>

    {/* Related doctors */}
    {relatedDoctors.length > 0 && (
      <section class="border-t border-border bg-surface-muted py-12">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-display text-2xl md:text-3xl mb-6">
            {hospital ? td("otherSpecialistsAt").replace("{name}", hospital.name) : td("otherSpecialists")}
          </h2>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {relatedDoctors.map((r) => (
              <li class="flex flex-col gap-2">
                <a
                  href={localizedPath(locale, r.href)}
                  class="group flex flex-1 items-center justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <span class="min-w-0">
                    <span class="block font-medium text-ink group-hover:text-accent transition-colors truncate">
                      {r.name}
                    </span>
                    {r.subtitle && <span class="block text-xs text-ink-subtle line-clamp-1">{r.subtitle}</span>}
                  </span>
                  <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x shrink-0 ms-3" />
                </a>
                <WhatsAppDoctorCta doctorName={r.name} doctorSlug={r.href.split("/").pop()} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Specialty-keyed evaluation framework */}
    {primarySpecSections && primarySpecName && (
      <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {td("evaluatingEyebrow")}
          </div>
          <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
            {td("howToEvaluate").replace("{specialty}", primarySpecName.toLowerCase())}
          </h2>

          {primarySpecSections.surgeonVolumeThresholds && primarySpecSections.surgeonVolumeThresholds.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{td("volumeBenchmarks")}</h3>
              <div class="paper overflow-hidden" style="padding: 0;">
                {primarySpecSections.surgeonVolumeThresholds.map((t: any, i: number) => (
                  <div
                    class="grid items-start gap-4 p-5"
                    style={`grid-template-columns: 220px 1fr; ${i > 0 ? "border-top: 1px solid var(--color-border-soft);" : ""}`}
                  >
                    <span class="mono uppercase" style="font-size: 12px; letter-spacing: 0.08em; color: var(--color-accent);">{t.range}</span>
                    <span style="font-size: 15px; line-height: 1.5;">{t.quality}</span>
                  </div>
                ))}
              </div>
              <p class="mt-3 mono" style="font-size: 12px; color: var(--color-ink-subtle); line-height: 1.5;">
                {td("askCaseVolumeNote").replace("{lastName}", doctor.name.split(" ").slice(-1)[0])}
              </p>
            </div>
          )}

          {primarySpecSections.questionsForProgram && primarySpecSections.questionsForProgram.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{td("questionsToAsk")}</h3>
              <ol class="space-y-3">
                {primarySpecSections.questionsForProgram.map((q: string, i: number) => (
                  <li class="flex gap-4 items-start paper" style="padding: 16px 22px;">
                    <span class="display tnum" style="font-size: 26px; line-height: 1; opacity: 0.35; min-width: 36px;">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <p style="font-size: 15.5px; line-height: 1.5;">{q}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {primarySpecSections.programQualitySignals && primarySpecSections.programQualitySignals.length > 0 && (
            <div>
              <h3 class="display mb-4" style="font-size: 22px;">{td("whatToLookFor").replace("{specialty}", primarySpecName.toLowerCase())}</h3>
              <ul class="space-y-3">
                {primarySpecSections.programQualitySignals.map((s: string) => (
                  <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                    <span style="color: var(--color-accent);">→</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {/* EEAT signals — methodology + reviewer attribution */}
    <MethodologyBlock locale={locale}
      lastReviewed={doctor.updatedAt}
      curationNote={`This profile of ${doctor.name} is built from primary credentialling sources — the relevant national medical council registry, the surgeon's institutional bio, and peer-reviewed publication record (where available). Patient testimonials are independently verified against booking records before publication.`}
      dataSources={[
        "National medical council registries",
        "Hospital institutional records",
        "Peer-reviewed publication record (PubMed, Google Scholar)",
        "Society membership directories (specialty-specific)",
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow="Continue your search"
      heading={`Other ways to find a fit beyond ${doctor.name}`}
      lede="One surgeon, evaluated. These pages broaden the picture — same specialty, same destination, same procedure — for an honest comparison."
      items={exploreItems}
    />

    <SiteFooter locale={locale} />
    <EngagementFab locale={locale} />
    <MobileQuoteBar
      locale={locale}
      label={doctor.name}
      sublabel={[hospital?.name, docSpecialties[0]?.specialty.name].filter(Boolean).join(" · ") || "Free 2nd opinion"}
      whatsapp={{
        page: "doctor",
        slug,
        doctorName: doctor.name,
        hospitalName: hospital?.name ?? undefined,
        specialtyName: docSpecialties[0]?.specialty.name,
        cityName: cityName ?? undefined,
        countryName: countryName ?? undefined,
      }}
    />
  </main>
</BaseLayout>
