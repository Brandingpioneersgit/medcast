---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import {
  ChevronRight,
  Target,
  Brain,
  FileText,
  Compass,
  Plane,
  Stethoscope,
  Siren,
  Receipt,
} from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { serviceScene, heroImage, journeyScene } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/services", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tSv = getTranslator(locale, "servicesPage");

type Service = {
  slug: string;
  icon: any;
  title: string;
  blurb: string;
  cta: string;
  href: string;
};
type Group = { eyebrow: string; title: string; sub: string; items: Service[] };

const groups: Group[] = [
  {
    eyebrow: tSv("g1Eyebrow"),
    title: tSv("g1Title"),
    sub: tSv("g1Sub"),
    items: [
      { slug: "quote-matching", icon: Target, title: tSv("s1Title"), blurb: tSv("s1Blurb"), cta: tSv("s1Cta"), href: "/quote" },
      { slug: "second-opinion", icon: Brain, title: tSv("s2Title"), blurb: tSv("s2Blurb"), cta: tSv("s2Cta"), href: "/second-opinion" },
      { slug: "case-management", icon: Compass, title: tSv("s4Title"), blurb: tSv("s4Blurb"), cta: tSv("s4Cta"), href: "/contact" },
    ],
  },
  {
    eyebrow: tSv("g2Eyebrow"),
    title: tSv("g2Title"),
    sub: tSv("g2Sub"),
    items: [
      { slug: "visa-coordination", icon: FileText, title: tSv("s3Title"), blurb: tSv("s3Blurb"), cta: tSv("s3Cta"), href: "/contact?topic=visa" },
      { slug: "airport-pickup", icon: Plane, title: tSv("s5Title"), blurb: tSv("s5Blurb"), cta: tSv("s5Cta"), href: "/contact?topic=travel" },
    ],
  },
  {
    eyebrow: tSv("g3Eyebrow"),
    title: tSv("g3Title"),
    sub: tSv("g3Sub"),
    items: [
      { slug: "post-op-followup", icon: Stethoscope, title: tSv("s6Title"), blurb: tSv("s6Blurb"), cta: tSv("s6Cta"), href: "/editorial-policy" },
      { slug: "emergency-evac", icon: Siren, title: tSv("s7Title"), blurb: tSv("s7Blurb"), cta: tSv("s7Cta"), href: "/emergency" },
      { slug: "insurance-liaison", icon: Receipt, title: tSv("s8Title"), blurb: tSv("s8Blurb"), cta: tSv("s8Cta"), href: "/insurance" },
    ],
  },
];

const seoTitle = tSv("seoTitle");
const seoDescription = tSv("seoDescription");
const path = "/services";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tSv("breadcrumbServices"), url: localeUrl(locale, path) },
]);

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">{tSv("breadcrumbServices")}</span>
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.7fr] lg:items-center">
          <div>
            <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tSv("heroEyebrow")}</div>
            <h1 class="display display-tight mt-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
              {tSv("heroH1First")} <span class="italic-display">{tSv("heroH1Italic")}</span>
            </h1>
            <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
              {tSv("heroLede")}
            </p>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
            <img
              src={heroImage("services-hero")}
              alt={tSv("heroImgAlt")}
              width="600"
              height="750"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 16px; inset-inline-end: 16px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tSv("imgOverlayLabel")}</div>
              <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">{tSv("imgOverlayDesc")}</div>
            </div>
          </div>
        </div>

        <div class="mt-14 space-y-14">
          {groups.map((g) => (
            <section>
              <div class="grid gap-6 lg:grid-cols-[0.4fr_1fr] lg:items-end mb-7" style="border-top: 1px solid var(--color-ink); padding-top: 22px;">
                <div>
                  <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.16em; color: var(--color-accent);">
                    {g.eyebrow}
                  </div>
                  <h2 class="display mt-2.5" style="font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 400;">
                    {g.title}
                  </h2>
                </div>
                <p class="serif" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted); max-width: 560px;">
                  {g.sub}
                </p>
              </div>
              <ul class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
                {g.items.map((s) => {
                  const Icon = s.icon;
                  return (
                    <li class="paper flex flex-col h-full overflow-hidden" style="padding: 0;">
                      <div class="relative" style="aspect-ratio: 16/9; overflow: hidden;">
                        <img
                          src={s.slug.includes("post-op") || s.slug.includes("emergency") ? journeyScene(s.slug) : serviceScene(s.slug)}
                          alt={s.title}
                          width="640"
                          height="360"
                          loading="lazy"
                          decoding="async"
                          style="width: 100%; height: 100%; object-fit: cover;"
                        />
                        <div class="image-veil" />
                      </div>
                      <div style="padding: 22px 24px 24px;" class="flex flex-col flex-1">
                        <div
                          class="flex items-center justify-center"
                          style="width: 40px; height: 40px; border-radius: 10px; background: var(--color-accent-mist, var(--color-accent-soft)); color: var(--color-accent);"
                          aria-hidden="true"
                        >
                          <Icon strokeWidth={1.6} className="h-[20px] w-[20px]" />
                        </div>
                        <div class="serif mt-3" style="font-size: 19px; font-weight: 500; letter-spacing: -0.015em; line-height: 1.25;">{s.title}</div>
                        <p class="mt-2 flex-1" style="font-size: 14px; color: var(--color-ink-muted); line-height: 1.55;">{s.blurb}</p>
                        <a
                          href={localizedPath(locale, s.href)}
                          class="inline-flex items-center gap-1 mt-4 font-medium"
                          style="color: var(--color-accent); font-size: 13px;"
                        >
                          {s.cta} <ChevronRight className="h-3.5 w-3.5 mirror-x" />
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section style="padding: 72px 28px; background: var(--color-ink); color: var(--color-bg);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">{tSv("alwaysEyebrow")}</div>
          <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
            {tSv("alwaysH2First")}
            <span class="italic-display"> {tSv("alwaysH2Italic")}</span>
          </h2>
          <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
            {tSv("alwaysDesc")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={localizedPath(locale, "/quote")} class="inline-flex items-center gap-2 font-semibold" style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;">
            {tSv("ctaStartNow")} <ChevronRight className="h-4 w-4 mirror-x" />
          </a>
          <a href={localizedPath(locale, "/terms")} class="inline-flex items-center gap-2 font-semibold" style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;">
            {tSv("ctaReadTerms")}
          </a>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tSv("howHeading")}
      italicWord={tSv("howItalicWord")}
      steps={[
        { title: tSv("step1Title"), description: tSv("step1Desc") },
        { title: tSv("step2Title"), description: tSv("step2Desc") },
        { title: tSv("step3Title"), description: tSv("step3Desc") },
        { title: tSv("step4Title"), description: tSv("step4Desc") },
        { title: tSv("step5Title"), description: tSv("step5Desc") },
        { title: tSv("step6Title"), description: tSv("step6Desc") },
        { title: tSv("step7Title"), description: tSv("step7Desc") },
      ]}
      outroNote={tSv("howOutroNote")}
    />

    <WhatToExpect
      heading={tSv("wteHeading")}
      italicWord={tSv("wteItalicWord")}
      items={[
        { label: tSv("wte1Label"), description: tSv("wte1Desc") },
        { label: tSv("wte2Label"), description: tSv("wte2Desc") },
        { label: tSv("wte3Label"), description: tSv("wte3Desc") },
        { label: tSv("wte4Label"), description: tSv("wte4Desc") },
        { label: tSv("wte5Label"), description: tSv("wte5Desc") },
        { label: tSv("wte6Label"), description: tSv("wte6Desc") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
