---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import {
  ChevronRight,
  Target,
  Brain,
  FileText,
  Compass,
  Plane,
  Stethoscope,
  Siren,
  Receipt,
} from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { serviceScene, heroImage, journeyScene } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/services", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");

type Service = {
  slug: string;
  icon: any;
  title: string;
  blurb: string;
  cta: string;
  href: string;
};
type Group = { eyebrow: string; title: string; sub: string; items: Service[] };

const groups: Group[] = [
  {
    eyebrow: "01 · Getting started",
    title: "Decide before you commit",
    sub: "Free, low-friction services that help you choose without booking anything.",
    items: [
      { slug: "quote-matching", icon: Target, title: "Quote matching", blurb: "Itemized quotes from 3 hospitals within 48 hours — no markup, no upfront fees.", cta: "Request quotes", href: "/quote" },
      { slug: "second-opinion", icon: Brain, title: "Free second opinion", blurb: "Multidisciplinary review of your case by senior specialists — 5–10 day turnaround.", cta: "Upload reports", href: "/second-opinion" },
      { slug: "case-management", icon: Compass, title: "Named case manager", blurb: "One person handling your case end-to-end — in your language, 8 supported.", cta: "Meet your coordinator", href: "/contact" },
    ],
  },
  {
    eyebrow: "02 · Travel & logistics",
    title: "Get to the hospital, hassle-free",
    sub: "Documentation, transit, and accommodation handled before you board the plane.",
    items: [
      { slug: "visa-coordination", icon: FileText, title: "Medical visa coordination", blurb: "Invitation letters, documentation checklists, embassy-appointment guidance across 9 destinations.", cta: "Start visa", href: "/contact?topic=visa" },
      { slug: "airport-pickup", icon: Plane, title: "Airport pickup + accommodation", blurb: "Coordinator meets you planeside, hospital-vetted hotels at corporate rates, interpreter on call.", cta: "Plan my trip", href: "/contact?topic=travel" },
    ],
  },
  {
    eyebrow: "03 · Support & safety",
    title: "After surgery, before you fly home — and after",
    sub: "Recovery support, emergency cover, and payment infrastructure for cross-border care.",
    items: [
      { slug: "post-op-followup", icon: Stethoscope, title: "90-day post-op follow-up", blurb: "Weekly telemedicine check-ins with your operating surgeon, lab coordination with your home doctor.", cta: "How follow-up works", href: "/editorial-policy" },
      { slug: "emergency-evac", icon: Siren, title: "Emergency + air ambulance", blurb: "24/7 desk reaches a senior physician directly, not a call centre. Lear-jet evacuation under 4 hours from major hubs.", cta: "Emergency desk", href: "/emergency" },
      { slug: "insurance-liaison", icon: Receipt, title: "Insurance + payment liaison", blurb: "Escrow for large deposits, direct-billing partners for Gulf insurers, FX with 0.5–1% spreads via regulated processors.", cta: "Payment options", href: "/insurance" },
    ],
  },
];

const seoTitle = "Services — MedCasts coordination end-to-end";
const seoDescription = "Every coordination service we run — quote matching, second opinions, visa, case management, post-op follow-up, emergency evac, insurance liaison. Free to you.";
const path = "/services";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Services", url: localeUrl(locale, path) },
]);

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">Services</span>
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.7fr] lg:items-center">
          <div>
            <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">What we do</div>
            <h1 class="display display-tight mt-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
              Eight services, <span class="italic-display">one coordinator.</span>
            </h1>
            <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
              Everything between your first message and your return flight home — handled. You never pay us directly; hospitals pay our coordination fee only after you choose to proceed.
            </p>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
            <img
              src={heroImage("services-hero")}
              alt="Coordinator with international patient"
              width="600"
              height="750"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 16px; inset-inline-end: 16px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">From first message to flight home</div>
              <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">One person, your language, every step.</div>
            </div>
          </div>
        </div>

        <div class="mt-14 space-y-14">
          {groups.map((g) => (
            <section>
              <div class="grid gap-6 lg:grid-cols-[0.4fr_1fr] lg:items-end mb-7" style="border-top: 1px solid var(--color-ink); padding-top: 22px;">
                <div>
                  <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.16em; color: var(--color-accent);">
                    {g.eyebrow}
                  </div>
                  <h2 class="display mt-2.5" style="font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 400;">
                    {g.title}
                  </h2>
                </div>
                <p class="serif" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted); max-width: 560px;">
                  {g.sub}
                </p>
              </div>
              <ul class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
                {g.items.map((s) => {
                  const Icon = s.icon;
                  return (
                    <li class="paper flex flex-col h-full overflow-hidden" style="padding: 0;">
                      <div class="relative" style="aspect-ratio: 16/9; overflow: hidden;">
                        <img
                          src={s.slug.includes("post-op") || s.slug.includes("emergency") ? journeyScene(s.slug) : serviceScene(s.slug)}
                          alt={s.title}
                          width="640"
                          height="360"
                          loading="lazy"
                          decoding="async"
                          style="width: 100%; height: 100%; object-fit: cover;"
                        />
                        <div class="image-veil" />
                      </div>
                      <div style="padding: 22px 24px 24px;" class="flex flex-col flex-1">
                        <div
                          class="flex items-center justify-center"
                          style="width: 40px; height: 40px; border-radius: 10px; background: var(--color-accent-mist, var(--color-accent-soft)); color: var(--color-accent);"
                          aria-hidden="true"
                        >
                          <Icon strokeWidth={1.6} className="h-[20px] w-[20px]" />
                        </div>
                        <div class="serif mt-3" style="font-size: 19px; font-weight: 500; letter-spacing: -0.015em; line-height: 1.25;">{s.title}</div>
                        <p class="mt-2 flex-1" style="font-size: 14px; color: var(--color-ink-muted); line-height: 1.55;">{s.blurb}</p>
                        <a
                          href={localizedPath(locale, s.href)}
                          class="inline-flex items-center gap-1 mt-4 font-medium"
                          style="color: var(--color-accent); font-size: 13px;"
                        >
                          {s.cta} <ChevronRight className="h-3.5 w-3.5 mirror-x" />
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section style="padding: 72px 28px; background: var(--color-ink); color: var(--color-bg);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">Always</div>
          <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
            Free to you —
            <span class="italic-display"> hospitals pay us.</span>
          </h2>
          <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
            Coordination fee (5-15% of the hospital invoice) comes from the hospital after you choose to proceed. Second opinions, quote preparation, visa coordination, and pre-travel support are free regardless.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={localizedPath(locale, "/quote")} class="inline-flex items-center gap-2 font-semibold" style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;">
            Start now <ChevronRight className="h-4 w-4 mirror-x" />
          </a>
          <a href={localizedPath(locale, "/terms")} class="inline-flex items-center gap-2 font-semibold" style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;">
            Read terms
          </a>
        </div>
      </div>
    </section>

    <HowItWorks
      heading="From first message to first follow-up"
      italicWord="follow-up"
      steps={[
        { title: "Initial conversation", description: "You share what you're considering — diagnosis, prior workup, location, budget. We listen, ask clarifying questions, and route the case to a specific case-manager. Typically a 20-30 minute call." },
        { title: "Workup review", description: "We collect your records — imaging, pathology, labs, prior reports — and circulate them to 2-3 partner programs that match your case. No commitment yet; this is the diagnostic-and-quote phase." },
        { title: "Quotes + recommendations", description: "Within 48-72 hours we return: itemized quotes from each program, surgeon-volume data, expected timelines, and our specific recommendation with rationale. You compare." },
        { title: "Decision support", description: "Questions, alternative options, second opinions — whatever you need before committing. We're not pushing a specific program; we're helping you choose." },
        { title: "Travel coordination", description: "Once you've chosen, we handle visa documentation, airport pickup, hospital-near hotel booking, and interpreter coordination. Your case-manager is your single point of contact." },
        { title: "On-site management", description: "While you're at the hospital, we coordinate between you, the surgical team, and your home physician. Daily check-ins during admission; on-call coverage 24/7 for emergencies." },
        { title: "Post-op + follow-up", description: "Records transfer to your home physician, telemedicine follow-up scheduled, complications protocol clear. We stay engaged through week 12 minimum." },
      ]}
      outroNote="Most patients move from initial conversation to flying out in 3-6 weeks. Complex oncology and transplant cases sometimes take longer (8-16 weeks) for thorough multi-program comparison."
    />

    <WhatToExpect
      heading="What we are — and what we aren't"
      italicWord="we aren't"
      items={[
        { label: "We are coordinators", description: "Licensed in our home country to coordinate medical-tourism logistics. We work with hospitals, surgeons, insurers, embassies." },
        { label: "We are not clinicians", description: "We don't diagnose, prescribe, or perform procedures. Clinical recommendations come from licensed physicians at partner programs, not from us." },
        { label: "We are partial to good outcomes", description: "Our incentive structure rewards repeat patients and referrals — not pushing specific programs. We disclose all coordination fees in our terms." },
        { label: "We are not affiliated with a specific hospital", description: "We work with multiple programs in each destination. We have direct relationships, but not exclusive ones." },
        { label: "We are honest about limitations", description: "If your case is better treated locally, we'll say so. If a procedure isn't right for you, we'll explain why. Bad referrals lose us future referrals — the math punishes overselling." },
        { label: "We are responsible for our recommendations", description: "Documented in writing. Trail of communication preserved. Open to scrutiny, dispute, and second opinions." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
