---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, faqJsonLd } from "@/lib/seo";
import { ChevronRight, Check } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { serviceScene, patientHero } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/insurance`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tIn = getTranslator(locale, "insurancePage");

const path = "/insurance";
const url = localeUrl(locale, path);

const partners = [
  { name: "Cigna Global", cashless: "yes" as const, note: tIn("partnerNote1") },
  { name: "Bupa International", cashless: "yes" as const, note: tIn("partnerNote2") },
  { name: "Allianz Worldwide Care", cashless: "partial" as const, note: tIn("partnerNote3") },
  { name: "AXA — Global Healthcare", cashless: "partial" as const, note: tIn("partnerNote4") },
  { name: "Aetna International", cashless: "yes" as const, note: tIn("partnerNote5") },
  { name: "IMG (International Medical Group)", cashless: "reimburse" as const, note: tIn("partnerNote6") },
  { name: "GeoBlue / Blue Cross Blue Shield", cashless: "partial" as const, note: tIn("partnerNote7") },
  { name: "WellAway", cashless: "reimburse" as const, note: tIn("partnerNote8") },
];

const faqs = [
  { question: tIn("faqQ1"), answer: tIn("faqA1") },
  { question: tIn("faqQ2"), answer: tIn("faqA2") },
  { question: tIn("faqQ3"), answer: tIn("faqA3") },
  { question: tIn("faqQ4"), answer: tIn("faqA4") },
];

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tIn("breadcrumbInsurance"), url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const stats = [
  { l: tIn("stat01label"), v: `${partners.length}+` },
  { l: tIn("stat02label"), v: tIn("stat02val") },
  { l: tIn("stat03label"), v: tIn("stat03val") },
  { l: tIn("stat04label"), v: tIn("stat04val") },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tIn("seoTitle")}
      description={tIn("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd(faqs))} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tIn("breadcrumbInsurance")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tIn("eyebrow")}
      h1First={tIn("h1First")}
      h1Italic={tIn("h1Italic")}
      lede={tIn("lede")}
      stats={stats}
    />

    {/* Real-care strip — paperwork + patient + family imagery */}
    <section style="padding: 0 0 24px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-3" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/3; border-radius: var(--radius-lg);">
            <img src={serviceScene("ins-1")} alt={tIn("imgAlt1")} width="600" height="450" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;" />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 12px; inset-inline-end: 14px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tIn("imgOverlay1Label")}</div>
              <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 3px;">{tIn("imgOverlay1Caption")}</div>
            </div>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/3; border-radius: var(--radius-lg);">
            <img src={patientHero(31, "middle_east", 600)} alt={tIn("imgAlt2")} width="600" height="450" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;" />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 12px; inset-inline-end: 14px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tIn("imgOverlay2Label")}</div>
              <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 3px;">{tIn("imgOverlay2Caption")}</div>
            </div>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/3; border-radius: var(--radius-lg);">
            <img src={serviceScene("ins-3")} alt={tIn("imgAlt3")} width="600" height="450" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;" />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 12px; inset-inline-end: 14px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tIn("imgOverlay3Label")}</div>
              <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 3px;">{tIn("imgOverlay3Caption")}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); margin-top: 24px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
          <div>
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tIn("insurance01")}
            </div>
            <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
              {tIn("insuranceCoverage")}
            </h2>
          </div>
          <p class="mono uppercase max-w-[24rem]" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-align: end;">
            {tIn("insuranceNote")}
          </p>
        </div>

        <div class="paper overflow-x-auto" style="padding: 0;">
          <table class="w-full" style="border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid var(--color-ink);">
                <th class="text-start mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tIn("tableHeaderInsurer")}</th>
                <th class="text-start mono uppercase whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tIn("tableHeaderSettlement")}</th>
                <th class="text-start mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tIn("tableHeaderNotes")}</th>
              </tr>
            </thead>
            <tbody>
              {partners.map((p, i) => {
                const tone = p.cashless === "yes" ? "var(--color-accent)" : p.cashless === "partial" ? "var(--color-saffron)" : "var(--color-ink-muted)";
                const label = p.cashless === "yes" ? tIn("labelCashless") : p.cashless === "partial" ? tIn("labelPartialCashless") : tIn("labelReimburse");
                return (
                  <tr style={i > 0 ? "border-top: 1px dashed var(--color-border);" : ""}>
                    <td class="serif" style="font-size: 16px; letter-spacing: -0.005em; color: var(--color-ink); padding: 16px 20px;">
                      {p.name}
                    </td>
                    <td style="padding: 16px 20px;">
                      <span
                        class="mono uppercase inline-flex items-center gap-1.5"
                        style={`font-size: 9.5px; letter-spacing: 0.14em; padding: 4px 10px; border-radius: 9999px; border: 1px solid color-mix(in srgb, ${tone} 50%, transparent); color: ${tone}; background: color-mix(in srgb, ${tone} 12%, transparent);`}
                      >
                        <span class="h-1.5 w-1.5 rounded-full" style={`background: ${tone};`} aria-hidden="true" />
                        {label}
                      </span>
                    </td>
                    <td class="serif" style="font-size: 14px; line-height: 1.5; color: var(--color-ink-muted); padding: 16px 20px;">
                      {p.note}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <p class="mt-4 mono uppercase" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
          {tIn("insuranceMissing")}
        </p>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mb-8">
          <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tIn("insuranceHow")}
          </div>
          <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
            {tIn("insuranceHowTitle")}
          </h2>
        </div>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {[
            { eyebrow: "01", t: tIn("insurancePreauth"), d: tIn("insurancePreauthDesc") },
            { eyebrow: "02", t: tIn("insuranceDocs"), d: tIn("insuranceDocsDesc") },
            { eyebrow: "03", t: tIn("insuranceDedicated"), d: tIn("insuranceDedicatedDesc") },
          ].map((x) => (
            <li class="paper" style="padding: 26px 28px;">
              <div class="display tnum" style="font-size: 40px; line-height: 0.95; color: var(--color-accent); letter-spacing: -0.02em;">{x.eyebrow}</div>
              <div class="serif mt-3" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">{x.t}</div>
              <p class="mt-2 serif" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">{x.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
          <div>
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tIn("insuranceFaq")}
            </div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
              {tIn("insuranceFaqTitle")}
            </h2>
          </div>
          <div class="divide-y divide-[var(--color-border-soft)]">
            {faqs.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer items-start justify-between gap-6 list-none" style="color: var(--color-ink);">
                  <span class="serif" style="font-size: 18px; line-height: 1.4; font-weight: 500;">{f.question}</span>
                  <span class="mt-1 shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 serif" style="color: var(--color-ink-muted); font-size: 16px; line-height: 1.6;">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 72px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              {tIn("insuranceCta")}
            </div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-bg);">
              {tIn("insuranceCtaText")}
            </h2>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, "/contact?type=insurance")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              {tIn("insuranceBtn")}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tIn("howHeading")}
      italicWord={tIn("howItalicWord")}
      eyebrow={tIn("howEyebrow")}
      steps={[
        { title: tIn("howStep1Title"), description: tIn("howStep1Desc") },
        { title: tIn("howStep2Title"), description: tIn("howStep2Desc") },
        { title: tIn("howStep3Title"), description: tIn("howStep3Desc") },
        { title: tIn("howStep4Title"), description: tIn("howStep4Desc") },
        { title: tIn("howStep5Title"), description: tIn("howStep5Desc") },
      ]}
      outroNote={tIn("howOutroNote")}
    />

    <WhatToExpect
      heading={tIn("wteHeading")}
      italicWord={tIn("wteItalicWord")}
      items={[
        { label: tIn("wteItem1Label"), description: tIn("wteItem1Desc") },
        { label: tIn("wteItem2Label"), description: tIn("wteItem2Desc") },
        { label: tIn("wteItem3Label"), description: tIn("wteItem3Desc") },
        { label: tIn("wteItem4Label"), description: tIn("wteItem4Desc") },
        { label: tIn("wteItem5Label"), description: tIn("wteItem5Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tIn("exploreEyebrow")}
      heading={tIn("exploreHeading")}
      lede={tIn("exploreLede")}
      items={[
        { eyebrow: "Cost", label: "Cost calculator", href: "/calculator", hint: "Procedure × country → live USD/EUR price band." },
        { eyebrow: "Cost", label: "Pricing matrix", href: "/pricing-index", hint: "All 88 treatments × 9 destinations." },
        { eyebrow: "Compare", label: "Compare countries", href: "/compare/countries", hint: "Cost band, language coverage, top specialties." },
        { eyebrow: "Compare", label: "Compare hospitals", href: "/compare/hospitals", hint: "Side-by-side cost, accreditations, rating." },
        { eyebrow: "Visa", label: "Medical visa playbooks", href: "/countries", hint: "Insurance + visa rules per destination." },
        { eyebrow: "Action", label: "Get a free quote", href: "/quote", hint: "We send 3 hospital options + cost in 48h." },
        { eyebrow: "Trust", label: "Free second opinion", href: "/second-opinion", hint: "Independent review before paying out of pocket." },
        { eyebrow: "B2B", label: "Hospital partnerships", href: "/for-hospitals", hint: "How we work with insurers + hospitals." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
