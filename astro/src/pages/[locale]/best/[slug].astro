---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Price from "@/components/Price.astro";
import WhyCountrySection from "@/components/content/WhyCountrySection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import { db, sql as rawSql } from "@/lib/db";
import {
  specialties as specialtiesTbl,
  countries as countriesTbl,
  treatments as treatmentsTbl,
  cities as citiesTbl,
} from "../../../../../src/lib/db/schema";
import { and, eq, sql } from "drizzle-orm";
import { getContentBatch, applyTranslated, isUntranslated, getContent } from "@/lib/translate";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { hospitalCover } from "@/lib/images";
import { ChevronRight } from "lucide-react";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/best/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tBd = getTranslator(locale, "bestDetailPage");

/** Parses "cardiac-surgery-in-india" → { specialtySlug, placeSlug }.
 *  placeSlug is a destination-country slug OR a city slug. */
function parseSlug(s: string): { specialtySlug: string; placeSlug: string } | null {
  const idx = s.lastIndexOf("-in-");
  if (idx < 1 || idx > s.length - 5) return null;
  return { specialtySlug: s.slice(0, idx), placeSlug: s.slice(idx + 4) };
}

// Common search-form → canonical-slug aliases. When a user / external link
// hits an alias (e.g. /best/knee-replacement-in-india), we 301 to the canonical
// (/best/total-knee-replacement-in-india) so SEO equity consolidates on one URL.
const SLUG_ALIASES: Record<string, string> = {
  // Procedure short forms → canonical treatment slugs
  "knee-replacement": "total-knee-replacement",
  "hair-transplant": "hair-transplant-fue",
  "ivf": "ivf-icsi",
  "cabg": "cabg-heart-bypass",
  "heart-bypass": "cabg-heart-bypass",
  "bypass-surgery": "cabg-heart-bypass",
  "gallbladder-surgery": "laparoscopic-gallbladder",
  "appendix-surgery": "appendectomy-laparoscopic",
  "kidney-stone-surgery": "kidney-stone-lithotripsy",
  "cataract-surgery": "cataract-premium-iol",
  "lasik": "lasik-smile",
  // Body-part / lay terms → canonical specialty slugs
  "heart": "cardiac-surgery",
  "heart-surgery": "cardiac-surgery",
  "cardiology": "cardiac-surgery",
  "cancer": "oncology",
  "cancer-hospital": "oncology",
  "tumor": "oncology",
  "brain": "neurology-neurosurgery",
  "neuro": "neurology-neurosurgery",
  "neurosurgery": "neurology-neurosurgery",
  "neurology": "neurology-neurosurgery",
  "eye": "ophthalmology",
  "vision": "ophthalmology",
  "transplant": "organ-transplant",
  "ent": "ent-otolaryngology",
  "kidney": "urology",
  "ortho": "orthopedics",
  "orthopedic": "orthopedics",
  "orthopaedic": "orthopedics",
  "joint-replacement": "orthopedics",
  "bone": "orthopedics",
  "plastic-surgery": "cosmetic-surgery",
  "cosmetic": "cosmetic-surgery",
  "weight-loss": "bariatric-surgery",
  "obesity": "bariatric-surgery",
  "fertility": "fertility-ivf",
  "gyno": "gynecology",
  "gynae": "gynecology",
  "gynaecology": "gynecology",
  "gi": "gi-surgery",
  "gastro": "gi-surgery",
  "pediatric": "pediatric-surgery",
  "paediatric": "pediatric-surgery",
};

const parsed = parseSlug(slug);
if (!parsed) return new Response("Not found", { status: 404 });

// 301 redirect aliases to the canonical /best/{canonical}-in-{place} URL.
const aliasTarget = SLUG_ALIASES[parsed.specialtySlug];
if (aliasTarget) {
  return Astro.redirect(localizedPath(locale, `/best/${aliasTarget}-in-${parsed.placeSlug}`), 301);
}

// The place after "-in-" can be a destination country (e.g. "india") or a
// city (e.g. "mumbai"). Resolve country first; fall back to city, keeping the
// city's parent country for cross-links + the "why this country" section.
type PlaceMode = "country" | "city";
const countryHit = await db.query.countries.findFirst({
  where: and(eq(countriesTbl.slug, parsed.placeSlug), eq(countriesTbl.isDestination, true)),
});
let placeMode: PlaceMode;
let city: { id: number; slug: string; name: string } | null = null;
let country: typeof countriesTbl.$inferSelect;
if (countryHit) {
  placeMode = "country";
  country = countryHit;
} else {
  // "unknown" is the ungeocoded-hospitals bucket — never a real city page.
  if (parsed.placeSlug === "unknown") return new Response("Not found", { status: 404 });
  const cityHit = await db.query.cities.findFirst({ where: eq(citiesTbl.slug, parsed.placeSlug) });
  if (!cityHit) return new Response("Not found", { status: 404 });
  const cityCountry = await db.query.countries.findFirst({ where: eq(countriesTbl.id, cityHit.countryId) });
  if (!cityCountry) return new Response("Not found", { status: 404 });
  placeMode = "city";
  city = { id: cityHit.id, slug: cityHit.slug, name: cityHit.name };
  country = cityCountry;
}
const placeScope = city ? sql`AND ci.id = ${city.id}` : sql`AND ci.country_id = ${country.id}`;

// The slug before "-in-" can be a specialty (e.g. cardiac-surgery) or a treatment
// (e.g. liver-transplant, hair-transplant-fue). Try specialty first; if absent,
// fall back to treatment so we can serve "best {treatment} hospital in {country}"
// queries with a dedicated ranking page.
type EntityKind = "specialty" | "treatment";
const specialtyHit = await db.query.specialties.findFirst({ where: eq(specialtiesTbl.slug, parsed.specialtySlug) });
let entity: { id: number; slug: string; name: string; description: string | null };
let parentSpecialty: { id: number; slug: string; name: string; description: string | null };
let kind: EntityKind;

if (specialtyHit) {
  kind = "specialty";
  entity = specialtyHit;
  parentSpecialty = specialtyHit;
} else {
  const treatmentHit = await db.query.treatments.findFirst({
    where: eq(treatmentsTbl.slug, parsed.specialtySlug),
    with: { specialty: true },
  });
  if (!treatmentHit || !treatmentHit.specialty) return new Response("Not found", { status: 404 });
  kind = "treatment";
  entity = treatmentHit;
  parentSpecialty = treatmentHit.specialty;
}
// Preserve legacy variable name to minimize churn through the rest of the file.
const specialty = entity;

// Ranked hospitals for this entity × country.
// Specialty mode ranks via hospital_specialties (CoE flag + featured + rating + reviews).
// Treatment mode ranks via hospital_treatments (must offer the procedure) joined
// against hospital_specialties for the CoE signal on the parent specialty.
type Row = {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  rating: string | null;
  reviewCount: number | null;
  bedCapacity: number | null;
  establishedYear: number | null;
  coverImageUrl: string | null;
  cityName: string | null;
  citySlug: string | null;
  isCoe: boolean | null;
  fromUsd: number | null;
};
const hospitals = kind === "specialty"
  ? Array.from(
      (await db.execute(sql`
        SELECT h.id, h.name, h.slug, h.description,
          h.rating, h.review_count as "reviewCount", h.bed_capacity as "bedCapacity",
          h.established_year as "establishedYear", h.cover_image_url as "coverImageUrl",
          ci.name as "cityName", ci.slug as "citySlug",
          hs.is_center_of_excellence as "isCoe",
          (SELECT MIN(ht.cost_min_usd)::int FROM hospital_treatments ht
            INNER JOIN treatments t ON t.id = ht.treatment_id
            WHERE ht.hospital_id = h.id AND t.specialty_id = ${parentSpecialty.id}) as "fromUsd"
        FROM hospital_specialties hs
        INNER JOIN hospitals h ON h.id = hs.hospital_id
        INNER JOIN cities ci ON ci.id = h.city_id
        WHERE hs.specialty_id = ${parentSpecialty.id}
          ${placeScope}
          AND h.is_active = true
        ORDER BY hs.is_center_of_excellence DESC NULLS LAST,
                 h.is_featured DESC NULLS LAST,
                 h.rating DESC NULLS LAST,
                 h.review_count DESC NULLS LAST
        LIMIT 20
      `)) as Iterable<Row>,
    )
  : Array.from(
      (await db.execute(sql`
        SELECT h.id, h.name, h.slug, h.description,
          h.rating, h.review_count as "reviewCount", h.bed_capacity as "bedCapacity",
          h.established_year as "establishedYear", h.cover_image_url as "coverImageUrl",
          ci.name as "cityName", ci.slug as "citySlug",
          COALESCE(hs.is_center_of_excellence, false) as "isCoe",
          ht.cost_min_usd as "fromUsd"
        FROM hospital_treatments ht
        INNER JOIN hospitals h ON h.id = ht.hospital_id
        INNER JOIN cities ci ON ci.id = h.city_id
        LEFT JOIN hospital_specialties hs
          ON hs.hospital_id = h.id AND hs.specialty_id = ${parentSpecialty.id}
        WHERE ht.treatment_id = ${entity.id}
          ${placeScope}
          AND h.is_active = true
        ORDER BY hs.is_center_of_excellence DESC NULLS LAST,
                 h.is_featured DESC NULLS LAST,
                 h.rating DESC NULLS LAST,
                 h.review_count DESC NULLS LAST,
                 ht.cost_min_usd ASC NULLS LAST
        LIMIT 20
      `)) as Iterable<Row>,
    );

if (hospitals.length === 0) return new Response("Not found", { status: 404 });

// Inventory floor for city-scoped pages: a "best of" ranking needs a real
// field to rank. Under 5 hospitals, 301 up to the country-level page.
if (placeMode === "city" && hospitals.length < 5) {
  return Astro.redirect(localizedPath(locale, `/best/${parsed.specialtySlug}-in-${country.slug}`), 301);
}

// Pull deep specialty + country sections — specSections always keyed off the
// parent specialty, since treatment-mode pages share the specialty's narrative.
const [specSectionRow, countrySectionRow] = await Promise.all([
  rawSql`SELECT content_sections FROM specialties WHERE id = ${parentSpecialty.id} LIMIT 1`,
  rawSql`SELECT content_sections FROM countries WHERE id = ${country.id} LIMIT 1`,
]);
const specSections: any = specSectionRow[0]?.content_sections ?? null;
const countrySections: any = countrySectionRow[0]?.content_sections ?? null;

// Translate — `entityMap` translates whatever the page is showing (specialty
// or treatment); `specialtyMap` always holds the parent specialty translation
// for the cross-link copy further down.
const entityMap = await getContent(kind, entity.id, locale);
const specialtyMap = kind === "specialty"
  ? entityMap
  : await getContent("specialty", parentSpecialty.id, locale);
const specialtyT = applyTranslated(specialty, entityMap, ["name"]);
const parentSpecialtyT = applyTranslated(parentSpecialty, specialtyMap, ["name"]);
const hMap = await getContentBatch("hospital", hospitals.map((h) => h.id), locale);
const hospitalsT = hospitals.map((h) => ({
  ...h,
  ...applyTranslated({ name: h.name, description: h.description }, hMap[h.id] ?? {}, ["name", "description"]),
}));

const year = new Date().getFullYear();
const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
const flag = FLAG[country.slug] ?? "🌐";

// Display labels — `placeName` is the city or country shown in headings;
// `placeLabel` adds the country for disambiguation in titles ("Mumbai, India").
const placeName = placeMode === "city" ? city!.name : country.name;
const placeLabel = placeMode === "city" ? `${city!.name}, ${country.name}` : country.name;

// Routing helpers — branch on whether the page is showing a specialty or a treatment.
const entityHubHref = kind === "specialty"
  ? `/specialty/${specialty.slug}`
  : `/treatment/${specialty.slug}`;
const entityContactQs = kind === "specialty"
  ? `specialty=${specialty.slug}`
  : `treatment=${specialty.slug}`;

const seoTitle = `Best Hospitals for ${specialtyT.name} in ${placeLabel} (${year})`;
const seoDescription = `Ranked list of the top ${hospitals.length} hospitals for ${specialtyT.name} in ${placeLabel} — by center-of-excellence status, rating, review volume, and transparent pricing. ${year} edition.`;
const path = `/best/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: country.name, url: localeUrl(locale, `/country/${country.slug}`) },
  ...(placeMode === "city"
    ? [
        { name: `${tBd("breadcrumbBest")} ${specialtyT.name}`, url: localeUrl(locale, `/best/${parsed.specialtySlug}-in-${country.slug}`) },
        { name: city!.name, url },
      ]
    : [{ name: `${tBd("breadcrumbBestFor")} ${specialtyT.name}`, url }]),
]);
const itemLd = itemListJsonLd(hospitalsT.map((h) => ({
  name: h.name,
  url: localeUrl(locale, `/hospital/${h.slug}`),
})));

const untranslated = isUntranslated(locale, specialtyMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, `/country/${country.slug}`)} class="hover:text-ink">{country.name}</a>
        <span class="mx-1.5">/</span>
        {placeMode === "city" ? (
          <>
            <a href={localizedPath(locale, `/best/${parsed.specialtySlug}-in-${country.slug}`)} class="hover:text-ink">{tBd("breadcrumbBest")} {specialtyT.name}</a>
            <span class="mx-1.5">/</span>
            <span style="color: var(--color-ink);">{city!.name}</span>
          </>
        ) : (
          <span style="color: var(--color-ink);">{tBd("breadcrumbBestFor")} {specialtyT.name}</span>
        )}
      </nav>
    </div>

    {/* Hero */}
    <section style="padding: 56px 28px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
          {tBd("heroEyebrow").replace("{year}", String(year))}
        </div>
        <h1
          class="display display-tight mt-3"
          style="font-size: clamp(2.5rem, 5.5vw, 4rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;"
        >
          {tBd("heroHeadingPre")} <span style="font-style: italic;">{specialtyT.name}</span>
          <br />
          {tBd("heroHeadingIn")} {flag} {placeName}
        </h1>
        <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
          {tBd("heroSubtitle").replace("{count}", String(hospitals.length))}
        </p>
        <div class="mono mt-4" style="font-size: 11px; color: var(--color-ink-subtle);">
          {tBd("heroMethodologyLabel")} <a href={`${localizedPath(locale, "/editorial-policy")}#authors`} class="underline">{tBd("heroMethodologyHowWeRank")}</a> · <a href={`${localizedPath(locale, "/editorial-policy")}#pricing`} class="underline">{tBd("heroMethodologyPricing")}</a> · {tBd("heroMethodologyUpdated")} {new Date().toLocaleDateString("en-US", { month: "short", year: "numeric" })}
        </div>
      </div>
    </section>

    {/* Ranked list */}
    <section style="padding: 24px 28px 72px; border-top: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1120px]">
        <ol class="space-y-6">
          {hospitalsT.map((h, i) => {
            const rank = i + 1;
            // Top 3 get medal styling. CoE designation is the strongest signal,
            // then high rating + volume. We compose a short "why ranked here"
            // line so every card carries a visible justification.
            const isMedal = rank < 4;
            const medalTone = rank === 1
              ? { ring: "color-mix(in srgb, var(--color-saffron) 55%, transparent)", chip: "var(--color-saffron)", chipBg: "var(--color-saffron-soft, #FBE9C7)", text: "Gold" }
              : rank === 2
              ? { ring: "color-mix(in srgb, var(--color-ink-subtle) 35%, transparent)", chip: "var(--color-ink-2)", chipBg: "color-mix(in srgb, var(--color-ink) 8%, var(--color-paper))", text: "Silver" }
              : { ring: "color-mix(in srgb, var(--color-coral) 38%, transparent)", chip: "var(--color-coral)", chipBg: "var(--color-coral-soft, #F9DCD7)", text: "Bronze" };
            const ratingNum = h.rating ? Number(h.rating) : 0;
            // Pick the strongest reason this hospital ranks where it does.
            const whyRanked: string = (() => {
              if (h.isCoe && ratingNum >= 4.5) return tBd("whyCoEHighRating").replace("{specialty}", specialtyT.name.toLowerCase()).replace("{rating}", ratingNum.toFixed(1)).replace("{reviews}", (h.reviewCount ?? 0).toLocaleString());
              if (h.isCoe) return tBd("whyCoE").replace("{specialty}", specialtyT.name.toLowerCase());
              if (ratingNum >= 4.6 && (h.reviewCount ?? 0) > 200) return tBd("whyTopRated").replace("{rating}", ratingNum.toFixed(1)).replace("{reviews}", (h.reviewCount ?? 0).toLocaleString());
              if ((h.reviewCount ?? 0) > 500) return tBd("whyHighVolume").replace("{country}", country.name);
              if (h.bedCapacity && h.bedCapacity > 500) return tBd("whyLargeCentre").replace("{beds}", h.bedCapacity.toLocaleString());
              if (h.establishedYear && h.establishedYear < 1990) return tBd("whyEstablished").replace("{year}", String(h.establishedYear));
              return tBd("whyDefault");
            })();
            return (
              <li
                class="paper mc-best-row"
                style={`padding: 0; ${isMedal ? `box-shadow: 0 0 0 2px ${medalTone.ring}, 0 1px 0 rgba(14,23,19,0.04), 0 1px 2px rgba(14,23,19,0.06);` : ""}`}
              >
                <div class="mc-best-grid">
                  <div class="relative mc-best-photo">
                    <PhotoBlock
                      aspect="auto"
                      imgUrl={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: country.slug })}
                      label={h.name}
                      rounded={false}
                      class="h-full"
                    />
                    <div
                      class="display tnum absolute mc-rank-medal"
                      style={`top: 12px; inset-inline-start: 12px; ${isMedal
                        ? `background: ${medalTone.chip}; color: #FFF; box-shadow: 0 4px 12px color-mix(in srgb, ${medalTone.chip} 38%, transparent);`
                        : "background: var(--color-ink); color: var(--color-bg);"}`}
                    >
                      {String(rank).padStart(2, "0")}
                    </div>
                    {isMedal && (
                      <span
                        class="absolute mono uppercase"
                        style={`top: 12px; inset-inline-end: 12px; padding: 4px 10px; border-radius: 9999px; background: ${medalTone.chipBg}; color: ${medalTone.chip}; font-size: 9.5px; letter-spacing: 0.12em; font-weight: 600; backdrop-filter: blur(6px);`}
                      >
                        {medalTone.text}
                      </span>
                    )}
                  </div>

                  <div class="mc-best-body">
                    <div class="flex items-center gap-2 flex-wrap" style="font-size: 11.5px; color: var(--color-ink-subtle);">
                      {h.isCoe && (
                        <span
                          class="mono uppercase"
                          style="padding: 2px 7px; border-radius: 9999px; background: var(--color-saffron-soft); color: #8A5E12; font-size: 9.5px; letter-spacing: 0.08em; font-weight: 600;"
                        >
                          {tBd("badgeCoe")}
                        </span>
                      )}
                      <span>{flag} {h.cityName}, {country.name}</span>
                    </div>
                    <a
                      href={localizedPath(locale, `/hospital/${h.slug}`)}
                      class="serif block mt-1.5 hover:text-accent"
                      style="font-size: 24px; font-weight: 500; letter-spacing: -0.015em; line-height: 1.2;"
                    >
                      {h.name}
                    </a>
                    <p
                      class="mt-2 inline-flex items-start gap-2"
                      style="font-size: 12.5px; line-height: 1.45; color: var(--color-accent-strong, var(--color-accent));"
                    >
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="margin-top: 4px; flex-shrink: 0;">
                        <path d="M3 8l3 3 7-7" />
                      </svg>
                      <span><strong style="font-weight: 600;">{tBd("whyRankedLabel").replace("{rank}", String(rank))}</strong> {whyRanked}</span>
                    </p>
                    {h.description && (
                      <p class="mt-3 line-clamp-2" style="font-size: 14px; line-height: 1.55; color: var(--color-ink-muted); max-width: 620px;">
                        {h.description.split(/\n\s*\n/)[0].slice(0, 220)}{h.description.length > 220 ? "…" : ""}
                      </p>
                    )}
                    <div class="flex items-center gap-4 flex-wrap mt-4" style="font-size: 12.5px; color: var(--color-ink-muted);">
                      {h.rating && ratingNum > 0 && (
                        <span class="inline-flex items-center gap-1">
                          <span style="color: var(--color-saffron);">★</span>
                          <span class="tnum">{ratingNum.toFixed(1)}</span>
                          {h.reviewCount && h.reviewCount > 0 && (
                            <span class="tnum" style="color: var(--color-ink-subtle);">· {h.reviewCount.toLocaleString()} {tBd("reviews")}</span>
                          )}
                        </span>
                      )}
                      {h.bedCapacity && <span class="tnum">{h.bedCapacity.toLocaleString()} {tBd("beds")}</span>}
                      {h.establishedYear && <span>{tBd("est")} {h.establishedYear}</span>}
                    </div>
                  </div>

                  <div class="mc-best-cta">
                    {h.fromUsd ? (
                      <div>
                        <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                          {tBd("priceFrom")}
                        </div>
                        <div class="display tnum" style="font-size: 24px; line-height: 1; letter-spacing: -0.025em; margin-top: 4px;">
                          <Price usd={h.fromUsd} />
                        </div>
                        <div class="mono" style="font-size: 10px; color: var(--color-ink-subtle); margin-top: 4px;">
                          {tBd("priceNote")}
                        </div>
                      </div>
                    ) : <div />}
                    <div class="flex flex-col gap-2 mt-4">
                      <a
                        href={localizedPath(locale, `/hospital/${h.slug}`)}
                        class="inline-flex items-center justify-center gap-1 font-semibold"
                        style="background: var(--color-ink); color: var(--color-bg); padding: 10px 16px; font-size: 13px; border-radius: 9999px; white-space: nowrap;"
                      >
                        {tBd("btnViewHospital")}
                        <ChevronRight className="h-3 w-3 mirror-x" />
                      </a>
                      <a
                        href={localizedPath(locale, `/contact?hospital=${h.slug}&${entityContactQs}`)}
                        class="inline-flex items-center justify-center gap-1"
                        style="background: transparent; color: var(--color-ink); padding: 8px 14px; font-size: 12px; border-radius: 9999px; border: 1px solid var(--color-border); white-space: nowrap;"
                      >
                        {tBd("btnGetQuote")}
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      </div>

      <style>
        /* Best-list grid: photo / body / CTA stack on desktop, full-stack on mobile */
        .mc-best-grid {
          display: grid;
          grid-template-columns: 220px 1fr 200px;
          gap: 0;
          align-items: stretch;
        }
        .mc-best-photo { min-height: 200px; overflow: hidden; }
        .mc-best-body { padding: 22px 24px; min-width: 0; }
        .mc-best-cta {
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          padding: 22px;
          border-inline-start: 1px solid var(--color-border-soft);
        }
        @media (max-width: 768px) {
          .mc-best-grid { grid-template-columns: 1fr; }
          .mc-best-photo { min-height: 200px; aspect-ratio: 16 / 9; }
          .mc-best-body { padding: 20px 18px 8px; }
          .mc-best-cta {
            border-inline-start: 0;
            border-top: 1px dashed var(--color-border);
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding: 16px 18px 20px;
          }
          .mc-best-cta > div:last-child {
            flex-direction: row !important;
            margin-top: 0 !important;
          }
        }
        .mc-rank-medal {
          width: 44px;
          height: 44px;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 16px;
          line-height: 1;
        }
      </style>
    </section>

    {/* Methodology — full transparency */}
    <section style="padding: 64px 28px; border-top: 1px solid var(--color-border); background: var(--color-paper);">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[0.45fr_1fr]">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tBd("methodologyEyebrow")}</div>
            <h2 class="display mt-3" style="font-size: 30px; line-height: 1.05; letter-spacing: -0.02em;">
              {tBd("methodologyHeadingPre").replace("{count}", String(hospitals.length))}
              <span style="font-style: italic; font-weight: 300;"> {tBd("methodologyHeadingAccent")}</span>
            </h2>
            <p class="serif mt-4" style="font-size: 15.5px; line-height: 1.6; color: var(--color-ink-muted);">
              {tBd("methodologyBody")}
            </p>
            <ul class="mt-5 grid gap-1.5 text-sm" style="color: var(--color-ink-muted);">
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tBd("methodologyBullet1")}</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tBd("methodologyBullet2")} {new Date().toLocaleDateString("en-US", { month: "long", year: "numeric" })}</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tBd("methodologyBullet3")}</li>
            </ul>
          </div>

          <div>
            <p class="mono uppercase mb-4" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBd("weightedCriteriaLabel")}</p>
            <ol class="space-y-3">
              {[
                { w: 40, label: tBd("criterion1Label"), body: tBd("criterion1Body").replace("{specialty}", specialtyT.name.toLowerCase()) },
                { w: 25, label: tBd("criterion2Label"), body: tBd("criterion2Body") },
                { w: 20, label: tBd("criterion3Label"), body: tBd("criterion3Body") },
                { w: 10, label: tBd("criterion4Label"), body: tBd("criterion4Body") },
                { w: 5, label: tBd("criterion5Label"), body: tBd("criterion5Body") },
              ].map((c) => (
                <li class="paper" style="padding: 16px 18px; display: grid; grid-template-columns: 56px 1fr; gap: 14px; align-items: start;">
                  <div class="display tnum" style="font-size: 26px; line-height: 1; color: var(--color-accent); letter-spacing: -0.025em;">
                    {c.w}<span style="font-size: 13px; opacity: 0.6;">%</span>
                  </div>
                  <div>
                    <div class="serif" style="font-size: 15px; line-height: 1.3; font-weight: 500; color: var(--color-ink);">{c.label}</div>
                    <p class="serif mt-1" style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">{c.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="mt-12 grid gap-8 md:grid-cols-2">
          <div class="paper" style="padding: 22px 24px; border-inline-start: 3px solid var(--color-coral);">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-coral);">{tBd("notListEyebrow")}</div>
            <h3 class="display mt-2" style="font-size: 21px; letter-spacing: -0.015em;">{tBd("notListHeading")}</h3>
            <p class="serif mt-2" style="font-size: 14px; line-height: 1.55; color: var(--color-ink-muted);">
              {tBd("notListBody")}
            </p>
          </div>
          <div class="paper" style="padding: 22px 24px; border-inline-start: 3px solid var(--color-accent);">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">{tBd("reRankEyebrow")}</div>
            <h3 class="display mt-2" style="font-size: 21px; letter-spacing: -0.015em;">{tBd("reRankHeading")}</h3>
            <p class="serif mt-2" style="font-size: 14px; line-height: 1.55; color: var(--color-ink-muted);">
              {tBd("reRankBody")}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section style="padding: 72px 28px; border-top: 1px solid var(--color-border); background: var(--color-ink); color: var(--color-bg);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">
            {tBd("ctaEyebrow")}
          </div>
          <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
            {tBd("ctaHeadingPre").replace("{place}", placeName).replace("{specialty}", specialtyT.name)}
            <span style="font-style: italic;"> {tBd("ctaHeadingAccent")}</span>
          </h2>
          <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
            {tBd("ctaBody")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={localizedPath(locale, `/contact?${entityContactQs}&country=${country.slug}`)}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {tBd("ctaBtnRequestQuotes")} <ChevronRight className="h-4 w-4 mirror-x" />
          </a>
          <a
            href={localizedPath(locale, entityHubHref)}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {kind === "specialty" ? tBd("ctaBtnSpecialtyOverview") : tBd("ctaBtnProcedureOverview")}
          </a>
        </div>
      </div>
    </section>

    {/* Why this country for this specialty */}
    <WhyCountrySection
      countryName={country.name}
      countrySlug={country.slug}
      treatmentName={specialtyT.name}
      hospitalCount={hospitals.length}
      specialtyName={parentSpecialtyT.name}
    />

    {/* Specialty-specific quality signals from specialty content_sections */}
    {specSections?.programQualitySignals && specSections.programQualitySignals.length > 0 && (
      <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tBd("qualitySignalsEyebrow")}
              </div>
              <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                {tBd("qualitySignalsHeadingPre")} <span style="font-style: italic;">{tBd("qualitySignalsHeadingAccent")}</span>
              </h2>
            </div>
            <ul class="space-y-3">
              {specSections.programQualitySignals.map((s: string) => (
                <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                  <span style="color: var(--color-accent);">→</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {specSections?.surgeonVolumeThresholds && specSections.surgeonVolumeThresholds.length > 0 && (
      <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tBd("volumeBenchmarksEyebrow")}
          </div>
          <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
            {tBd("volumeBenchmarksHeadingPre")} <span style="font-style: italic;">{tBd("volumeBenchmarksHeadingAccent")}</span>
          </h2>
          <div class="paper overflow-hidden" style="padding: 0;">
            {specSections.surgeonVolumeThresholds.map((t: any, i: number) => (
              <div
                class="grid items-start gap-4 p-5"
                style={`grid-template-columns: 220px 1fr; ${i > 0 ? "border-top: 1px solid var(--color-border-soft);" : ""}`}
              >
                <span class="mono uppercase" style="font-size: 12px; letter-spacing: 0.08em; color: var(--color-accent);">{t.range}</span>
                <span style="font-size: 15px; line-height: 1.5;">{t.quality}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {countrySections?.bestMonthsToTravel && (
      <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tBd("travelTimingEyebrow")}
              </div>
              <h2 class="display mt-3" style="font-size: 24px; letter-spacing: -0.015em;">
                {tBd("travelTimingHeading").replace("{country}", country.name)}
              </h2>
            </div>
            <div class="paper" style="padding: 22px;">
              {countrySections.bestMonthsToTravel.peak && (
                <p class="mb-2" style="font-size: 14.5px;"><strong>{tBd("travelPeakLabel")}</strong> {countrySections.bestMonthsToTravel.peak.join(", ")}</p>
              )}
              {countrySections.bestMonthsToTravel.avoid && countrySections.bestMonthsToTravel.avoid.length > 0 && (
                <p class="mb-2" style="font-size: 14.5px;"><strong>{tBd("travelAvoidLabel")}</strong> {countrySections.bestMonthsToTravel.avoid.join(", ")}</p>
              )}
              {countrySections.bestMonthsToTravel.notes && (
                <p style="font-size: 14px; line-height: 1.6; color: var(--color-ink-muted);">{countrySections.bestMonthsToTravel.notes}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    {specSections?.questionsForProgram && specSections.questionsForProgram.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tBd("questionsEyebrow")}
          </div>
          <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
            {tBd("questionsHeadingPre")} <span style="font-style: italic;">{tBd("questionsHeadingAccent")}</span>
          </h2>
          <ol class="space-y-3">
            {specSections.questionsForProgram.map((q: string, i: number) => (
              <li class="flex gap-4 items-start paper" style="padding: 16px 22px;">
                <span class="display tnum" style="font-size: 24px; line-height: 1; opacity: 0.35; min-width: 36px;">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p style="font-size: 15.5px; line-height: 1.5;">{q}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {/* EEAT signals */}
    <MethodologyBlock locale={locale}
      curationNote={`This ranking of "best ${specialtyT.name.toLowerCase()} in ${placeLabel}" weights center-of-excellence designations, JCI/national accreditation status, peer-reviewed surgeon publication record, and patient outcome data — not advertising spend. Position is re-evaluated quarterly when new credentialling data lands.`}
      dataSources={[
        "JCI accreditation registry",
        ...(country.slug === "india" ? ["NABH licence register", "AIIMS / PGIMER training records"] : []),
        "National medical council registries",
        "Peer-reviewed publication record",
        "Hospital outcomes annual reports",
      ]}
    />

    
    <ExploreGrid
      locale={locale}
      eyebrow={tBd("exploreEyebrow")}
      heading={tBd("exploreHeading").replace("{specialty}", specialtyT.name).replace("{place}", placeName)}
      lede={tBd("exploreLede")}
      items={[
        ...(kind === "treatment"
          ? [
              { eyebrow: tBd("exploreCatProcedure"), label: `${specialtyT.name} overview`, href: entityHubHref, hint: tBd("exploreProcedureHint").replace("{specialty}", specialtyT.name.toLowerCase()) },
              { eyebrow: tBd("exploreCatProcedureCost"), label: `${specialtyT.name} cost in ${country.name}`, href: `/treatment/${specialty.slug}/${country.slug}`, hint: tBd("exploreProcedureCostHint").replace("{country}", country.name) },
            ]
          : [
              { eyebrow: tBd("exploreCatSpecialty"), label: `${specialtyT.name} hub`, href: entityHubHref, hint: tBd("exploreSpecialtyHint").replace("{specialty}", specialtyT.name.toLowerCase()) },
            ]),
        ...(placeMode === "city"
          ? [
              { eyebrow: tBd("exploreCatBestOf"), label: `Best ${specialtyT.name} in ${country.name}`, href: `/best/${parsed.specialtySlug}-in-${country.slug}`, hint: tBd("exploreBestOfCityHint").replace("{city}", city!.name).replace("{country}", country.name) },
              { eyebrow: tBd("exploreCatCity"), label: `${city!.name} hospital hub`, href: `/city/${city!.slug}`, hint: tBd("exploreCityHint").replace("{city}", city!.name) },
            ]
          : []),
        { eyebrow: tBd("exploreCatDestination"), label: `${country.name} hospital hub`, href: `/country/${country.slug}`, hint: tBd("exploreDestinationHint").replace("{country}", country.name) },
        { eyebrow: tBd("exploreCatSurgeons"), label: `${parentSpecialtyT.name} surgeons`, href: `/surgeons/${parentSpecialty.slug}`, hint: tBd("exploreSurgeonsHint") },
        { eyebrow: tBd("exploreCatSurgeons"), label: `${parentSpecialtyT.name} surgeons in ${country.name}`, href: `/surgeons/${parentSpecialty.slug}/${country.slug}`, hint: tBd("exploreSurgeonsCountryHint").replace("{country}", country.name) },
        { eyebrow: tBd("exploreCatHospitals"), label: `All ${country.name} hospitals`, href: `/hospitals/country/${country.slug}`, hint: tBd("exploreAllHospitalsHint") },
        { eyebrow: tBd("exploreCatHospitals"), label: `Hospitals filtered by ${parentSpecialtyT.name}`, href: `/hospitals/specialty/${parentSpecialty.slug}`, hint: tBd("exploreHospitalsBySpecialtyHint").replace("{specialty}", parentSpecialtyT.name.toLowerCase()) },
        { eyebrow: tBd("exploreCatBrowse"), label: tBd("exploreBrowseBestOfLabel"), href: "/best", hint: tBd("exploreBrowseBestOfHint") },
        { eyebrow: tBd("exploreCatCompare"), label: tBd("exploreCompareHospitalsLabel"), href: "/compare/hospitals", hint: tBd("exploreCompareHospitalsHint") },
        { eyebrow: tBd("exploreCatCompare"), label: tBd("exploreCompareDoctorsLabel"), href: "/compare/doctors", hint: tBd("exploreCompareDoctorsHint") },
        { eyebrow: tBd("exploreCatTool"), label: tBd("exploreCostCalcLabel"), href: "/calculator", hint: tBd("exploreCostCalcHint").replace("{specialty}", parentSpecialtyT.name.toLowerCase()) },
        { eyebrow: tBd("exploreCatTool"), label: tBd("exploreMatchMeLabel"), href: "/match-me", hint: tBd("exploreMatchMeHint") },
        { eyebrow: tBd("exploreCatTrust"), label: tBd("exploreEditorialLabel"), href: "/editorial-policy", hint: tBd("exploreEditorialHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
