---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { getTranslator } from "@/lib/messages";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/best", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tBe = getTranslator(locale, "bestPage");

// Find all specialty × country pairs that have at least one active hospital
const rows = Array.from(
  (await db.execute(sql`
    SELECT DISTINCT s.slug as specialty_slug, s.name as specialty_name,
           c.slug as country_slug, c.name as country_name,
           COUNT(h.id) as hospital_count
    FROM specialties s
    CROSS JOIN countries c
    INNER JOIN hospital_specialties hs ON hs.specialty_id = s.id
    INNER JOIN hospitals h ON h.id = hs.hospital_id
    INNER JOIN cities ci ON ci.id = h.city_id
    WHERE ci.country_id = c.id
      AND c.is_destination = true
      AND h.is_active = true
    GROUP BY s.id, s.slug, s.name, c.id, c.slug, c.name
    HAVING COUNT(h.id) >= 2
    ORDER BY c.name, s.name
  `)) as Iterable<{ specialty_slug: string; specialty_name: string; country_slug: string; country_name: string; hospital_count: number }>,
);

const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦", "costa-rica": "🇨🇷",
  "czech-republic": "🇨🇿", hungary: "🇭🇺", poland: "🇵🇱",
};

// Translate
const items = rows.map((r) => {
  const slug = `${r.specialty_slug}-in-${r.country_slug}`;
  const flag = FLAG[r.country_name.toLowerCase().replace(/ /g, "-")] ?? "🌐";
  return { slug, name: r.specialty_name, country: r.country_name, count: Number(r.hospital_count), flag };
});

const path = "/best";
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tBe("indexBreadcrumb"), url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tBe("indexSeoTitle")}
      description={tBe("indexSeoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tBe("indexBreadcrumb")}</span>
        </nav>
      </div>
    </div>

    {/* Hero */}
    <section style="padding: 72px 28px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
          {new Date().getFullYear()}{tBe("indexHeroEyebrowSuffix")}
        </div>
        <h1 class="display mt-3" style="font-size: clamp(2.5rem, 5.5vw, 3.75rem); line-height: 1; letter-spacing: -0.03em; font-weight: 400;">
          {tBe("indexH1First")}<br />
          <span style="font-style: italic;">{tBe("indexH1Italic")}</span>
        </h1>
        <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 600px;">
          {tBe("indexLede").replace("{count}", String(items.length))}
        </p>
      </div>
    </section>

    {/* Grid */}
    <section style="padding: 0 28px 80px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="mb-6">
          <input
            id="bestFilter"
            type="search"
            placeholder={tBe("indexFilterPlaceholder")}
            class="w-full"
            style="padding: 12px 16px; border: 1px solid var(--color-border); border-radius: 9999px; background: var(--color-paper); color: var(--color-ink); font-size: 14px;"
          />
        </div>
        <div id="bestGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <a
              href={localizedPath(locale, `/best/${item.slug}`)}
              class="paper group flex flex-col gap-3 p-6 hover:border-[var(--color-accent)] transition-colors best-card"
              style="border: 1px solid var(--color-border-soft);"
              data-haystack={`${item.name} ${item.country}`.toLowerCase()}
            >
              <div class="flex items-start justify-between gap-2">
                <span class="text-2xl">{item.flag}</span>
                <span class="mono text-[11px]" style="color: var(--color-ink-subtle);">
                  {tBe("indexHospitalCount").replace("{count}", String(item.count))}
                </span>
              </div>
              <div>
                <div class="serif font-medium" style="font-size: 18px; line-height: 1.25; letter-spacing: -0.01em;">
                  {item.name}
                </div>
                <div class="mono text-[12px] mt-1" style="color: var(--color-ink-muted);">
                  {item.country}
                </div>
              </div>
              <div class="mt-auto pt-2 flex items-center gap-1 text-[13px] font-medium" style="color: var(--color-accent);">
                {tBe("indexViewRanking")}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mirror-x">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
        <p id="bestEmpty" class="serif mt-8 text-center" style="display: none; color: var(--color-ink-muted);">
          {tBe("indexEmptyState")}
        </p>
      </div>
    </section>

    <script is:inline>
      (function () {
        const input = document.getElementById("bestFilter");
        const grid = document.getElementById("bestGrid");
        const empty = document.getElementById("bestEmpty");
        if (!input || !grid || !empty) return;
        const cards = Array.from(grid.querySelectorAll(".best-card"));
        input.addEventListener("input", () => {
          const q = String(input.value || "").trim().toLowerCase();
          let visible = 0;
          for (const card of cards) {
            const haystack = card.getAttribute("data-haystack") ?? "";
            const match = !q || haystack.includes(q);
            card.style.display = match ? "" : "none";
            if (match) visible++;
          }
          empty.style.display = visible === 0 ? "" : "none";
        });
      })();
    </script>

    <HowItWorks
      heading={tBe("methodologyHeading")}
      italicWord={tBe("methodologyItalicWord")}
      eyebrow={tBe("methodologyEyebrow")}
      steps={[
        { title: tBe("methodologyStep1Title"), description: tBe("methodologyStep1Desc") },
        { title: tBe("methodologyStep2Title"), description: tBe("methodologyStep2Desc") },
        { title: tBe("methodologyStep3Title"), description: tBe("methodologyStep3Desc") },
        { title: tBe("methodologyStep4Title"), description: tBe("methodologyStep4Desc") },
        { title: tBe("methodologyStep5Title"), description: tBe("methodologyStep5Desc") },
      ]}
      outroNote={tBe("methodologyOutro")}
    />

    <WhatToExpect
      heading={tBe("howToHeading")}
      italicWord={tBe("howToItalicWord")}
      items={[
        { label: tBe("howToStep1Label"), description: tBe("howToStep1Desc") },
        { label: tBe("howToStep2Label"), description: tBe("howToStep2Desc") },
        { label: tBe("howToStep3Label"), description: tBe("howToStep3Desc") },
        { label: tBe("howToStep4Label"), description: tBe("howToStep4Desc") },
      ]}
    />
    <ExploreGrid
      locale={locale}
      eyebrow={tBe("exploreEyebrow")}
      heading={tBe("exploreHeading")}
      lede={tBe("exploreLede")}
      items={[
        { eyebrow: tBe("exploreItem1Eyebrow"), label: tBe("exploreItem1Label"), href: "/hospitals", hint: tBe("exploreItem1Hint") },
        { eyebrow: tBe("exploreItem2Eyebrow"), label: tBe("exploreItem2Label"), href: "/compare/hospitals", hint: tBe("exploreItem2Hint") },
        { eyebrow: tBe("exploreItem3Eyebrow"), label: tBe("exploreItem3Label"), href: "/accreditation", hint: tBe("exploreItem3Hint") },
        { eyebrow: tBe("exploreItem4Eyebrow"), label: tBe("exploreItem4Label"), href: "/surgeons", hint: tBe("exploreItem4Hint") },
        { eyebrow: tBe("exploreItem5Eyebrow"), label: tBe("exploreItem5Label"), href: "/compare/countries", hint: tBe("exploreItem5Hint") },
        { eyebrow: tBe("exploreItem6Eyebrow"), label: tBe("exploreItem6Label"), href: "/pricing-index", hint: tBe("exploreItem6Hint") },
        { eyebrow: tBe("exploreItem7Eyebrow"), label: tBe("exploreItem7Label"), href: "/second-opinion", hint: tBe("exploreItem7Hint") },
        { eyebrow: tBe("exploreItem8Eyebrow"), label: tBe("exploreItem8Label"), href: "/quote", hint: tBe("exploreItem8Hint") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>