        <div
          class="mono"
          style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 12px;"
        >
          05 · {t("h.dest.eyebrow")}
        </div>
        <h2
          class="display display-tight"
          style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; letter-spacing: -0.02em; margin-bottom: 40px;"
        >
          {tHm("destTitle1")} <span style="font-style: italic;">{tHm("destTitle2")}</span>
        </h2>

        <ul class="grid gap-[14px]" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
          {destinations.map((c, i) => (
            <li>
              <a
                href={localizedPath(locale, `/country/${c.slug}`)}
                data-astro-prefetch="viewport"
                class="paper block relative h-full flex flex-col transition hover:-translate-y-0.5 group overflow-hidden"
                style="padding: 22px 22px 18px; box-shadow: var(--shadow-xs);"
              >
                {/* Soft tonal wash from the country's flag colour palette */}
                <div
                  aria-hidden="true"
                  style={`position: absolute; inset: 0; background: radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--color-accent) 8%, transparent) 0%, transparent 55%); pointer-events: none;`}
                />
                {i === 0 && (
                  <span
                    class="mono uppercase"
                    style="position: absolute; top: 14px; inset-inline-end: 14px; font-size: 9.5px; padding: 4px 9px; background: var(--color-coral); color: #FFF; border-radius: 9999px; font-weight: 600; letter-spacing: 0.12em; box-shadow: 0 4px 12px color-mix(in srgb, var(--color-coral) 32%, transparent);"
                  >{tHm("destTrending")}</span>
                )}
                <div class="relative" style="z-index: 1;">
                  <div style="font-size: 38px; line-height: 1; filter: drop-shadow(0 2px 6px rgba(14,23,19,0.08));">
                    {countryFlag(c.slug)}
                  </div>
                  <div class="serif group-hover:text-accent transition-colors" style="font-size: 20px; font-weight: 500; margin-top: 16px; letter-spacing: -0.005em;">
                    {c.name}
                  </div>
                  <div class="tnum mono" style="font-size: 11px; color: var(--color-ink-subtle); margin-top: 3px; letter-spacing: 0.04em;">
                    {c.hospitals.toLocaleString()} {tHm("hospitalsLabel")}
                  </div>
                  <div style="font-size: 12.5px; color: var(--color-ink-2); margin-top: 10px; line-height: 1.4;">
                    {DESTINATION_BLURB[c.slug] ?? ""}
                  </div>
                  <div
                    class="mono uppercase opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center gap-1"
                    style="margin-top: 14px; font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);"
                  >
                    {tHm("destExplore")}
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="mirror-x">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
