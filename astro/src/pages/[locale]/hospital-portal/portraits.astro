---
// Hospital portrait intake — token-gated multi-photo upload.
// One row per active doctor at the hospital. Each row accepts a single image
// file (or none — partial submissions are fine; the hospital comes back later).
//
// Flow:
//   1. Outreach email contains a 21-day signed URL: ...?token=eyJ...
//   2. Token carries { kind: "portrait_intake", slug } scoped to this hospital
//   3. Page POSTs multipart/form-data to /api/v1/portrait-upload
//   4. Server side: verifies token, validates files, uploads to R2,
//      writes doctors.image_url + image_credit, logs to portrait_intake_log
//
// noindex — this is operational, not editorial.
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import { db, sql as rawSql } from "@/lib/db";
import { isLocale, type Locale } from "@/lib/i18n";
import { verifyToken } from "@/lib/tokens";
import { isR2Configured } from "../../../../../src/lib/upload/r2";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospital-portal/portraits${Astro.url.search}`, 308);
const locale = rawLocale as Locale;

const token = Astro.url.searchParams.get("token");
const success = Astro.url.searchParams.get("ok");

type TokenPayload = { kind?: string; slug?: string; exp: number };
const payload = token ? verifyToken<TokenPayload>(token) : null;
const validToken = payload?.kind === "portrait_intake" && typeof payload?.slug === "string";

type DoctorRow = { id: number; name: string; slug: string; image_url: string | null };
type HospitalRow = { id: number; name: string; slug: string; city: string | null };

let hospital: HospitalRow | null = null;
let doctorRows: DoctorRow[] = [];

if (validToken) {
  const slug = payload!.slug as string;
  const hRes = (await rawSql<HospitalRow[]>`
    SELECT h.id, h.name, h.slug, c.name AS city
    FROM hospitals h
    LEFT JOIN cities c ON c.id = h.city_id
    WHERE h.slug = ${slug} AND h.is_active = TRUE
    LIMIT 1
  `.catch(() => [])) as HospitalRow[];
  hospital = hRes[0] ?? null;

  if (hospital) {
    doctorRows = (await rawSql<DoctorRow[]>`
      SELECT id, name, slug, image_url
      FROM doctors
      WHERE hospital_id = ${hospital.id} AND is_active = TRUE
      ORDER BY rating DESC NULLS LAST, name ASC
    `.catch(() => [])) as DoctorRow[];
  }
}

// Heuristic: image_url that is NULL, contains pravatar, or unsplash → fallback.
function isFallbackPortrait(url: string | null): boolean {
  if (!url) return true;
  return /pravatar\.cc|images\.unsplash\.com/.test(url);
}
const fallbackCount = doctorRows.filter((d) => isFallbackPortrait(d.image_url)).length;

// Token-gated, per-hospital content — never let a shared cache store it.
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout locale={locale} title="Portrait intake — Medcasts">
  <HeadMeta
    slot="head"
    title="Portrait intake"
    description="Hospital partner portal for surgeon portrait submission"
    locale={locale}
    path="/hospital-portal/portraits"
    noindex
  />

  <main class="mx-auto w-full max-w-[60rem] px-5 md:px-8" style="padding-top: 60px; padding-bottom: 80px;">
    {!validToken ? (
      <section class="paper" style="padding: 32px;">
        <span class="mono" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle); text-transform: uppercase;">
          Link expired or invalid
        </span>
        <h1 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em; line-height: 1.1;">
          We couldn't verify
          <span style="font-style: italic; color: var(--color-accent);"> your invite</span>
        </h1>
        <p class="mt-3" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
          The portrait intake link in your invitation has expired (21-day window) or
          was edited in transit. Reply to the original email and we'll send a fresh one.
        </p>
        <p class="mt-2" style="font-size: 13.5px; color: var(--color-ink-subtle);">
          Or reach medcastsdigital@gmail.com directly with photos attached.
        </p>
      </section>
    ) : !hospital ? (
      <section class="paper" style="padding: 32px;">
        <h1 class="display" style="font-size: 28px;">Hospital not found</h1>
        <p class="mt-3" style="font-size: 14.5px; color: var(--color-ink-muted);">
          The hospital referenced in this token (<code>{payload?.slug}</code>) isn't in our active directory.
          Contact medcastsdigital@gmail.com.
        </p>
      </section>
    ) : (
      <>
        <header>
          <span class="mono" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-accent); text-transform: uppercase;">
            Hospital portal · Portraits
          </span>
          <h1 class="display mt-3" style="font-size: clamp(30px, 4vw, 42px); letter-spacing: -0.02em; line-height: 1.05;">
            {hospital.name}
            <span style="font-style: italic; font-weight: 300; color: var(--color-accent);"> · surgeon photos</span>
          </h1>
          <p class="serif mt-3" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink-muted); max-width: 60ch;">
            Upload high-resolution headshots for the surgeons listed below. We'll
            replace stock portraits within 48 hours and add a "Portraits provided
            by {hospital.name}" credit on each profile.
          </p>
          <div class="grid mt-5" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px;">
            <div class="paper" style="padding: 12px 14px;">
              <div class="mono" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">Doctors</div>
              <div class="display tnum" style="font-size: 22px; margin-top: 2px;">{doctorRows.length}</div>
            </div>
            <div class="paper" style="padding: 12px 14px;">
              <div class="mono" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">On stock portrait</div>
              <div class="display tnum" style="font-size: 22px; margin-top: 2px; color: var(--color-coral, #E85A4F);">{fallbackCount}</div>
            </div>
            <div class="paper" style="padding: 12px 14px;">
              <div class="mono" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">Token expires</div>
              <div class="display tnum" style="font-size: 14px; margin-top: 6px;">{new Date(payload!.exp).toLocaleDateString(locale, { month: "short", day: "numeric", year: "numeric" })}</div>
            </div>
          </div>
        </header>

        {success === "1" && (
          <div
            class="paper mt-7"
            style="padding: 18px 22px; background: var(--color-accent-soft, #D9EDE8); border: 1px solid var(--color-accent, #0A5D54);"
          >
            <span class="mono" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">
              Received
            </span>
            <div class="serif mt-1" style="font-size: 15px;">
              Thanks — we've logged your submission. Editorial will apply photos within 48 hours.
            </div>
          </div>
        )}

        {!isR2Configured() && (
          <div
            class="paper mt-7"
            style="padding: 18px 22px; border: 1px solid var(--color-coral, #E85A4F);"
          >
            <span class="mono" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-coral, #E85A4F); text-transform: uppercase;">
              Intake disabled
            </span>
            <div class="serif mt-1" style="font-size: 14.5px; color: var(--color-ink-muted);">
              R2 storage isn't configured in this environment. Photos can't be accepted right now.
              Reply to the original email and we'll set up a direct upload link.
            </div>
          </div>
        )}

        <form
          action="/api/v1/portrait-upload"
          method="post"
          enctype="multipart/form-data"
          class="mt-7"
        >
          <input type="hidden" name="token" value={token} />

          <div style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
            {doctorRows.map((d) => {
              const usingFallback = isFallbackPortrait(d.image_url);
              return (
                <label
                  for={`portrait-${d.id}`}
                  style="display: grid; grid-template-columns: 56px 1fr auto; gap: 16px; padding: 14px 4px; align-items: center; border-bottom: 1px solid var(--color-border-soft); cursor: pointer;"
                >
                  <div
                    style={`width: 56px; height: 56px; border-radius: 9999px; background: var(--color-paper); border: 1px solid var(--color-border); overflow: hidden; ${d.image_url ? "" : "background-image: linear-gradient(135deg, #0A5D54, #073D37);"}`}
                  >
                    {d.image_url && (
                      <img
                        src={d.image_url}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="56"
                        height="56"
                        style="width: 100%; height: 100%; object-fit: cover;"
                      />
                    )}
                  </div>
                  <div style="min-width: 0;">
                    <div class="serif" style="font-size: 15px; font-weight: 500;">{d.name}</div>
                    <div class="mono" style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle); margin-top: 2px;">
                      {d.slug}
                      {usingFallback && (
                        <span style={`color: var(--color-coral, #E85A4F); margin-inline-start: 8px;`}>· stock portrait</span>
                      )}
                    </div>
                  </div>
                  <input
                    id={`portrait-${d.id}`}
                    type="file"
                    name={`doctor_${d.id}`}
                    accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
                    style="font-size: 12.5px; max-width: 240px;"
                  />
                </label>
              );
            })}
          </div>

          <div class="grid mt-7" style="grid-template-columns: 1fr 1fr; gap: 18px;">
            <label class="paper" style="padding: 16px 18px; cursor: pointer;">
              <span class="mono block" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">Submitter email (optional)</span>
              <input
                type="email"
                name="submitter_email"
                placeholder="marketing@hospital.org"
                class="mt-1 w-full bg-transparent outline-none"
                style="font-size: 14px; border: 0;"
              />
            </label>
            <label class="paper" style="padding: 16px 18px;">
              <span class="mono block" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">Photo credit (optional)</span>
              <input
                type="text"
                name="image_credit"
                placeholder={`Provided by ${hospital.name}`}
                class="mt-1 w-full bg-transparent outline-none"
                style="font-size: 14px; border: 0;"
              />
            </label>
          </div>

          <div class="mt-6" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
            <button
              type="submit"
              class="inline-flex items-center justify-center font-semibold"
              style="background: var(--color-accent); color: #FFF; border: 1px solid var(--color-accent); padding: 14px 26px; font-size: 15px; border-radius: 9999px;"
              disabled={!isR2Configured()}
            >
              Submit portraits
            </button>
            <p class="mono" style="font-size: 10.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">
              JPG · PNG · WEBP · HEIC · max 8 MB / file · square or 4:5 preferred
            </p>
          </div>

          <p style="margin-top: 22px; font-size: 12px; color: var(--color-ink-subtle); line-height: 1.5; max-width: 60ch;">
            By submitting, you confirm {hospital.name} has the right to share these photos
            for use in our directory. We'll credit your hospital and remove any portrait on request
            (24-hour SLA — email medcastsdigital@gmail.com).
          </p>
        </form>
      </>
    )}
  </main>
</BaseLayout>
