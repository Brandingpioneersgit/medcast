---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_NAME, SITE_URL } from "@/lib/seo";
import { Mail, Phone, MessageCircle, ChevronRight } from "lucide-react";
export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/contact`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tc2 = getTranslator(locale, "contactPage");

const path = "/contact";
const url = localeUrl(locale, path);

/**
 * Intent context — links from across the site land on /contact with
 * `?type=` or `?topic=`. Each intent rewrites the headline, subtitle,
 * and tags the inquiry so coordinators see the route the patient came in on.
 */
type IntentMeta = {
  eyebrow: string;
  headline: string;
  italic: string;
  subtitle: string;
  hideStep2?: boolean;
  defaultMessage?: string;
};
const INTENT_MAP: Record<string, IntentMeta> = {
  "second-opinion": {
    eyebrow: "Second opinion",
    headline: "Get a free",
    italic: "second opinion",
    subtitle: "Send your case + recent imaging. A panel-matched specialist replies within 48 hours — no obligation, no upsell. We've recommended against surgery in 28% of cases we've reviewed.",
  },
  partnership: {
    eyebrow: "For hospitals",
    headline: "Partner with",
    italic: "MedCasts",
    subtitle: "Apply to list your hospital, become a referral partner, or connect with our coordinator network. We respond to commercial inquiries within one business day.",
    hideStep2: true,
    defaultMessage: "Tell us about your hospital, the specialties you'd like to surface, and any volume targets we should know about.",
  },
  insurance: {
    eyebrow: "Insurance & coverage",
    headline: "Insurance",
    italic: "questions",
    subtitle: "We help patients navigate international coverage — pre-auth, claim documentation, escrow, and direct-billing arrangements with destination hospitals. Tell us your insurer + plan and we'll point you the right way.",
  },
  referral: {
    eyebrow: "Refer a patient",
    headline: "Refer a",
    italic: "patient",
    subtitle: "Refer a friend, family member or patient — we'll coordinate the care end-to-end and credit your account. Use the form below or jump to our dedicated referral flow.",
  },
  visa: {
    eyebrow: "Medical visa",
    headline: "Visa & travel",
    italic: "coordination",
    subtitle: "Tell us your destination, treatment, and travel window — we'll send the medical-visa checklist, embassy timing notes, and our case-manager intro by email within hours.",
  },
  travel: {
    eyebrow: "Travel logistics",
    headline: "Travel",
    italic: "support",
    subtitle: "Flights, airport pickup, attendant accommodation, and post-discharge stays — give us your trip details and we'll line everything up around your medical appointments.",
  },
  "portal-help": {
    eyebrow: "Patient portal",
    headline: "Portal access",
    italic: "help",
    subtitle: "Trouble accessing your case timeline? Send us your tracking code and we'll get you in within minutes.",
  },
  "code-recovery": {
    eyebrow: "Lost tracking code",
    headline: "Recover your",
    italic: "tracking code",
    subtitle: "Lost the 6-character code from your inquiry confirmation email? Tell us the email address you used and we'll look it up.",
  },
  explain: {
    eyebrow: "Glossary help",
    headline: "Help understanding",
    italic: "a term",
    subtitle: "Picked up an unfamiliar term in your discharge note or quote? Send it over with whatever context you have and a clinician on the desk will explain in plain language.",
  },
  "specialist-match": {
    eyebrow: "Specialist match",
    headline: "Match me to a",
    italic: "specialist",
    subtitle: "Tell us your case + preferences and we'll come back with 2–3 matched physicians (with case volumes and language fits) within a few hours during business hours.",
  },
};

const reqUrl = new URL(Astro.request.url);
const intentTypeParam = reqUrl.searchParams.get("type") ?? "";
const intentTopicParam = reqUrl.searchParams.get("topic") ?? "";
const intentKey = intentTypeParam || intentTopicParam;
const intent = intentKey && INTENT_MAP[intentKey] ? INTENT_MAP[intentKey] : null;
const sentSuccess = reqUrl.searchParams.get("sent") === "1";
const sentIntent = reqUrl.searchParams.get("intent") ?? "";
const sentLabel =
  sentIntent && INTENT_MAP[sentIntent] ? INTENT_MAP[sentIntent].eyebrow.toLowerCase() : "inquiry";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc2("breadcrumbContact"), url },
]);

// ContactPage schema — primary contact surface; mirrors the Org-level
// contactPoint catalog (also in BaseLayout) so Google can resolve "contact
// medcasts" intent directly to this page.
const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: tc2("seoTitle"),
  description: tc2("seoDescription"),
  url,
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "care@medcasts.com",
        telephone: "+918006210000",
        availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"],
      },
      {
        "@type": "ContactPoint",
        contactType: "emergency",
        telephone: "+918006210000",
        availableLanguage: ["en", "ar", "hi"],
        hoursAvailable: "24/7",
      },
    ],
  },
};

// Pre-fill values from query string — passed from various CTAs across the site.
const prefillTreatment = reqUrl.searchParams.get("treatment") ?? "";
const prefillSpecialty = reqUrl.searchParams.get("specialty") ?? "";
const prefillCity = reqUrl.searchParams.get("city") ?? "";
const prefillCountry = reqUrl.searchParams.get("country") ?? "";
const prefillHospital = reqUrl.searchParams.get("hospital") ?? "";
const prefillCondition = reqUrl.searchParams.get("condition") ?? "";
const prefillDoctor = reqUrl.searchParams.get("doctor") ?? "";
const prefillCode = reqUrl.searchParams.get("code") ?? "";

const prefillContext =
  prefillTreatment ||
  prefillSpecialty ||
  prefillHospital ||
  prefillDoctor ||
  prefillCondition ||
  prefillCity ||
  prefillCountry;

const STEPS = [
  { n: "01", t: tc2("step01Title"), d: tc2("step01Desc") },
  { n: "02", t: tc2("step02Title"), d: tc2("step02Desc") },
  { n: "03", t: tc2("step03Title"), d: tc2("step03Desc") },
  { n: "04", t: tc2("step04Title"), d: tc2("step04Desc") },
];

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tc2("seoTitle")}
      description={tc2("seoDescription")}
      path={path}
      locale={locale}
      noindex={locale !== "en"}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tc2("breadcrumbContact")}</span>
        </nav>
      </div>
    </div>

    <section class="pt-12 md:pt-16">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">
        <p class="mono uppercase flex items-center gap-2" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
          <span class="inline-block w-1.5 h-1.5 rounded-full live-dot" style="background: var(--color-accent);" aria-hidden="true" />
          {intent ? intent.eyebrow : tc2("coordinatorsOnline")}
        </p>

        {sentSuccess && (
          <div class="mt-4 paper" style="padding: 16px 22px; border-color: var(--color-accent); display: flex; gap: 14px; align-items: flex-start;">
            <span class="serif" style="color: var(--color-accent); font-size: 22px; line-height: 1;" aria-hidden="true">✓</span>
            <div>
              <div class="serif" style="font-size: 17px; color: var(--color-ink);">
                Thanks — your {sentLabel} is in.
              </div>
              <p class="mt-1.5 serif" style="font-size: 14px; color: var(--color-ink-muted);">
                A coordinator will reach out within {intent ? "the next few hours" : "9 minutes during business hours"}. Check your email for confirmation.
              </p>
            </div>
          </div>
        )}

        <div class="grid gap-10 lg:grid-cols-[1.35fr,1fr] lg:gap-14 mt-3">
          <div>
            <h1
              class="display display-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {intent ? (
                <Fragment set:html={`${intent.headline} <span class="italic-display">${intent.italic}</span>`} />
              ) : (
                <Fragment set:html={tc2("headline").replace(tc2("headlineAccent"), `<span class="italic-display">${tc2("headlineAccent")}</span>`)} />
              )}
            </h1>
            <p class="serif mt-5 max-w-[44rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">
              {intent ? intent.subtitle : tc2("subtitle")}
            </p>

            <form
              action="/api/v1/inquiry"
              method="POST"
              class="paper mt-8"
              style="padding: 28px 28px 26px;"
              novalidate
              data-contact-form
            >
              {(prefillContext || intent) && (
                <div class="mb-5 mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent); padding: 10px 14px; border: 1px dashed var(--color-accent); border-radius: 9999px; display: inline-flex; align-items: center; gap: 8px;">
                  {intent ? intent.eyebrow : tc2("preFilledFor")}&nbsp;
                  <span style="color: var(--color-ink);">
                    {prefillHospital || prefillDoctor || prefillTreatment || prefillSpecialty || prefillCondition || prefillCity || prefillCountry || intent?.italic}
                  </span>
                </div>
              )}

              {intentTypeParam && <input type="hidden" name="type" value={intentTypeParam} />}
              {intentTopicParam && <input type="hidden" name="topic" value={intentTopicParam} />}
              {prefillCode && <input type="hidden" name="code" value={prefillCode} />}

              <input type="hidden" name="ref" id="referral-code-input" />

              {/* Step 1 of 2 — minimal first contact */}
              <div class="mb-6 flex items-center gap-2">
                <div class="flex items-center justify-center w-6 h-6 rounded-full" style="background: var(--color-accent); color: var(--color-bg);">
                  <span class="mono" style="font-size: 11px;">1</span>
                </div>
                <span class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tc2("step1")}</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="name">{tc2("fullName")}</label>
                  <input
                    type="text" id="name" name="name" required autocomplete="name"
                    class="w-full serif focus:outline-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink);"
                    data-validate
                  />
                  <p data-error-for="name" hidden class="mono mt-1" style="font-size: 10px; color: var(--color-danger); letter-spacing: 0.06em;">
                    {tc2("pleaseEnterName")}
                  </p>
                </div>
                <div>
                  <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="email">{tc2("email")}</label>
                  <input
                    type="email" id="email" name="email" required autocomplete="email"
                    class="w-full serif focus:outline-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink);"
                    data-validate
                  />
                  <p data-error-for="email" hidden class="mono mt-1" style="font-size: 10px; color: var(--color-danger); letter-spacing: 0.06em;">
                    {tc2("enterValidEmail")}
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                <div>
                  <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="phone">{tc2("phoneWhatsapp")}</label>
                  <input
                    type="tel" id="phone" name="phone"
                    class="w-full serif focus:outline-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink);"
                  />
                </div>
                <div>
                  <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="countryCode">{tc2("yourCountry")}</label>
                  <input
                    type="text" id="countryCode" name="countryCode"
                    class="w-full serif focus:outline-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink);"
                  />
                </div>
              </div>

              {prefillSpecialty && <input type="hidden" name="specialty" value={prefillSpecialty} />}
              {prefillCity && <input type="hidden" name="city" value={prefillCity} />}
              {prefillCountry && <input type="hidden" name="country" value={prefillCountry} />}
              {prefillHospital && <input type="hidden" name="hospital" value={prefillHospital} />}
              {prefillCondition && <input type="hidden" name="condition" value={prefillCondition} />}
              {prefillDoctor && <input type="hidden" name="doctor" value={prefillDoctor} />}

              {/* Step 2 — visible but visually softer (optional, not collapsed) */}
              {!intent?.hideStep2 && (
              <div class="mt-8 pt-6" style="border-top: 1px dashed var(--color-border);" data-step2>
                <div class="flex items-center gap-2 mb-5">
                  <div class="flex items-center justify-center w-6 h-6 rounded-full" style="border: 1px solid var(--color-border); color: var(--color-ink-muted);">
                    <span class="mono" style="font-size: 11px;">2</span>
                  </div>
                  <span class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tc2("step2Summary")}</span>
                  <span class="mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--color-ink-subtle); text-transform: none; font-style: italic;">— optional, helps us match faster</span>
                </div>
                <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="treatment">{tc2("treatmentNeeded")}</label>
                <input
                  type="text" id="treatment" name="treatment"
                  value={prefillTreatment}
                  placeholder={tc2("treatmentPlaceholder")}
                  class="w-full serif focus:outline-none"
                  style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink);"
                />
                <label class="mono uppercase block mt-4 mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="message">{tc2("caseSummary")}</label>
                <textarea
                  id="message" name="message" rows="3"
                  placeholder={intent?.defaultMessage ?? tc2("caseSummaryPlaceholder")}
                  class="w-full serif focus:outline-none"
                  style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink); font-family: inherit;"
                ></textarea>
              </div>
              )}

              {/* For partnership / commercial intents, render a single message field instead of Step 2 prefab */}
              {intent?.hideStep2 && (
                <div class="mt-8">
                  <label class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);" for="message">
                    Tell us more
                  </label>
                  <textarea
                    id="message" name="message" rows="4"
                    placeholder={intent.defaultMessage}
                    class="w-full serif focus:outline-none"
                    style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 10px; font-size: 15px; color: var(--color-ink); font-family: inherit;"
                  ></textarea>
                </div>
              )}

              <div class="mt-7 flex flex-wrap items-center gap-4">
                <button
                  type="submit"
                  data-submit-btn
                  data-i18n-sending={tc2("sending")}
                  class="inline-flex items-center gap-2 font-semibold"
                  style="background: var(--color-ink); color: var(--color-bg); padding: 13px 24px; border-radius: 9999px; font-size: 14px;"
                >
                  {tc2("submitBtn")}
                  <ChevronRight className="h-4 w-4 mirror-x" />
                </button>
                <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tc2("noMarketingNote")}
                </p>
              </div>
            </form>
          </div>

          <aside class="lg:sticky lg:top-32 lg:self-start space-y-4">
            {/* What happens next */}
            <div class="paper" style="padding: 24px 26px;">
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tc2("whatHappensNext")}
              </div>
              <ol class="mt-5 space-y-5">
                {STEPS.map((s) => (
                  <li class="grid gap-3" style="grid-template-columns: 40px 1fr;">
                    <div class="display tnum" style="font-size: 22px; line-height: 1; color: var(--color-accent); letter-spacing: -0.02em;">
                      {s.n}
                    </div>
                    <div>
                      <div class="serif" style="font-size: 16px; line-height: 1.3; color: var(--color-ink);">
                        {s.t}
                      </div>
                      <p class="mt-1.5 serif" style="font-size: 13.5px; line-height: 1.5; color: var(--color-ink-muted);">
                        {s.d}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>

            {/* Direct channels */}
            <div class="paper" style="padding: 24px 26px;">
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tc2("skipForm")}
              </div>
              <ul class="mt-4 space-y-3.5">
                <li class="flex items-start gap-3">
                  <MessageCircle className="h-4 w-4 mt-1 shrink-0" style={{color: "var(--color-accent)"}} />
                  <div>
                    <div class="serif" style="font-size: 15px; color: var(--color-ink);">{tc2("whatsappFastest")}</div>
                    <a href="https://wa.me/918006210000" class="mono uppercase" style="font-size: 11px; letter-spacing: 0.1em; color: var(--color-ink-muted);">+91 800 621 000 →</a>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <Mail className="h-4 w-4 mt-1 shrink-0" style={{color: "var(--color-accent)"}} />
                  <div>
                    <div class="serif" style="font-size: 15px; color: var(--color-ink);">{tc2("emailLabel")}</div>
                    <a href="mailto:care@medcasts.com" class="mono uppercase" style="font-size: 11px; letter-spacing: 0.1em; color: var(--color-ink-muted);">care@medcasts.com →</a>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <Phone className="h-4 w-4 mt-1 shrink-0" style={{color: "var(--color-accent)"}} />
                  <div>
                    <div class="serif" style="font-size: 15px; color: var(--color-ink);">{tc2("phoneLabel")}</div>
                    <a href="tel:+918006210000" class="mono uppercase" style="font-size: 11px; letter-spacing: 0.1em; color: var(--color-ink-muted);">+91 800 621 000 →</a>
                  </div>
                </li>
              </ul>
              <div class="mt-5 pt-4 mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); border-top: 1px dashed var(--color-border);">
                {tc2("hoursNote")}
              </div>
            </div>

            {/* Emergency nudge */}
            <a
              href={localizedPath(locale, "/emergency")}
              class="group flex items-center justify-between gap-4"
              style="background: var(--color-coral); color: var(--color-bg); padding: 18px 22px; border-radius: var(--radius-lg);"
            >
              <div>
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; opacity: 0.8;">
                  {tc2("medicalEmergency")}
                </div>
                <div class="serif mt-1" style="font-size: 17px; line-height: 1.3;">
                  {tc2("airAmbulance")}
                </div>
              </div>
              <ChevronRight className="h-5 w-5 mirror-x shrink-0" />
            </a>

            {/* Referral CTA */}
            <div class="paper" style="padding: 24px 26px;" id="referral-cta">
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tc2("referFriend")}
              </div>
              <p class="serif mt-3" style="font-size: 14px; line-height: 1.5; color: var(--color-ink-muted);">
                {tc2("referFriendDesc")}
                <strong style="color: var(--color-accent);">{tc2("perReferral")}</strong>
              </p>
              <div class="mt-4" id="referral-form-area">
                <div id="referral-logged-in" class="hidden">
                  <div class="flex items-center gap-3 flex-wrap">
                    <code class="mono" style="font-size: 16px; padding: 6px 12px; border: 1px dashed var(--color-border); border-radius: 8px; color: var(--color-ink); letter-spacing: 0.06em;" id="referral-code-display"></code>
                    <button type="button" id="copy-referral-btn"
                      data-i18n-copied={tc2("copied")}
                      data-i18n-copy={tc2("copy")}
                      class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent); padding: 6px 12px; border: 1px solid var(--color-accent); border-radius: 9999px; cursor: pointer;">
                      {tc2("copy")}
                    </button>
                  </div>
                  <p class="mono mt-3" style="font-size: 10px; color: var(--color-ink-subtle);">
                    {tc2("shareVia")}
                    <a id="share-whatsapp" href="#" target="_blank" rel="noopener" class="underline ml-1" data-share-text={tc("medcasts")}>WhatsApp</a> ·
                    <a id="share-email" href="#" target="_blank" rel="noopener" class="underline" data-share-text={tc("medcasts")}>{tc2("emailLabel")}</a>
                  </p>
                </div>
                <div id="referral-signup">
                  <div class="flex gap-2 flex-wrap">
                    <input
                      type="email"
                      id="referral-email"
                      placeholder={tc2("yourEmail")}
                      class="w-full serif"
                      style="background: var(--color-bg); border: 1px solid var(--color-border); padding: 10px 14px; border-radius: 10px; font-size: 14px; color: var(--color-ink);"
                    />
                    <button
                      type="button"
                      id="referral-generate-btn"
                      data-i18n-sending={tc2("sending")}
                      data-i18n-default={tc2("getReferralLinkDefault")}
                      data-i18n-email-first={tc2("enterEmailFirst")}
                      data-i18n-failed={tc2("failedGenerate")}
                      data-i18n-network={tc2("networkError")}
                      class="inline-flex items-center gap-2 mono uppercase"
                      style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent); padding: 10px 16px; border: 1px solid var(--color-accent); border-radius: 9999px; cursor: pointer; white-space: nowrap;"
                    >
                      {tc2("getReferralLinkDefault")}
                    </button>
                  </div>
                  <p id="referral-error" class="mono mt-2 hidden" style="font-size: 10px; color: var(--color-danger);"></p>
                  <p class="mono mt-2" style="font-size: 10px; color: var(--color-ink-subtle);">{tc2("creditedNote")}</p>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section style="padding: 96px 0 88px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-6 md:grid-cols-4" style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);">
          {[
            { l: tc2("trustCoordinators"), v: tc2("trustCoordinatorsVal") },
            { l: tc2("trustMedianReply"), v: tc2("trustMedianReplyVal") },
            { l: tc2("trustLanguages"), v: tc2("trustLanguagesVal") },
            { l: tc2("trustNoFee"), v: tc2("trustNoFeeVal") },
          ].map((s, i) => (
            <div
              class="px-5 py-6"
              style={i > 0 ? {borderInlineStart: "1px solid var(--color-border)"} : {}}
            >
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                {s.l}
              </div>
              <div class="display tnum mt-1.5" style="font-size: 26px;">{s.v}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SiteFooter locale={locale} />

    <div data-trust-bar class="paper fixed bottom-0 left-0 right-0 z-30 hidden" style="margin: 0; padding: 14px 24px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: none; box-shadow: var(--shadow-lg); background: var(--color-paper);" aria-live="polite">
      <div class="mx-auto max-w-[1440px] flex items-center justify-between gap-6 flex-wrap">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
          <span class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tc2("trustSignalsHere")} <a href={localizedPath(locale, "/accreditation")} class="hover:text-accent">JCI · ISO · GDPR</a>
          </span>
        </div>
        <div class="flex items-center gap-4">
          {["JCI Partner", "ISO 27001", "GDPR", "HIPAA"].map(badge => (
            <span class="mono" style="font-size: 10px; padding: 4px 10px; border: 1px solid var(--color-border); border-radius: 9999px; color: var(--color-ink-subtle); letter-spacing: 0.08em;">{badge}</span>
          ))}
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        // Auto-populate referral code from URL ?ref= param
        const params = new URLSearchParams(window.location.search);
        const refCode = params.get('ref');
        if (refCode) {
          const input = document.getElementById('referral-code-input');
          if (input) input.value = refCode;
        }

        const form = document.querySelector('[data-contact-form]');
        if (!form) return;
        const submitBtn = form.querySelector('[data-submit-btn]');
        const trustBar = document.querySelector('[data-trust-bar]');
        const validatedFields = form.querySelectorAll('[data-validate]');

        function showError(input) {
          const err = form.querySelector(`[data-error-for="${input.id}"]`);
          if (err) err.removeAttribute('hidden');
          input.style.borderColor = 'var(--color-danger)';
        }
        function clearError(input) {
          const err = form.querySelector(`[data-error-for="${input.id}"]`);
          if (err) err.setAttribute('hidden', '');
          input.style.borderColor = 'var(--color-border)';
        }

        validatedFields.forEach(f => f.addEventListener('input', () => clearError(f)));

        // Show trust bar when user focuses an input
        form.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('focus', () => {
            if (trustBar) trustBar.classList.remove('hidden');
          }, { once: true });
        });

        form.addEventListener('submit', (e) => {
          let valid = true;
          validatedFields.forEach(f => {
            if (!f.value.trim()) { showError(f); valid = false; }
            if (f.type === 'email' && f.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value)) {
              showError(f); valid = false;
            }
          });
          if (!valid) { e.preventDefault(); return; }
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = submitBtn.dataset.i18nSending || 'Sending…';
          }
          if (typeof window !== 'undefined' && window.dataLayer) {
            window.dataLayer.push({ event: 'quote_request_submit', value: 1 });
          }
        });

        let formStarted = false;
        form.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('focus', () => {
            if (!formStarted) {
              formStarted = true;
              if (typeof window !== 'undefined' && window.dataLayer) {
                window.dataLayer.push({ event: 'quote_form_start', value: 1 });
              }
            }
          }, { once: true });
        });

        const step2 = form.querySelector('[data-step2]');
        if (step2) {
          step2.addEventListener('toggle', () => {
            if (step2.hasAttribute('open') && window.dataLayer) {
              window.dataLayer.push({ event: 'quote_form_step2_open', value: 1 });
            }
          });
        }

        // Referral section
        const referralEmailInput = document.getElementById('referral-email');
        const referralGenerateBtn = document.getElementById('referral-generate-btn');
        const referralError = document.getElementById('referral-error');
        const referralLoggedIn = document.getElementById('referral-logged-in');
        const referralSignup = document.getElementById('referral-signup');
        const referralCodeDisplay = document.getElementById('referral-code-display');
        const copyBtn = document.getElementById('copy-referral-btn');

        function showReferralCode(code) {
          if (referralLoggedIn) referralLoggedIn.classList.remove('hidden');
          if (referralSignup) referralSignup.classList.add('hidden');
          if (referralCodeDisplay) referralCodeDisplay.textContent = code;
          const shareBase = window.location.origin + '/' + (document.documentElement.lang || 'en') + '/contact?ref=' + encodeURIComponent(code);
          const whatsappLink = document.getElementById('share-whatsapp');
          const shareText = (whatsappLink && whatsappLink.dataset.shareText) ? whatsappLink.dataset.shareText : 'MedCasts';
          if (whatsappLink) whatsappLink.href = 'https://wa.me/?text=' + encodeURIComponent('Check out ' + shareText + ': ' + shareBase);
          const emailLink = document.getElementById('share-email');
          const emailText = (emailLink && emailLink.dataset.shareText) ? emailLink.dataset.shareText : 'MedCasts';
          if (emailLink) emailLink.href = 'mailto:?subject=' + encodeURIComponent(emailText + ' — Medical Travel Support') + '&body=' + encodeURIComponent('I use ' + emailText + ': ' + shareBase);
        }

        // Check for existing referral code in localStorage
        const stored = localStorage.getItem('mc_ref_code');
        if (stored) showReferralCode(stored);

        if (referralGenerateBtn) {
          referralGenerateBtn.addEventListener('click', async () => {
            const email = referralEmailInput?.value?.trim() || '';
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              if (referralError) { referralError.textContent = referralGenerateBtn.dataset.i18nEmailFirst || 'Enter a valid email first'; referralError.classList.remove('hidden'); }
              return;
            }
            if (referralError) referralError.classList.add('hidden');
            referralGenerateBtn.textContent = referralGenerateBtn.dataset.i18nSending || '...';
            referralGenerateBtn.disabled = true;
            try {
              const res = await fetch('/api/v1/referral', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: 'Friend', email }),
              });
              const data = await res.json();
              if (data.code) {
                localStorage.setItem('mc_ref_code', data.code);
                showReferralCode(data.code);
              } else {
                if (referralError) { referralError.textContent = referralGenerateBtn.dataset.i18nFailed || 'Failed to generate code. Try again.'; referralError.classList.remove('hidden'); }
              }
            } catch {
              if (referralError) { referralError.textContent = referralGenerateBtn.dataset.i18nNetwork || 'Network error. Try again.'; referralError.classList.remove('hidden'); }
            } finally {
              referralGenerateBtn.textContent = referralGenerateBtn.dataset.i18nDefault || 'Get referral link';
              referralGenerateBtn.disabled = false;
            }
          });
        }

        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            const code = referralCodeDisplay?.textContent || '';
            const shareUrl = window.location.origin + '/' + (document.documentElement.lang || 'en') + '/contact?ref=' + encodeURIComponent(code);
            navigator.clipboard.writeText(shareUrl).then(() => {
              copyBtn.textContent = copyBtn.dataset.i18nCopied || 'Copied!';
              setTimeout(() => { if (copyBtn) copyBtn.textContent = copyBtn.dataset.i18nCopy || 'Copy'; }, 2000);
            });
          });
        }
      })();
    </script>
  </main>
</BaseLayout>
