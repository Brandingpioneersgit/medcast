---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PageCta from "@/components/PageCta.astro";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/cities", 308);
const locale = rawLocale as Locale;

// Cities with ≥3 active hospitals — the meaningful medical hubs. Thin cities
// are excluded so this stays a useful crawl index, not a noise dump.
type CityRow = { countrySlug: string; countryName: string; slug: string; name: string; n: number };
let rows: CityRow[] = [];
try {
  rows = Array.from(
    await db.execute<CityRow>(sql`
      SELECT co.slug AS "countrySlug", co.name AS "countryName",
             ci.slug, ci.name, COUNT(h.id)::int AS n
      FROM cities ci
      INNER JOIN countries co ON co.id = ci.country_id AND co.is_destination = true
      INNER JOIN hospitals h ON h.city_id = ci.id AND h.is_active = true
      WHERE ci.slug <> 'unknown'
      GROUP BY co.slug, co.name, ci.slug, ci.name
      HAVING COUNT(h.id) >= 3
      ORDER BY co.name, n DESC, ci.name
    `),
  );
} catch {
  rows = [];
}

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};

// Group by country; cap each at 60 hubs with a "+N more" link to the country page.
const PER_COUNTRY_CAP = 60;
type Group = { countrySlug: string; countryName: string; cities: CityRow[]; total: number };
const groupMap = new Map<string, Group>();
for (const r of rows) {
  let g = groupMap.get(r.countrySlug);
  if (!g) {
    g = { countrySlug: r.countrySlug, countryName: r.countryName, cities: [], total: 0 };
    groupMap.set(r.countrySlug, g);
  }
  g.total += 1;
  if (g.cities.length < PER_COUNTRY_CAP) g.cities.push(r);
}
const groups = Array.from(groupMap.values()).sort((a, b) => b.total - a.total);

const totalCities = rows.length;
const tc = getTranslator(locale, "common");
const seoTitle = `Cities for Medical Travel — Hospital Directory by City`;
const seoDescription = `Browse ${totalCities.toLocaleString()} cities across ${groups.length} destination countries, each with accredited hospitals for international patients. Find hospitals, doctors and pricing by city.`;
const path = "/cities";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Cities", url: localeUrl(locale, path) },
]);
const collectionLd = collectionPageJsonLd({
  name: "Medical travel cities",
  description: seoDescription,
  url: localeUrl(locale, path),
  items: rows.slice(0, 100).map((r) => ({ name: r.name, url: localeUrl(locale, `/city/${r.slug}`) })),
});

const stats = [
  { l: "Cities", v: totalCities.toLocaleString() },
  { l: "Countries", v: groups.length.toString() },
  { l: "Hospitals", v: rows.reduce((s, r) => s + r.n, 0).toLocaleString() },
];

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">Cities</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={`${totalCities.toLocaleString()} medical-travel cities`}
      h1First="Hospitals by"
      h1Italic="city"
      lede={seoDescription}
      stats={stats}
    />

    <section style="padding: 32px 0 88px;">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 space-y-12">
        {groups.map((g) => (
          <div>
            <div class="flex items-baseline justify-between border-b border-border-soft pb-3">
              <h2 class="display-tight" style="font-size: clamp(1.35rem, 2.6vw, 1.9rem); letter-spacing: -0.02em;">
                <span aria-hidden="true" class="me-2">{FLAG_MAP[g.countrySlug] ?? "🌐"}</span>
                {g.countryName}
              </h2>
              <a
                href={localizedPath(locale, `/country/${g.countrySlug}`)}
                class="mono text-[11px] uppercase tracking-wider hover:text-accent"
                style="color: var(--color-ink-subtle);"
              >
                {g.countryName} hub <ChevronRight className="inline h-3 w-3 mirror-x" />
              </a>
            </div>
            <ul class="mt-4 grid grid-cols-2 gap-x-5 gap-y-1.5 sm:grid-cols-3 lg:grid-cols-4">
              {g.cities.map((c) => (
                <li>
                  <a
                    href={localizedPath(locale, `/city/${c.slug}`)}
                    class="group flex items-baseline justify-between gap-2 py-1 text-[14px] hover:text-accent"
                  >
                    <span class="truncate">{c.name}</span>
                    <span class="tnum shrink-0 text-[12px]" style="color: var(--color-ink-subtle);">{c.n.toLocaleString()}</span>
                  </a>
                </li>
              ))}
            </ul>
            {g.total > g.cities.length && (
              <p class="mt-3 text-[13px]" style="color: var(--color-ink-muted);">
                + {(g.total - g.cities.length).toLocaleString()} more cities —{" "}
                <a href={localizedPath(locale, `/country/${g.countrySlug}`)} class="underline hover:text-accent">
                  see all of {g.countryName}
                </a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
