---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import AccreditationLogo from "@/components/AccreditationLogo.astro";
import { db, sql as rawSql } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { hospitalCover } from "@/lib/images";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Price from "@/components/Price.astro";
import { ChevronRight } from "lucide-react";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const code = Astro.params.code;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/accreditation/${code}`, 308);
if (!code) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tAcc = getTranslator(locale, "accreditationCodePage");

type AccredRow = {
  id: number;
  slug: string;
  name: string;
  acronym: string | null;
  description: string | null;
  website: string | null;
};
const accRes = await db
  .execute(sql`SELECT id, slug, name, acronym, description, website FROM accreditations WHERE slug = ${code}`)
  .catch(() => [] as unknown[]);
const acc = Array.from(accRes as Iterable<AccredRow>)[0] ?? null;
if (!acc) return new Response(`Not found: ${code}`, { status: 404 });

// Pull deep accreditation sections
const accSectionRow = await rawSql`SELECT content_sections FROM accreditations WHERE id = ${acc.id} LIMIT 1`;
const accSections: any = accSectionRow[0]?.content_sections ?? null;

type HospitalRow = {
  id: number;
  slug: string;
  name: string;
  coverImageUrl: string | null;
  rating: string | null;
  reviewCount: number | null;
  bedCapacity: number | null;
  cityName: string | null;
  countryName: string | null;
  countrySlug: string | null;
  accrCount: number;
  fromUsd: number | null;
};
const hospitals = Array.from(
  (await db.execute(sql`
    SELECT h.id, h.slug, h.name, h.cover_image_url as "coverImageUrl",
      h.rating, h.review_count as "reviewCount", h.bed_capacity as "bedCapacity",
      ci.name as "cityName", co.name as "countryName", co.slug as "countrySlug",
      (SELECT COUNT(*)::int FROM hospital_accreditations WHERE hospital_id = h.id) as "accrCount",
      (SELECT MIN(cost_min_usd)::int FROM hospital_treatments WHERE hospital_id = h.id) as "fromUsd"
    FROM hospitals h
    INNER JOIN hospital_accreditations ha ON ha.hospital_id = h.id AND ha.accreditation_id = ${acc.id}
    INNER JOIN cities ci ON ci.id = h.city_id
    INNER JOIN countries co ON co.id = ci.country_id
    WHERE h.is_active = true
    ORDER BY h.is_featured DESC NULLS LAST, h.rating DESC NULLS LAST, h.review_count DESC NULLS LAST
    LIMIT 60
  `)) as Iterable<HospitalRow>,
);

type CountrySplit = { country_slug: string; country_name: string; n: number };
const byCountry = Array.from(
  (await db.execute(sql`
    SELECT co.slug as country_slug, co.name as country_name, COUNT(DISTINCT h.id)::int AS n
    FROM hospital_accreditations ha
    INNER JOIN hospitals h ON h.id = ha.hospital_id AND h.is_active = true
    INNER JOIN cities ci ON ci.id = h.city_id
    INNER JOIN countries co ON co.id = ci.country_id
    WHERE ha.accreditation_id = ${acc.id}
    GROUP BY co.slug, co.name
    ORDER BY n DESC
  `)) as Iterable<CountrySplit>,
);

const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};

const label = acc.acronym ?? acc.name;
const seoTitle = tAcc("seoTitle").replace("{label}", label).replace("{count}", String(hospitals.length));
const seoDescription = acc.description
  ? `${acc.description} ${tAcc("seoDescriptionWith").replace("{count}", String(hospitals.length)).replace("{label}", label).replace("{countries}", String(byCountry.length))}`
  : tAcc("seoDescriptionWithout").replace("{count}", String(hospitals.length)).replace("{label}", label).replace("{countries}", String(byCountry.length));

const path = `/accreditation/${code}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tAcc("breadcrumbAccreditations"), url: localeUrl(locale, "/accreditation") },
  { name: label, url },
]);

const itemLd = hospitals.length > 0
  ? itemListJsonLd(hospitals.slice(0, 20).map((h) => ({
      name: h.name,
      url: localeUrl(locale, `/hospital/${h.slug}`),
    })))
  : null;

// Certifying body as Organization — surfaces the accrediting authority
// (JCI, NABH, etc.) as a real entity Google can resolve, separate from
// the hospitals it accredits. Helpful for "what is JCI" type queries.
const accreditationOrgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: acc.name,
  ...(acc.acronym ? { alternateName: acc.acronym } : {}),
  ...(acc.description ? { description: acc.description } : {}),
  ...(acc.website ? { url: acc.website, sameAs: [acc.website] } : {}),
};

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={hospitals.length === 0} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(accreditationOrgLd)} />
    {itemLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />}
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <a href={localizedPath(locale, "/accreditation")} class="hover:text-ink">{tAcc("breadcrumbAccreditations")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">{label}</span>
      </nav>
    </div>

    <section style="padding: 48px 28px;">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-10 lg:grid-cols-[2fr_1fr]">
          <div>
            <div class="flex items-center gap-3" style="margin-bottom: 4px;">
              <AccreditationLogo code={acc.acronym ?? acc.slug} title={acc.name} size="lg" showText={false} />
              <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
                {tAcc("certifyingBody")}
              </div>
            </div>
            <h1
              class="display display-tight mt-3"
              style="font-size: clamp(2.5rem, 5.5vw, 4rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;"
            >
              {label}
              {acc.acronym && acc.name !== acc.acronym && (
                <span style="font-style: italic; display: block; font-size: 0.55em; color: var(--color-ink-muted); margin-top: 8px;">{acc.name}</span>
              )}
            </h1>
            {acc.description && (
              <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
                {acc.description}
              </p>
            )}
            {acc.website && (
              <a
                href={acc.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 mt-4"
                style="font-size: 13px; color: var(--color-accent);"
              >
                {tAcc("officialWebsite")}
              </a>
            )}

            <div
              class="grid mt-7 py-5"
              style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
            >
              <div style="padding-inline: 18px;">
                <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{tAcc("statAccredited")}</div>
                <div class="display tnum" style="font-size: 28px; margin-top: 4px;">{hospitals.length.toLocaleString()}</div>
              </div>
              <div style="padding-inline: 18px; border-inline-start: 1px solid var(--color-border);">
                <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{tAcc("statCountries")}</div>
                <div class="display tnum" style="font-size: 28px; margin-top: 4px;">{byCountry.length}</div>
              </div>
            </div>
          </div>

          <aside>
            <div class="paper" style="padding: 22px;">
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                {tAcc("byCountry")}
              </div>
              <ul class="mt-3 space-y-2">
                {byCountry.map((c) => (
                  <li>
                    <a
                      href={localizedPath(locale, c.n >= 3 ? `/accreditation/${code}/${c.country_slug}` : `/country/${c.country_slug}`)}
                      class="flex items-center justify-between gap-3 hover:text-accent"
                      style="font-size: 14px;"
                    >
                      <span class="flex items-center gap-2">
                        <span aria-hidden="true">{FLAG[c.country_slug] ?? "🌐"}</span>
                        {c.country_name}
                      </span>
                      <span class="mono tnum" style="font-size: 12px; color: var(--color-ink-subtle);">
                        {c.n.toLocaleString()}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {/* Hospital grid */}
    {hospitals.length > 0 && (
      <section style="padding: 32px 28px 80px; border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1440px]">
          <h2 class="display" style="font-size: 28px; letter-spacing: -0.02em; margin-bottom: 24px;">
            {tAcc("hospitalsHeading").replace("{label}", label)}
          </h2>
          <ul class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
            {hospitals.map((h) => (
              <li>
                <a
                  href={localizedPath(locale, `/hospital/${h.slug}`)}
                  class="paper block overflow-hidden transition hover:-translate-y-0.5"
                  style="padding: 0;"
                >
                  <PhotoBlock
                    aspect="16/10"
                    imgUrl={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: h.countrySlug })}
                    label={h.name}
                    rounded={false}
                  />
                  <div style="padding: 18px;">
                    <div class="mono flex items-center gap-2" style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">
                      <span aria-hidden="true">{FLAG[h.countrySlug ?? ""] ?? "🌐"}</span>
                      {h.cityName}, {h.countryName}
                    </div>
                    <div class="serif mt-2" style="font-size: 19px; font-weight: 500; letter-spacing: -0.015em;">
                      {h.name}
                    </div>
                    <div class="flex items-center gap-3 flex-wrap mt-3" style="font-size: 12.5px; color: var(--color-ink-muted);">
                      {h.rating && Number(h.rating) > 0 && (
                        <span class="inline-flex items-center gap-1">
                          <span style="color: var(--color-saffron);">★</span>
                          <span class="tnum">{Number(h.rating).toFixed(1)}</span>
                        </span>
                      )}
                      {h.bedCapacity && (
                        <span class="tnum">{h.bedCapacity.toLocaleString()} {tAcc("beds")}</span>
                      )}
                      <span class="mono" style="font-size: 10px; color: var(--color-ink-subtle);">
                        {h.accrCount} {tAcc("accreditations")}
                      </span>
                    </div>
                    {h.fromUsd && (
                      <div class="flex items-end justify-between mt-4 pt-4" style="border-top: 1px solid var(--color-border-soft);">
                        <div>
                          <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">
                            {tAcc("from")}
                          </div>
                          <div class="display tnum" style="font-size: 20px;">
                            <Price usd={h.fromUsd} />
                          </div>
                        </div>
                        <span
                          class="inline-flex items-center gap-1"
                          style="background: var(--color-ink); color: var(--color-bg); padding: 6px 12px; font-size: 12px; font-weight: 500; border-radius: 9999px;"
                        >
                          {tAcc("view")}
                          <ChevronRight className="h-3 w-3 mirror-x" />
                        </span>
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Deep accreditation content */}
    {accSections && (
      <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tAcc("sectionEyebrow")}
          </div>
          <h2 class="display mb-7" style="font-size: 30px; letter-spacing: -0.02em;">
            {tAcc("understandingPrefix")} <span style="font-style: italic;">{acc.acronym ?? acc.name}</span>
          </h2>

          {accSections.whatItIs && Array.isArray(accSections.whatItIs) && (
            <div class="prose-editorial mb-10" style="max-width: 56rem;">
              {accSections.whatItIs.map((p: string) => <p>{p}</p>)}
            </div>
          )}

          {accSections.whatItMeansForPatients && accSections.whatItMeansForPatients.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{tAcc("whatItMeansForPatientsHeading")}</h3>
              <ul class="space-y-3">
                {accSections.whatItMeansForPatients.map((p: string) => (
                  <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                    <span style="color: var(--color-accent);">→</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="grid gap-6 md:grid-cols-2 mb-10">
            {accSections.howItsAwarded && (
              <div class="paper" style="padding: 22px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  {tAcc("howItsAwardedLabel")}
                </div>
                <p style="font-size: 14.5px; line-height: 1.55;">{accSections.howItsAwarded}</p>
              </div>
            )}

            {accSections.signalStrength && (
              <div class="paper" style="padding: 22px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  {tAcc("signalStrengthLabel")}
                </div>
                <p style="font-size: 14.5px; line-height: 1.55;">{accSections.signalStrength}</p>
              </div>
            )}
          </div>

          {accSections.limitations && accSections.limitations.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{tAcc("honestLimitationsHeading")}</h3>
              <ul class="space-y-3">
                {accSections.limitations.map((l: string) => (
                  <li class="flex gap-3 items-start" style="font-size: 15px; line-height: 1.55; padding: 14px 18px; border: 1px solid var(--color-border-soft); border-inline-start: 3px solid var(--color-coral, #E85A4F); background: white;">
                    <span style="color: var(--color-coral, #E85A4F); font-weight: 700;">!</span>
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {accSections.howToVerify && (
            <div class="paper mb-6" style="padding: 22px;">
              <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                {tAcc("howToVerifyLabel")}
              </div>
              <p style="font-size: 14.5px; line-height: 1.55;">{accSections.howToVerify}</p>
            </div>
          )}

          {accSections.relatedAccreditations && accSections.relatedAccreditations.length > 0 && (
            <div>
              <h3 class="display mb-4" style="font-size: 20px;">{tAcc("relatedCertificationsHeading")}</h3>
              <div class="flex flex-wrap gap-2">
                {accSections.relatedAccreditations.map((r: string) => (
                  <span class="mono uppercase" style="font-size: 11px; letter-spacing: 0.1em; padding: 6px 12px; border: 1px solid var(--color-border); background: white; color: var(--color-ink);">
                    {r}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    
    <ExploreGrid
      locale={locale}
      eyebrow="Use this credential"
      heading="Where this accreditation matters"
      lede={`${acc.acronym ?? acc.name} is one signal among several. These hubs let you weight it against pricing, surgeon volume, and destination — not just take the badge at face value.`}
      items={[
        { eyebrow: "Reference", label: "All accreditation bodies", href: "/accreditation", hint: "JCI, NABH, ISO 9001, KTQ, HA, MOHAP — what each one actually means clinically." },
        { eyebrow: "Browse", label: "All hospitals", href: "/hospitals", hint: "Filter by accreditation, country, specialty, beds, rating." },
        { eyebrow: "Browse", label: "9 destination countries", href: "/countries", hint: "Per-country accreditation profile and program quality benchmarks." },
        { eyebrow: "Browse", label: "15 medical specialties", href: "/specialties", hint: "Where program quality matters most: cardiac, transplant, oncology, neuro." },
        { eyebrow: "Browse", label: "All 88 procedures", href: "/treatments", hint: "Procedure-first browsing with success rates and recovery timelines." },
        { eyebrow: "Compare", label: "Hospital comparison", href: "/compare/hospitals", hint: "Side-by-side accreditations, ratings, beds, pricing for up to 4 hospitals." },
        { eyebrow: "Compare", label: "Destination shootout", href: "/compare/countries", hint: "Hospitals, doctors, treatments, programs by country." },
        { eyebrow: "Tool", label: "Cost calculator", href: "/calculator", hint: "Hospital-reported pricing across procedures × destinations." },
        { eyebrow: "Reference", label: "Glossary of terms", href: "/glossary", hint: "Plain-language definitions for credentials, procedures, logistics." },
        { eyebrow: "Trust", label: "Editorial policy", href: "/editorial-policy", hint: "How we verify accreditations and methodology behind hospital scoring." },
        { eyebrow: "Trust", label: "Medical board", href: "/medical-board", hint: "Named clinicians who review hospital programs and content." },
        { eyebrow: "Action", label: "Free second opinion", href: "/second-opinion", hint: "Independent panel review of your case in 48 hours — no charge." },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
