---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/editorial-policy`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tEd = getTranslator(locale, "editorialPage");

const path = "/editorial-policy";
const url = localeUrl(locale, path);
const currentYear = new Date().getFullYear();

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tEd("breadcrumbEditorial"), url },
]);

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: tEd("breadcrumbEditorial"),
  url,
  mainEntity: {
    "@type": "Article",
    headline: tEd("jsonLdHeadline"),
    publisher: { "@type": "Organization", name: "MedCasts" },
    inLanguage: locale,
    dateModified: `${currentYear}-04-21`,
  },
  about: [
    { "@type": "Thing", name: tEd("jsonLdAbout1") },
    { "@type": "Thing", name: tEd("jsonLdAbout2") },
    { "@type": "Thing", name: tEd("jsonLdAbout3") },
    { "@type": "Thing", name: tEd("jsonLdAbout4") },
    { "@type": "Thing", name: tEd("jsonLdAbout5") },
  ],
};

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const stats = [
  { l: tEd("statLastUpdated"), v: tEd("statLastUpdatedValue").replace("{year}", String(currentYear)) },
  { l: tEd("statReviewCadence"), v: tEd("statReviewCadenceValue") },
  { l: tEd("statCorrectionsSLA"), v: tEd("statCorrectionsSLAValue") },
  { l: tEd("statAIonEditorial"), v: tEd("statAIValue") },
];

const TOC = [
  { id: "authors", label: tEd("tocAuthors") },
  { id: "citations", label: tEd("tocCitations") },
  { id: "pricing", label: tEd("tocPricing") },
  { id: "cadence", label: tEd("tocCadence") },
  { id: "corrections", label: tEd("tocCorrections") },
  { id: "ads", label: tEd("tocAds") },
  { id: "ai", label: tEd("tocAI") },
  { id: "never", label: tEd("tocNever") },
  { id: "leadership", label: tEd("tocLeadership") },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tEd("seoTitle")}
      description={tEd("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(aboutLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tEd("breadcrumbEditorial")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tEd("eyebrowTemplate").replace("{year}", String(currentYear))}
      h1First={tEd("h1First")}
      h1Italic={tEd("h1Italic")}
      lede={tEd("lede")}
      stats={stats}
    />

    <section style="padding: 56px 0 88px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.28fr]">
          <article class="min-w-0">
            <div class="policy-prose prose-editorial">
              <h2 id="authors">{tEd("h2Authors")}</h2>
              <p>{tEd("contentFallsCategories")}</p>
              <ul>
                <li><strong>{tEd("listDirectoryPagesTitle")}</strong> {tEd("listDirectoryPagesBody")}</li>
                <li><strong>{tEd("listEditorialPagesTitle")}</strong> {tEd("listEditorialPagesBody")}</li>
              </ul>

              <h2 id="citations">{tEd("h2Citations")}</h2>
              <p>{tEd("citationsIntro")}</p>
              <ul>
                <li>{tEd("listCitPubMed")}</li>
                <li>{tEd("listCitGuidelines")}</li>
                <li>{tEd("listCitWHO")}</li>
                <li>{tEd("listCitHospital")}</li>
              </ul>
              <p>{tEd("citationsOutro")}</p>

              <h2 id="pricing">{tEd("h2Pricing")}</h2>
              <p>{tEd("pricingPara1")}</p>
              <p>{tEd("pricingPara2")}</p>

              <h2 id="cadence">{tEd("h2Cadence")}</h2>
              <p>{tEd("cadencePara1")}</p>
              <p>{tEd("cadencePara2")}</p>
              <ul>
                <li>{tEd("listCadenceVisa")}</li>
                <li>{tEd("listCadenceCost")}</li>
                <li>{tEd("listCadenceHospital")}</li>
                <li>{tEd("listCadenceTreatment")}</li>
              </ul>

              <h2 id="corrections">{tEd("h2Corrections")}</h2>
              <p set:html={tEd("correctionsPara")} />

              <h2 id="ads">{tEd("h2Ads")}</h2>
              <p>{tEd("adsPara1")}</p>
              <p>{tEd("adsPara2")}</p>

              <h2 id="ai">{tEd("h2AI")}</h2>
              <p>{tEd("aiPara1")}</p>
              <p>{tEd("aiPara2")}</p>

              <h2 id="never">{tEd("h2Never")}</h2>
              <ul>
                <li>{tEd("listNever1")}</li>
                <li>{tEd("listNever2")}</li>
                <li>{tEd("listNever3")}</li>
                <li>{tEd("listNever4")}</li>
              </ul>

              <h2 id="leadership">{tEd("h2Leadership")}</h2>
              <p set:html={tEd("leadershipPara")} />
            </div>

            <div
              class="mt-12 flex items-start gap-4"
              style="padding: 20px 24px; border: 1px dashed var(--color-border); border-radius: var(--radius-lg);"
            >
              <div>
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tEd("foundError")}
                </div>
                <p class="mt-2 serif" style="font-size: 15.5px; line-height: 1.5; color: var(--color-ink-muted);">
                  {tEd("foundErrorText")}
                </p>
              </div>
            </div>
          </article>

          <aside class="hidden lg:block">
            <div class="lg:sticky lg:top-28 lg:self-start space-y-6">
              <nav
                aria-label={tEd("onThisPage")}
                style="padding: 18px 0; border-top: 1px solid var(--color-ink);"
              >
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tEd("onThisPage")}
                </div>
                <ol class="mt-3 space-y-2 tnum">
                  {TOC.map((item, i) => (
                    <li class="flex gap-2.5">
                      <span class="mono" style="font-size: 11px; color: var(--color-ink-subtle);">{String(i + 1).padStart(2, "0")}</span>
                      <a
                        href={`#${item.id}`}
                        class="serif hover:text-accent transition-colors"
                        style="font-size: 13.5px; line-height: 1.4; color: var(--color-ink);"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>

              <a
                href={localizedPath(locale, "/about")}
                class="paper group block transition hover:-translate-y-0.5"
                style="padding: 18px 20px;"
              >
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tEd("aboutMedCasts")}
                </div>
                <div class="serif mt-2" style="font-size: 16px; line-height: 1.3; color: var(--color-ink);">
                  {tEd("aboutWhoWeAre")} <span class="italic-display">{tEd("aboutInPlainEnglish")}</span>
                </div>
                <div class="mt-3 mono uppercase inline-flex items-center gap-1 group-hover:text-accent transition-colors" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-muted);">
                  {tEd("readAboutUs")}
                  <ChevronRight className="h-3 w-3 mirror-x" />
                </div>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <style is:global>
      .policy-prose > p:first-of-type::first-letter {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: 5em;
        line-height: 0.92;
        float: inline-start;
        margin-inline-end: 10px;
        margin-block-start: 0.08em;
        color: var(--color-ink);
      }
      .policy-prose h2 {
        scroll-margin-top: 120px;
      }
    </style>

    <HowItWorks
      heading={tEd("howHeading")}
      italicWord={tEd("howItalicWord")}
      eyebrow={tEd("howEyebrow")}
      steps={[
        { title: tEd("howStep1Title"), description: tEd("howStep1Desc") },
        { title: tEd("howStep2Title"), description: tEd("howStep2Desc") },
        { title: tEd("howStep3Title"), description: tEd("howStep3Desc") },
        { title: tEd("howStep4Title"), description: tEd("howStep4Desc") },
        { title: tEd("howStep5Title"), description: tEd("howStep5Desc") },
        { title: tEd("howStep6Title"), description: tEd("howStep6Desc") },
      ]}
      outroNote={tEd("howOutroNote")}
    />

    <WhatToExpect
      heading={tEd("whatHeading")}
      italicWord={tEd("whatItalicWord")}
      items={[
        { label: tEd("whatItem1Label"), description: tEd("whatItem1Desc") },
        { label: tEd("whatItem2Label"), description: tEd("whatItem2Desc") },
        { label: tEd("whatItem3Label"), description: tEd("whatItem3Desc") },
        { label: tEd("whatItem4Label"), description: tEd("whatItem4Desc") },
        { label: tEd("whatItem5Label"), description: tEd("whatItem5Desc") },
        { label: tEd("whatItem6Label"), description: tEd("whatItem6Desc") },
      ]}
    />
    <ExploreGrid
      locale={locale}
      eyebrow={tEd("exploreEyebrow")}
      heading={tEd("exploreHeading")}
      lede={tEd("exploreLede")}
      items={[
        { eyebrow: tEd("exploreItem1Eyebrow"), label: tEd("exploreItem1Label"), href: "/medical-board", hint: tEd("exploreItem1Hint") },
        { eyebrow: tEd("exploreItem2Eyebrow"), label: tEd("exploreItem2Label"), href: "/accreditation", hint: tEd("exploreItem2Hint") },
        { eyebrow: tEd("exploreItem3Eyebrow"), label: tEd("exploreItem3Label"), href: "/security", hint: tEd("exploreItem3Hint") },
        { eyebrow: tEd("exploreItem4Eyebrow"), label: tEd("exploreItem4Label"), href: "/incident-report", hint: tEd("exploreItem4Hint") },
        { eyebrow: tEd("exploreItem5Eyebrow"), label: tEd("exploreItem5Label"), href: "/privacy-policy", hint: tEd("exploreItem5Hint") },
        { eyebrow: tEd("exploreItem6Eyebrow"), label: tEd("exploreItem6Label"), href: "/terms", hint: tEd("exploreItem6Hint") },
        { eyebrow: tEd("exploreItem7Eyebrow"), label: tEd("exploreItem7Label"), href: "/about", hint: tEd("exploreItem7Hint") },
        { eyebrow: tEd("exploreItem8Eyebrow"), label: tEd("exploreItem8Label"), href: "/glossary", hint: tEd("exploreItem8Hint") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
