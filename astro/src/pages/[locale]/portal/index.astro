---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_NAME, SITE_URL } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import { journeyScene } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/portal", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");

const url = new URL(Astro.request.url);
const codeAttempt = url.searchParams.get("code")?.trim();
let redirectUrl: string | null = null;
if (codeAttempt && /^[A-Z0-9-]{6,24}$/i.test(codeAttempt)) {
  redirectUrl = localizedPath(locale, `/portal/${codeAttempt.toUpperCase()}`);
}

const seoTitle = "Patient portal — track your case";
const seoDescription = "Look up your case by the 10-character tracking code your coordinator sent. See journey stage, upcoming appointments, and messages.";
const path = "/portal";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Patient portal", url: localeUrl(locale, path) },
]);

const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  description: seoDescription,
  url: localeUrl(locale, path),
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "medcastsdigital@gmail.com",
        availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"],
      },
    ],
  },
};

if (redirectUrl) return Astro.redirect(redirectUrl, 303);

Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">Patient portal</span>
      </nav>
    </div>

    <section style="padding: 64px 28px;">
      <div class="mx-auto" style="max-width: 540px;">
        <div class="relative paper-flat overflow-hidden mb-8" style="aspect-ratio: 16/9; border-radius: var(--radius-lg);">
          <img
            src={journeyScene("portal-hero")}
            alt="Patient and family at home"
            width="800"
            height="450"
            loading="eager"
            decoding="async"
            style="width: 100%; height: 100%; object-fit: cover;"
          />
          <div class="image-veil" />
          <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 14px; inset-inline-end: 16px;">
            <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">6-stage timeline</div>
            <div class="serif" style="font-size: 15px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 3px;">Track your case from records → recovery</div>
          </div>
        </div>
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); text-align: center;">Case lookup</div>
        <h1 class="display display-tight mt-3 text-center" style="font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
          Enter your <span class="italic-display">tracking code</span>
        </h1>
        <p class="serif mt-5 text-center" style="font-size: 17px; line-height: 1.5; color: var(--color-ink-muted);">
          Your coordinator sent a 10-character code by email and WhatsApp when your case opened. Enter it below to see stage, appointments, and messages.
        </p>

        <h2 class="sr-only">Look up your case by tracking code</h2>
        <form method="get" class="paper mt-8" style="padding: 24px; box-shadow: var(--shadow-md);">
          <label class="block">
            <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">Tracking code</span>
            <input
              name="code"
              placeholder="MC-A1B2C3D4"
              required
              pattern="[A-Za-z0-9\-]{6,24}"
              class="w-full"
              style="padding: 14px 16px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 17px; color: var(--color-ink); font-family: var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase;"
              autofocus
            />
          </label>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 w-full mt-4 font-semibold"
            style="background: var(--color-ink); color: var(--color-bg); padding: 14px 22px; font-size: 15px; border-radius: 9999px;"
          >
            Look up my case <ChevronRight className="h-3.5 w-3.5 mirror-x" />
          </button>
        </form>

        <div class="mt-6 text-center" style="font-size: 13.5px; color: var(--color-ink-muted);">
          Lost your code?
          <a href={localizedPath(locale, "/contact?topic=code-recovery")} class="underline" style="color: var(--color-accent);">Ask your coordinator</a>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow="No code yet?"
      heading="Start a case or learn how the portal works"
      lede="The portal tracks active cases by code. If you don't have one, the entry points below get you started."
      items={[
        { eyebrow: "Quote", label: "Get a free quote", href: "/quote", hint: "5-minute form — we send 3 hospital options + cost." },
        { eyebrow: "Match", label: "Match Me quiz", href: "/match-me", hint: "Concern + budget → recommended path." },
        { eyebrow: "Find", label: "Find a specialist", href: "/find-specialist", hint: "Specialty + condition → matched surgeon." },
        { eyebrow: "Trust", label: "Free second opinion", href: "/second-opinion", hint: "Independent review of an existing surgical plan." },
        { eyebrow: "Process", label: "How our case managers work", href: "/services", hint: "Quote, second opinion, visa, follow-up — what we deliver." },
        { eyebrow: "Refer", label: "Refer someone", href: "/referral", hint: "Doctor, family, or past patient — start a referral." },
        { eyebrow: "Talk", label: "Talk to a coordinator", href: "/contact", hint: "Email, phone, or WhatsApp." },
        { eyebrow: "Q&A", label: "Patient Q&A", href: "/qa", hint: "30 answered questions across 12 categories." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
