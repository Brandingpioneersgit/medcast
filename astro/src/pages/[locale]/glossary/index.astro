---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, faqJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContentBatch, applyTranslated } from "@/lib/translate";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/glossary", 308);
const locale = rawLocale as Locale;
const tg = getTranslator(locale, "glossaryPage");
const tc = getTranslator(locale, "common");

type Row = { id: number; slug: string; term: string; category: string | null; short_definition: string };
const rawTerms = Array.from(
  (await db
    .execute(sql`
      SELECT id, slug, term, category, short_definition FROM glossary_terms
      ORDER BY category, term
    `)
    .catch(() => [] as unknown[])) as Iterable<Row>,
);

const trMap: Record<number, Record<string, string>> = await getContentBatch("glossary", rawTerms.map((t) => t.id), locale).catch(() => ({}));
const terms = rawTerms.map((t) => applyTranslated(t, trMap[t.id] ?? {}, ["term", "short_definition"]));
const localeHasTranslations = locale === "en" || rawTerms.some((t) => Object.keys(trMap[t.id] ?? {}).length > 0);

const byCategory = new Map<string, Row[]>();
for (const t of terms) {
  const cat = t.category ?? "General";
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(t);
}
const categories = Array.from(byCategory.keys()).sort();

const seoTitle = tg("seoTitle");
const seoDescription = tg("seoDescription");
const path = "/glossary";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tg("breadcrumbGlossary"), url: localeUrl(locale, path) },
]);

const glossaryFaqs = [
  { question: "What does JCI accreditation mean?", answer: "Joint Commission International (JCI) accreditation is the gold standard for hospital quality. JCI-accredited hospitals meet rigorous international patient safety and care standards." },
  { question: "What's the difference between a tourist visa and a medical visa?", answer: "A tourist visa typically allows 30-60 days, suitable for minor procedures and consultations. A medical visa covers longer stays required for surgical procedures, with extensions available for recovery." },
  { question: "What is medical tourism facilitation?", answer: "Medical tourism facilitation is the coordination of your entire treatment journey — hospital selection, doctor matching, visa support, accommodation, and follow-up care. MedCasts provides this as a free service." },
];
const faqSchema = faqJsonLd(glossaryFaqs);

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={!localeHasTranslations} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tg("breadcrumbGlossary")}</span>
        </nav>
      </div>
    </div>

    <section style="padding: 56px 0 32px;">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
          {tg("eyebrow")}
        </div>
        <h1
          class="display display-tight mt-3"
          style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;"
        >
          {tg("h1First")} <span class="italic-display">{tg("h1Italic")}</span>
        </h1>
        <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
          {tg("lede")}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3" style="font-size: 12.5px; color: var(--color-ink-subtle);">
          <span class="mono">{terms.length} {tg("termsCount")} · {categories.length} {tg("categoriesCount")}</span>
        </div>
      </div>
    </section>

    {/* Sticky category tabs — stay visible while scrolling between sections */}
    <nav
      class="mc-glossary-tabs"
      aria-label="Glossary categories"
      style="position: sticky; top: 84px; z-index: 30; background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--color-border-soft); border-bottom: 1px solid var(--color-border-soft); padding: 12px 0;"
    >
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 overflow-x-auto">
        <div class="flex flex-nowrap md:flex-wrap gap-2 min-w-max md:min-w-0">
          {categories.map((c) => {
            const id = c.toLowerCase().replace(/[^a-z0-9]+/g, "-");
            const count = byCategory.get(c)!.length;
            return (
              <a
                href={`#${id}`}
                data-category-tab={id}
                class="inline-flex items-center gap-2 transition"
                style="padding: 7px 14px; border-radius: 9999px; font-size: 12px; font-weight: 500; background: var(--color-surface-elevated); color: var(--color-ink); border: 1px solid var(--color-border); white-space: nowrap;"
              >
                {c}
                <span class="tnum mono" style="font-size: 10px; padding: 0 5px; border-radius: 9999px; background: var(--color-bg); color: var(--color-ink-subtle);">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </nav>

    <section style="padding: 32px 0 0;">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">

        {/* Category sections */}
        {categories.map((c) => (
          <section id={c.toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="mt-12" style="scroll-margin-top: 120px;">
            <h2
              class="display"
              style="font-size: 28px; letter-spacing: -0.02em; padding-bottom: 12px; border-bottom: 1px solid var(--color-ink);"
            >
              {c}
            </h2>
            <ul class="mt-6 grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
              {byCategory.get(c)!.map((t) => (
                <li>
                  <a
                    href={localizedPath(locale, `/glossary/${t.slug}`)}
                    class="paper flex items-start gap-3 transition hover:-translate-y-0.5"
                    style="padding: 16px 18px;"
                  >
                    <div class="flex-1 min-w-0">
                      <div class="serif font-medium" style="font-size: 15.5px; letter-spacing: -0.005em;">
                        {t.term}
                      </div>
                      <p class="mt-1.5 line-clamp-2" style="font-size: 13px; color: var(--color-ink-muted); line-height: 1.5;">
                        {t.short_definition}
                      </p>
                    </div>
                    <ChevronRight className="h-4 w-4 mirror-x shrink-0 mt-1" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {/* FAQ — schema matches visible content (FAQPage) */}
        <section class="mt-16" style="scroll-margin-top: 120px;">
          <h2
            class="display"
            style="font-size: 28px; letter-spacing: -0.02em; padding-bottom: 12px; border-bottom: 1px solid var(--color-ink);"
          >
            Common questions
          </h2>
          <div class="mt-6 grid gap-3">
            {glossaryFaqs.map((f) => (
              <details class="paper" style="padding: 18px 22px;">
                <summary class="serif font-medium cursor-pointer" style="font-size: 16px; letter-spacing: -0.005em;">
                  {f.question}
                </summary>
                <p class="serif mt-3" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">
                  {f.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </section>

    <script is:inline>
      // Scroll-spy: highlight the visible category tab as the user scrolls
      (function () {
        const tabs = document.querySelectorAll("[data-category-tab]");
        if (!tabs.length || !("IntersectionObserver" in window)) return;
        const tabMap = new Map();
        tabs.forEach((t) => tabMap.set(t.dataset.categoryTab, t));
        const setActive = (id) => {
          tabs.forEach((t) => {
            const on = t.dataset.categoryTab === id;
            t.style.background = on ? "var(--color-ink)" : "var(--color-surface-elevated)";
            t.style.color = on ? "var(--color-bg)" : "var(--color-ink)";
            t.style.borderColor = on ? "var(--color-ink)" : "var(--color-border)";
          });
        };
        const sections = Array.from(tabMap.keys())
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        const io = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top)[0];
            if (visible) setActive(visible.target.id);
          },
          { rootMargin: "-180px 0px -55% 0px", threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));
        // Smooth-scroll behaviour for the anchor click
        tabs.forEach((t) => {
          t.addEventListener("click", () => {
            // brief immediate visual response while IO catches up
            setActive(t.dataset.categoryTab);
          });
        });
      })();
    </script>

    <HowItWorks
      heading='How to use the glossary'
      italicWord='the glossary'
      eyebrow='Reference'
      steps={[
        { title: 'Browse by category', description: 'Pharmacology, imaging, surgery, recovery, insurance, regulatory, evidence, visa, payment, specialty terms. Pick the closest fit.' },
        { title: 'Search by term', description: 'Use Cmd+K (or header search) to find a specific term across all 135 entries.' },
        { title: "Read 'what this means for you'", description: 'Each term has a clinical definition + a patient-meaning section explaining why it matters in your decision.' },
        { title: 'Cross-reference', description: 'Each entry links to related terms. Reading the cluster gives a fuller picture than a single definition.' },
      ]}
    />

    <WhatToExpect
      heading='Glossary structure'
      italicWord='structure'
      items={[
        { label: 'Short definition', description: 'One-sentence definition for quick reference.' },
        { label: 'Full definition', description: "Paragraph with clinical context and how it's used in practice." },
        { label: 'Patient meaning', description: 'What the term means specifically for you as a patient making decisions.' },
        { label: 'Related terms', description: 'Cross-links to terms that often come up together.' },
      ]}
    />
    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>