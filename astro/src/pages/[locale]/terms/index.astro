---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import {
  Building2,
  Briefcase,
  ShieldOff,
  CircleDollarSign,
  CheckCircle2,
  FileCheck,
  Hospital,
  Stethoscope,
  Undo2,
  Scale,
  ShieldCheck,
  Gavel,
  Copyright,
  AlertTriangle,
  RefreshCw,
  Mail,
  ChevronRight,
} from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/terms", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");

const seoTitle = "Terms of Service";
const seoDescription =
  "MedCasts terms: who we are, what we do and don't do, how we're paid, and the honest boundaries of a medical-travel coordinator.";
const path = "/terms";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Terms of service", url: localeUrl(locale, path) },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const LAST_UPDATED = "April 2026";

type Section = {
  id: string;
  icon: any;
  title: string;
  intro?: string;
  bullets?: string[];
  paras?: string[];
  tone?: "default" | "warn" | "accent";
};

const sections: Section[] = [
  {
    id: "who-we-are",
    icon: Building2,
    title: "Who we are",
    paras: [
      `MedCasts ("we", "us", "our") operates a medical-travel coordination platform connecting international patients with accredited hospitals. We are coordinators, not clinicians. We don't practice medicine, diagnose conditions, or prescribe treatment.`,
    ],
  },
  {
    id: "what-we-do",
    icon: Briefcase,
    title: "What we do",
    bullets: [
      "Match you to 1–3 hospitals appropriate for your clinical situation and budget.",
      "Coordinate itemized quotes, treatment plans, and surgeon communications.",
      "Handle visa invitation letters, travel logistics, accommodation, and interpreter support.",
      "Provide a named case manager from first contact through 90-day post-op follow-up.",
      "Coordinate free second opinions from our medical panel of senior specialists.",
    ],
  },
  {
    id: "what-we-dont",
    icon: ShieldOff,
    title: "What we don't do",
    tone: "warn",
    bullets: [
      "**We don't practice medicine.** Our case managers, researchers, and the information on this site are not a substitute for a doctor-patient relationship.",
      "**We don't prescribe.** No medication recommendations, dosages, or clinical judgments.",
      "**We don't guarantee outcomes.** Every surgery has risk. We surface hospitals with strong track records; we can't promise results.",
      "**We don't replace your local doctor.** You should keep your local physician informed throughout.",
    ],
  },
  {
    id: "how-paid",
    icon: CircleDollarSign,
    title: "How we're paid",
    tone: "accent",
    paras: [
      "Hospitals pay us a coordination fee after you choose to proceed — typically 5–15% of the hospital's gross invoice. This is disclosed on every quote we send. You don't pay us anything directly. Second opinions, quote preparation, and pre-travel coordination are free to you whether or not you book.",
      `This means: our incentive to send you to a hospital increases with the hospital's invoice. We counter this structurally by (a) running an independent medical panel whose second-opinion compensation is flat per case, and (b) publishing our editorial policy including the 28% of oncology cases where we recommend against surgery.`,
    ],
  },
  {
    id: "responsibilities",
    icon: CheckCircle2,
    title: "Your responsibilities",
    bullets: [
      "Give us accurate clinical information. Omissions (prior surgery, current medications, allergies) can directly affect your safety.",
      "Verify your visa eligibility, passport validity, and any travel restrictions before booking flights.",
      "Maintain appropriate medical insurance. Most plans don't cover elective international care.",
      "Pay hospitals directly. We never handle clinical payments ourselves.",
    ],
  },
  {
    id: "quote-validity",
    icon: FileCheck,
    title: "Quote validity",
    paras: [
      "Quotes are indicative until the destination hospital has reviewed your medical records in full. Final prices may adjust based on findings during pre-operative workup (imaging in-country, blood work, cardiac clearance, etc.). Any material change of ≥5% to the quote must be disclosed in writing before you commit.",
    ],
  },
  {
    id: "hospital-independence",
    icon: Hospital,
    title: "Hospital independence",
    paras: [
      "We're a coordinator; we are not the operating entity. Your clinical contract is between you and the destination hospital. Their malpractice coverage, complication indemnity, and dispute-resolution processes apply. We disclose these terms on every hospital we match you to.",
    ],
  },
  {
    id: "second-opinions",
    icon: Stethoscope,
    title: "Second opinions",
    paras: [
      "Second opinions are reviews of submitted records by senior specialists on our panel. They are for your consideration and do not constitute treatment or a substitute for an in-person consultation. Decisions to proceed, modify, or decline treatment remain yours in consultation with your treating doctor.",
    ],
  },
  {
    id: "cancellation",
    icon: Undo2,
    title: "Cancellation and refunds",
    paras: [
      "We don't charge you deposits. Any deposits paid to hospitals follow that hospital's refund policy, which we require in writing before you pay. Typical terms: full refund if cancelled >14 days before surgery (less processing fee), 50–70% refund 3–14 days before, case-by-case within 72 hours. Medical-reason cancellations (fever, abnormal labs) are typically handled without penalty — get this specific language in writing.",
    ],
  },
  {
    id: "liability",
    icon: Scale,
    title: "Limitation of liability",
    paras: [
      `We provide coordination services on an "as is" basis. Our maximum aggregate liability to you is limited to the coordination fee we received from the hospital for your case, or US$1,000, whichever is greater. This does not limit our liability for gross negligence, wilful misconduct, or death and personal injury under applicable law.`,
    ],
  },
  {
    id: "indemnification",
    icon: ShieldCheck,
    title: "Indemnification",
    paras: [
      "You agree to indemnify us against third-party claims arising from inaccurate information you provided or activities clearly outside the scope of our coordination services.",
    ],
  },
  {
    id: "governing-law",
    icon: Gavel,
    title: "Governing law and disputes",
    paras: [
      "These terms are governed by the laws of Delaware, USA, where MedCasts is incorporated. Disputes go first to good-faith negotiation, then mediation, then binding arbitration under AAA rules. You retain the right to bring claims before your local consumer-protection body where applicable law permits.",
    ],
  },
  {
    id: "ip",
    icon: Copyright,
    title: "Content and intellectual property",
    paras: [
      "Content on this site (editorial articles, hospital descriptions, medical panel reviews, data compilations) is our intellectual property. You may share individual articles for non-commercial personal use. Republishing at scale, scraping, or retraining AI models on this content requires written permission.",
    ],
  },
  {
    id: "medical-disclaimer",
    icon: AlertTriangle,
    title: "Medical information disclaimer",
    tone: "warn",
    paras: [
      "Information here — hospital descriptions, treatment guides, cost ranges, blog posts — is educational, not medical advice. It doesn't establish a doctor-patient relationship. Before acting on anything: consult your doctor.",
    ],
  },
  {
    id: "changes",
    icon: RefreshCw,
    title: "Changes to these terms",
    paras: [
      "We update terms when materially necessary. Active case clients are notified by email. Continued use after notification constitutes acceptance.",
    ],
  },
  {
    id: "contact",
    icon: Mail,
    title: "Contact",
    bullets: [
      "**Legal:** legal@medcasts.com",
      "**Editorial or clinical concerns:** corrections@medcasts.com",
      "**Everything else:** your case manager.",
    ],
  },
];

// Lightweight markdown for **bold** in bullets
function renderInline(s: string): string {
  return s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">Terms of service</span>
      </nav>
    </div>

    <section style="padding: 64px 28px 32px;">
      <div class="mx-auto w-full max-w-[1120px]">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">
          Legal · Last updated {LAST_UPDATED}
        </div>
        <h1
          class="display display-tight mt-3"
          style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;"
        >
          Terms of <span class="italic-display">service</span>
        </h1>
        <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted); max-width: 720px;">
          The honest boundaries of what a medical-travel coordinator can and cannot do for you. Read before you engage our case managers.
        </p>
      </div>
    </section>

    <section style="padding: 24px 28px 88px;">
      <div class="mx-auto w-full max-w-[1120px] grid gap-12 lg:grid-cols-[1fr,0.28fr]">
        <div class="min-w-0 space-y-5">
          {sections.map((s, i) => {
            const Icon = s.icon;
            const num = String(i + 1).padStart(2, "0");
            const tone = s.tone ?? "default";
            const accentColor =
              tone === "warn"
                ? "var(--color-coral, #E85A4F)"
                : "var(--color-accent)";
            const accentBg =
              tone === "warn"
                ? "var(--color-coral-soft, rgba(232,90,79,0.10))"
                : "var(--color-accent-mist, var(--color-accent-soft))";
            const cardBg = tone === "accent" ? "var(--color-accent-mist, var(--color-accent-soft))" : "var(--color-paper)";
            return (
              <article
                id={s.id}
                class="paper"
                style={`padding: 32px 36px; scroll-margin-top: 120px; background: ${cardBg};`}
              >
                <div class="flex items-start gap-5">
                  <div
                    class="flex items-center justify-center shrink-0"
                    style={`width: 48px; height: 48px; border-radius: 12px; background: ${accentBg}; color: ${accentColor};`}
                    aria-hidden="true"
                  >
                    <Icon className="h-[22px] w-[22px]" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="mono tnum" style={`font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);`}>
                      Section {num}
                    </div>
                    <h2
                      class="display mt-1.5"
                      style="font-size: clamp(1.4rem, 2.4vw, 1.75rem); line-height: 1.15; letter-spacing: -0.015em; font-weight: 400;"
                    >
                      {s.title}
                    </h2>
                  </div>
                </div>

                <div class="mt-5 space-y-4 serif" style="font-size: 16px; line-height: 1.65; color: var(--color-ink-muted);">
                  {s.intro && <p>{s.intro}</p>}
                  {s.paras?.map((p) => <p>{p}</p>)}
                  {s.bullets && (
                    <ul class="space-y-3 mt-2">
                      {s.bullets.map((b) => (
                        <li class="flex gap-3" style="font-size: 15.5px; line-height: 1.55;">
                          <span style={`color: ${accentColor}; flex-shrink: 0; font-weight: 600;`} aria-hidden="true">→</span>
                          <span set:html={renderInline(b)} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            );
          })}

          <div
            class="mt-6 flex items-start gap-4"
            style="padding: 20px 24px; border: 1px dashed var(--color-border); border-radius: var(--radius-lg);"
          >
            <span class="shrink-0 mt-0.5" style="color: var(--color-accent);"><Mail className="h-5 w-5" /></span>
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                Questions about these terms?
              </div>
              <p class="mt-2 serif" style="font-size: 15.5px; line-height: 1.5; color: var(--color-ink-muted);">
                Email <a href="mailto:legal@medcasts.com" style="color: var(--color-ink);" class="underline">legal@medcasts.com</a> — we respond within 5 working days.
              </p>
            </div>
          </div>
        </div>

        <aside class="hidden lg:block">
          <div class="lg:sticky lg:top-28 lg:self-start space-y-6">
            <nav
              aria-label="On this page"
              style="padding: 18px 0; border-top: 1px solid var(--color-ink);"
            >
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                On this page
              </div>
              <ol class="mt-3 space-y-2 tnum">
                {sections.map((s, i) => (
                  <li class="flex gap-2.5">
                    <span class="mono" style="font-size: 11px; color: var(--color-ink-subtle);">{String(i + 1).padStart(2, "0")}</span>
                    <a
                      href={`#${s.id}`}
                      class="serif hover:text-accent transition-colors"
                      style="font-size: 13.5px; line-height: 1.4; color: var(--color-ink);"
                    >
                      {s.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>

            <a
              href={localizedPath(locale, "/privacy-policy")}
              class="paper group block transition hover:-translate-y-0.5"
              style="padding: 18px 20px;"
            >
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                Privacy policy
              </div>
              <div class="serif mt-2" style="font-size: 16px; line-height: 1.3; color: var(--color-ink);">
                How we handle your <span class="italic-display">medical data.</span>
              </div>
              <div class="mt-3 mono uppercase inline-flex items-center gap-1 group-hover:text-accent transition-colors" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-muted);">
                Read privacy
                <ChevronRight className="h-3 w-3 mirror-x" />
              </div>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow="Adjacent policies"
      heading="Other terms + policies"
      lede="Terms is one slice of how we operate. The pages below cover the rest — privacy, editorial, security, and how we accept reports."
      items={[
        { eyebrow: "Legal", label: "Privacy policy", href: "/privacy-policy", hint: "What we collect, retention, GDPR rights." },
        { eyebrow: "Process", label: "Editorial + corrections policy", href: "/editorial-policy", hint: "Sourcing, AI use, corrections SLA." },
        { eyebrow: "Trust", label: "Security disclosure", href: "/security", hint: "How we accept reports from researchers." },
        { eyebrow: "Action", label: "Report a safety incident", href: "/incident-report", hint: "Anonymous channel for clinical concerns." },
        { eyebrow: "Reviewers", label: "Medical board", href: "/medical-board", hint: "Clinicians behind specialty + condition pages." },
        { eyebrow: "Quality", label: "Accreditation registry", href: "/accreditation", hint: "JCI, NABH, ISO and 10 others." },
        { eyebrow: "About", label: "Who we are", href: "/about", hint: "Coordinator-not-clinician scope." },
        { eyebrow: "Contact", label: "Contact us", href: "/contact", hint: "Disputes, refunds, escalations." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
