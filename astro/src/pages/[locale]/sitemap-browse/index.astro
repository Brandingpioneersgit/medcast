---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { db } from "@/lib/db";
import {
  specialties as specialtiesTbl,
  treatments as treatmentsTbl,
  countries as countriesTbl,
  conditions as conditionsTbl,
} from "../../../../../src/lib/db/schema";
import { asc, eq, sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/sitemap-browse", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tSm = getTranslator(locale, "sitemapBrowsePage");

const [specialties, treatments, countries, conditions, cities, topBlog, topHospitals] = await Promise.all([
  db.select({ slug: specialtiesTbl.slug, name: specialtiesTbl.name }).from(specialtiesTbl).where(eq(specialtiesTbl.isActive, true)).orderBy(asc(specialtiesTbl.name)),
  db.select({ slug: treatmentsTbl.slug, name: treatmentsTbl.name }).from(treatmentsTbl).where(eq(treatmentsTbl.isActive, true)).orderBy(asc(treatmentsTbl.name)),
  db.select({ slug: countriesTbl.slug, name: countriesTbl.name }).from(countriesTbl).where(eq(countriesTbl.isDestination, true)).orderBy(asc(countriesTbl.name)),
  db.select({ slug: conditionsTbl.slug, name: conditionsTbl.name }).from(conditionsTbl).orderBy(asc(conditionsTbl.name)),
  db.execute<{ slug: string; name: string }>(sql`
    SELECT ci.slug, ci.name
    FROM cities ci
    JOIN countries c ON c.id = ci.country_id
    WHERE c.is_destination = true
      AND EXISTS(SELECT 1 FROM hospitals h WHERE h.city_id = ci.id AND h.is_active = true)
    ORDER BY ci.name ASC
    LIMIT 40
  `).then((r) => Array.from(r)).catch(() => []),
  db.execute<{ slug: string; title: string }>(sql`
    SELECT slug, title FROM blog_posts WHERE published_at IS NOT NULL ORDER BY published_at DESC LIMIT 20
  `).then((r) => Array.from(r)).catch(() => []),
  db.execute<{ slug: string; name: string }>(sql`
    SELECT slug, name FROM hospitals WHERE is_active = true AND is_featured = true ORDER BY rating DESC NULLS LAST LIMIT 12
  `).then((r) => Array.from(r)).catch(() => []),
]);

const seoTitle = tSm("seoTitle");
const seoDescription = tSm("seoDescription")
  .replace("{specialties}", String(specialties.length))
  .replace("{treatments}", String(treatments.length))
  .replace("{countries}", String(countries.length))
  .replace("{conditions}", String(conditions.length));
const path = "/sitemap-browse";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tSm("breadcrumbLabel"), url: localeUrl(locale, path) },
]);

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");

type Section = { title: string; rows: Array<{ href: string; label: string }> };
const sections: Section[] = [
  { title: tSm("sectionQuickActions"), rows: [
    { href: "/quote", label: tSm("quickRow0") },
    { href: "/second-opinion", label: tSm("quickRow1") },
    { href: "/find-specialist", label: tSm("quickRow2") },
    { href: "/emergency", label: tSm("quickRow3") },
    { href: "/portal", label: tSm("quickRow4") },
    { href: "/referral", label: tSm("quickRow5") },
  ]},
  { title: tSm("sectionReference"), rows: [
    { href: "/glossary", label: tSm("refRow0") },
    { href: "/qa", label: tSm("refRow1") },
    { href: "/accreditation", label: tSm("refRow2") },
    { href: "/services", label: tSm("refRow3") },
    { href: "/editorial-policy", label: tSm("refRow4") },
    { href: "/privacy-policy", label: tSm("refRow5") },
    { href: "/terms", label: tSm("refRow6") },
  ]},
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label={tSm("breadcrumbAriaLabel")}>
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">{tSm("breadcrumbLabel")}</span>
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto max-w-[1440px]">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tSm("eyebrow")}</div>
        <h1 class="display display-tight mt-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
          {tSm("heroHeading").replace(tSm("heroItalicWord"), "")}
          <span class="italic-display">{tSm("heroItalicWord")}</span>
        </h1>
        <p class="serif mt-5" style="font-size: 17px; line-height: 1.5; color: var(--color-ink-muted); max-width: 680px;">
          {tSm("heroBody")} <a href={localizedPath(locale, "/sitemap.xml")} class="underline">/sitemap.xml</a>
        </p>

        <div class="grid gap-10 lg:grid-cols-3 mt-12">
          {/* Quick actions + Reference (static) */}
          {sections.map((sec) => (
            <section>
              <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{sec.title}</h2>
              <ul class="mt-3 flex flex-col gap-2">
                {sec.rows.map((r) => (
                  <li><a href={localizedPath(locale, r.href)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{r.label}</a></li>
                ))}
              </ul>
            </section>
          ))}

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionDestinations").replace("{count}", String(countries.length))}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {countries.map((c) => (
                <li><a href={localizedPath(locale, `/country/${c.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{c.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionSpecialties").replace("{count}", String(specialties.length))}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {specialties.map((s) => (
                <li><a href={localizedPath(locale, `/specialty/${s.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{s.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionTreatments").replace("{count}", String(treatments.length))}</h2>
            <ul class="mt-3 flex flex-col gap-2" style="max-height: 600px; overflow-y: auto; padding-inline-end: 8px;">
              {treatments.map((t) => (
                <li><a href={localizedPath(locale, `/treatment/${t.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{t.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionConditions").replace("{count}", String(conditions.length))}</h2>
            <ul class="mt-3 flex flex-col gap-2" style="max-height: 600px; overflow-y: auto; padding-inline-end: 8px;">
              {conditions.map((c) => (
                <li><a href={localizedPath(locale, `/condition/${c.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{c.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionTopCities")}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {cities.map((c) => (
                <li><a href={localizedPath(locale, `/city/${c.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{c.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionFeaturedHospitals")}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {topHospitals.map((h) => (
                <li><a href={localizedPath(locale, `/hospital/${h.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{h.name}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionEditorial").replace("{count}", String(topBlog.length))}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {topBlog.map((b) => (
                <li><a href={localizedPath(locale, `/blog/${b.slug}`)} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{b.title}</a></li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="display" style="font-size: 22px; letter-spacing: -0.015em; padding-bottom: 10px; border-bottom: 1px solid var(--color-ink);">{tSm("sectionCompare")}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              <li><a href={localizedPath(locale, "/compare/hospitals")} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{tSm("compareHospitals")}</a></li>
              <li><a href={localizedPath(locale, "/compare/doctors")} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{tSm("compareDoctors")}</a></li>
              <li><a href={localizedPath(locale, "/compare/treatments")} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{tSm("compareTreatments")}</a></li>
              <li><a href={localizedPath(locale, "/compare/countries")} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{tSm("compareCountries")}</a></li>
              <li><a href={localizedPath(locale, "/calculator")} class="hover:text-accent" style="font-size: 14px; color: var(--color-ink-muted);">{tSm("costCalculator")}</a></li>
            </ul>
          </section>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tSm("howHeading")}
      italicWord={tSm("howItalicWord")}
      eyebrow={tSm("howEyebrow")}
      steps={[
        { title: tSm("howStep0Title"), description: tSm("howStep0Desc") },
        { title: tSm("howStep1Title"), description: tSm("howStep1Desc") },
        { title: tSm("howStep2Title"), description: tSm("howStep2Desc") },
        { title: tSm("howStep3Title"), description: tSm("howStep3Desc") },
        { title: tSm("howStep4Title"), description: tSm("howStep4Desc") },
        { title: tSm("howStep5Title"), description: tSm("howStep5Desc") },
      ]}
    />

    <WhatToExpect
      heading={tSm("indexedHeading")}
      italicWord={tSm("indexedItalicWord")}
      items={[
        { label: tSm("indexedItem0Label"), description: tSm("indexedItem0Desc") },
        { label: tSm("indexedItem1Label"), description: tSm("indexedItem1Desc") },
        { label: tSm("indexedItem2Label"), description: tSm("indexedItem2Desc") },
        { label: tSm("indexedItem3Label"), description: tSm("indexedItem3Desc") },
        { label: tSm("indexedItem4Label"), description: tSm("indexedItem4Desc") },
        { label: tSm("indexedItem5Label"), description: tSm("indexedItem5Desc") },
        { label: tSm("indexedItem6Label"), description: tSm("indexedItem6Desc") },
        { label: tSm("indexedItem7Label"), description: tSm("indexedItem7Desc") },
      ]}
    />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
