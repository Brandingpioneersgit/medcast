      { tier: "standard", label: "Full Travel Package", desc: "Clinical care plus flights, accommodation and a coordinator managing the journey for patient and family.", includes: ["Everything in Specialist Referral", "Return flights for patient + 1 attendant", "Hotel near hospital (up to 10 nights)", "In-person care coordinator", "Medical-visa documentation support"] },
      { tier: "premium", label: "Executive Concierge", desc: "Private suite, named surgeon, business-class travel and structured follow-up once you return.", includes: ["Everything in Full Travel Package", "Business-class flights", "Private hospital suite", "Named consultant + second opinion", "Accommodation for up to 3 family members", "6-month remote follow-up"] },
