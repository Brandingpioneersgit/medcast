    faqs: [
      { q: "Why do so many Nigerians travel for treatment?", a: "A shortage of sub-specialists, limited tertiary-hospital capacity and unreliable equipment availability mean that cardiac, oncology, transplant and complex orthopaedic care often cannot be scheduled quickly at home. Travelling gives faster, more predictable access." },
      { q: "Which destination should I choose?", a: "India is the most common for cost and capacity; the UK and Turkey are also used. We match the destination to your diagnosis, budget and visa access, and give you transparent pricing before you commit." },
      { q: "Will my HMO cover it?", a: "Premium plans from Hygeia, AXA Mansard, Leadway and Avon include international treatment benefits for care unavailable in Nigeria. We help with pre-authorisation; most elective outbound treatment is still partly self-funded." },
      { q: "How is follow-up handled?", a: "You receive a full English discharge summary and imaging on disc, and we coordinate remote follow-up with your doctor in Nigeria." },
    ],
    insurersCoverOutbound: ["Hygeia HMO", "AXA Mansard Health", "Leadway Health", "Avon HMO", "Reliance Health"],
  },
  oman: {
    name: "Oman",
    flagEmoji: "🇴🇲",
    tagline: "Sponsored care, sent to the right hospital.",
    intro: "Oman's Ministry of Health runs a long-standing programme that sponsors citizens for treatment abroad when a procedure is not available domestically — sending patients to India, Germany, the UK and Thailand. Private patients and expatriate residents also travel for faster access and a wider choice of surgeon.",
    insuranceCompanies: [
      { name: "Oman Ministry of Health overseas scheme", note: "Sponsors citizens for MoH-approved cases that cannot be treated within Oman." },
      { name: "GIG Gulf (formerly AXA Gulf)", note: "Regional and international health plans; planned treatment abroad covered on higher tiers." },
      { name: "Sukoon Insurance (formerly Oman Insurance)", note: "International health cover available on premium products." },
      { name: "National Life & General Insurance", note: "Group medical schemes; some include regional / international treatment cover." },
      { name: "Dhofar Insurance", note: "Health products with treatment-abroad benefit on selected plans." },
    ],
    packages: [
      { tier: "basic", label: "Treatment Access", desc: "For patients needing a procedure not available in Oman. Covers the full clinical pathway abroad.", includes: ["Specialist consultation + procedure", "Hospital stay as needed", "Return airport transfers", "Arabic-speaking coordinator", "Discharge summary + imaging on disc"] },
      { tier: "standard", label: "Family Journey", desc: "Clinical care plus travel and accommodation for the patient and accompanying family.", includes: ["Everything in Treatment Access", "Return flights for patient + 1 attendant", "Hotel near hospital (up to 10 nights)", "In-person care coordinator", "MoH-sponsorship or insurer documentation support"] },
      { tier: "premium", label: "Executive Concierge", desc: "Private suite, named surgeon, business-class travel and structured follow-up once you return.", includes: ["Everything in Family Journey", "Business-class flights", "Private hospital suite", "Named consultant + second opinion", "Accommodation for up to 3 family members", "6-month remote follow-up"] },
    ],
    waitStats: [
      { procedure: "Complex paediatric surgery", waitWeeks: 32, note: "Specialised cases routinely referred abroad" },
      { procedure: "Organ transplant", waitWeeks: 48, note: "Domestic programmes limited; most cases sponsored overseas" },
      { procedure: "Advanced oncology (proton / specialised)", waitWeeks: 30, note: "Specialised radiotherapy not available domestically" },
      { procedure: "Complex cardiac surgery", waitWeeks: 24, note: "Sub-specialty cardiac cases often sent abroad" },
      { procedure: "Neurosurgery (complex tumour)", waitWeeks: 28, note: "Highly specialised neurosurgery capacity limited" },
      { procedure: "Joint replacement", waitWeeks: 18, note: "Available domestically; some travel for faster access or choice of surgeon" },
    ],
    faqs: [
      { q: "How does the Ministry of Health overseas scheme work?", a: "When a procedure is not available within Oman, the MoH can sponsor a citizen's treatment abroad. The decision and destination are set by the Ministry; we can prepare the medical documentation and coordinate the hospital side once a case is approved." },
      { q: "Can private patients and expatriates travel too?", a: "Yes. Private patients and expatriate residents often travel independently for faster access or a specific surgeon. We provide transparent pricing and full trip coordination." },
      { q: "Which destinations do Omani patients use most?", a: "India, Germany, the UK and Thailand are the most common, depending on the procedure. We match the destination to your diagnosis, budget and sponsorship status." },
      { q: "What about follow-up back in Oman?", a: "You receive a full discharge summary and imaging on disc, and we coordinate follow-up with your treating doctor or hospital in Oman." },
    ],
    insurersCoverOutbound: ["Oman Ministry of Health", "GIG Gulf", "Sukoon Insurance", "National Life & General Insurance", "Dhofar Insurance"],
  },
  uzbekistan: {
    name: "Uzbekistan",
    flagEmoji: "🇺🇿",
    tagline: "Beyond what’s available in Tashkent.",
    intro: "Uzbekistan has invested heavily in specialised national medical centres, but advanced oncology, paediatric cardiac surgery, transplant and certain neurosurgical procedures still send patients abroad — most often to India, Turkey, South Korea and Germany. State quotas cover some cases; many families travel privately for faster access and choice of surgeon.",
    insuranceCompanies: [
      { name: "State quota programme", note: "Government quotas can fund select procedures abroad that are unavailable domestically; allocation is limited." },
      { name: "Uzbekinvest", note: "State-linked insurer with health products; outbound elective treatment is rarely covered." },
      { name: "Gross Insurance", note: "Health products available; verify any international clause in writing before travel." },
      { name: "Kafolat Insurance", note: "Group medical schemes; outbound surgery typically self-funded." },
      { name: "Apex Insurance", note: "Private health cover; treatment-abroad benefit limited to specific policies." },
    ],
    packages: [
      { tier: "basic", label: "Specialist Access", desc: "For patients needing a procedure not available domestically. Covers the full clinical pathway abroad.", includes: ["Specialist consultation + procedure", "Hospital stay as needed", "Return airport transfers", "Russian-speaking coordinator", "Discharge summary + imaging on disc"] },
      { tier: "standard", label: "Guided Journey", desc: "Clinical care plus travel and accommodation, with a coordinator managing the trip for patient and family.", includes: ["Everything in Specialist Access", "Return flights for patient + 1 attendant", "Hotel near hospital (up to 10 nights)", "In-person care coordinator", "Medical-visa documentation support"] },
      { tier: "premium", label: "Full Concierge", desc: "Private room, named surgeon, family accommodation and follow-up coordination once you return.", includes: ["Everything in Guided Journey", "Private hospital room", "Named consultant + second opinion", "Accommodation for up to 3 family members", "6-month remote follow-up"] },
    ],
    waitStats: [
      { procedure: "Advanced oncology care", waitWeeks: 34, note: "Specialised cancer treatment capacity limited" },
      { procedure: "Paediatric cardiac surgery", waitWeeks: 40, note: "Complex congenital cases routinely referred abroad" },
      { procedure: "Organ transplant", waitWeeks: 50, note: "Domestic programmes limited; most patients travel" },
      { procedure: "Bone marrow transplant", waitWeeks: 48, note: "Very limited domestic availability" },
      { procedure: "Complex neurosurgery", waitWeeks: 30, note: "Highly specialised neurosurgery concentrated in Tashkent" },
      { procedure: "Joint replacement", waitWeeks: 22, note: "Available domestically; some travel for implants or surgeon choice" },
    ],
    faqs: [
      { q: "Which procedures most often require travel from Uzbekistan?", a: "Advanced oncology, paediatric cardiac surgery, transplant and complex neurosurgery — areas where domestic capacity is still developing. We confirm whether your specific procedure is realistically available at home before you commit to travelling." },
      { q: "Can the state quota cover my treatment?", a: "Government quotas can fund select procedures abroad that are not available in Uzbekistan, but allocation is limited. We can prepare the medical documentation; the funding decision rests with the relevant authority." },
      { q: "Which destinations do Uzbek patients use?", a: "India, Turkey, South Korea and Germany are the most common, depending on the procedure and budget. We match the destination to your diagnosis and give you transparent pricing before you commit." },
      { q: "What about follow-up after returning home?", a: "You receive a full discharge summary and imaging on disc, and we coordinate remote follow-up with your doctor in Uzbekistan." },
    ],
    insurersCoverOutbound: ["State quota programme", "Uzbekinvest", "Gross Insurance", "Kafolat Insurance"],
  },
};

const data = SOURCE_COUNTRIES[countrySlug];
if (!data) return new Response(`Not found: ${countrySlug}`, { status: 404 });

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tFr("breadcrumbLabel").replace("{country}", data.name), url },
]);

const maxWait = 60;
const tierColors: Record<string, string> = {
  basic: "var(--color-ink-muted)",
  standard: "var(--color-accent)",
  premium: "var(--color-ink)",
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=86400, stale-while-revalidate=604800");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tFr("metaTitle").replace("{country}", data.name)}
      description={data.intro.slice(0, 160)}
      path={path}
      locale={locale}
      noindex={locale !== "en"}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <!-- Breadcrumb -->
    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">
        <div class="py-4">
          <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
            <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
            <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
            <span>{tFr("breadcrumbLabel").replace("{country}", data.name)}</span>
          </nav>
        </div>
      </div>
    </div>

    <!-- Hero -->
    <section style="border-bottom: 1px solid var(--color-border);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8 py-12 md:py-16">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.5fr] lg:items-center">
          <div>
            <p class="mono uppercase inline-flex items-center gap-2" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
              <span>{data.flagEmoji}</span>
              {tFr("heroEyebrow").replace("{country}", data.name)}
            </p>
            <h1 class="display mt-4" style="font-size: clamp(2.25rem, 5vw, 4.25rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;">
              {data.tagline}
            </h1>
            <p class="serif mt-5 max-w-[44rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">{data.intro}</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={localizedPath(locale, "/contact")} class="inline-flex items-center gap-2 font-semibold px-6 py-3 rounded-full" style="background: var(--color-accent); color: var(--color-bg);">
                {tFr("heroCtaPrimary")}
              </a>
              <a href={localizedPath(locale, "/insurance")} class="inline-flex items-center gap-2 font-semibold px-6 py-3 rounded-full border transition-colors hover:border-ink" style="border-color: var(--color-border); color: var(--color-ink);">
                {tFr("heroCtaSecondary")}
              </a>
            </div>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
            <img
              src={patientHero(`from-${countrySlug}`, regionForCountry(countrySlug), 600)}
              alt={tFr("heroImgAlt").replace("{country}", data.name)}
              width="600"
              height="750"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 16px; inset-inline-end: 16px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">
                {data.flagEmoji} {data.name} → MedCasts hospitals
              </div>
              <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">
                {tFr("imageCaption")}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wait times -->
    <section class="py-14">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tFr("waitEyebrow")}</p>
        <h2 class="display mb-8" style="font-size: 32px; letter-spacing: -0.02em;">{tFr("waitHeading").replace("{country}", data.name)}</h2>
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {data.waitStats.map((s) => {
            const pct = Math.min((s.waitWeeks / maxWait) * 100, 100);
            return (
              <li class="paper" style="padding: 20px;">
                <div class="flex items-baseline justify-between gap-2">
                  <p class="serif text-xl" style="letter-spacing: -0.01em;">{s.procedure}</p>
                  <p class="mono tnum text-[13px]" style="color: var(--color-accent);">{s.waitWeeks} {tFr("weeksAbbr")}</p>
                </div>
                <div class="w-full rounded-full h-2 mt-3" style="background: var(--color-border);">
                  <div class="h-2 rounded-full" style={{width: `${pct}%`, background: "var(--color-accent)"}}></div>
                </div>
                <p class="mt-2 text-[11px]" style="color: var(--color-ink-subtle);">{s.note}</p>
              </li>
            );
          })}
        </ul>
        <p class="mt-6 text-[13px]" style="color: var(--color-ink-subtle);">{tFr("waitCompareNote")}</p>
      </div>
    </section>

    <!-- Packages -->
    <section style="background: var(--color-paper); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8 py-14">
        <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tFr("packagesEyebrow")}</p>
        <h2 class="display mb-8" style="font-size: 32px; letter-spacing: -0.02em;">{tFr("packagesHeading").replace("{country}", data.name)}</h2>
        <ul class="grid gap-5 md:grid-cols-3">
          {data.packages.map((pkg) => (
            <li class="paper" style={{padding: "24px", borderTop: `3px solid ${tierColors[pkg.tier]}`}}>
              <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">{pkg.tier}</p>
              <h3 class="serif mt-3" style="font-size: 22px; font-weight: 500; letter-spacing: -0.015em;">{pkg.label}</h3>
              <p class="mt-2 text-[14px]" style="color: var(--color-ink-muted); line-height: 1.55;">{pkg.desc}</p>
              <ul class="mt-4 space-y-1.5">
                {pkg.includes.map((item) => (
                  <li class="flex items-start gap-2 text-[13px]" style="color: var(--color-ink-muted);">
                    <span style="color: var(--color-accent); line-height: 1.6;">—</span>
                    {item}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Insurers -->
    <section class="py-14">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tFr("insuranceEyebrow")}</p>
        <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
          <div>
            <h2 class="display" style="font-size: 32px; letter-spacing: -0.02em;">{tFr("insuranceHeading")}</h2>
            <p class="mt-4 serif max-w-[36rem]" style="font-size: 17px; line-height: 1.5; color: var(--color-ink-muted);">
              {tFr("insuranceLede").replace("{country}", data.name)}
            </p>
            <a href={localizedPath(locale, "/insurance")} class="inline-flex items-center gap-2 font-semibold px-6 py-3 rounded-full border mt-7 transition-colors hover:border-ink" style="border-color: var(--color-border); color: var(--color-ink);">
              {tFr("insuranceLink")}
            </a>
          </div>
          <ul class="space-y-3">
            {data.insuranceCompanies.map((ins) => (
              <li class="paper" style="padding: 18px;">
                <p class="serif text-base" style="letter-spacing: -0.005em;">{ins.name}</p>
                <p class="mt-1 text-[13px]" style="color: var(--color-ink-muted);">{ins.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Coverage check -->
    <section style="background: var(--color-paper); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8 py-14">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tFr("coverageCheckEyebrow")}</p>
            <h2 class="display" style="font-size: 32px; letter-spacing: -0.02em;">{tFr("coverageCheckHeading")}</h2>
            <p class="mt-4" style="font-size: 15px; color: var(--color-ink-muted); line-height: 1.6;">
              {tFr("coverageCheckBody")}
            </p>
          </div>
          <div class="paper" style="padding: 24px; box-shadow: var(--shadow-md);">
            <p class="mono uppercase mb-4" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">{tFr("formEyebrow")}</p>
            <form id="from-inquiry-form" class="space-y-4">
              <input type="hidden" name="source" value={`/from/${countrySlug}`} />
              <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--color-ink-muted);">{tFr("formLabelName")}</label>
                <input type="text" name="name" required autocomplete="name" class="w-full px-4 py-3 border rounded-lg text-sm" style="border-color: var(--color-border);" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-sm font-medium mb-1" style="color: var(--color-ink-muted);">{tFr("formLabelEmail")}</label>
                  <input type="email" name="email" autocomplete="email" class="w-full px-4 py-3 border rounded-lg text-sm" style="border-color: var(--color-border);" />
                </div>
                <div>
                  <label class="block text-sm font-medium mb-1" style="color: var(--color-ink-muted);">{tFr("formLabelPhone")}</label>
                  <input type="tel" name="phone" required autocomplete="tel" class="w-full px-4 py-3 border rounded-lg text-sm" style="border-color: var(--color-border);" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium mb-1" style="color: var(--color-ink-muted);">{tFr("formLabelInsurer")}</label>
                <input type="text" name="condition" placeholder={tFr("formPlaceholderInsurer")} class="w-full px-4 py-3 border rounded-lg text-sm" style="border-color: var(--color-border);" />
              </div>
              <div id="from-submit-result" class="hidden p-4 rounded-xl text-center" style="background: var(--color-accent-soft);">
                <p class="font-semibold" style="color: var(--color-accent);">{tFr("formSuccessTitle")}</p>
                <p class="mt-1 text-sm" style="color: var(--color-ink-muted);">{tFr("formSuccessBody")}</p>
              </div>
              <button type="submit" class="w-full py-3.5 rounded-lg font-semibold transition-colors" style="background: var(--color-accent); color: var(--color-bg);">
                {tFr("formSubmitBtn")}
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-14">
      <div class="mx-auto w-full max-w-[60rem] px-5 md:px-8">
        <p class="mono uppercase mb-3" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tFr("faqEyebrow")}</p>
        <h2 class="display mb-6" style="font-size: 32px; letter-spacing: -0.02em;">{tFr("faqHeading").replace("{country}", data.name)}</h2>
