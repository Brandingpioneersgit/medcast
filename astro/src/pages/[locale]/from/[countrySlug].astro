      { tier: "standard", label: "Coordinated Care", desc: "Clinical care plus travel, accommodation and help filing an NHIF or private overseas-treatment claim.", includes: ["Everything in Referral Pathway", "Return flights for patient + 1 attendant", "Hotel near hospital (up to 10 nights)", "NHIF / insurer claim documentation support", "In-person care coordinator"] },
      { tier: "premium", label: "Concierge Care", desc: "Private room, named surgeon, family accommodation and follow-up coordination once you are home.", includes: ["Everything in Coordinated Care", "Private hospital room", "Named consultant + second opinion", "Accommodation for up to 3 family members", "6-month follow-up coordination in Kenya"] },
    ],
    waitStats: [
      { procedure: "Paediatric cardiac surgery", waitWeeks: 44, note: "Long queues at the few centres performing it" },
      { procedure: "Radiotherapy (cancer)", waitWeeks: 30, note: "Limited number of functioning radiotherapy machines" },
      { procedure: "Kidney transplant", waitWeeks: 40, note: "Programme growing but capacity-limited" },
      { procedure: "Cardiac bypass surgery", waitWeeks: 26, note: "Tertiary cardiac-surgery capacity concentrated in Nairobi" },
