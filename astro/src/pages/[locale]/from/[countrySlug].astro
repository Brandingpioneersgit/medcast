      { procedure: "Kidney transplant", waitWeeks: 44, note: "Programmes limited; most patients referred abroad" },
      { procedure: "IVF / advanced fertility", waitWeeks: 20, note: "Available but variable; many travel for higher success rates" },
      { procedure: "Complex orthopaedic surgery", waitWeeks: 28, note: "Specialist availability and implant supply inconsistent" },
      { procedure: "Bone marrow transplant", waitWeeks: 52, note: "Minimal domestic capacity" },
