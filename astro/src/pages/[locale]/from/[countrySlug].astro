export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const countrySlug = Astro.params.countrySlug;
if (!isLocale(rawLocale)) return Astro.redirect("/en/from/united-kingdom", 308);
if (!countrySlug) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
