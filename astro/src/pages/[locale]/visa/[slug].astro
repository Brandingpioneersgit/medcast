---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { db } from "@/lib/db";
import { countries } from "../../../../../src/lib/db/schema";
import { eq, sql } from "drizzle-orm";
import { listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, faqJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, applyTranslated, isUntranslated } from "@/lib/translate";
import { ChevronRight, AlertCircle } from "lucide-react";
import TravelLogisticsSection from "@/components/content/TravelLogisticsSection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/visa/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tV = getTranslator(locale, "visaDetailPage");

const country = await db.query.countries.findFirst({ where: eq(countries.slug, slug) });
if (!country) return new Response(`Not found: ${slug}`, { status: 404 });

type VisaRow = {
  id: number;
  visa_required: boolean;
  visa_type: string | null;
  processing_time_days: number | null;
  duration_days: number | null;
  extendable: boolean;
  allows_attendants: boolean;
  overview: string | null;
  requirements: string | null;
  tips: string | null;
  embassy_url: string | null;
  updated_at: Date | null;
  last_verified_at: Date | null;
};
// `last_verified_at` is added by scripts/migrations/2026-05-05-visa-last-verified.sql.
// Until that's applied, the column resolves to NULL and we fall back to updated_at.
const visaRes = await db.execute(sql`
  SELECT id, visa_required, visa_type, processing_time_days, duration_days,
         extendable, allows_attendants, overview, requirements, tips, embassy_url, updated_at,
         (CASE WHEN EXISTS (
            SELECT 1 FROM information_schema.columns
            WHERE table_name = 'visa_info' AND column_name = 'last_verified_at'
          ) THEN
            (SELECT last_verified_at FROM visa_info WHERE country_id = ${country.id})
          ELSE NULL END) AS last_verified_at
  FROM visa_info WHERE country_id = ${country.id}
`).catch(() => [] as unknown[]);
const rawVisa: VisaRow | null = Array.from(visaRes as Iterable<VisaRow>)[0] ?? null;
const visaMap = rawVisa ? await getContent("visa_info", rawVisa.id, locale).catch(() => ({})) : {};
const visa = rawVisa ? applyTranslated(rawVisa, visaMap, ["overview", "requirements", "tips"]) : null;

const linkables = await listLinkableEntities().catch(() => []);
function linkifyText(s: string | null | undefined): string {
  if (!s) return "";
  const safe = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return linkifyBlogHtml(`<p>${safe}</p>`, linkables, (p: string) => localizedPath(locale, p)).html;
}
const overviewHtml = linkifyText(visa?.overview);
const tipsHtml = linkifyText(visa?.tips);
const visaUntranslated = isUntranslated(locale, visaMap);

type CountRow = { c: number };
const hospitalCount = await db
  .execute(sql`
    SELECT COUNT(*)::int AS c
    FROM hospitals h
    JOIN cities ci ON ci.id = h.city_id
    WHERE ci.country_id = ${country.id} AND h.is_active = true
  `)
  .catch(() => [] as unknown[]);
const countHospitals = Array.from(hospitalCount as Iterable<CountRow>)[0]?.c ?? 0;

const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
const flag = FLAG[country.slug] ?? "🌐";

const reqList = (visa?.requirements ?? "")
  .split(/\s*·\s*/)
  .map((s) => s.trim())
  .filter(Boolean);

const faqList = [
  {
    question: tV("faq1Q").replace("{countryName}", country.name),
    answer: visa?.visa_required
      ? tV("faq1AYes").replace("{countryName}", country.name).replace("{visaType}", visa.visa_type ?? "Medical Visa").replace("{days}", String(visa.processing_time_days ?? "3-5"))
      : tV("faq1ANo").replace("{countryName}", country.name),
  },
  {
    question: tV("faq2Q"),
    answer: visa?.duration_days
      ? (tV("faq2AWithData").replace("{days}", String(visa.duration_days)).replace("{extendable}", visa.extendable ? tV("faq2AExtendable") : tV("faq2ANonExtendable")).replace("{attendants}", visa.allows_attendants ? tV("faq2AAttendants") : "")).trim()
      : tV("faq2AFallback").replace("{countryName}", country.name),
  },
  {
    question: tV("faq3Q"),
    answer: visa?.allows_attendants
      ? tV("faq3AYes").replace("{countryName}", country.name)
      : tV("faq3ANo").replace("{countryName}", country.name),
  },
  {
    question: tV("faq4Q"),
    answer: tV("faq4A"),
  },
  {
    question: tV("faq5Q"),
    answer: tV("faq5A"),
  },
];

const seoTitle = tV("seoTitle").replace("{countryName}", country.name);
const seoDescription = visa?.overview?.slice(0, 160) ??
  (visa?.visa_type && visa?.processing_time_days
    ? tV("seoDescFallback").replace("{countryName}", country.name).replace("{visaType}", visa.visa_type).replace("{processingTime}", `Processed in ~${visa.processing_time_days} days.`)
    : visa?.visa_type
    ? tV("seoDescFallbackNoProcessing").replace("{countryName}", country.name).replace("{visaType}", visa.visa_type)
    : visa?.processing_time_days
    ? tV("seoDescFallbackNoType").replace("{countryName}", country.name).replace("{processingTime}", `Processed in ~${visa.processing_time_days} days.`)
    : tV("seoDescFallbackMinimal").replace("{countryName}", country.name));

const path = `/visa/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: country.name, url: localeUrl(locale, `/country/${country.slug}`) },
  { name: tV("breadcrumb"), url },
]);
const faqSchema = faqJsonLd(faqList);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={visaUntranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    {/* Breadcrumb */}
    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, `/country/${country.slug}`)} class="hover:text-ink">{country.name}</a>
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">{tV("breadcrumb")}</span>
      </nav>
    </div>

    {/* Hero */}
    <section style="padding: 56px 28px;">
      <div class="mx-auto max-w-[1440px] grid gap-10 lg:grid-cols-[2fr_1fr] items-start">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 12px;">
            {tV("heroEyebrow")}
          </div>
          <h1
            class="display display-tight"
            style="font-size: clamp(2.5rem, 5.5vw, 4rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
          >
            {country.name} <span style="font-style: italic;">{tV("heroTitleItalic")}</span>
          </h1>
          <div class="flex items-center gap-3 mt-4" style="color: var(--color-ink-muted); font-size: 14px;">
            <span>{flag}</span>
            <span>{tV("activeHospitals").replace("{count}", countHospitals.toLocaleString())}</span>
            {visa?.updated_at && (
              <>
                <span style="width: 3px; height: 3px; border-radius: 50%; background: var(--color-border);" aria-hidden="true" />
                <span class="mono" style="font-size: 11.5px; color: var(--color-ink-subtle);">
                  {tV("verifiedDate").replace("{date}", new Date(visa.updated_at).toLocaleDateString("en-US", { month: "short", year: "numeric" }))}
                </span>
              </>
            )}
          </div>

          {visa?.overview && (
            <div class="serif mt-6 max-w-[680px]" style="font-size: 20px; line-height: 1.45; color: var(--color-ink-muted);" set:html={overviewHtml} />
          )}

          <div
            class="grid mt-8 py-5"
            style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
          >
            {[
              visa?.visa_type && { l: tV("statVisaType"), v: visa.visa_type.split("(")[0].trim() },
              visa?.processing_time_days && { l: tV("statProcessing"), v: tV("statDays").replace("{n}", String(visa.processing_time_days)) },
              visa?.duration_days && { l: tV("statDuration"), v: tV("statDays").replace("{n}", String(visa.duration_days)) },
              { l: tV("statExtendable"), v: visa?.extendable ? tV("yes") : tV("no") },
            ].filter(Boolean).map((s: any, i: number) => (
              <div style={`padding-inline: 18px; ${i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}`}>
                <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{s.l}</div>
                <div class="display tnum" style="font-size: 22px; margin-top: 4px;">{s.v}</div>
              </div>
            ))}
          </div>
        </div>

        <aside class="lg:sticky lg:top-32 lg:self-start">
          <div class="paper" style="padding: 22px;">
            <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
              {tV("asideEyebrow")}
            </div>
            <div class="display mt-1.5" style="font-size: 22px; letter-spacing: -0.02em; line-height: 1.2;">
              {tV("asideHeading")}
              <span style="font-style: italic;"> {tV("asideHeadingItalic")}</span>
            </div>
            <p style="font-size: 13.5px; color: var(--color-ink-muted); margin-top: 10px; line-height: 1.55;">
              {tV("asideBody")}
            </p>
            <a
              href={localizedPath(locale, `/contact?country=${country.slug}&topic=visa`)}
              class="inline-flex items-center justify-center gap-2 w-full mt-4 font-semibold"
              style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 14.5px; border-radius: 9999px;"
            >
              {tV("asideCta")}
              <ChevronRight className="h-3.5 w-3.5 mirror-x" />
            </a>
            {visa?.embassy_url && (
              <a
                href={visa.embassy_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full mt-2 font-medium"
                style="background: transparent; color: var(--color-ink); border: 1px solid var(--color-border); padding: 9px 14px; font-size: 13px; border-radius: 9999px;"
              >
                {tV("embassyLink")}
              </a>
            )}
          </div>
        </aside>
      </div>
    </section>

    {reqList.length > 0 && (
      <section style="padding: 48px 28px; background: var(--color-paper); border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1120px]">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tV("requirementsEyebrow")}</div>
              <h2 class="display mt-3" style="font-size: 30px; letter-spacing: -0.02em;">{tV("requirementsHeading")}</h2>
            </div>
            <ul class="grid gap-2.5">
              {reqList.map((r) => (
                <li class="flex items-start gap-3 serif" style="font-size: 15.5px; line-height: 1.5;">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--color-accent)" stroke-width="2" class="mt-1 shrink-0"><path d="M3 8l3 3 7-7"/></svg>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {visa?.tips && (
      <section style="padding: 48px 28px; border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1120px]">
          <div class="paper" style="padding: 28px; background: var(--color-accent-mist); border: 1px solid var(--color-accent-soft);">
            <div class="flex items-start gap-4">
              <AlertCircle className="h-5 w-5 shrink-0 mt-1" />
              <div>
                <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">{tV("tipsEyebrow")}</div>
                <div class="serif mt-2" style="font-size: 17px; line-height: 1.5; color: var(--color-ink);" set:html={tipsHtml} />
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section style="padding: 56px 28px; border-top: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1120px]">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 12px;">
          {tV("stepsEyebrow")}
        </div>
        <h2 class="display" style="font-size: 30px; letter-spacing: -0.02em;">
          {tV("stepsHeading")}
        </h2>

        <ol class="mt-8">
          {[
            { k: tV("step01Key"), t: tV("step01Title"), d: tV("step01Desc"), dur: tV("step01Dur") },
            { k: tV("step02Key"), t: tV("step02Title"), d: tV("step02Desc").replace("{countryName}", country.name), dur: tV("step02Dur") },
            { k: tV("step03Key"), t: tV("step03Title"), d: (visa?.processing_time_days ? tV("step03Desc").replace("{visaType}", visa?.visa_type ?? tV("heroTitleItalic")).replace("{processingNote}", tV("step03ProcessingNote").replace("{n}", String(visa.processing_time_days))) : tV("step03DescNoProcessing").replace("{visaType}", visa?.visa_type ?? tV("heroTitleItalic"))), dur: visa?.processing_time_days ? tV("step03Dur").replace("{end}", String(6 + visa.processing_time_days)) : tV("step03DurFallback") },
            { k: tV("step04Key"), t: tV("step04Title"), d: tV("step04Desc"), dur: tV("step04Dur") },
            { k: tV("step05Key"), t: tV("step05Title"), d: tV("step05Desc"), dur: tV("step05Dur") },
          ].map((step, i) => (
            <li
              class="grid items-start gap-4"
              style={`grid-template-columns: 56px 1fr 140px; padding: 20px 0; border-top: ${i > 0 ? "1px solid var(--color-border-soft)" : "1px solid var(--color-ink)"};`}
            >
              <div class="mono display tnum" style="font-size: 26px; color: var(--color-ink-subtle);">{step.k}</div>
              <div>
                <div class="serif" style="font-size: 20px; font-weight: 500; letter-spacing: -0.015em;">{step.t}</div>
                <div style="font-size: 14px; color: var(--color-ink-muted); margin-top: 4px; max-width: 520px;">{step.d}</div>
              </div>
              <div class="mono" style="font-size: 12px; color: var(--color-ink-subtle); text-align: end; padding-top: 8px;">{step.dur}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section style="padding: 56px 28px; border-top: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[0.35fr_1fr]">
        <div>
          <div class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);">{tV("faqEyebrow")}</div>
          <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
            {tV("faqHeading")}
          </h2>
        </div>
        <div class="divide-y" style="border-color: var(--color-border-soft);">
          {faqList.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-start justify-between gap-6">
                <span class="serif" style="font-size: 17px; font-weight: 500; line-height: 1.4;">{f.question}</span>
                <span class="mt-1 shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;" aria-hidden="true">+</span>
              </summary>
              <p class="serif mt-3" style="color: var(--color-ink-muted); font-size: 15.5px; line-height: 1.6;">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* Travel + recovery context for this destination */}
    <TravelLogisticsSection
      countryName={country.name}
      countrySlug={country.slug}
    />

    {/* EEAT signals — methodology + corrections */}
    <MethodologyBlock locale={locale}
      curationNote={tV("methodologyCurationNote").replace("{countryName}", country.name)}
      dataSources={[
        tV("methodologySource1").replace("{countryName}", country.name),
        tV("methodologySource2"),
        tV("methodologySource3"),
      ]}
    />

    <section style="padding: 72px 28px; border-top: 1px solid var(--color-border); background: var(--color-ink); color: var(--color-bg);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">{tV("ctaBottomEyebrow")}</div>
          <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
            {tV("ctaBottomHeading").replace("{countryName}", country.name).replace("{flag}", flag)}
            <span style="font-style: italic;"> {tV("ctaBottomHeadingItalic")}</span>
          </h2>
          <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
            {tV("ctaBottomBody")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={localizedPath(locale, `/contact?country=${country.slug}&topic=visa`)}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {tV("ctaBottomStart")}
            <ChevronRight className="h-4 w-4 mirror-x" />
          </a>
          <a
            href={localizedPath(locale, `/country/${country.slug}`)}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {tV("ctaBottomBrowse").replace("{countryName}", country.name)}
          </a>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tV("howItWorksHeading").replace("{countryName}", country.name)}
      italicWord={tV("howItWorksItalicWord").replace("{countryName}", country.name)}
      eyebrow={tV("howItWorksEyebrow")}
      steps={[
        { title: tV("howStep1Title"), description: tV("howStep1Desc") },
        { title: tV("howStep2Title"), description: tV("howStep2Desc").replace("{countryName}", country.name) },
        { title: tV("howStep3Title"), description: tV("howStep3Desc") },
        { title: tV("howStep4Title"), description: tV("howStep4Desc") },
        { title: tV("howStep5Title"), description: tV("howStep5Desc") },
      ]}
      outroNote={tV("howOutroNote").replace("{countryName}", country.name)}
    />

    <WhatToExpect
      heading={tV("whatHeading")}
      italicWord={tV("whatItalicWord")}
      items={[
        { label: tV("whatItem1Label"), description: tV("whatItem1Desc") },
        { label: tV("whatItem2Label"), description: tV("whatItem2Desc") },
        { label: tV("whatItem3Label"), description: tV("whatItem3Desc") },
        { label: tV("whatItem4Label"), description: tV("whatItem4Desc") },
        { label: tV("whatItem5Label"), description: tV("whatItem5Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tV("exploreEyebrow").replace("{countryName}", country.name)}
      heading={tV("exploreHeading").replace("{countryName}", country.name)}
      lede={tV("exploreLede")}
      items={[
        { eyebrow: tV("exploreItem1Eyebrow"), label: tV("exploreItem1Label").replace("{countryName}", country.name), href: `/country/${country.slug}`, hint: tV("exploreItem1Hint").replace("{countryName}", country.name) },
        { eyebrow: tV("exploreItem2Eyebrow"), label: tV("exploreItem2Label").replace("{countryName}", country.name), href: `/hospitals/country/${country.slug}`, hint: tV("exploreItem2Hint") },
        { eyebrow: tV("exploreItem3Eyebrow"), label: tV("exploreItem3Label").replace("{countryName}", country.name), href: `/doctors/country/${country.slug}`, hint: tV("exploreItem3Hint") },
        { eyebrow: tV("exploreItem4Eyebrow"), label: tV("exploreItem4Label"), href: "/countries", hint: tV("exploreItem4Hint") },
        { eyebrow: tV("exploreItem5Eyebrow"), label: tV("exploreItem5Label"), href: "/calculator", hint: tV("exploreItem5Hint") },
        { eyebrow: tV("exploreItem6Eyebrow"), label: tV("exploreItem6Label"), href: "/pricing-index", hint: tV("exploreItem6Hint") },
        { eyebrow: tV("exploreItem7Eyebrow"), label: tV("exploreItem7Label"), href: "/compare/countries", hint: tV("exploreItem7Hint") },
        { eyebrow: tV("exploreItem8Eyebrow"), label: tV("exploreItem8Label"), href: "/match-me", hint: tV("exploreItem8Hint") },
        { eyebrow: tV("exploreItem9Eyebrow"), label: tV("exploreItem9Label"), href: "/treatments", hint: tV("exploreItem9Hint") },
