---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listTestimonials } from "@/lib/queries";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { ShieldCheck } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/stories", 308);
const locale = rawLocale as Locale;

const rawStories = await listTestimonials(72);
const tc = getTranslator(locale, "common");
const tSt = getTranslator(locale, "storiesPage");

// Localize testimonials + their joined treatment/hospital/country names for
// non-default locales (getContentBatch returns {} on `en` — no-op there).
const testimonialTx = await getContentBatch("testimonial", rawStories.map((s) => s.id), locale);
const storyTreatmentTx = await getContentBatch(
  "treatment",
  rawStories.map((s) => s.treatment_id).filter((id): id is number => id != null),
  locale,
);
const storyHospitalTx = await getContentBatch(
  "hospital",
  rawStories.map((s) => s.hospital_id).filter((id): id is number => id != null),
  locale,
);
const storyCountryTx = await getContentBatch(
  "country",
  rawStories.map((s) => s.country_id).filter((id): id is number => id != null),
  locale,
);
const stories = rawStories.map((s) => ({
  ...applyTranslated(s, testimonialTx[s.id] ?? {}, ["title", "story", "patient_name"]),
  treatment_name: (s.treatment_id != null ? storyTreatmentTx[s.treatment_id]?.name : undefined) ?? s.treatment_name,
  hospital_name: (s.hospital_id != null ? storyHospitalTx[s.hospital_id]?.name : undefined) ?? s.hospital_name,
  country_name: (s.country_id != null ? storyCountryTx[s.country_id]?.name : undefined) ?? s.country_name,
}));

const verifiedCount = stories.filter((s) => s.is_verified).length;
const countryCount = new Set(stories.map((s) => s.patient_country).filter(Boolean)).size;
const path = "/stories";

const seoTitle = tSt("seoTitle");
const seoDescription = tSt("seoDescription")
  .replace("{count}", stories.length.toLocaleString())
  .slice(0, 160);

// Empty until testimonials are loaded — don't index a hollow page. Also skip
// indexing a non-default locale when none of the stories are translated.
const shouldNoindex = stories.length === 0 || isUntranslated(locale, ...Object.values(testimonialTx));

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tSt("breadcrumbStories"), url: localeUrl(locale, path) },
]);

// Collect the treatments these stories relate to — an honest CollectionPage
// of procedure experiences. No self-serving Review markup on our own page.
const treatmentItems = Array.from(
  new Map(
    stories
      .filter((s) => s.treatment_slug && s.treatment_name)
      .map((s) => [s.treatment_slug!, { name: s.treatment_name!, url: localeUrl(locale, `/treatment/${s.treatment_slug}`) }]),
  ).values(),
);
const collectionLd =
  treatmentItems.length > 0
    ? withProvenance(
        collectionPageJsonLd({
          name: tSt("breadcrumbStories"),
          description: seoDescription,
          url: localeUrl(locale, path),
          items: treatmentItems,
        }),
        { dateModified: new Date() },
      )
    : null;

const stats =
  stories.length > 0
    ? [
        { l: tSt("statStories"), v: stories.length.toLocaleString() },
        { l: tSt("statVerified"), v: verifiedCount.toLocaleString() },
        { l: tSt("statHomeCountries"), v: countryCount.toLocaleString() },
        { l: tSt("statReplyTime"), v: "9 min" },
      ]
    : [];

function initials(name: string): string {
  return name.trim().split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase() || "P";
}
function excerpt(s: string, n = 280): string {
  const clean = s.trim();
  return clean.length > n ? `${clean.slice(0, n).trimEnd()}…` : clean;
}
function storyYear(d: Date | null): string {
  return d ? new Date(d).getFullYear().toString() : "";
}

Astro.response.headers.set("Cache-Control", "public, s-maxage=1800, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={shouldNoindex} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {collectionLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tSt("breadcrumbStories")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tSt("eyebrow")}
      h1First={tSt("h1First")}
      h1Italic={tSt("h1Italic")}
      lede={tSt("lede")}
      stats={stats}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-6 pb-20">
      <h2 class="sr-only">{tSt("srOnlyH2")}</h2>
      {stories.length === 0 ? (
        <div class="paper text-center py-20" style="color: var(--color-ink-muted);">
          <p class="serif text-lg mb-3">{tSt("emptyStateMain")}</p>
          <p class="text-sm mb-5">{tSt("emptyStateDesc")}</p>
          <div class="flex items-center justify-center gap-3">
            <a
              href={localizedPath(locale, "/medical-board")}
              class="mono uppercase"
              style="font-size: 11px; letter-spacing: 0.12em; border: 1px solid var(--color-border); padding: 9px 16px; border-radius: 9999px; color: var(--color-ink);"
            >
              {tSt("emptyStateMedBoard")}
            </a>
            <a
              href={localizedPath(locale, "/match-me")}
              class="mono uppercase"
              style="font-size: 11px; letter-spacing: 0.12em; background: var(--color-ink); color: var(--color-bg); padding: 9px 16px; border-radius: 9999px;"
            >
              {tSt("emptyStateStartCase")}
            </a>
          </div>
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {stories.map((s) => {
            const year = storyYear(s.treatment_date);
            return (
              <li class="paper flex h-full flex-col" style="padding: 24px;">
                <div class="flex items-center gap-3">
                  {s.image_url ? (
                    <img
                      src={s.image_url}
                      alt={s.patient_name}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-border"
                    />
                  ) : (
                    <span
                      class="serif inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full"
                      style="background: var(--color-accent-soft, #0a5d541a); color: var(--color-accent); font-size: 17px;"
                      aria-hidden="true"
                    >
                      {initials(s.patient_name)}
                    </span>
                  )}
                  <div class="min-w-0">
                    <div class="serif" style="font-size: 16px; line-height: 1.2; color: var(--color-ink);">
                      {s.patient_name}
                    </div>
                    <div class="mono uppercase mt-0.5" style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {[s.patient_country, s.patient_age ? tSt("ageLabel").replace("{age}", String(s.patient_age)) : null].filter(Boolean).join(" · ")}
                    </div>
                  </div>
                </div>

                <div class="mt-3 flex items-center gap-2">
                  <span class="tnum" style="color: var(--color-saffron); letter-spacing: 0.05em;" aria-label={`${s.rating} out of 5`}>
                    {"★".repeat(Math.max(0, Math.min(5, s.rating)))}<span style="color: var(--color-border);">{"★".repeat(Math.max(0, 5 - Math.min(5, s.rating)))}</span>
                  </span>
                  {s.is_verified && (
                    <span class="inline-flex items-center gap-1 mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-accent);">
                      <ShieldCheck className="h-3 w-3" /> {tSt("verifiedBadge")}
                    </span>
                  )}
                </div>

                {s.title && (
                  <h3 class="serif mt-3" style="font-size: 18px; line-height: 1.3; letter-spacing: -0.005em; color: var(--color-ink);">
                    {s.title}
                  </h3>
                )}
                <p class="mt-2 text-[14px]" style="line-height: 1.6; color: var(--color-ink-muted);">
                  {excerpt(s.story)}
                </p>

                <div
                  class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-4"
                  style="border-top: 1px dashed var(--color-border); margin-top: 16px; font-size: 12.5px;"
                >
                  {s.treatment_slug && s.treatment_name && (
                    <a
                      href={localizedPath(locale, `/treatment/${s.treatment_slug}`)}
                      class="hover:text-accent"
                      style="color: var(--color-ink);"
                    >
                      {s.treatment_name}
                    </a>
                  )}
                  {s.hospital_slug && s.hospital_name && (
                    <>
                      <span style="color: var(--color-border);">·</span>
                      <a
                        href={localizedPath(locale, `/hospital/${s.hospital_slug}`)}
                        class="hover:text-accent line-clamp-1"
                        style="color: var(--color-ink-muted);"
                      >
                        {s.hospital_name}
                      </a>
                    </>
                  )}
                  {year && (
                    <>
                      <span style="color: var(--color-border);">·</span>
                      <span class="mono tnum" style="color: var(--color-ink-subtle); font-size: 11px;">{year}</span>
                    </>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <HowItWorks
      heading={tSt("howHeading")}
      italicWord={tSt("howItalicWord")}
      eyebrow={tSt("howEyebrow")}
      steps={[
        { title: tSt("howStep1Title"), description: tSt("howStep1Desc") },
        { title: tSt("howStep2Title"), description: tSt("howStep2Desc") },
        { title: tSt("howStep3Title"), description: tSt("howStep3Desc") },
        { title: tSt("howStep4Title"), description: tSt("howStep4Desc") },
      ]}
      outroNote={tSt("howOutroNote")}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tSt("exploreEyebrow")}
      heading={tSt("exploreHeading")}
      lede={tSt("exploreLede")}
      items={[
        { eyebrow: tSt("exploreItem0Eyebrow"), label: tSt("exploreItem0Label"), href: "/gallery", hint: tSt("exploreItem0Hint") },
        { eyebrow: tSt("exploreItem1Eyebrow"), label: tSt("exploreItem1Label"), href: "/match-me", hint: tSt("exploreItem1Hint") },
        { eyebrow: tSt("exploreItem2Eyebrow"), label: tSt("exploreItem2Label"), href: "/calculator", hint: tSt("exploreItem2Hint") },
        { eyebrow: tSt("exploreItem3Eyebrow"), label: tSt("exploreItem3Label"), href: "/treatments", hint: tSt("exploreItem3Hint") },
        { eyebrow: tSt("exploreItem4Eyebrow"), label: tSt("exploreItem4Label"), href: "/countries", hint: tSt("exploreItem4Hint") },
        { eyebrow: tSt("exploreItem5Eyebrow"), label: tSt("exploreItem5Label"), href: "/medical-board", hint: tSt("exploreItem5Hint") },
        { eyebrow: tSt("exploreItem6Eyebrow"), label: tSt("exploreItem6Label"), href: "/editorial-policy", hint: tSt("exploreItem6Hint") },
        { eyebrow: tSt("exploreItem7Eyebrow"), label: tSt("exploreItem7Label"), href: "/second-opinion", hint: tSt("exploreItem7Hint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
