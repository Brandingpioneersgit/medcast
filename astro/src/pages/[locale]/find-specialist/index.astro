---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { db } from "@/lib/db";
import {
  specialties as specialtiesTbl,
  countries as countriesTbl,
  conditions as conditionsTbl,
} from "../../../../../src/lib/db/schema";
import { asc, eq } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_NAME, SITE_URL } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { heroImage, careTeam } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/find-specialist", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tFs = getTranslator(locale, "findSpecialistPage");

const [specialties, countries, conditions] = await Promise.all([
  db.select({ slug: specialtiesTbl.slug, name: specialtiesTbl.name }).from(specialtiesTbl).where(eq(specialtiesTbl.isActive, true)).orderBy(asc(specialtiesTbl.name)),
  db.select({ slug: countriesTbl.slug, name: countriesTbl.name }).from(countriesTbl).where(eq(countriesTbl.isDestination, true)).orderBy(asc(countriesTbl.name)),
  db.select({ slug: conditionsTbl.slug, name: conditionsTbl.name }).from(conditionsTbl).orderBy(asc(conditionsTbl.name)),
]);

const seoTitle = tFs("seoTitle");
const seoDescription = tFs("seoDescription");
const path = "/find-specialist";
// /api/v1/inquiry redirects back here with ?sent=1 after a successful submit.
const sent = new URL(Astro.request.url).searchParams.get("sent") === "1";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tFs("breadcrumb"), url: localeUrl(locale, path) },
]);

const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  description: seoDescription,
  url: localeUrl(locale, path),
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "medcastsdigital@gmail.com",
        availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"],
      },
      {
        "@type": "ContactPoint",
        contactType: "specialist matching",
        telephone: "+918006210000",
        availableLanguage: ["en", "ar", "hi"],
      },
    ],
  },
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={locale !== "en"} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px] flex items-center gap-2 flex-wrap" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
        <span style="color: var(--color-ink);">{tFs("breadcrumb")}</span>
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto" style="max-width: 1120px;">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.6fr] lg:items-center">
          <div>
            <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tFs("heroEyebrow")}</div>
            <h1 class="display display-tight mt-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
              {tFs("heroHeadingMain")} <span class="italic-display">{tFs("heroHeadingItalic")}</span>
            </h1>
            <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">
              {tFs("heroBody")}
            </p>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
            <img
              src={heroImage("find-specialist")}
              alt={tFs("heroImageAlt")}
              width="600"
              height="750"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 16px; inset-inline-end: 16px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tFs("imageOverlaySub")}</div>
              <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">{tFs("imageOverlayMain")}</div>
            </div>
          </div>
        </div>
      </div>
      <div class="mx-auto mt-12" style="max-width: 800px;">

        {sent ? (
          <div class="paper mt-10" style="padding: 32px; box-shadow: var(--shadow-md);">
            <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">Request received</div>
            <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.02em; line-height: 1.15;">Thank you — we're matching your case</h2>
            <p class="serif mt-3" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted);">
              A senior coordinator will shortlist sub-specialists for your condition and reach out within a few hours during business hours.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={localizedPath(locale, "/surgeons")} class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; border: 1px solid var(--color-border); padding: 10px 18px; border-radius: 9999px; color: var(--color-ink);">Browse surgeons meanwhile</a>
              <a href={localizedPath(locale, "/second-opinion")} class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; background: var(--color-ink); color: var(--color-bg); padding: 10px 18px; border-radius: 9999px;">Free second opinion →</a>
            </div>
          </div>
        ) : (
        <form
          action="/api/v1/inquiry"
          method="post"
          class="paper mt-10"
          style="padding: 0; box-shadow: var(--shadow-md); overflow: hidden;"
        >
          <input type="hidden" name="topic" value="specialist-match" />
          <input type="hidden" name="locale" value={locale} />

          {/* Section 1 — clinical */}
          <fieldset class="border-0 m-0" style="padding: 28px 32px;">
            <legend class="contents">
              <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.16em; color: var(--color-accent);">
                {tFs("section1Eyebrow")}
              </div>
              <div class="serif mt-1" style="font-size: 18px; line-height: 1.3; color: var(--color-ink); font-weight: 500;">
                {tFs("section1Legend")}
              </div>
            </legend>
            <div class="grid gap-4 md:grid-cols-2 mt-5">
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelSpecialty")}</span>
                <select name="specialty" class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;">
                  <option value="">{tFs("specialtyDefault")}</option>
                  {specialties.map((s) => (<option value={s.slug}>{s.name}</option>))}
                </select>
              </label>
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelCondition")} <span style="color: var(--color-ink-subtle); text-transform: none; letter-spacing: 0.02em;">({tFs("optionalParens")})</span></span>
                <select name="condition" class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;">
                  <option value="">{tFs("conditionDefault")}</option>
                  {conditions.map((c) => (<option value={c.slug}>{c.name}</option>))}
                </select>
              </label>
            </div>
            <label class="block mt-4">
              <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelDetails")} <span style="color: var(--color-ink-subtle); text-transform: none; letter-spacing: 0.02em;">({tFs("detailsHint")})</span></span>
              <textarea name="message" rows="4" placeholder={tFs("detailsPlaceholder")} class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px; font-family: inherit; resize: vertical;"></textarea>
            </label>
          </fieldset>

          {/* Section 2 — preferences */}
          <fieldset class="border-0 m-0" style="padding: 28px 32px; background: var(--color-paper); border-top: 1px dashed var(--color-border);">
            <legend class="contents">
              <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.16em; color: var(--color-accent);">
                {tFs("section2Eyebrow")} <span style="color: var(--color-ink-subtle); text-transform: none; letter-spacing: 0.02em;">({tFs("optionalParens")})</span>
              </div>
              <div class="serif mt-1" style="font-size: 18px; line-height: 1.3; color: var(--color-ink); font-weight: 500;">
                {tFs("section2Legend")}
              </div>
            </legend>
            <div class="grid gap-4 md:grid-cols-2 mt-5">
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelDestination")}</span>
                <select name="country" class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14px;">
                  <option value="">{tFs("destinationDefault")}</option>
                  {countries.map((c) => (<option value={c.slug}>{c.name}</option>))}
                </select>
              </label>
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelLanguage")}</span>
                <select name="language" class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14px;">
                  <option value="">{tFs("languageDefault")}</option>
                  <option value="ar">العربية</option>
                  <option value="ru">Русский</option>
                  <option value="fr">Français</option>
                  <option value="pt">Português</option>
                  <option value="bn">বাংলা</option>
                  <option value="tr">Türkçe</option>
                  <option value="hi">हिन्दी</option>
                </select>
              </label>
            </div>
          </fieldset>

          {/* Section 3 — contact */}
          <fieldset class="border-0 m-0" style="padding: 28px 32px; border-top: 1px dashed var(--color-border);">
            <legend class="contents">
              <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.16em; color: var(--color-accent);">
                {tFs("section3Eyebrow")}
              </div>
              <div class="serif mt-1" style="font-size: 18px; line-height: 1.3; color: var(--color-ink); font-weight: 500;">
                {tFs("section3Legend")}
              </div>
            </legend>
            <div class="grid gap-4 md:grid-cols-2 mt-5">
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelYourName")}</span>
                <input name="name" required placeholder={tFs("namePlaceholder")} class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
              </label>
              <label class="block">
                <span class="mono block mb-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">{tFs("labelWhatsapp")}</span>
                <input name="phone" required placeholder="+91 98765 43210" class="w-full" style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
              </label>
            </div>

            <button type="submit" class="inline-flex items-center justify-center gap-2 w-full mt-6 font-semibold" style="background: var(--color-ink); color: var(--color-bg); padding: 14px 22px; font-size: 15px; border-radius: 9999px;">
              {tFs("submitBtn")} <ChevronRight className="h-3.5 w-3.5 mirror-x" />
            </button>

            <p class="mono mt-4 text-center" style="font-size: 11px; color: var(--color-ink-subtle);">
              {tFs("submitNote")}
            </p>
          </fieldset>
        </form>
        )}
      </div>
    </section>

    <HowItWorks
      heading={tFs("howHeading")}
      italicWord={tFs("howItalicWord")}
      steps={[
        { title: tFs("step1Title"), description: tFs("step1Desc") },
        { title: tFs("step2Title"), description: tFs("step2Desc") },
        { title: tFs("step3Title"), description: tFs("step3Desc") },
        { title: tFs("step4Title"), description: tFs("step4Desc") },
        { title: tFs("step5Title"), description: tFs("step5Desc") },
        { title: tFs("step6Title"), description: tFs("step6Desc") },
      ]}
      outroNote={tFs("howOutroNote")}
    />

    <WhatToExpect
      heading={tFs("wteHeading")}
      italicWord={tFs("wteItalicWord")}
      items={[
        { label: tFs("wte1Label"), description: tFs("wte1Desc") },
        { label: tFs("wte2Label"), description: tFs("wte2Desc") },
        { label: tFs("wte3Label"), description: tFs("wte3Desc") },
        { label: tFs("wte4Label"), description: tFs("wte4Desc") },
        { label: tFs("wte5Label"), description: tFs("wte5Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tFs("exploreEyebrow")}
      heading={tFs("exploreHeading")}
      lede={tFs("exploreLede")}
      items={[
        { eyebrow: tFs("exploreItem1Eyebrow"), label: tFs("exploreItem1Label"), href: "/surgeons", hint: tFs("exploreItem1Hint") },
        { eyebrow: tFs("exploreItem2Eyebrow"), label: tFs("exploreItem2Label"), href: "/specialties", hint: tFs("exploreItem2Hint") },
        { eyebrow: tFs("exploreItem3Eyebrow"), label: tFs("exploreItem3Label"), href: "/compare/doctors", hint: tFs("exploreItem3Hint") },
        { eyebrow: tFs("exploreItem4Eyebrow"), label: tFs("exploreItem4Label"), href: "/quote", hint: tFs("exploreItem4Hint") },
        { eyebrow: tFs("exploreItem5Eyebrow"), label: tFs("exploreItem5Label"), href: "/match-me", hint: tFs("exploreItem5Hint") },
        { eyebrow: tFs("exploreItem6Eyebrow"), label: tFs("exploreItem6Label"), href: "/second-opinion", hint: tFs("exploreItem6Hint") },
        { eyebrow: tFs("exploreItem7Eyebrow"), label: tFs("exploreItem7Label"), href: "/services", hint: tFs("exploreItem7Hint") },
        { eyebrow: tFs("exploreItem8Eyebrow"), label: tFs("exploreItem8Label"), href: "/contact", hint: tFs("exploreItem8Hint") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
