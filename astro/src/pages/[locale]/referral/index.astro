---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_NAME, SITE_URL } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/referral", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tr = getTranslator(locale, "referralPage");

const path = "/referral";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tr("breadcrumbReferral"), url: localeUrl(locale, path) },
]);

const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: tr("seoTitle"),
  description: tr("seoDescription"),
  url: localeUrl(locale, path),
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "patient referrals",
        email: "hello@medcasts.com",
        availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"],
      },
    ],
  },
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={tr("seoTitle")} description={tr("seoDescription")} path={path} locale={locale} noindex={locale !== "en"} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <main class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px] flex items-center gap-2 flex-wrap" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
        <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
        <span style="color: var(--color-ink);">{tr("breadcrumbReferral")}</span>
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto" style="max-width: 760px;">
        <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tr("eyebrow")}</div>
        <h1 class="display display-tight mt-3" style="font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
          {tr("h1First")} <span class="italic-display">{tr("h1Italic")}</span>
        </h1>
        <p class="serif mt-5" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">
          {tr("lede")}
        </p>

        <form action={localizedPath(locale, "/contact")} method="get" class="paper mt-10" style="padding: 32px; box-shadow: var(--shadow-md);">
          <input type="hidden" name="topic" value="referral" />

          <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">{tr("sectionYourDetails")}</div>
          <div class="grid gap-4 md:grid-cols-2 mt-3">
            <label class="block">
              <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelYourName")}</span>
              <input name="referrer_name" required placeholder={tr("placeholderYourName")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
            </label>
            <label class="block">
              <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelYourRelationship")}</span>
              <select name="referrer_role" required class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;">
                <option value="">— Select —</option>
                <option value="doctor">{tr("selectDoctor")}</option>
                <option value="family">{tr("selectFamily")}</option>
                <option value="friend">{tr("selectFriend")}</option>
                <option value="past-patient">{tr("selectPastPatient")}</option>
                <option value="other">{tr("selectOther")}</option>
              </select>
            </label>
          </div>
          <label class="block mt-4">
            <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelYourEmail")}</span>
            <input name="referrer_email" type="email" required placeholder={tr("placeholderYourEmail")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
          </label>

          <hr style="margin-top: 28px; margin-bottom: 24px; border: 0; border-top: 1px solid var(--color-border-soft);" />

          <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">{tr("sectionPatientDetails")}</div>
          <div class="grid gap-4 md:grid-cols-2 mt-3">
            <label class="block">
              <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelPatientName")}</span>
              <input name="name" required placeholder={tr("placeholderPatientName")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
            </label>
            <label class="block">
              <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelPatientPhone")}</span>
              <input name="phone" required placeholder={tr("placeholderPatientPhone")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
            </label>
          </div>
          <label class="block mt-4">
            <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelPatientEmail")}</span>
            <input name="email" type="email" placeholder={tr("placeholderPatientEmail")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px;" />
          </label>
          <label class="block mt-4">
            <span class="block mb-1.5" style="font-size: 12.5px; color: var(--color-ink-subtle);">{tr("labelClinicalSituation")}</span>
            <textarea name="description" rows="4" required placeholder={tr("placeholderClinicalSituation")} class="w-full" style="padding: 11px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-elevated); font-size: 14px; font-family: inherit; resize: vertical;"></textarea>
          </label>

          <label class="block mt-4" style="font-size: 13px; color: var(--color-ink-muted);">
            <input type="checkbox" name="consent" required style="margin-inline-end: 8px;" />
            {tr("consentLabel")}
          </label>

          <button type="submit" class="inline-flex items-center justify-center gap-2 w-full mt-6 font-semibold" style="background: var(--color-ink); color: var(--color-bg); padding: 14px 22px; font-size: 15px; border-radius: 9999px;">
            {tr("btnSendReferral")} <ChevronRight className="h-3.5 w-3.5 mirror-x" />
          </button>

          <p class="mono mt-4 text-center" style="font-size: 11px; color: var(--color-ink-subtle);">
            {tr("footerNote")}
          </p>
        </form>
      </div>
    </section>

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
