---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import QuoteCalculator from "@/components/QuoteCalculator.tsx";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getCalculatorMatrix } from "@/lib/queries";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/calculator", 308);
const locale = rawLocale as Locale;

const tc = getTranslator(locale, "common");
const tCa = getTranslator(locale, "calculatorPage");
const { treatments, countries, matrix } = await getCalculatorMatrix();

const pairs = Object.keys(matrix).length;

const stats = [
  { l: tCa("statLabelProcedures"), v: treatments.length.toLocaleString() },
  { l: tCa("statLabelDestinations"), v: countries.length.toString() },
  { l: tCa("statLabelPricePairs"), v: pairs.toLocaleString() },
  { l: tCa("statLabelMedianReply"), v: tCa("statValueMedianReply") },
];

const TRUST_POINTS = [
  { eyebrow: "01", title: tCa("trustPoint1Title"), body: tCa("trustPoint1Body") },
  { eyebrow: "02", title: tCa("trustPoint2Title"), body: tCa("trustPoint2Body") },
  { eyebrow: "03", title: tCa("trustPoint3Title"), body: tCa("trustPoint3Body") },
];

const { bindChromeT } = await import("@/lib/chrome-i18n");
const ct = bindChromeT(locale);
const seoTitle = ct("lp.calculator.title");
const seoDescription = ct("lp.calculator.desc");
const path = "/calculator";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tCa("breadcrumbCalculator"), url: localeUrl(locale, path) },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=3600",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tCa("breadcrumbCalculator")}</span>
        </nav>
      </div>
    </div>

    <section class="pt-12 md:pt-16 pb-10">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
          {ct("lp.calculator.eyebrow")}
        </p>
        <h1 class="mt-3 display display-tight" style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;">
          {ct("lp.calculator.h1a")} <span class="italic-display">{ct("lp.calculator.h1b")}</span>
        </h1>
        <p class="serif mt-5 max-w-[48rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">
          {seoDescription}
        </p>

        <div
          class="mt-8 grid grid-cols-2 sm:grid-cols-4 max-w-[64rem]"
          style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
        >
          {stats.map((s, i) => (
            <div
              class="px-4 md:px-5 py-5"
              style={i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}
            >
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                {s.l}
              </div>
              <div class="display tnum mt-1.5" style="font-size: 28px;">{s.v}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="padding-bottom: 72px;">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <div class="paper" style="padding: 28px 28px 32px;">
          <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tCa("calcSectionEyebrow")}
              </div>
              <h2 class="display mt-2" style="font-size: 26px; line-height: 1.1; letter-spacing: -0.015em;">
                {tCa("calcSectionH2").replace(tCa("calcSectionH2ItalicWord"), "")}<span class="italic-display">{tCa("calcSectionH2ItalicWord")}</span>
              </h2>
            </div>
            <a
              href={localizedPath(locale, "/editorial-policy")}
              class="mono text-[11px] uppercase tracking-wider hover:text-accent"
              style="color: var(--color-ink-subtle);"
            >
              {tCa("pricingMethodologyLink")}
            </a>
          </div>
          <QuoteCalculator
            client:idle
            treatments={treatments}
            countries={countries}
            matrix={matrix}
            locale={locale}
            localeHref={(p: string) => localizedPath(locale, p)}
          />
        </div>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mb-8">
          <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tCa("trustSectionEyebrow")}
          </div>
          <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
            {tCa("trustSectionH2").replace(tCa("trustSectionH2ItalicWord"), "")}<span class="italic-display">{tCa("trustSectionH2ItalicWord")}</span>
          </h2>
        </div>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {TRUST_POINTS.map((t) => (
            <li class="paper" style="padding: 26px 28px;">
              <div class="display tnum" style="font-size: 32px; line-height: 1; color: var(--color-accent); letter-spacing: -0.02em;">
                {t.eyebrow}
              </div>
              <div class="serif mt-3" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">
                {t.title}
              </div>
              <p class="mt-2 serif" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
                {t.body}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 72px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              {tCa("ctaEyebrow")}
            </div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-bg);">
              {(() => { const full = tCa("ctaH2"); const phrase = tCa("ctaH2ItalicPhrase"); const idx = full.indexOf(phrase); if (idx < 0) return full; return <>{full.slice(0, idx)}<span class="italic-display">{phrase}</span>{full.slice(idx + phrase.length)}</>; })()}
            </h2>
            <p class="serif mt-4 max-w-[42rem]" style="font-size: 17px; line-height: 1.5; color: rgba(246,241,230,0.75);">
              {tCa("ctaBody")}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, "/contact")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              {tCa("ctaButtonRequestQuotes")}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, "/second-opinion")}
              class="inline-flex items-center gap-2 font-semibold"
              style="border: 1px solid rgba(246,241,230,0.35); color: var(--color-bg); padding: 13px 22px; border-radius: 9999px;"
            >
              {tCa("ctaButtonSecondOpinion")}
            </a>
          </div>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tCa("exploreEyebrow")}
      heading={tCa("exploreHeading")}
      lede={tCa("exploreLede")}
      items={[
        { eyebrow: tCa("exploreItem1Eyebrow"), label: tCa("exploreItem1Label"), href: "/pricing-index", hint: tCa("exploreItem1Hint") },
        { eyebrow: tCa("exploreItem2Eyebrow"), label: tCa("exploreItem2Label"), href: "/treatments", hint: tCa("exploreItem2Hint") },
        { eyebrow: tCa("exploreItem3Eyebrow"), label: tCa("exploreItem3Label"), href: "/countries", hint: tCa("exploreItem3Hint") },
        { eyebrow: tCa("exploreItem4Eyebrow"), label: tCa("exploreItem4Label"), href: "/specialties", hint: tCa("exploreItem4Hint") },
        { eyebrow: tCa("exploreItem5Eyebrow"), label: tCa("exploreItem5Label"), href: "/match-me", hint: tCa("exploreItem5Hint") },
        { eyebrow: tCa("exploreItem6Eyebrow"), label: tCa("exploreItem6Label"), href: "/compare/treatments", hint: tCa("exploreItem6Hint") },
        { eyebrow: tCa("exploreItem7Eyebrow"), label: tCa("exploreItem7Label"), href: "/compare/countries", hint: tCa("exploreItem7Hint") },
        { eyebrow: tCa("exploreItem8Eyebrow"), label: tCa("exploreItem8Label"), href: "/editorial-policy", hint: tCa("exploreItem8Hint") },
        { eyebrow: tCa("exploreItem9Eyebrow"), label: tCa("exploreItem9Label"), href: "/accreditation", hint: tCa("exploreItem9Hint") },
        { eyebrow: tCa("exploreItem10Eyebrow"), label: tCa("exploreItem10Label"), href: "/glossary", hint: tCa("exploreItem10Hint") },
        { eyebrow: tCa("exploreItem11Eyebrow"), label: tCa("exploreItem11Label"), href: "/second-opinion", hint: tCa("exploreItem11Hint") },
        { eyebrow: tCa("exploreItem12Eyebrow"), label: tCa("exploreItem12Label"), href: "/quote", hint: tCa("exploreItem12Hint") },
      ]}
    />

    <HowItWorks
      heading={tCa("howItWorksHeading")}
      italicWord={tCa("howItWorksItalicWord")}
      steps={[
        { title: tCa("howItWorksStep1Title"), description: tCa("howItWorksStep1Desc") },
        { title: tCa("howItWorksStep2Title"), description: tCa("howItWorksStep2Desc") },
        { title: tCa("howItWorksStep3Title"), description: tCa("howItWorksStep3Desc") },
        { title: tCa("howItWorksStep4Title"), description: tCa("howItWorksStep4Desc") },
      ]}
      outroNote={tCa("howItWorksOutroNote")}
    />

    <WhatToExpect
      heading={tCa("whatToExpectHeading")}
      italicWord={tCa("whatToExpectItalicWord")}
      items={[
        { label: tCa("whatToExpectItem1Label"), description: tCa("whatToExpectItem1Desc") },
        { label: tCa("whatToExpectItem2Label"), description: tCa("whatToExpectItem2Desc") },
        { label: tCa("whatToExpectItem3Label"), description: tCa("whatToExpectItem3Desc") },
        { label: tCa("whatToExpectItem4Label"), description: tCa("whatToExpectItem4Desc") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
