---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import QuoteCalculator from "@/components/QuoteCalculator.tsx";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getCalculatorMatrix } from "@/lib/queries";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/calculator", 308);
const locale = rawLocale as Locale;

const tc = getTranslator(locale, "common");
const { treatments, countries, matrix } = await getCalculatorMatrix();

const pairs = Object.keys(matrix).length;

const stats = [
  { l: "Procedures", v: treatments.length.toLocaleString() },
  { l: "Destinations", v: countries.length.toString() },
  { l: "Price pairs", v: pairs.toLocaleString() },
  { l: "Median reply", v: "9 min" },
];

const TRUST_POINTS = [
  { eyebrow: "01", title: "Hospital-reported", body: "Ranges come from quote sheets our partner hospitals issue to real patients, not ad-driven averages." },
  { eyebrow: "02", title: "Itemised quotes", body: "Submit the shortlist and 3 itemised quotes arrive within 48 hours. No fee, no obligation." },
  { eyebrow: "03", title: "Surgeon-specific", body: "Final number accounts for BMI, comorbidities, implant brand, room tier, and stay length." },
];

const { bindChromeT } = await import("@/lib/chrome-i18n");
const ct = bindChromeT(locale);
const seoTitle = ct("lp.calculator.title");
const seoDescription = ct("lp.calculator.desc");
const path = "/calculator";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Calculator", url: localeUrl(locale, path) },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=3600",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">Calculator</span>
        </nav>
      </div>
    </div>

    <section class="pt-12 md:pt-16 pb-10">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
          {ct("lp.calculator.eyebrow")}
        </p>
        <h1 class="mt-3 display display-tight" style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;">
          {ct("lp.calculator.h1a")} <span class="italic-display">{ct("lp.calculator.h1b")}</span>
        </h1>
        <p class="serif mt-5 max-w-[48rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);">
          {seoDescription}
        </p>

        <div
          class="mt-8 grid grid-cols-2 sm:grid-cols-4 max-w-[64rem]"
          style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
        >
          {stats.map((s, i) => (
            <div
              class="px-4 md:px-5 py-5"
              style={i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}
            >
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                {s.l}
              </div>
              <div class="display tnum mt-1.5" style="font-size: 28px;">{s.v}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="padding-bottom: 72px;">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <div class="paper" style="padding: 28px 28px 32px;">
          <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Three steps
              </div>
              <h2 class="display mt-2" style="font-size: 26px; line-height: 1.1; letter-spacing: -0.015em;">
                Search · pick destination · review <span class="italic-display">shortlist</span>
              </h2>
            </div>
            <a
              href={localizedPath(locale, "/editorial-policy")}
              class="mono text-[11px] uppercase tracking-wider hover:text-accent"
              style="color: var(--color-ink-subtle);"
            >
              Pricing methodology →
            </a>
          </div>
          <QuoteCalculator
            client:idle
            treatments={treatments}
            countries={countries}
            matrix={matrix}
            locale={locale}
            localeHref={(p: string) => localizedPath(locale, p)}
          />
        </div>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mb-8">
          <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            How the numbers work
          </div>
          <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
            Honest bands, <span class="italic-display">case-specific</span> quotes
          </h2>
        </div>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {TRUST_POINTS.map((t) => (
            <li class="paper" style="padding: 26px 28px;">
              <div class="display tnum" style="font-size: 32px; line-height: 1; color: var(--color-accent); letter-spacing: -0.02em;">
                {t.eyebrow}
              </div>
              <div class="serif mt-3" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">
                {t.title}
              </div>
              <p class="mt-2 serif" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
                {t.body}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 72px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              Want a number tied to your case
            </div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-bg);">
              Three <span class="italic-display">itemised quotes</span> in 48 hours.
            </h2>
            <p class="serif mt-4 max-w-[42rem]" style="font-size: 17px; line-height: 1.5; color: rgba(246,241,230,0.75);">
              Submit your shortlist and imaging. Coordinators route the case to matched surgeons and return three itemised quotes — inclusions, exclusions, timelines, all on one page.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, "/contact")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              Request quotes
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, "/second-opinion")}
              class="inline-flex items-center gap-2 font-semibold"
              style="border: 1px solid rgba(246,241,230,0.35); color: var(--color-bg); padding: 13px 22px; border-radius: 9999px;"
            >
              Free second opinion
            </a>
          </div>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow="Pricing context"
      heading="Where the numbers come from, and what to do next"
      lede="The calculator shows ranges. These pages show the underlying data, the methodology, and the routes to a real itemised quote."
      items={[
        { eyebrow: "Open data", label: "Global Price Index", href: "/pricing-index", hint: "Median package pricing across 9 destinations · CC BY 4.0 · CSV + JSON downloads." },
        { eyebrow: "Browse", label: "All 88 procedures", href: "/treatments", hint: "Per-procedure cost ranges, success rates, recovery time." },
        { eyebrow: "Browse", label: "9 destination countries", href: "/countries", hint: "Cost-of-care profile, hospital programs, visa playbooks." },
        { eyebrow: "Browse", label: "15 specialties", href: "/specialties", hint: "Cardiac, oncology, transplant, ortho, fertility, ENT, cosmetic." },
        { eyebrow: "Triage", label: "Match-me triage", href: "/match-me", hint: "Three questions, get a specialty + destination + 3-hospital shortlist." },
        { eyebrow: "Compare", label: "Treatments side-by-side", href: "/compare/treatments", hint: "Cost, stay, recovery columns across procedures." },
        { eyebrow: "Compare", label: "Destination shootout", href: "/compare/countries", hint: "Hospitals, doctors, treatments, programs per country." },
        { eyebrow: "Trust", label: "Editorial policy", href: "/editorial-policy", hint: "Sourcing, pricing methodology, AI disclosure, corrections SLA." },
        { eyebrow: "Trust", label: "Accreditation hub", href: "/accreditation", hint: "JCI, NABH, ISO 9001 — what each one means clinically." },
        { eyebrow: "Reference", label: "Glossary of terms", href: "/glossary", hint: "Plain-language definitions for procedures and travel logistics." },
        { eyebrow: "Action", label: "Free second opinion", href: "/second-opinion", hint: "Independent panel review of your case in 48 hours." },
        { eyebrow: "Action", label: "Get itemised quotes", href: "/quote", hint: "Three quotes broken into line items — surgeon, OR, implant, stay." },
      ]}
    />

    <HowItWorks
      heading="How the cost calculator works"
      italicWord="works"
      steps={[
        { title: "Pick your procedure", description: "Search 88 procedures across 15 specialties. We use the same procedure naming convention as the WHO ICD-11 catalog and major US billing codes — so 'CABG' and 'coronary artery bypass grafting' both find the same entry." },
        { title: "Select destination", description: "9 destination countries. Each has a baseline pricing structure reflecting local cost of care, surgeon compensation, and currency. We don't include US/UK/Australia in this calculator (cost of care is fundamentally different)." },
        { title: "View price band", description: "We show low, mid, and high price ranges by hospital tier within the destination. Mid-range is what most patients actually pay; the low range is bottom-tier programs we'd usually steer away from." },
        { title: "Get hospital options", description: "If you proceed, we show 3-5 specific hospital options with current pricing. These are itemized quotes — surgeon fee, implant, hospital stay, anesthesia broken out — not package marketing." },
      ]}
      outroNote="Calculator shows ranges based on hospital-reported pricing collected over the past 90 days. Final cost depends on your specific case complexity, implant choice, length of stay, and destination program. Get an itemized quote for binding pricing."
    />

    <WhatToExpect
      heading="Reading the price ranges honestly"
      italicWord="honestly"
      items={[
        { label: "Low range", description: "Bottom-tier programs in the destination. Often technically capable but lacking some quality infrastructure (limited ICU, less experienced surgeons on rare cases). For routine procedures, sometimes appropriate; for complex cases, we generally steer toward mid-tier." },
        { label: "Mid range", description: "Where most international patients land. Top-tier programs with substantial international-patient experience, full clinical infrastructure, and transparent pricing. The 'right answer' for most cases." },
        { label: "High range", description: "Premium programs (often featured Western-affiliate hospitals or new-wave premium destinations). Charge a premium for amenities and concierge experience; clinical outcomes typically not better than mid-range." },
        { label: "What's not in the range", description: "Travel costs, accommodation, meals, attendant logistics, complications, follow-up imaging, post-op medications. Real total trip cost typically 1.5-2.5× the procedure quote." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
