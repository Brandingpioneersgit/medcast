---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { db } from "@/lib/db";
import { treatments, specialties, countries } from "../../../../../src/lib/db/schema";
import { eq, asc } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_NAME, SITE_URL } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import { heroImage, serviceScene, journeyScene } from "@/lib/images";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/quote", 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tq = getTranslator(locale, "quotePage");

const [treatmentRows, specialtyRows, countryRows] = await Promise.all([
  db.select({ slug: treatments.slug, name: treatments.name, specialtyId: treatments.specialtyId })
    .from(treatments).where(eq(treatments.isActive, true)).orderBy(asc(treatments.name)),
  db.select({ id: specialties.id, slug: specialties.slug, name: specialties.name })
    .from(specialties).where(eq(specialties.isActive, true)).orderBy(asc(specialties.name)),
  db.select({ slug: countries.slug, name: countries.name })
    .from(countries).where(eq(countries.isDestination, true)).orderBy(asc(countries.name)),
]);

const url = Astro.url;
const preTreatment = url.searchParams.get("treatment") ?? "";
const preCountry = url.searchParams.get("country") ?? "";

const path = "/quote";
// /api/v1/inquiry redirects back here with ?sent=1 after a successful submit.
const sent = url.searchParams.get("sent") === "1";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tq("breadcrumbQuote"), url: localeUrl(locale, path) },
]);

// ContactPage schema — Google uses this to surface inquiry pages in
// "contact us" rich results. mainEntity links back to the organization
// so the page inherits the org's contactPoint catalog.
const contactPageLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: tq("seoTitle"),
  description: tq("seoDescription"),
  url: localeUrl(locale, path),
  mainEntity: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "medcastsdigital@gmail.com",
        availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"],
      },
      {
        "@type": "ContactPoint",
        contactType: "sales",
        telephone: "+918006210000",
        availableLanguage: ["en", "ar", "hi"],
      },
    ],
  },
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");

const heroStats = [
  { l: tq("statResponse"), v: "48 hr" },
  { l: tq("statQuotes"), v: "3 itemised" },
  { l: tq("statVetted"), v: "9,254" },
  { l: tq("statYouPay"), v: "$0" },
];

const whyStats = [
  { n: tq("whyStat1Num"), l: tq("whyStat1Label") },
  { n: tq("whyStat2Num"), l: tq("whyStat2Label") },
  { n: tq("whyStat3Num"), l: tq("whyStat3Label") },
  { n: tq("whyStat4Num"), l: tq("whyStat4Label") },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={tq("seoTitle")} description={tq("seoDescription")} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tq("breadcrumbQuote")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tq("eyebrow")}
      h1First={tq("h1First")}
      h1Italic={tq("h1Italic")}
      lede={tq("lede")}
      stats={heroStats}
    />

    {/* Real-care strip — what happens after the quote */}
    <section style="padding: 0 0 24px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-3" style="grid-template-columns: repeat(4, minmax(0, 1fr));">
          {[
            { src: heroImage("quote-step-1"), n: "01", title: "You upload reports" },
            { src: heroImage("quote-step-2"), n: "02", title: "Panel reviews · 48 hr" },
            { src: serviceScene("quote-step-3"), n: "03", title: "Itemised quotes from 3 hospitals" },
            { src: journeyScene("quote-step-4"), n: "04", title: "Speak the surgeon. Decide." },
          ].map((s) => (
            <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
              <img
                src={s.src}
                alt={s.title}
                width="500"
                height="625"
                loading="lazy"
                decoding="async"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
              <div class="image-veil-strong" />
              <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 14px; inset-inline-end: 14px;">
                <div class="mono tnum" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-saffron);">
                  {s.n}
                </div>
                <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">
                  {s.title}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="padding: 24px 0 56px;">
      <div class="mx-auto w-full max-w-[62rem] px-5 md:px-8">
        {sent ? (
          <div class="paper" style="padding: 32px;">
            <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">Quote request received</div>
            <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.02em; line-height: 1.15;">Thank you — your quote is in motion</h2>
            <p class="serif mt-3" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted);">
              A senior coordinator will review your case and reply within a few hours during business hours. Keep an eye on your phone and email.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={localizedPath(locale, "/calculator")} class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; border: 1px solid var(--color-border); padding: 10px 18px; border-radius: 9999px; color: var(--color-ink);">Estimate costs meanwhile</a>
              <a href={localizedPath(locale, "/countries")} class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; background: var(--color-ink); color: var(--color-bg); padding: 10px 18px; border-radius: 9999px;">Explore destinations →</a>
            </div>
          </div>
        ) : (
        <form
          action="/api/v1/inquiry"
          method="post"
          class="paper"
          style="padding: 32px;"
        >
          <input type="hidden" name="topic" value="quote" />
          <input type="hidden" name="locale" value={locale} />
          <div class="flex items-baseline justify-between flex-wrap gap-2">
            <div class="serif" style="font-size: 26px; letter-spacing: -0.015em;">
              {tq("formStepLabel")} · <span class="italic-display">{tq("formStepItalic")}</span>
            </div>
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tq("formTimeEstimate")}
            </div>
          </div>
          <div class="serif mt-2" style="font-size: 15px; line-height: 1.5; color: var(--color-ink-muted);">
            {tq("formStepDesc")}
          </div>

          <div class="mt-7 grid gap-4 md:grid-cols-2">
            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelSpecialty")}</span>
              <select
                name="specialty"
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              >
                <option value="">{tq("placeholderAnySpecialty")}</option>
                {specialtyRows.map((s) => (
                  <option value={s.slug}>{s.name}</option>
                ))}
              </select>
            </label>

            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelTreatment")}</span>
              <select
                name="treatment"
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              >
                <option value="">{tq("placeholderAnyTreatment")}</option>
                {treatmentRows.map((t) => (
                  <option value={t.slug} selected={t.slug === preTreatment}>{t.name}</option>
                ))}
              </select>
            </label>
          </div>

          <label class="block mt-4">
            <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelDescribe")}</span>
            <textarea
              name="message"
              rows="4"
              placeholder={tq("placeholderDescription")}
              class="w-full serif"
              style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink); font-family: inherit; resize: vertical;"
            ></textarea>
          </label>

          <div class="grid gap-4 md:grid-cols-2 mt-4">
            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelDestination")}</span>
              <select
                name="country"
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              >
                <option value="">{tq("placeholderAnyDestination")}</option>
                {countryRows.map((c) => (
                  <option value={c.slug} selected={c.slug === preCountry}>{c.name}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelBudget")}</span>
              <select
                name="budget"
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              >
                <option value="">{tq("placeholderAnyBudget")}</option>
                <option value="under-5k">Under $5,000</option>
                <option value="5-15k">$5,000 – $15,000</option>
                <option value="15-30k">$15,000 – $30,000</option>
                <option value="30-60k">$30,000 – $60,000</option>
                <option value="60-plus">$60,000+</option>
              </select>
            </label>
          </div>

          <div class="grid gap-4 md:grid-cols-2 mt-7">
            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelName")}</span>
              <input
                name="name" required autocomplete="name" placeholder={tq("placeholderName")}
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              />
            </label>
            <label class="block">
              <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelPhone")}</span>
              <input
                name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder={tq("placeholderPhone")}
                class="w-full serif"
                style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
              />
            </label>
          </div>

          <label class="block mt-4">
            <span class="mono uppercase block mb-2" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tq("labelEmail")}</span>
            <input
              name="email" type="email" autocomplete="email" placeholder={tq("placeholderEmail")}
              class="w-full serif"
              style="padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); font-size: 14.5px; color: var(--color-ink);"
            />
          </label>

          <div class="flex items-center justify-between mt-8 flex-wrap gap-4">
            <a
              href={localizedPath(locale, "/")}
              class="mono uppercase inline-flex items-center gap-1"
              style="color: var(--color-ink); padding: 10px 18px; font-size: 11px; letter-spacing: 0.12em; border-radius: 9999px; border: 1px solid var(--color-border);"
            >
              ← {tq("btnCancel")}
            </a>
            <button
              type="submit"
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-ink); color: var(--color-bg); padding: 14px 24px; font-size: 14px; border-radius: 9999px;"
            >
              {tq("btnContinue")}
              <ChevronRight className="h-3.5 w-3.5 mirror-x" />
            </button>
          </div>

          <div class="flex items-center gap-2 mt-5 mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
            <span class="inline-block w-1.5 h-1.5 rounded-full live-dot" style="background: var(--color-accent);" aria-hidden="true" />
            {tq("footerNote")}
          </div>
        </form>
        )}
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 56px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mono uppercase mb-8" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
          {tq("whySectionEyebrow")}
        </div>
        <ul class="grid gap-8 md:grid-cols-4">
          {whyStats.map((s) => (
            <li>
              <div class="display tnum" style="font-size: 40px; line-height: 1; letter-spacing: -0.02em; color: var(--color-bg);">{s.n}</div>
              <div class="mono mt-2 uppercase" style="font-size: 10.5px; letter-spacing: 0.14em; color: rgba(246,241,230,0.6);">{s.l}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <HowItWorks
      heading='How quote routing works'
      italicWord='quote routing works'
      eyebrow='The process'
      steps={[
        { title: 'Submit the form', description: 'Specialty + procedure + destination preference + contact. The more clinical detail, the more accurate the routing.' },
        { title: 'Senior coordinator review (24 hours)', description: 'Confirms case fit, identifies 2-4 partner programs that match, validates surgeon volume for your specific procedure.' },
        { title: 'Hospital outreach (48 hours)', description: 'We approach the matched programs with your case summary. Clinical fit + capacity + timeline confirmed before quoting.' },
        { title: 'Itemized quotes returned', description: 'Each program returns line-item quote: surgeon fee, anesthesia, OR time, hospital stay, implants, post-op care, follow-up.' },
        { title: 'Comparison + recommendation', description: 'We present the quotes side-by-side with our specific recommendation and rationale. You compare and decide.' },
      ]},
      outroNote='Free for the patient. Hospitals pay our coordination fee (5-15% of invoice) only after you proceed with treatment.'
    />

    <WhatToExpect
      heading="What's in a real itemized quote"
      italicWord='real itemized quote'
      items={[
        { label: 'Surgeon + anesthesia fees', description: 'Broken out by named surgeon and anesthesia provider type (MD vs CRNA).' },
        { label: 'OR time + hospital stay', description: 'Per-day rate × days; intermediate care + ICU rates if needed.' },
        { label: 'Implants and devices', description: 'Brand and model specified. Generic vs branded clearly stated.' },
        { label: 'Pre-op + post-op care', description: 'Workup, imaging, labs, follow-up clinic visits, telemedicine continuity.' },
        { label: 'Exclusions', description: 'Travel, accommodation, meals, contingency for complications. Total trip cost = quote + 30-50%.' },
      ]}
    />
    <ExploreGrid
      locale={locale}
      eyebrow="While you're filling this out"
      heading="Useful pages alongside your quote"
      lede="Some patients prefer to browse before submitting a form. The pages below answer the questions that come up most while shaping a quote."
      items={[
        { eyebrow: "Cost", label: "Cost calculator", href: "/calculator", hint: "Live procedure × country pricing band." },
        { eyebrow: "Cost", label: "Pricing matrix", href: "/pricing-index", hint: "All 88 treatments × 9 destinations." },
        { eyebrow: "Match", label: "Match Me quiz", href: "/match-me", hint: "Concern + budget → recommended path." },
        { eyebrow: "Compare", label: "Compare hospitals", href: "/compare/hospitals", hint: "Side-by-side rating, cost, accreditations." },
        { eyebrow: "Compare", label: "Compare countries", href: "/compare/countries", hint: "Cost band, language, top specialties." },
        { eyebrow: "Trust", label: "Free second opinion", href: "/second-opinion", hint: "Independent review of an existing surgical plan." },
        { eyebrow: "Print", label: "Quote-as-PDF plan", href: "/quote-plan", hint: "Take-home plan you can share with family or doctors." },
        { eyebrow: "Insurance", label: "Insurance + cashless coverage", href: "/insurance", hint: "Whether your policy works at our partner hospitals." },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
