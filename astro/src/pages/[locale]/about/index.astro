---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_URL } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";
import { careTeam, patientConsultation, patientHero } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/about`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tA = getTranslator(locale, "aboutPage");
const { bindChromeT } = await import("@/lib/chrome-i18n");
const ct = bindChromeT(locale);

const path = "/about";
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tA("breadcrumbAbout"), url },
]);

const orgLd = {
  "@context": "https://schema.org",
  "@type": ["MedicalOrganization", "Organization"],
  name: "MedCasts",
  url: SITE_URL,
  logo: `${SITE_URL}/logo.svg`,
  description: tA("orgLdDescription"),
  foundingDate: "2024",
  contactPoint: [
    { "@type": "ContactPoint", contactType: "Customer Service", email: "medcastsdigital@gmail.com", availableLanguage: ["en", "ar", "ru", "fr", "pt", "bn", "tr", "hi"] },
  ],
};

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const stats = [
  { l: tA("statFounded"), v: "2024" },
  { l: tA("statDestinations"), v: "9" },
  { l: tA("statLanguages"), v: "8" },
  { l: tA("statPatientFee"), v: tA("statPatientFeeVal") },
];

const TOC = [
  { id: "what-we-do", label: tA("tocWhatWeDo") },
  { id: "what-we-dont", label: tA("tocWhatWeDont") },
  { id: "vetting", label: tA("tocVetting") },
  { id: "records", label: tA("tocRecords") },
  { id: "content", label: tA("tocContent") },
  { id: "base", label: tA("tocBase") },
  { id: "contact", label: tA("tocContact") },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tA("seoTitle")}
      description={tA("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tA("breadcrumbAbout")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={ct("lp.about.eyebrow")}
      h1First={ct("lp.about.h1a")}
      h1Italic={ct("lp.about.h1b")}
      lede={ct("lp.about.desc")}
      stats={stats}
    />

    {/* Care team strip — multi-ethnic team supporting international patients */}
    <section style="padding: 0 0 24px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="paper overflow-hidden" style="padding: 0;">
          <div class="grid" style="grid-template-columns: 1fr;">
            <div class="grid lg:grid-cols-3" style="grid-template-columns: 1fr;">
              <div class="relative" style="aspect-ratio: 4/3; overflow: hidden; min-height: 220px;">
                <img
                  src={careTeam("about-hero", 900, 700)}
                  alt={tA("imgAltCareTeam")}
                  width="900"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
                <div class="image-veil" />
                <div class="absolute" style="inset-block-end: 14px; inset-inline-start: 16px; inset-inline-end: 16px;">
                  <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">Bangalore · Dubai · Istanbul</div>
                  <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; margin-top: 4px;">{tA("imgOverlayCareTeamLabel")}</div>
                </div>
              </div>
              <div class="relative" style="aspect-ratio: 4/3; overflow: hidden; min-height: 220px;">
                <img
                  src={patientConsultation("about-consult", 900, 700)}
                  alt={tA("imgAltConsultation")}
                  width="900"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
                <div class="image-veil" />
                <div class="absolute" style="inset-block-end: 14px; inset-inline-start: 16px; inset-inline-end: 16px;">
                  <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">In writing · in your language</div>
                  <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; margin-top: 4px;">{tA("imgOverlayConsultLabel")}</div>
                </div>
              </div>
              <div class="relative" style="aspect-ratio: 4/3; overflow: hidden; min-height: 220px;">
                <img
                  src={patientHero(101, "africa", 900)}
                  alt={tA("imgAltPatient")}
                  width="900"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
                <div class="image-veil" />
                <div class="absolute" style="inset-block-end: 14px; inset-inline-start: 16px; inset-inline-end: 16px;">
                  <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">Africa · Middle East · CIS · S.Asia</div>
                  <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; margin-top: 4px;">{tA("imgOverlayPatientsLabel")}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 56px 0 88px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.28fr]">
          <article class="min-w-0">
            <div class="about-prose prose-editorial">
              <h2 id="what-we-do">{tA("h2WhatWeDo")}</h2>
              <p>{tA("pWhatWeDo")}</p>

              <h2 id="what-we-dont">{tA("h2WhatWeDont")}</h2>
              <p>{tA("pWhatWeDont")}</p>

              <h2 id="vetting">{tA("h2Vetting")}</h2>
              <p>{tA("pVetting1")}</p>
              <p>{tA("pVetting2")}</p>

              <h2 id="records">{tA("h2Records")}</h2>
              <p>{tA("pRecords")}</p>

              <h2 id="content">{tA("h2Content")}</h2>
              <p>
                {tA("pContent1")} <a href={localizedPath(locale, "/editorial-policy")}>{tA("pContentEditorialPolicyLink")}</a> {tA("pContent2")}
              </p>

              <h2 id="base">{tA("h2Base")}</h2>
              <p>{tA("pBase")}</p>

              <h2 id="contact">{tA("h2Contact")}</h2>
              <ul>
                <li><strong>{tA("contactPatientDesk")}</strong> <a href="mailto:medcastsdigital@gmail.com">{tA("emailPatient")}</a></li>
                <li><strong>{tA("contactPress")}</strong> <a href="mailto:medcastsdigital@gmail.com">{tA("emailPress")}</a></li>
                <li><strong>{tA("contactHospitals")}</strong> <a href={localizedPath(locale, "/for-hospitals")}>{tA("contactForHospitalsLink")}</a></li>
                <li><strong>{tA("contactEmergency")}</strong> <a href={localizedPath(locale, "/emergency")}>{tA("contactEmergencyLink")}</a></li>
              </ul>
            </div>

            <div
              class="mt-12"
              style="padding: 20px 24px; border: 1px dashed var(--color-border); border-radius: var(--radius-lg);"
            >
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tA("limitsBoxTitle")}
              </div>
              <p class="mt-2 serif" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink-muted);">
                {tA("limitsBoxText")}
              </p>
            </div>
          </article>

          <aside class="hidden lg:block">
            <div class="lg:sticky lg:top-28 lg:self-start space-y-6">
              <nav
                aria-label={tA("onThisPage")}
                style="padding: 18px 0; border-top: 1px solid var(--color-ink);"
              >
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tA("onThisPage")}
                </div>
                <ol class="mt-3 space-y-2 tnum">
                  {TOC.map((item, i) => (
                    <li class="flex gap-2.5">
                      <span class="mono" style="font-size: 11px; color: var(--color-ink-subtle);">{String(i + 1).padStart(2, "0")}</span>
                      <a
                        href={`#${item.id}`}
                        class="serif hover:text-accent transition-colors"
                        style="font-size: 13.5px; line-height: 1.4; color: var(--color-ink);"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>

              <a
                href={localizedPath(locale, "/editorial-policy")}
                class="paper group block transition hover:-translate-y-0.5"
                style="padding: 18px 20px;"
              >
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tA("editorialPolicyEyebrow")}
                </div>
                <div class="serif mt-2" style="font-size: 16px; line-height: 1.3; color: var(--color-ink);">
                  {tA("editorialPolicyText")}
                </div>
                <div class="mt-3 mono uppercase inline-flex items-center gap-1 group-hover:text-accent transition-colors" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-muted);">
                  {tA("editorialPolicyLink")}
                  <ChevronRight className="h-3 w-3 mirror-x" />
                </div>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <style is:global>
      .about-prose > p:first-of-type::first-letter {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: 5em;
        line-height: 0.92;
        float: inline-start;
        margin-inline-end: 10px;
        margin-block-start: 0.08em;
        color: var(--color-ink);
      }
      .about-prose h2 {
        scroll-margin-top: 120px;
      }
    </style>

    <HowItWorks
      heading={tA("howItWorksHeading")}
      italicWord={tA("howItWorksItalicWord")}
      eyebrow={tA("howItWorksEyebrow")}
      steps={[
        { title: tA("step1Title"), description: tA("step1Desc") },
        { title: tA("step2Title"), description: tA("step2Desc") },
        { title: tA("step3Title"), description: tA("step3Desc") },
        { title: tA("step4Title"), description: tA("step4Desc") },
        { title: tA("step5Title"), description: tA("step5Desc") },
        { title: tA("step6Title"), description: tA("step6Desc") },
      ]}
      outroNote={tA("howItWorksOutroNote")}
    />

    <WhatToExpect
      heading={tA("whatWeAreHeading")}
      italicWord={tA("whatWeAreItalicWord")}
      items={[
        { label: tA("item1Label"), description: tA("item1Desc") },
        { label: tA("item2Label"), description: tA("item2Desc") },
        { label: tA("item3Label"), description: tA("item3Desc") },
        { label: tA("item4Label"), description: tA("item4Desc") },
        { label: tA("item5Label"), description: tA("item5Desc") },
        { label: tA("item6Label"), description: tA("item6Desc") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
