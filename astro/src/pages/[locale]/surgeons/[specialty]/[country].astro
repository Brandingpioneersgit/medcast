---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { listSurgeonsForSpecialty } from "@/lib/queries";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, withProvenance, surgeonNoun, titleCase } from "@/lib/seo";
import { Award, ChevronRight, MapPin, Users } from "lucide-react";
import { doctorPortrait } from "@/lib/images";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const specialtyParam = Astro.params.specialty;
const countryParam = Astro.params.country;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/surgeons/${specialtyParam}/${countryParam}`, 308);
if (!specialtyParam || !countryParam) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

const data = await listSurgeonsForSpecialty(specialtyParam, { countrySlug: countryParam, limit: 36 });
if (!data.specialty || !data.country) return new Response(`Not found: ${specialtyParam}/${countryParam}`, { status: 404 });
if (data.doctors.length === 0) return new Response(`No surgeons listed for ${specialtyParam}/${countryParam}`, { status: 404 });

const specialtyMap = await getContent("specialty", data.specialty.id, locale);
const specialty = applyTranslated(data.specialty, specialtyMap, ["name", "description"]);
const country = data.country;

const doctorMap = await getContentBatch("doctor", data.doctors.map((d) => d.id), locale);
const doctors = data.doctors.map((d) => ({
  ...d,
  ...applyTranslated({ name: d.name, qualifications: d.qualifications }, doctorMap[d.id] ?? {}, ["name", "qualifications"]),
}));

const tc = getTranslator(locale, "common");

const surgeonYear = new Date().getFullYear();
const surgeonNounLower = surgeonNoun(specialtyParam, specialty.name);
const seoTitle = `Best ${titleCase(surgeonNounLower)} in ${country.name} (${surgeonYear}) — Ranked`;
const seoDescription =
  `Top ${surgeonNounLower} in ${country.name} for ${surgeonYear} — ${data.total.toLocaleString()} doctors ranked by patient volume, years of practice and hospital credentialing. Free human shortlist on request.`.slice(0, 160);
const path = `/surgeons/${specialtyParam}/${countryParam}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Surgeons", url: localeUrl(locale, "/surgeons") },
  { name: specialty.name, url: localeUrl(locale, `/surgeons/${specialtyParam}`) },
  { name: country.name, url },
]);

const itemLd = withProvenance(
  itemListJsonLd(
    doctors.slice(0, 10).map((d) => ({
      name: d.title ? `${d.title} ${d.name}`.replace(/^Dr\. Dr\./i, "Dr.") : d.name,
      url: localeUrl(locale, `/doctor/${d.slug}`),
    })),
  ),
  { dateModified: new Date() },
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={isUntranslated(locale, specialtyMap)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/surgeons")} class="hover:text-accent">Surgeons</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/surgeons/${specialtyParam}`)} class="hover:text-accent">{specialty.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{country.name}</span>
      </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-8">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {specialty.name} · {country.name}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.025em; line-height: 1.02;">
        Best {surgeonNounLower} in {country.name}
      </h1>
      <p class="lede mt-5 max-w-[44rem]">
        {data.total.toLocaleString()} surgeons at {country.name} hospitals credentialed for {specialty.name.toLowerCase()}, ranked by patient volume and years in practice. Not every doctor operates exclusively in this specialty — we'll narrow the list to your case.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <LastUpdated updated={new Date()} locale={locale} />
      </div>

      {/* Back / other countries */}
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="mono uppercase text-[11px]" style="letter-spacing: 0.12em; color: var(--color-ink-subtle);">Scope</span>
        <a
          href={localizedPath(locale, `/surgeons/${specialtyParam}`)}
          class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
        >
          All countries
        </a>
        {data.countryBreakdown
          .filter((c) => c.slug !== country.slug)
          .slice(0, 8)
          .map((c) => (
            <a
              href={localizedPath(locale, `/surgeons/${specialtyParam}/${c.slug}`)}
              class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
            >
              {c.name} · <span class="tnum">{c.n.toLocaleString()}</span>
            </a>
          ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-10 border-t border-border-soft pt-8">
      <h2 class="display-tight mb-5" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {data.total.toLocaleString()} {specialty.name.toLowerCase()} surgeons in {country.name}
      </h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {doctors.map((d) => {
          const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
          const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
          const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
          return (
            <li>
              <a
                href={localizedPath(locale, `/doctor/${d.slug}`)}
                class="group flex h-full gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
              >
                <img
                  src={doctorPortrait({ imageUrl: d.image_url, id: d.id }, 128)}
                  alt={d.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                />
                <div class="min-w-0 flex-1">
                  <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                  {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-1">{d.qualifications}</span>}
                  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                    {d.experience_years != null && (
                      <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{d.experience_years} yrs</span>
                    )}
                    {d.patients_treated != null && d.patients_treated > 0 && (
                      <span class="inline-flex items-center gap-1"><Users className="h-3 w-3 text-accent" />{d.patients_treated.toLocaleString()}</span>
                    )}
                    {d.rating && Number(d.rating) > 0 && (
                      <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                    )}
                  </div>
                  <div class="mt-2 text-[12px] text-ink-subtle inline-flex items-center gap-1">
                    <MapPin className="h-3 w-3" />{d.hospital_name} · {d.city}
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <h2 class="sr-only">Get a personal {specialty.name.toLowerCase()} surgeon shortlist for {country.name}</h2>
      <div class="paper p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-[36rem]">
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">Match me to a surgeon</p>
          <h3 class="mt-2 font-display text-2xl md:text-3xl">
            Want a case-specific shortlist from this list?
          </h3>
          <p class="mt-2 text-sm text-ink-muted">
            Send your reports and we'll come back with 3 specific {country.name} surgeons, availability, and a quote — no fee.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={localizedPath(locale, `/calculator`)}
            class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            Start the shortlist
          </a>
          <a
            href={localizedPath(locale, `/country/${country.slug}`)}
            class="inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold hover:border-border-strong"
          >
            About {country.name}
            <ChevronRight className="ml-1 h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={`${specialty.name} · ${country.name}`}
      heading={`Beyond the surgeon list — full ${country.name} ${specialty.name.toLowerCase()} picture`}
      lede={`Volume-ranked physician list is one cut. These hubs cover the hospitals, the destination context, the procedures, and the visa logistics — so the surgeon decision lands in a real travel plan.`}
      items={[
        { eyebrow: "Specialty", label: `${specialty.name} hub`, href: `/specialty/${specialtyParam}`, hint: `All ${specialty.name.toLowerCase()} programs across destinations.` },
        { eyebrow: "Surgeons", label: `All ${specialty.name.toLowerCase()} surgeons`, href: `/surgeons/${specialtyParam}`, hint: "Volume-ranked directory across all destinations — for cross-border comparison." },
        { eyebrow: "Best of", label: `Best ${specialty.name} in ${country.name}`, href: `/best/${specialtyParam}-in-${countryParam}`, hint: "Editorially ranked programs in this destination with methodology disclosed." },
        { eyebrow: "Destination", label: `${country.name} hospital hub`, href: `/country/${countryParam}`, hint: `Featured programs and pricing benchmarks across ${country.name}.` },
        { eyebrow: "Hospitals", label: `${country.name} hospitals`, href: `/hospitals?country=${countryParam}`, hint: "Filter by city, specialty, accreditation, beds, rating." },
        { eyebrow: "Hospitals", label: `${specialty.name} hospitals`, href: `/hospitals?specialty=${specialtyParam}`, hint: "Programs credentialed for this specialty across all destinations." },
        { eyebrow: "Visa", label: `${country.name} medical visa`, href: `/visa/${countryParam}`, hint: "Documents, processing time, embassy guidance." },
        { eyebrow: "Browse", label: "All 88 procedures", href: "/treatments", hint: "Per-procedure success rates, recovery time, hospital pricing." },
        { eyebrow: "Compare", label: "Doctor comparison", href: "/compare/doctors", hint: "Surgeons compared on volume, fees, languages, video-consult availability." },
        { eyebrow: "Compare", label: "Hospital comparison", href: "/compare/hospitals", hint: "Side-by-side accreditations, ratings, beds, pricing for up to 4 hospitals." },
        { eyebrow: "Tool", label: "Cost calculator", href: "/calculator", hint: "Hospital-reported pricing across procedures × destinations." },
        { eyebrow: "Action", label: "Free second opinion", href: "/second-opinion", hint: "Independent panel review of your case in 48 hours — no charge." },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
