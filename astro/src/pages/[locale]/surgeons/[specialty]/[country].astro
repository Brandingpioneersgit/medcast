---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppDoctorCta from "@/components/WhatsAppDoctorCta.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { listSurgeonsForSpecialty } from "@/lib/queries";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, withProvenance, surgeonNoun, titleCase } from "@/lib/seo";
import { Award, ChevronRight, MapPin, Users } from "lucide-react";
import { doctorPortrait } from "@/lib/images";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const specialtyParam = Astro.params.specialty;
// File is [country].astro but the param accepts a country OR a city slug —
// Astro can't have two dynamic files at the same depth, so this page is
// place-aware (same pattern as condition/[slug]/[place]).
const placeParam = Astro.params.country;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/surgeons/${specialtyParam}/${placeParam}`, 308);
if (!specialtyParam || !placeParam) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

// Resolve as a destination country first; if the slug isn't a country, retry
// as a city. Worst case is 2 queries on a cold city hit — CDN-cached after.
// `data` stays const so the `!data.specialty` guard's narrowing holds.
const countryAttempt = await listSurgeonsForSpecialty(specialtyParam, { countrySlug: placeParam, limit: 36 });
if (!countryAttempt.specialty) return new Response(`Not found: ${specialtyParam}`, { status: 404 });
const mode: "country" | "city" = countryAttempt.country ? "country" : "city";
const data = mode === "country"
  ? countryAttempt
  : await listSurgeonsForSpecialty(specialtyParam, { citySlug: placeParam, limit: 36 });
if (mode === "city" && (!data.city || !data.country)) {
  return new Response(`Not found: ${specialtyParam}/${placeParam}`, { status: 404 });
}
if (!data.specialty) return new Response(`Not found: ${specialtyParam}`, { status: 404 });

// Inventory floor: a city with <3 surgeons isn't worth its own indexable page —
// 301 up to the country page so the link still resolves to useful content.
if (mode === "city" && data.total < 3 && data.country) {
  return Astro.redirect(localizedPath(locale, `/surgeons/${specialtyParam}/${data.country.slug}`), 301);
}
if (data.doctors.length === 0) return new Response(`No surgeons listed for ${specialtyParam}/${placeParam}`, { status: 404 });

const specialtyMap = await getContent("specialty", data.specialty.id, locale);
const specialty = applyTranslated(data.specialty, specialtyMap, ["name", "description"]);
const country = data.country!;
const city = data.city;
const placeName = mode === "city" ? city!.name : country.name;

const doctorMap = await getContentBatch("doctor", data.doctors.map((d) => d.id), locale);
const doctors = data.doctors.map((d) => ({
  ...d,
  ...applyTranslated({ name: d.name, qualifications: d.qualifications }, doctorMap[d.id] ?? {}, ["name", "qualifications"]),
}));

const tc = getTranslator(locale, "common");
const tSsc = getTranslator(locale, "surgeonsSpecialtyCountryPage");

const surgeonYear = new Date().getFullYear();
const surgeonNounLower = surgeonNoun(specialtyParam, specialty.name);
const placeLabel = mode === "city" ? `${city!.name}, ${country.name}` : country.name;
const seoTitle = `Best ${titleCase(surgeonNounLower)} in ${placeLabel} (${surgeonYear}) — Ranked`;
const seoDescription =
  `Top ${surgeonNounLower} in ${placeLabel} for ${surgeonYear} — ${data.total.toLocaleString()} doctors ranked by patient volume, years of practice and hospital credentialing. Free human shortlist on request.`.slice(0, 160);
const path = `/surgeons/${specialtyParam}/${placeParam}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Surgeons", url: localeUrl(locale, "/surgeons") },
  { name: specialty.name, url: localeUrl(locale, `/surgeons/${specialtyParam}`) },
  ...(mode === "city"
    ? [
        { name: country.name, url: localeUrl(locale, `/surgeons/${specialtyParam}/${country.slug}`) },
        { name: city!.name, url },
      ]
    : [{ name: country.name, url }]),
]);

const itemLd = withProvenance(
  itemListJsonLd(
    doctors.slice(0, 10).map((d) => ({
      name: d.title ? `${d.title} ${d.name}`.replace(/^Dr\. Dr\./i, "Dr.") : d.name,
      url: localeUrl(locale, `/doctor/${d.slug}`),
    })),
  ),
  { dateModified: new Date() },
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={isUntranslated(locale, specialtyMap)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/surgeons")} class="hover:text-accent">{tSsc("breadcrumbSurgeons")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/surgeons/${specialtyParam}`)} class="hover:text-accent">{specialty.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        {mode === "city" ? (
          <>
            <a href={localizedPath(locale, `/surgeons/${specialtyParam}/${country.slug}`)} class="hover:text-accent">{country.name}</a>
            <span class="mx-2 text-ink-subtle">/</span>
            <span class="text-ink" aria-current="page">{city!.name}</span>
          </>
        ) : (
          <span class="text-ink" aria-current="page">{country.name}</span>
        )}
      </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-8">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {specialty.name} · {placeName}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.025em; line-height: 1.02;">
        {tSsc("heroHeading").replace("{surgeonNoun}", surgeonNounLower).replace("{place}", placeName)}
      </h1>
      <p class="lede mt-5 max-w-[44rem]">
        {tSsc("heroLede").replace("{total}", data.total.toLocaleString()).replace("{place}", placeName).replace("{specialty}", specialty.name.toLowerCase())}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <LastUpdated updated={new Date()} locale={locale} />
      </div>

      {/* Scope selector — country mode lists countries + cities; city mode
          lists the parent country + sibling cities. */}
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="mono uppercase text-[11px]" style="letter-spacing: 0.12em; color: var(--color-ink-subtle);">{tSsc("scopeLabel")}</span>
        <a
          href={localizedPath(locale, `/surgeons/${specialtyParam}`)}
          class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
        >
          {tSsc("scopeAllCountries")}
        </a>
        {mode === "city" && (
          <a
            href={localizedPath(locale, `/surgeons/${specialtyParam}/${country.slug}`)}
            class="rounded-full border border-accent bg-accent-soft px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
          >
            {tSsc("scopeAllCountry").replace("{country}", country.name)}
          </a>
        )}
        {mode === "country" && data.countryBreakdown
          .filter((c) => c.slug !== country.slug)
          .map((c) => (
            <a
              href={localizedPath(locale, `/surgeons/${specialtyParam}/${c.slug}`)}
              class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
            >
              {c.name} · <span class="tnum">{c.n.toLocaleString()}</span>
            </a>
          ))}
        {data.cityBreakdown
          .filter((c) => !city || c.slug !== city.slug)
          .map((c) => (
            <a
              href={localizedPath(locale, `/surgeons/${specialtyParam}/${c.slug}`)}
              class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
            >
              {c.name} · <span class="tnum">{c.n.toLocaleString()}</span>
            </a>
          ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-10 border-t border-border-soft pt-8">
      <h2 class="display-tight mb-5" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tSsc("listHeading").replace("{total}", data.total.toLocaleString()).replace("{specialty}", specialty.name.toLowerCase()).replace("{place}", placeName)}
      </h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {doctors.map((d) => {
          const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
          const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
          const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
          return (
            <li class="flex flex-col gap-2">
              <a
                href={localizedPath(locale, `/doctor/${d.slug}`)}
                class="group flex flex-1 gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
              >
                <img
                  src={doctorPortrait({ imageUrl: d.image_url, id: d.id }, 128)}
                  alt={d.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                />
                <div class="min-w-0 flex-1">
                  <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                  {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-1">{d.qualifications}</span>}
                  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                    {d.experience_years != null && (
                      <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{tSsc("experienceYrs").replace("{n}", String(d.experience_years))}</span>
                    )}
                    {d.patients_treated != null && d.patients_treated > 0 && (
                      <span class="inline-flex items-center gap-1"><Users className="h-3 w-3 text-accent" />{d.patients_treated.toLocaleString()}</span>
                    )}
                    {d.rating && Number(d.rating) > 0 && (
                      <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                    )}
                  </div>
                  <div class="mt-2 text-[12px] text-ink-subtle inline-flex items-center gap-1">
                    <MapPin className="h-3 w-3" />{d.hospital_name} · {d.city}
                  </div>
                </div>
              </a>
              <WhatsAppDoctorCta doctorName={d.name} doctorSlug={d.slug} hospitalName={d.hospital_name} specialtyName={specialty.name} />
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <h2 class="sr-only">{tSsc("ctaSrHeading").replace("{specialty}", specialty.name.toLowerCase()).replace("{place}", placeName)}</h2>
      <div class="paper p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-[36rem]">
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tSsc("ctaEyebrow")}</p>
          <h3 class="mt-2 font-display text-2xl md:text-3xl">
            {tSsc("ctaHeading")}
          </h3>
          <p class="mt-2 text-sm text-ink-muted">
            {tSsc("ctaBody").replace("{country}", country.name)}
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={localizedPath(locale, `/calculator`)}
            class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            {tSsc("ctaBtnShortlist")}
          </a>
          <a
            href={localizedPath(locale, `/country/${country.slug}`)}
            class="inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold hover:border-border-strong"
          >
            {tSsc("ctaBtnAboutCountry").replace("{country}", country.name)}
            <ChevronRight className="ml-1 h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={`${specialty.name} · ${country.name}`}
      heading={tSsc("exploreHeading").replace("{country}", country.name).replace("{specialty}", specialty.name.toLowerCase())}
      lede={tSsc("exploreLede")}
      items={[
        { eyebrow: tSsc("exploreEyebrowSpecialty"), label: tSsc("exploreItemSpecialtyLabel").replace("{specialty}", specialty.name), href: `/specialty/${specialtyParam}`, hint: tSsc("exploreItemSpecialtyHint").replace("{specialty}", specialty.name.toLowerCase()) },
        { eyebrow: tSsc("exploreEyebrowSurgeons"), label: tSsc("exploreItemAllSurgeonsLabel").replace("{specialty}", specialty.name.toLowerCase()), href: `/surgeons/${specialtyParam}`, hint: tSsc("exploreItemAllSurgeonsHint") },
        { eyebrow: tSsc("exploreEyebrowBestOf"), label: tSsc("exploreItemBestOfLabel").replace("{specialty}", specialty.name).replace("{country}", country.name), href: `/best/${specialtyParam}-in-${country.slug}`, hint: tSsc("exploreItemBestOfHint") },
        ...(mode === "city"
          ? [{ eyebrow: tSsc("exploreEyebrowDestination"), label: tSsc("exploreItemCityAllSurgeonsLabel").replace("{specialty}", specialty.name.toLowerCase()).replace("{country}", country.name), href: `/surgeons/${specialtyParam}/${country.slug}`, hint: tSsc("exploreItemCityAllSurgeonsHint").replace("{city}", city!.name).replace("{country}", country.name) }]
          : []),
        { eyebrow: tSsc("exploreEyebrowDestination"), label: tSsc("exploreItemHospitalHubLabel").replace("{place}", mode === "city" ? city!.name : country.name), href: mode === "city" ? `/city/${city!.slug}` : `/country/${country.slug}`, hint: tSsc("exploreItemHospitalHubHint").replace("{place}", placeName) },
        { eyebrow: tSsc("exploreEyebrowHospitals"), label: tSsc("exploreItemCountryHospitalsLabel").replace("{country}", country.name), href: `/hospitals/country/${country.slug}`, hint: tSsc("exploreItemCountryHospitalsHint") },
        { eyebrow: tSsc("exploreEyebrowHospitals"), label: tSsc("exploreItemSpecialtyHospitalsLabel").replace("{specialty}", specialty.name), href: `/hospitals/specialty/${specialtyParam}`, hint: tSsc("exploreItemSpecialtyHospitalsHint") },
        { eyebrow: tSsc("exploreEyebrowVisa"), label: tSsc("exploreItemVisaLabel").replace("{country}", country.name), href: `/visa/${country.slug}`, hint: tSsc("exploreItemVisaHint") },
        { eyebrow: tSsc("exploreEyebrowBrowse"), label: tSsc("exploreItemAllProceduresLabel"), href: "/treatments", hint: tSsc("exploreItemAllProceduresHint") },
        { eyebrow: tSsc("exploreEyebrowCompare"), label: tSsc("exploreItemDoctorCompareLabel"), href: "/compare/doctors", hint: tSsc("exploreItemDoctorCompareHint") },
        { eyebrow: tSsc("exploreEyebrowCompare"), label: tSsc("exploreItemHospitalCompareLabel"), href: "/compare/hospitals", hint: tSsc("exploreItemHospitalCompareHint") },
        { eyebrow: tSsc("exploreEyebrowTool"), label: tSsc("exploreItemCalculatorLabel"), href: "/calculator", hint: tSsc("exploreItemCalculatorHint") },
        { eyebrow: tSsc("exploreEyebrowAction"), label: tSsc("exploreItemSecondOpinionLabel"), href: "/second-opinion", hint: tSsc("exploreItemSecondOpinionHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
