---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppDoctorCta from "@/components/WhatsAppDoctorCta.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listSurgeonSpecialtiesForPlace, listDoctors, getGeoCountry } from "@/lib/queries";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance, surgeonNoun } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { Award, ChevronRight, MapPin } from "lucide-react";
import { doctorPortrait, countryBanner } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const countrySlug = Astro.params.countrySlug;
if (!countrySlug) return new Response("Not found", { status: 404 });
if (!isLocale(rawLocale)) return Astro.redirect(`/en/surgeons/country/${countrySlug}`, 308);
const locale = rawLocale as Locale;

const countryRow = await getGeoCountry(countrySlug);
if (!countryRow) return new Response(`Not found: ${countrySlug}`, { status: 404 });

const [{ specialties: rawSpecialties, total }, topSurgeons] = await Promise.all([
  listSurgeonSpecialtiesForPlace({ countrySlug }),
  listDoctors({ country: [countrySlug], page: 1, sort: "experience" }),
]);

// No surgeons at all in this country — nothing indexable to show.
if (total === 0 || rawSpecialties.length === 0) {
  return new Response(`No surgeons listed for ${countrySlug}`, { status: 404 });
}

const tc = getTranslator(locale, "common");
const tSco = getTranslator(locale, "surgeonsCountryPage");

// Localize DB content for non-default locales (getContent/getContentBatch
// return {} on `en`, so applyTranslated is a no-op there).
const countryMap = await getContent("country", countryRow.id, locale);
const country = applyTranslated(countryRow, countryMap, ["name"]);
const specialtyTx = await getContentBatch("specialty", rawSpecialties.map((s) => s.id), locale);
const specialties = rawSpecialties.map((s) => applyTranslated(s, specialtyTx[s.id] ?? {}, ["name"]));
const doctorTx = await getContentBatch("doctor", topSurgeons.rows.map((d) => d.id), locale);
const year = new Date().getFullYear();
const countText = total.toLocaleString();
const path = `/surgeons/country/${countrySlug}`;

const seoTitle = tSco("seoTitle")
  .replace("{country}", country.name)
  .replace("{year}", String(year));
const seoDescription = tSco("seoDescription")
  .replace("{count}", countText)
  .replace("{country}", country.name)
  .replace("{specialties}", String(specialties.length))
  .slice(0, 160);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tSco("breadcrumbSurgeons"), url: localeUrl(locale, "/surgeons") },
  { name: country.name, url: localeUrl(locale, path) },
]);

const collectionLd = withProvenance(
  collectionPageJsonLd({
    name: tSco("collectionName").replace("{country}", country.name),
    description: seoDescription,
    url: localeUrl(locale, path),
    items: specialties.map((s) => ({
      name: `${surgeonNoun(s.slug, s.name)} in ${country.name}`,
      url: localeUrl(locale, `/surgeons/${s.slug}/${countrySlug}`),
    })),
  }),
  { dateModified: new Date() },
);

const stats = [
  { l: tSco("statSurgeons"), v: countText },
  { l: tSco("statSpecialties"), v: specialties.length.toLocaleString() },
  { l: tSco("statVerified"), v: tSco("statVerifiedValue") },
  { l: tSco("statReplyTime"), v: tSco("statReplyTimeValue") },
];

const topStrip = topSurgeons.rows
  .slice(0, 12)
  .map((d) => applyTranslated(d, doctorTx[d.id] ?? {}, ["name", "qualifications"]));

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={isUntranslated(locale, countryMap)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/surgeons")} class="hover:text-ink">{tSco("breadcrumbSurgeons")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{country.name}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tSco("heroEyebrow").replace("{count}", countText).replace("{country}", country.name)}
      h1First={tSco("heroH1First")}
      h1Italic={country.name}
      lede={tSco("heroLede").replace("{country}", country.name)}
      stats={stats}
      locale={locale}
      image={countryBanner(countrySlug)}
      imageAlt={tSco("heroImageAlt").replace("{country}", country.name)}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-6 pb-10">
      <h2 class="display-tight mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tSco("specialtySectionHeadingPre")} {country.name} <span class="italic-display">{tSco("specialtySectionHeadingItalic")}</span>
      </h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {specialties.map((s) => (
          <li>
            <a
              href={localizedPath(locale, `/surgeons/${s.slug}/${countrySlug}`)}
              class="paper group flex h-full flex-col transition hover:-translate-y-0.5"
              style="padding: 22px 24px;"
            >
              <div class="serif" style="font-size: 20px; line-height: 1.2; letter-spacing: -0.01em; color: var(--color-ink);">
                {s.name}
              </div>
              <div class="mt-2 mono uppercase tnum" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                {s.docs.toLocaleString()} surgeon{s.docs === 1 ? "" : "s"}
              </div>
              <div
                class="mt-auto flex items-center justify-between"
                style="border-top: 1px dashed var(--color-border); margin-top: 14px; padding-top: 12px;"
              >
                <span class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tSco("viewRoster")}
                </span>
                <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {topStrip.length > 0 && (
      <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pb-12 border-t border-border-soft pt-10">
        <h2 class="display-tight mb-5" style="font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em;">
          {tSco("topSurgeonsHeading").replace("{country}", country.name)}
        </h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {topStrip.map((d) => {
            const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
            const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
            const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
            return (
              <li class="flex flex-col gap-2">
                <a
                  href={localizedPath(locale, `/doctor/${d.slug}`)}
                  class="group flex flex-1 gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <img
                    src={doctorPortrait({ imageUrl: d.imageUrl, id: d.id }, 128)}
                    alt={d.name}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                  />
                  <div class="min-w-0 flex-1">
                    <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                    {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-1">{d.qualifications}</span>}
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                      {d.experienceYears != null && (
                        <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{d.experienceYears} {tSco("yrs")}</span>
                      )}
                      {d.rating && Number(d.rating) > 0 && (
                        <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                      )}
                    </div>
                    {d.hospitalName && (
                      <div class="mt-2 text-[12px] text-ink-subtle inline-flex items-center gap-1">
                        <MapPin className="h-3 w-3" />{d.hospitalName}{d.cityName ? ` · ${d.cityName}` : ""}
                      </div>
                    )}
                  </div>
                </a>
                <WhatsAppDoctorCta doctorName={d.name} doctorSlug={d.slug} hospitalName={d.hospitalName} />
              </li>
            );
          })}
        </ul>
        <div class="mt-6">
          <a
            href={localizedPath(locale, `/doctors/country/${countrySlug}`)}
            class="mono uppercase inline-flex items-center gap-1.5"
            style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent);"
          >
            {tSco("browseAllDoctors").replace("{country}", country.name)}
          </a>
        </div>
      </section>
    )}

    <HowItWorks
      heading={tSco("howHeading").replace("{country}", country.name)}
      italicWord={country.name}
      eyebrow={tSco("howEyebrow")}
      steps={[
        { title: tSco("howStep1Title"), description: tSco("howStep1Desc") },
        { title: tSco("howStep2Title"), description: tSco("howStep2Desc") },
        { title: tSco("howStep3Title"), description: tSco("howStep3Desc").replace("{country}", country.name) },
        { title: tSco("howStep4Title"), description: tSco("howStep4Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tSco("exploreEyebrow").replace("{country}", country.name)}
      heading={tSco("exploreHeading").replace("{country}", country.name)}
      lede={tSco("exploreLede")}
      items={[
        { eyebrow: tSco("exploreItem1Eyebrow"), label: tSco("exploreItem1Label").replace("{country}", country.name), href: `/doctors/country/${countrySlug}`, hint: tSco("exploreItem1Hint") },
        { eyebrow: tSco("exploreItem2Eyebrow"), label: tSco("exploreItem2Label").replace("{country}", country.name), href: `/country/${countrySlug}`, hint: tSco("exploreItem2Hint").replace("{country}", country.name) },
        { eyebrow: tSco("exploreItem3Eyebrow"), label: tSco("exploreItem3Label").replace("{country}", country.name), href: `/hospitals/country/${countrySlug}`, hint: tSco("exploreItem3Hint") },
        { eyebrow: tSco("exploreItem4Eyebrow"), label: tSco("exploreItem4Label").replace("{country}", country.name), href: `/treatments/country/${countrySlug}`, hint: tSco("exploreItem4Hint") },
        { eyebrow: tSco("exploreItem5Eyebrow"), label: tSco("exploreItem5Label").replace("{country}", country.name), href: `/visa/${countrySlug}`, hint: tSco("exploreItem5Hint") },
        ...(specialties[0] ? [{ eyebrow: tSco("exploreItem6Eyebrow"), label: tSco("exploreItem6Label").replace("{specialty}", specialties[0].name).replace("{country}", country.name), href: `/best/${specialties[0].slug}-in-${countrySlug}`, hint: tSco("exploreItem6Hint") }] : []),
        { eyebrow: tSco("exploreItem7Eyebrow"), label: tSco("exploreItem7Label"), href: "/surgeons", hint: tSco("exploreItem7Hint") },
        { eyebrow: tSco("exploreItem8Eyebrow"), label: tSco("exploreItem8Label"), href: "/compare/doctors", hint: tSco("exploreItem8Hint") },
        { eyebrow: tSco("exploreItem9Eyebrow"), label: tSco("exploreItem9Label"), href: "/match-me", hint: tSco("exploreItem9Hint") },
        { eyebrow: tSco("exploreItem10Eyebrow"), label: tSco("exploreItem10Label"), href: "/second-opinion", hint: tSco("exploreItem10Hint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
