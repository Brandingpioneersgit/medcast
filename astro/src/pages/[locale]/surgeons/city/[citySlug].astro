---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppDoctorCta from "@/components/WhatsAppDoctorCta.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listSurgeonSpecialtiesForPlace, listDoctors, getGeoCity } from "@/lib/queries";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance, surgeonNoun } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { Award, ChevronRight, MapPin } from "lucide-react";
import { doctorPortrait, countryBanner } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const citySlug = Astro.params.citySlug;
if (!citySlug) return new Response("Not found", { status: 404 });
if (!isLocale(rawLocale)) return Astro.redirect(`/en/surgeons/city/${citySlug}`, 308);
const locale = rawLocale as Locale;

const city = await getGeoCity(citySlug);
if (!city) return new Response(`Not found: ${citySlug}`, { status: 404 });

// Localize the parent country (city names have no DB translations — proper
// nouns, left as-is). getContent returns {} on `en`, so this is a no-op there.
const rawCountry = city.country ?? null;
const countryMap = rawCountry ? await getContent("country", rawCountry.id, locale) : {};
const country = rawCountry ? applyTranslated(rawCountry, countryMap, ["name"]) : null;

const [{ specialties: rawSpecialties, total }, topSurgeons] = await Promise.all([
  listSurgeonSpecialtiesForPlace({ citySlug }),
  listDoctors({ city: citySlug, page: 1, sort: "experience" }),
]);

// Inventory floor: a city with fewer than 3 surgeons isn't worth its own
// indexable hub — send it up to the country roster.
if (total < 3 && country) {
  return Astro.redirect(localizedPath(locale, `/surgeons/country/${country.slug}`), 301);
}
if (total === 0 || rawSpecialties.length === 0) {
  return new Response(`No surgeons listed for ${citySlug}`, { status: 404 });
}

const tc = getTranslator(locale, "common");
const tSc = getTranslator(locale, "surgeonsCityPage");
const specialtyTx = await getContentBatch("specialty", rawSpecialties.map((s) => s.id), locale);
const specialties = rawSpecialties.map((s) => applyTranslated(s, specialtyTx[s.id] ?? {}, ["name"]));
const doctorTx = await getContentBatch("doctor", topSurgeons.rows.map((d) => d.id), locale);
const year = new Date().getFullYear();
const countText = total.toLocaleString();
const placeLabel = country ? `${city.name}, ${country.name}` : city.name;
const path = `/surgeons/city/${citySlug}`;

const seoTitle = tSc("seoTitle").replace("{city}", city.name).replace("{year}", String(year));
const seoDescription = tSc("seoDescription")
  .replace("{count}", countText)
  .replace("{place}", placeLabel)
  .replace("{specialtyCount}", String(specialties.length))
  .slice(0, 160);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tSc("breadcrumbSurgeons"), url: localeUrl(locale, "/surgeons") },
  ...(country ? [{ name: country.name, url: localeUrl(locale, `/surgeons/country/${country.slug}`) }] : []),
  { name: city.name, url: localeUrl(locale, path) },
]);

const collectionLd = withProvenance(
  collectionPageJsonLd({
    name: tSc("collectionName").replace("{place}", placeLabel),
    description: seoDescription,
    url: localeUrl(locale, path),
    items: specialties.map((s) => ({
      name: `${surgeonNoun(s.slug, s.name)} in ${city.name}`,
      url: localeUrl(locale, `/surgeons/${s.slug}/${citySlug}`),
    })),
  }),
  { dateModified: new Date() },
);

const stats = [
  { l: tSc("statSurgeons"), v: countText },
  { l: tSc("statSpecialties"), v: specialties.length.toLocaleString() },
  { l: tSc("statCountry"), v: country?.name ?? "—" },
  { l: tSc("statReplyTime"), v: tSc("statReplyTimeVal") },
];

const topStrip = topSurgeons.rows
  .slice(0, 12)
  .map((d) => applyTranslated(d, doctorTx[d.id] ?? {}, ["name", "qualifications"]));

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={isUntranslated(locale, countryMap)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/surgeons")} class="hover:text-ink">{tSc("breadcrumbSurgeons")}</a>
          {country && (
            <>
              <span class="mx-1.5">/</span>
              <a href={localizedPath(locale, `/surgeons/country/${country.slug}`)} class="hover:text-ink">{country.name}</a>
            </>
          )}
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{city.name}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tSc("heroEyebrow").replace("{count}", countText).replace("{place}", placeLabel)}
      h1First={tSc("heroH1First")}
      h1Italic={city.name}
      lede={tSc("heroLede").replace("{place}", placeLabel)}
      stats={stats}
      locale={locale}
      image={countryBanner(country?.slug)}
      imageAlt={tSc("heroImageAlt").replace("{city}", city.name)}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-6 pb-10">
      <h2 class="display-tight mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tSc("specialtiesBySpecialtyH2").replace("{city}", city.name)} <span class="italic-display">{tSc("specialtiesBySpecialtyItalic")}</span>
      </h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {specialties.map((s) => (
          <li>
            <a
              href={localizedPath(locale, `/surgeons/${s.slug}/${citySlug}`)}
              class="paper group flex h-full flex-col transition hover:-translate-y-0.5"
              style="padding: 22px 24px;"
            >
              <div class="serif" style="font-size: 20px; line-height: 1.2; letter-spacing: -0.01em; color: var(--color-ink);">
                {s.name}
              </div>
              <div class="mt-2 mono uppercase tnum" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                {s.docs.toLocaleString()} {s.docs === 1 ? tSc("surgeonSingular") : tSc("surgeonPlural")}
              </div>
              <div
                class="mt-auto flex items-center justify-between"
                style="border-top: 1px dashed var(--color-border); margin-top: 14px; padding-top: 12px;"
              >
                <span class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tSc("viewRoster")}
                </span>
                <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {topStrip.length > 0 && (
      <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pb-12 border-t border-border-soft pt-10">
        <h2 class="display-tight mb-5" style="font-size: clamp(1.4rem, 2.6vw, 2rem); letter-spacing: -0.02em;">
          {tSc("mostExperiencedH2").replace("{city}", city.name)}
        </h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {topStrip.map((d) => {
            const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
            const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
            const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
            return (
              <li class="flex flex-col gap-2">
                <a
                  href={localizedPath(locale, `/doctor/${d.slug}`)}
                  class="group flex flex-1 gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <img
                    src={doctorPortrait({ imageUrl: d.imageUrl, id: d.id }, 128)}
                    alt={d.name}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                  />
                  <div class="min-w-0 flex-1">
                    <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                    {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-1">{d.qualifications}</span>}
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                      {d.experienceYears != null && (
                        <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{d.experienceYears} {tSc("yrs")}</span>
                      )}
                      {d.rating && Number(d.rating) > 0 && (
                        <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                      )}
                    </div>
                    {d.hospitalName && (
                      <div class="mt-2 text-[12px] text-ink-subtle inline-flex items-center gap-1">
                        <MapPin className="h-3 w-3" />{d.hospitalName}
                      </div>
                    )}
                  </div>
                </a>
                <WhatsAppDoctorCta doctorName={d.name} doctorSlug={d.slug} hospitalName={d.hospitalName} />
              </li>
            );
          })}
        </ul>
        <div class="mt-6">
          <a
            href={localizedPath(locale, `/doctors/city/${citySlug}`)}
            class="mono uppercase inline-flex items-center gap-1.5"
            style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent);"
          >
            {tSc("browseAllDoctors").replace("{city}", city.name)}
          </a>
        </div>
      </section>
    )}

    <HowItWorks
      heading={tSc("howHeading").replace("{city}", city.name)}
      italicWord={tSc("howItalicWord")}
      eyebrow={tSc("howEyebrow")}
      steps={[
        { title: tSc("howStep1Title"), description: tSc("howStep1Desc") },
        { title: tSc("howStep2Title"), description: tSc("howStep2Desc") },
        { title: tSc("howStep3Title"), description: tSc("howStep3Desc").replace("{city}", city.name) },
        { title: tSc("howStep4Title"), description: tSc("howStep4Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tSc("exploreEyebrow").replace("{city}", city.name)}
      heading={tSc("exploreHeading").replace("{city}", city.name)}
      lede={tSc("exploreLede")}
      items={[
        { eyebrow: tSc("exploreItemDoctorsEyebrow"), label: tSc("exploreItemDoctorsLabel").replace("{city}", city.name), href: `/doctors/city/${citySlug}`, hint: tSc("exploreItemDoctorsHint") },
        { eyebrow: tSc("exploreItemCityEyebrow"), label: tSc("exploreItemCityLabel").replace("{city}", city.name), href: `/city/${citySlug}`, hint: tSc("exploreItemCityHint") },
        { eyebrow: tSc("exploreItemHospitalsEyebrow"), label: tSc("exploreItemHospitalsLabel").replace("{city}", city.name), href: `/hospitals/city/${citySlug}`, hint: tSc("exploreItemHospitalsHint") },
        ...(country ? [{ eyebrow: tSc("exploreItemDestinationEyebrow"), label: tSc("exploreItemDestinationLabel").replace("{country}", country.name), href: `/surgeons/country/${country.slug}`, hint: tSc("exploreItemDestinationHint").replace("{city}", city.name).replace("{country}", country.name) }] : []),
        ...(country ? [{ eyebrow: tSc("exploreItemDestinationEyebrow"), label: tSc("exploreItemDestinationHubLabel").replace("{country}", country.name), href: `/country/${country.slug}`, hint: tSc("exploreItemDestinationHubHint").replace("{country}", country.name) }] : []),
        ...(specialties[0] ? [{ eyebrow: tSc("exploreItemSpecialtyEyebrow"), label: tSc("exploreItemSpecialtyLabel").replace("{specialty}", specialties[0].name), href: `/specialty/${specialties[0].slug}`, hint: tSc("exploreItemSpecialtyHint").replace("{count}", String(specialties[0].docs)) }] : []),
        { eyebrow: tSc("exploreItemBrowseEyebrow"), label: tSc("exploreItemBrowseLabel"), href: "/surgeons", hint: tSc("exploreItemBrowseHint") },
        { eyebrow: tSc("exploreItemCompareEyebrow"), label: tSc("exploreItemCompareLabel"), href: "/compare/doctors", hint: tSc("exploreItemCompareHint") },
        { eyebrow: tSc("exploreItemToolEyebrow"), label: tSc("exploreItemToolLabel"), href: "/match-me", hint: tSc("exploreItemToolHint") },
        { eyebrow: tSc("exploreItemActionEyebrow"), label: tSc("exploreItemActionLabel"), href: "/second-opinion", hint: tSc("exploreItemActionHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
