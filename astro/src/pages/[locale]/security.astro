---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { getTranslator } from "@/lib/messages";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const locale = (isLocale(rawLocale) ? rawLocale : "en") as Locale;
const tSe = getTranslator(locale, "securityPage");

Astro.response.headers.set("Cache-Control", "public, s-maxage=86400, stale-while-revalidate=604800");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tSe("seoTitle")}
      description={tSe("seoDescription")}
      path="/security"
      locale={locale}
      translatedLocales={["en"]}
      noindex={locale !== "en"}
    />
  </Fragment>

  <main id="main" style="min-height: 100dvh; background: var(--color-bg);">
    <SiteHeader locale={locale} />

    <section style="padding: 56px 28px 96px;">
      <div class="mx-auto" style="max-width: 720px;">
        <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tSe("eyebrow")}</p>
        <h1
          class="display display-tight mt-3"
          style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; font-weight: 400; letter-spacing: -0.03em;"
        >
          {tSe("h1Main")} <span class="italic-display">{tSe("h1Accent")}</span>
        </h1>
        <p class="serif mt-5" style="font-size: 17px; line-height: 1.55; color: var(--color-ink-muted);">
          {tSe("leadParagraph")}
        </p>

        <div class="prose-editorial mt-12">
          <h2>{tSe("h2HowToReport")}</h2>
          <p>
            {tSe("howToReportIntro")} <a href="mailto:medcastsdigital@gmail.com">medcastsdigital@gmail.com</a> {tSe("howToReportWith")}
          </p>
          <ul>
            <li>{tSe("reportItem1")}</li>
            <li>{tSe("reportItem2")}</li>
            <li>{tSe("reportItem3")}</li>
          </ul>
          <p>
            {tSe("urgentNote")}
          </p>

          <h2>{tSe("h2InScope")}</h2>
          <ul>
            <li><code>medcasts.com</code> + all <code>*.medcasts.com</code> subdomains</li>
            <li>{tSe("inScopeItem2")}</li>
            <li>{tSe("inScopeItem3")}</li>
            <li>{tSe("inScopeItem4")}</li>
            <li>{tSe("inScopeItem5")}</li>
            <li>SSRF, RCE, SQLi, deserialization, auth-bypass</li>
            <li>{tSe("inScopeItem7")}</li>
          </ul>

          <h2>{tSe("h2OutOfScope")}</h2>
          <ul>
            <li>{tSe("outOfScopeItem1")}</li>
            <li>{tSe("outOfScopeItem2")}</li>
            <li>{tSe("outOfScopeItem3")}</li>
            <li>{tSe("outOfScopeItem4")}</li>
            <li>{tSe("outOfScopeItem5")}</li>
            <li>{tSe("outOfScopeItem6")}</li>
          </ul>

          <h2>{tSe("h2WhatWeAsk")}</h2>
          <ul>
            <li><strong>{tSe("whatWeAskItem1Bold")}</strong> {tSe("whatWeAskItem1Rest")}</li>
            <li>{tSe("whatWeAskItem2")}</li>
            <li>{tSe("whatWeAskItem3")}</li>
            <li>{tSe("whatWeAskItem4")}</li>
          </ul>

          <h2>{tSe("h2Recognition")}</h2>
          <p>
            {tSe("recognitionParagraph")}
          </p>

          <h2>{tSe("h2Reference")}</h2>
          <ul>
            <li>{tSe("refItem1Label")}: <a href="/.well-known/security.txt">/.well-known/security.txt</a></li>
            <li>{tSe("refItem2Label")}: <a href={localizedPath(locale, "/editorial-policy")}>/editorial-policy</a></li>
            <li>{tSe("refItem3Label")}: <a href={localizedPath(locale, "/privacy-policy")}>/privacy-policy</a></li>
            <li>{tSe("refItem4Label")}: <a href="/api/health">/api/health</a></li>
          </ul>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tSe("gridEyebrow")}
      heading={tSe("gridHeading")}
      lede={tSe("gridLede")}
      items={[
        { eyebrow: tSe("gridItem1Eyebrow"), label: tSe("gridItem1Label"), href: "/editorial-policy", hint: tSe("gridItem1Hint") },
        { eyebrow: tSe("gridItem2Eyebrow"), label: tSe("gridItem2Label"), href: "/medical-board", hint: tSe("gridItem2Hint") },
        { eyebrow: tSe("gridItem3Eyebrow"), label: tSe("gridItem3Label"), href: "/privacy-policy", hint: tSe("gridItem3Hint") },
        { eyebrow: tSe("gridItem4Eyebrow"), label: tSe("gridItem4Label"), href: "/terms", hint: tSe("gridItem4Hint") },
        { eyebrow: tSe("gridItem5Eyebrow"), label: tSe("gridItem5Label"), href: "/accreditation", hint: tSe("gridItem5Hint") },
        { eyebrow: tSe("gridItem6Eyebrow"), label: tSe("gridItem6Label"), href: "/incident-report", hint: tSe("gridItem6Hint") },
        { eyebrow: tSe("gridItem7Eyebrow"), label: tSe("gridItem7Label"), href: "/about", hint: tSe("gridItem7Hint") },
        { eyebrow: tSe("gridItem8Eyebrow"), label: tSe("gridItem8Label"), href: "/contact", hint: tSe("gridItem8Hint") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
