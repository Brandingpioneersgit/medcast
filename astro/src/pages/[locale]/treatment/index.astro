---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import Price from "@/components/Price.astro";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/treatments", 308);
const locale = rawLocale as Locale;

type TreatmentRow = {
  slug: string;
  name: string;
  specialtyName: string | null;
  hospitalCount: number;
  fromUsd: number | null;
};

let rows: TreatmentRow[] = [];
try {
  rows = Array.from(
    await db.execute<TreatmentRow>(sql`
      SELECT t.slug, t.name,
        s.name AS "specialtyName",
        COALESCE((SELECT COUNT(DISTINCT ht.hospital_id)::int
                  FROM hospital_treatments ht
                  WHERE ht.treatment_id = t.id AND ht.is_active = true), 0) AS "hospitalCount",
        (SELECT MIN(ht.cost_min_usd)::int
                  FROM hospital_treatments ht
                  WHERE ht.treatment_id = t.id AND ht.cost_min_usd IS NOT NULL) AS "fromUsd"
      FROM treatments t
      LEFT JOIN specialties s ON s.id = t.specialty_id
      WHERE t.is_active = true
      ORDER BY t.name ASC
    `),
  );
} catch {
  rows = [];
}

type Group = { letter: string; items: TreatmentRow[] };
const groupedMap = new Map<string, Group>();
for (const r of rows) {
  const L = (r.name[0] ?? "#").toUpperCase();
  const key = /[A-Z]/.test(L) ? L : "#";
  if (!groupedMap.has(key)) groupedMap.set(key, { letter: key, items: [] });
  groupedMap.get(key)!.items.push(r);
}
const groups = Array.from(groupedMap.values()).sort((a, b) => a.letter.localeCompare(b.letter));
const allLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const activeLetters = new Set(groups.map((g) => g.letter));

const totalHospitals = rows.reduce((s, r) => s + r.hospitalCount, 0);

const tc = getTranslator(locale, "common");
const tTi = getTranslator(locale, "treatmentIndexPage");
const seoTitle = tTi("seoTitle");
const seoDescription = tTi("seoDescription").replace("{n}", String(rows.length));
const path = "/treatments";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tTi("breadcrumbTreatments"), url: localeUrl(locale, path) },
]);

const collectionLd = collectionPageJsonLd({
  name: tTi("collectionName"),
  description: seoDescription,
  url: localeUrl(locale, path),
  items: rows.map((r) => ({ name: r.name, url: localeUrl(locale, `/treatment/${r.slug}`) })),
});

const stats = [
  { l: tTi("statTreatments"), v: rows.length.toString() },
  { l: tTi("statHospitals"), v: totalHospitals.toString() },
].filter(Boolean) as Array<{ l: string; v: string }>;

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tTi("breadcrumbTreatments")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tTi("heroEyebrow").replace("{n}", String(rows.length))}
      h1First={tTi("heroH1First")}
      h1Italic={tTi("heroH1Italic")}
      lede={tTi("heroLede").replace("{n}", String(rows.length))}
      stats={stats}
    />

    <section style="padding: 32px 0 48px; position: sticky; top: 96px; z-index: 30; background: color-mix(in srgb, var(--color-bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">
        <div class="flex flex-wrap gap-1.5">
          {allLetters.map((L) => {
            const isActive = activeLetters.has(L);
            return (
              <a
                href={isActive ? `#letter-${L}` : undefined}
                title={isActive ? undefined : tTi("noEntries")}
                aria-disabled={isActive ? undefined : "true"}
                class="mono tnum inline-flex items-center justify-center transition"
                style={{
                  width: "32px", height: "32px",
                  fontSize: "12px", letterSpacing: "0.05em",
                  borderRadius: "9999px",
                  border: isActive ? "1px solid var(--color-ink)" : "1px dashed var(--color-border)",
                  color: isActive ? "var(--color-ink)" : "var(--color-ink-subtle)",
                  ...(isActive ? {} : {pointerEvents: "none", opacity: 0.4})
                }}
              >
                {L}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section style="padding-bottom: 88px;">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10">
        {groups.map((g) => (
          <div id={`letter-${g.letter}`} style="scroll-margin-top: 160px; padding: 48px 0; border-top: 1px solid var(--color-border-soft);">
            <div class="grid gap-10 lg:grid-cols-[0.22fr_1fr]">
              <div class="lg:sticky lg:top-40 lg:self-start">
                <div
                  class="display tnum letter-heading"
                  style="font-size: 96px; line-height: 0.9; letter-spacing: -0.04em; color: var(--color-ink);"
                >
                  {g.letter}
                </div>
                <div class="mono uppercase mt-1" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tTi("groupEntries").replace("{n}", String(g.items.length))}
                </div>
              </div>
              <ul>
                {g.items.map((t, i) => (
                  <li
                    style={i === 0
                  ? {borderTop: "1px dashed var(--color-border)"}
                  : {
                      borderTop: "1px dashed var(--color-border)",
                      ...(i === g.items.length - 1 ? {borderBottom: "1px dashed var(--color-border)"} : {})
                    }
                }
                  >
                    <a
                      href={localizedPath(locale, `/treatment/${t.slug}`)}
                      class="grid items-center gap-4 py-5 group"
                      style="grid-template-columns: 1fr auto auto auto auto;"
                    >
                      <div class="min-w-0">
                        <div class="serif group-hover:text-accent transition-colors" style="font-size: 20px; letter-spacing: -0.005em; color: var(--color-ink);">
                          {t.name}
                        </div>
                        {t.specialtyName && (
                          <div class="mt-1 mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                            {t.specialtyName}
                          </div>
                        )}
                      </div>
                      {t.fromUsd && (
                        <span class="mono tnum text-[11px]" style="color: var(--color-ink-muted);">
                          {tTi("priceFrom")} <Price usd={t.fromUsd} />
                        </span>
                      )}
                      {t.hospitalCount > 0 && (
                        <span class="mono tnum text-[11px]" style="color: var(--color-ink-subtle);">
                          {t.hospitalCount} {t.hospitalCount === 1 ? tTi("hospSingular") : tTi("hospPlural")}
                        </span>
                      )}
                      <ChevronRight className="h-4 w-4 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tTi("exploreEyebrow")}
      heading={tTi("exploreHeading")}
      lede={tTi("exploreLede")}
      items={[
        { eyebrow: tTi("item0Eyebrow"), label: tTi("item0Label"), href: "/specialties", hint: tTi("item0Hint") },
        { eyebrow: tTi("item1Eyebrow"), label: tTi("item1Label"), href: "/conditions", hint: tTi("item1Hint") },
        { eyebrow: tTi("item2Eyebrow"), label: tTi("item2Label"), href: "/countries", hint: tTi("item2Hint") },
        { eyebrow: tTi("item3Eyebrow"), label: tTi("item3Label"), href: "/calculator", hint: tTi("item3Hint") },
        { eyebrow: tTi("item4Eyebrow"), label: tTi("item4Label"), href: "/pricing-index", hint: tTi("item4Hint") },
        { eyebrow: tTi("item5Eyebrow"), label: tTi("item5Label"), href: "/compare/treatments", hint: tTi("item5Hint") },
        { eyebrow: tTi("item6Eyebrow"), label: tTi("item6Label"), href: "/match-me", hint: tTi("item6Hint") },
        { eyebrow: tTi("item7Eyebrow"), label: tTi("item7Label"), href: "/quote", hint: tTi("item7Hint") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .letter-heading { font-size: 48px !important; }
  }
</style>