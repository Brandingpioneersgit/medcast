---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { db } from "@/lib/db";
import { treatments } from "../../../../../../src/lib/db/schema";
import { eq } from "drizzle-orm";
import { getContent, applyTranslated, isUntranslated } from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, faqJsonLd } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/treatment/${slug}/recovery`, 308);
if (!slug) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

const t = await db.query.treatments.findFirst({
  where: eq(treatments.slug, slug),
  with: { specialty: true },
});
if (!t) return new Response(`Not found: ${slug}`, { status: 404 });
// No recovery window on file → no timeline to build; send to the main page.
if (t.recoveryDays == null) {
  return Astro.redirect(localizedPath(locale, `/treatment/${slug}`), 301);
}

const tc = getTranslator(locale, "common");
const tTr = getTranslator(locale, "treatmentRecoveryPage");
const tMap = await getContent("treatment", t.id, locale);
const treatment = applyTranslated(t, tMap, ["name", "description"]);
const R = t.recoveryDays;
const H = t.hospitalStayDays ?? 0;
const specialtySlug = t.specialty?.slug ?? "";
const dayCase = H === 0;

// Recovery phases — computed from the hospital stay + recovery window so the
// timeline is honest to this procedure rather than a generic template.
const wk = (d: number) =>
  d <= 13
    ? tTr("windowDay").replace("{d}", String(d))
    : tTr("windowWeek").replace("{w}", String(Math.round(d / 7)));
const phases = [
  {
    label: dayCase
      ? tTr("phase1LabelDayCase")
      : tTr("phase1LabelHospital")
          .replace("{H}", String(H))
          .replace("{nights}", H === 1 ? tTr("statNightSingular") : tTr("statNightPlural")),
    window: dayCase
      ? tTr("phase1WindowDayCase")
      : tTr("phase1WindowHospital").replace("{H}", String(H)),
    body: dayCase
      ? tTr("phase1BodyDayCase")
      : tTr("phase1BodyHospital"),
  },
  {
    label: tTr("phase2Label"),
    window: `${tTr("windowDay").replace("{d}", String(H + 1))}–${tTr("windowDay").replace("{d}", String(H + 5))}`,
    body: tTr("phase2Body"),
  },
  {
    label: tTr("phase3Label"),
    window: `${wk(H + 6)}–${wk(Math.max(H + 7, Math.round(R * 0.5)))}`,
    body: tTr("phase3Body"),
  },
  {
    label: tTr("phase4Label"),
    window: `Around day ${R}`,
    body: tTr("phase4Body").replace("{R}", String(R)),
  },
  {
    label: tTr("phase5Label"),
    window: `Beyond day ${R}`,
    body: tTr("phase5Body"),
  },
];

// Specialty-keyed red flags — when to seek urgent help.
const RED_FLAGS: Record<string, string[]> = {
  "cardiac-surgery": ["Chest pain, palpitations or breathlessness at rest", "Fever, or redness/discharge at the wound", "Sudden swelling in one leg", "Dizziness or fainting"],
  "orthopedics": ["Calf pain or swelling (possible clot)", "Fever or spreading wound redness", "Sudden loss of movement or new severe pain", "Numbness or pins-and-needles below the operated joint"],
  "oncology": ["Fever ≥38°C (infection risk during treatment)", "Uncontrolled nausea, vomiting or inability to keep fluids down", "Unusual bleeding or bruising", "Severe fatigue or breathlessness"],
  "neurology-neurosurgery": ["Severe or worsening headache", "New weakness, numbness or speech difficulty", "Seizure", "Fever with neck stiffness, or clear fluid from the wound/nose"],
  "organ-transplant": ["Fever or flu-like symptoms (rejection or infection)", "Reduced urine output or sudden weight gain", "Pain or tenderness over the graft", "Yellowing of skin or eyes"],
  "fertility-ivf": ["Severe abdominal pain or rapid bloating", "Heavy vaginal bleeding", "Shortness of breath or reduced urination (possible OHSS)", "Fever"],
  "cosmetic-surgery": ["Spreading redness, warmth or discharge at incisions", "Fever", "Sudden asymmetric swelling or severe pain", "Calf pain or breathlessness"],
  "bariatric-surgery": ["Persistent vomiting or inability to keep fluids down", "Fever or rapid heartbeat", "Severe abdominal pain", "Calf pain or breathlessness"],
};
const redFlags = RED_FLAGS[specialtySlug] ?? [
  "Fever, or spreading redness, warmth or discharge at the wound",
  "Pain that worsens instead of easing, or isn't controlled by prescribed medication",
  "Calf pain, swelling or breathlessness (possible clot)",
  "Anything that feels sudden, severe or simply wrong",
];

const flyHomeFrom = Math.max(H + 3, 7);
const flyHomeTo = Math.max(flyHomeFrom + 4, Math.round(R * 0.4));

const nightsStr = H === 1 ? tTr("statNightSingular") : tTr("statNightPlural");
const faqs = [
  {
    question: tTr("faqQ1").replace("{treatmentName}", treatment.name.toLowerCase()),
    answer: dayCase
      ? tTr("faqA1DayCase")
          .replace("{R}", String(R))
          .replace("{R}", String(R))
      : tTr("faqA1Hospital")
          .replace("{R}", String(R))
          .replace("{H}", String(H))
          .replace("{nights}", nightsStr)
          .replace("{R}", String(R)),
  },
  {
    question: tTr("faqQ2").replace("{treatmentName}", treatment.name.toLowerCase()),
    answer: tTr("faqA2")
      .replace("{from}", String(flyHomeFrom))
      .replace("{to}", String(flyHomeTo)),
  },
  {
    question: tTr("faqQ3"),
    answer: tTr("faqA3").replace("{R}", String(R)),
  },
  {
    question: tTr("faqQ4"),
    answer: tTr("faqA4"),
  },
  {
    question: tTr("faqQ5"),
    answer: treatment.specialty?.name
      ? tTr("faqA5WithSpecialty").replace("{specialtyName}", treatment.specialty.name.toLowerCase())
      : tTr("faqA5NoSpecialty"),
  },
];

const seoTitle = `${treatment.name} Recovery Time — Week-by-Week Guide`;
const seoDescription =
  `${treatment.name} recovery: a day-by-day timeline — hospital stay, when you can fly home, return to work around day ${R}, red flags to watch, and follow-up. Reviewed by the MedCasts editorial desk.`.slice(0, 160);

const path = `/treatment/${slug}/recovery`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tTr("breadcrumbTreatments"), url: localeUrl(locale, "/treatments") },
  { name: treatment.name, url: localeUrl(locale, `/treatment/${slug}`) },
  { name: tTr("breadcrumbRecovery"), url },
]);
const faqLd = faqJsonLd(faqs);
const pageLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: seoTitle,
  description: seoDescription,
  url,
  about: { "@type": "MedicalProcedure", name: treatment.name },
  lastReviewed: new Date().toISOString().slice(0, 10),
  reviewedBy: { "@type": "Organization", name: "MedCasts editorial desk", url: localeUrl(locale, "/editorial-policy") },
};

const untranslated = isUntranslated(locale, tMap);

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-5xl px-6 py-3.5 text-sm text-ink-muted overflow-x-auto whitespace-nowrap">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/treatments")} class="hover:text-accent">{tTr("breadcrumbTreatments")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/treatment/${slug}`)} class="hover:text-accent">{treatment.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{tTr("breadcrumbRecovery")}</span>
      </div>
    </nav>

    <section class="mx-auto max-w-5xl px-6 pt-10 md:pt-14 pb-8">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {tTr("eyebrowRecoveryGuide")}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4.5vw, 3.3rem); letter-spacing: -0.025em; line-height: 1.04;">
        {treatment.name}{tTr("h1Suffix")}
      </h1>
      <p class="lede mt-5 max-w-[44rem]">
        {tTr("ledePara").replace("{treatmentName}", treatment.name.toLowerCase()).replace("{R}", String(R))}
      </p>
      <div class="mt-5"><LastUpdated updated={new Date()} locale={locale} showPolicyLink /></div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-border bg-surface p-3">
          <div class="mono uppercase text-[10px]" style="letter-spacing: 0.1em; color: var(--color-ink-subtle);">{tTr("statHospitalStay")}</div>
          <div class="display tnum mt-1" style="font-size: 20px;">{dayCase ? tTr("statDayCase") : `${H} ${H === 1 ? tTr("statNightSingular") : tTr("statNightPlural")}`}</div>
        </div>
        <div class="rounded-lg border border-border bg-surface p-3">
          <div class="mono uppercase text-[10px]" style="letter-spacing: 0.1em; color: var(--color-ink-subtle);">{tTr("statBackToNormal")}</div>
          <div class="display tnum mt-1" style="font-size: 20px;">~{R} days</div>
        </div>
        <div class="rounded-lg border border-border bg-surface p-3">
          <div class="mono uppercase text-[10px]" style="letter-spacing: 0.1em; color: var(--color-ink-subtle);">{tTr("statFlyHome")}</div>
          <div class="display tnum mt-1" style="font-size: 20px;">{flyHomeFrom}–{flyHomeTo} days</div>
        </div>
        <div class="rounded-lg border border-border bg-surface p-3">
          <div class="mono uppercase text-[10px]" style="letter-spacing: 0.1em; color: var(--color-ink-subtle);">{tTr("statSpecialty")}</div>
          <div class="mt-1" style="font-size: 14px; font-weight: 600;">{t.specialty?.name ?? "—"}</div>
        </div>
      </div>
    </section>

    {/* Timeline */}
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <h2 class="display-tight mb-6" style="font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -0.02em;">
        {tTr("timelineH2")}
      </h2>
      <ol class="relative space-y-5 border-s-2 border-border ps-6">
        {phases.map((p, i) => (
          <li class="relative">
            <span
              class="absolute flex h-7 w-7 items-center justify-center rounded-full bg-accent text-accent-contrast tnum"
              style="inset-inline-start: -38px; top: 0; font-size: 12px; font-weight: 700;"
            >
              {i + 1}
            </span>
            <div class="paper p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-[18px]">{p.label}</h3>
                <span class="mono uppercase text-[11px]" style="letter-spacing: 0.1em; color: var(--color-accent);">{p.window}</span>
              </div>
              <p class="serif mt-2" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* When to fly home callout */}
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <div class="paper p-6" style="border-inline-start: 3px solid var(--color-accent);">
        <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.13em; color: var(--color-accent);">{tTr("fitToFlyEyebrow")}</div>
        <h3 class="font-display text-xl mt-2">{tTr("fitToFlyH3").replace("{from}", String(flyHomeFrom)).replace("{to}", String(flyHomeTo))}</h3>
        <p class="serif mt-2" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">
          {tTr("fitToFlyBody")}
        </p>
      </div>
    </section>

    {/* Red flags */}
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <div class="paper p-6" style="border-inline-start: 3px solid var(--color-coral, #E85A4F);">
        <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.13em; color: var(--color-coral, #E85A4F);">{tTr("redFlagsEyebrow")}</div>
        <h3 class="font-display text-xl mt-2">{tTr("redFlagsH3")}</h3>
        <ul class="mt-3 space-y-2">
          {redFlags.map((f) => (
            <li class="flex gap-2.5 items-start" style="font-size: 14.5px; line-height: 1.55;">
              <span style="color: var(--color-coral, #E85A4F); font-weight: 700;">!</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[13px]" style="color: var(--color-ink-subtle);">
          {tTr("redFlagsDisclaimer")}
        </p>
      </div>
    </section>

    {/* FAQ */}
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <h2 class="display-tight mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -0.02em;">
        {tTr("faqH2")}
      </h2>
      <div class="divide-y divide-border-soft border-y border-border-soft">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-4 py-4 list-none">
              <span class="font-display text-[16px]">{f.question}</span>
              <ChevronRight className="h-4 w-4 shrink-0 text-ink-subtle transition-transform group-open:rotate-90" />
            </summary>
            <p class="pb-4 serif" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {/* CTA */}
    <section class="mx-auto max-w-5xl px-6 pb-16">
      <div class="paper p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-[34rem]">
          <h3 class="font-display text-xl md:text-2xl">{tTr("ctaH3").replace("{treatmentName}", treatment.name.toLowerCase())}</h3>
          <p class="mt-1.5 text-sm text-ink-muted">
            {tTr("ctaBody")}
          </p>
        </div>
        <a
          href={localizedPath(locale, `/treatment/${slug}`)}
          class="inline-flex shrink-0 items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
        >
          {tTr("ctaButton").replace("{treatmentName}", treatment.name)}
        </a>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tTr("exploreEyebrow").replace("{treatmentName}", treatment.name)}
      heading={tTr("exploreHeading")}
      lede={tTr("exploreLede")}
      items={[
        {
          eyebrow: tTr("exploreItem1Eyebrow"),
          label: tTr("exploreItem1Label").replace("{treatmentName}", treatment.name),
          href: `/treatment/${slug}`,
          hint: tTr("exploreItem1Hint"),
        },
        ...(t.specialty
          ? [{
              eyebrow: tTr("exploreItem2Eyebrow"),
              label: tTr("exploreItem2Label").replace("{specialtyName}", t.specialty.name),
              href: `/specialty/${t.specialty.slug}`,
              hint: tTr("exploreItem2Hint").replace("{specialtyNameLower}", t.specialty.name.toLowerCase()),
            }]
          : []),
        {
          eyebrow: tTr("exploreItem3Eyebrow"),
          label: tTr("exploreItem3Label"),
          href: "/quote-plan",
          hint: tTr("exploreItem3Hint"),
        },
        {
          eyebrow: tTr("exploreItem4Eyebrow"),
          label: tTr("exploreItem4Label"),
          href: "/calculator",
          hint: tTr("exploreItem4Hint"),
        },
        {
          eyebrow: tTr("exploreItem5Eyebrow"),
          label: tTr("exploreItem5Label"),
          href: "/second-opinion",
          hint: tTr("exploreItem5Hint"),
        },
        {
          eyebrow: tTr("exploreItem6Eyebrow"),
          label: tTr("exploreItem6Label"),
          href: "/glossary",
          hint: tTr("exploreItem6Hint"),
        },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
