---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { db } from "@/lib/db";
import Price from "@/components/Price.astro";
import { formatUsd } from "@/lib/currency";
import WhyCountrySection from "@/components/content/WhyCountrySection.astro";
import TravelLogisticsSection from "@/components/content/TravelLogisticsSection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import { getTreatmentSections, getCountrySections } from "@/lib/content-sections";
import {
  hospitals, hospitalTreatments, treatments, specialties, cities, countries,
  testimonials as testimonialsTbl,
} from "../../../../../../src/lib/db/schema";
import { and, asc, desc, eq } from "drizzle-orm";
type TestimonialRow = { id: number; rating: number; isVerified: boolean | null; title: string | null; story: string; patientName: string | null; patientCountry: string | null; patientAge: number | null };
async function getTestimonialsForTreatment(treatmentId: number, limit: number): Promise<TestimonialRow[]> {
  return db
    .select({
      id: testimonialsTbl.id,
      rating: testimonialsTbl.rating,
      isVerified: testimonialsTbl.isVerified,
      title: testimonialsTbl.title,
      story: testimonialsTbl.story,
      patientName: testimonialsTbl.patientName,
      patientCountry: testimonialsTbl.patientCountry,
      patientAge: testimonialsTbl.patientAge,
    })
    .from(testimonialsTbl)
    .where(and(eq(testimonialsTbl.treatmentId, treatmentId), eq(testimonialsTbl.isActive, true)))
    .orderBy(desc(testimonialsTbl.isFeatured), desc(testimonialsTbl.createdAt))
    .limit(limit);
}
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { breadcrumbJsonLd, localeUrl, treatmentJsonLd, faqJsonLd, withProvenance } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
const countrySlug = Astro.params.country;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/treatment/${slug}/${countrySlug}`, 308);
if (!slug || !countrySlug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tTcy = getTranslator(locale, "treatmentCountryPage");

const treatmentRow = await db.query.treatments.findFirst({
  where: eq(treatments.slug, slug),
  with: { specialty: true },
});
if (!treatmentRow) return new Response(`Not found: ${slug}`, { status: 404 });

const countryRow = await db.query.countries.findFirst({ where: eq(countries.slug, countrySlug) });
if (!countryRow) {
  // Param may be a city slug (e.g. /treatment/cabg-heart-bypass/new-delhi).
  // 301 to the city's country page so city-shaped URLs (sitemap-treatments-cities,
  // city/[slug] cross-links) still resolve to useful content. Country is canonical.
  const cityFallback = await db.query.cities.findFirst({
    where: eq(cities.slug, countrySlug),
    with: { country: true },
  });
  if (cityFallback?.country?.slug) {
    return Astro.redirect(
      `/${locale}/treatment/${slug}/${cityFallback.country.slug}?city=${countrySlug}`,
      301,
    );
  }
  return new Response(`Not found: ${countrySlug}`, { status: 404 });
}

// Hospital pricing for this treatment × country
const pricingRows = await db
  .select({
    hospitalId: hospitals.id,
    hospitalName: hospitals.name,
    hospitalSlug: hospitals.slug,
    hospitalRating: hospitals.rating,
    hospitalBeds: hospitals.bedCapacity,
    hospitalImage: hospitals.coverImageUrl,
    cityName: cities.name,
    citySlug: cities.slug,
    costMinUsd: hospitalTreatments.costMinUsd,
    costMaxUsd: hospitalTreatments.costMaxUsd,
    includesDescription: hospitalTreatments.includesDescription,
  })
  .from(hospitalTreatments)
  .innerJoin(hospitals, eq(hospitalTreatments.hospitalId, hospitals.id))
  .innerJoin(cities, eq(hospitals.cityId, cities.id))
  .innerJoin(countries, eq(cities.countryId, countries.id))
  .where(
    and(
      eq(hospitalTreatments.treatmentId, treatmentRow.id),
      eq(hospitals.isActive, true),
      eq(countries.slug, countrySlug),
    ),
  )
  .orderBy(asc(hospitalTreatments.costMinUsd))
  .limit(30);

// Translations
const treatmentMap = await getContent("treatment", treatmentRow.id, locale);
const treatment = applyTranslated(treatmentRow, treatmentMap, ["name", "description"]);

// Deep content sections (treatment-side + country-side)
const [treatmentContentRow, countryContentRow] = await Promise.all([
  getTreatmentSections(treatmentRow.id),
  getCountrySections(countryRow.id),
]);
const tcSections = treatmentContentRow?.content_sections ?? null;
const ccSections = countryContentRow?.content_sections ?? null;
const specialty = treatmentRow.specialty
  ? applyTranslated(treatmentRow.specialty, await getContent("specialty", treatmentRow.specialty.id, locale), ["name"])
  : null;

const hospitalIds = pricingRows.map((r) => r.hospitalId);
const hospitalMap = await getContentBatch("hospital", hospitalIds, locale);
const hospitalPricing = pricingRows.map((hp) => ({
  ...hp,
  hospitalName: hospitalMap[hp.hospitalId]?.name ?? hp.hospitalName,
}));

const lowestPrice = hospitalPricing[0]?.costMinUsd ? Number(hospitalPricing[0].costMinUsd) : null;
const highestPrice = hospitalPricing.reduce((acc, hp) => {
  const v = hp.costMaxUsd ? Number(hp.costMaxUsd) : 0;
  return v > acc ? v : acc;
}, 0);
const avgPrice =
  hospitalPricing.length > 0
    ? Math.round(hospitalPricing.reduce((sum, h) => sum + Number(h.costMinUsd || 0), 0) / hospitalPricing.length)
    : null;

const US_REFERENCE: Record<string, number> = {
  "cabg-heart-bypass": 120000,
  "total-knee-replacement": 50000,
  "hip-replacement": 55000,
  "liver-transplant": 500000,
  "cancer-surgery": 80000,
  "kidney-transplant": 200000,
  "spine-surgery": 80000,
  "heart-valve-replacement": 150000,
  "ivf-cycle": 20000,
  "hair-transplant-fue": 15000,
  "gastric-sleeve": 22000,
};
const usPrice = US_REFERENCE[slug] ?? null;
const savingsPct = usPrice && lowestPrice ? Math.round((1 - lowestPrice / usPrice) * 100) : null;

const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
const flag = FLAG[countryRow.slug] ?? "🌐";

const seoTitle = tTcy("seoTitleTemplate").replace("{treatment}", treatment.name).replace("{country}", countryRow.name).replace("{year}", String(new Date().getFullYear()));
const stayPart = treatmentRow.hospitalStayDays
  ? `${treatmentRow.hospitalStayDays}-night stay. `
  : "";
const seoDescription = lowestPrice
  ? `${treatment.name} in ${countryRow.name} from $${Math.round(lowestPrice).toLocaleString()}. ${hospitalPricing.length} ${tTcy("seoDescAccreditedHospitals")}${savingsPct ? `, ${tTcy("seoDescSaveUpTo").replace("{pct}", String(savingsPct))}` : ""}. ${stayPart}${tTcy("seoDescFreeQuote")}`.slice(0, 160)
  : `${treatment.name} in ${countryRow.name}. ${tTcy("seoDescCompare")} ${stayPart}${tTcy("seoDescFreeQuote")}`.slice(0, 160);

const path = `/treatment/${slug}/${countrySlug}`;
const url = localeUrl(locale, path);

const jsonLd = withProvenance(
  treatmentJsonLd({
    name: `${treatment.name} in ${countryRow.name}`,
    description: treatment.description,
    costMinUsd: lowestPrice ? String(lowestPrice) : undefined,
    costMaxUsd: highestPrice > 0 ? String(highestPrice) : undefined,
    url,
    hospitalStayDays: treatmentRow.hospitalStayDays,
    successRatePercent: treatmentRow.successRatePercent ? Number(treatmentRow.successRatePercent) : null,
  }),
  { dateModified: treatmentRow.updatedAt },
);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("treatments"), url: localeUrl(locale, "/treatments") },
  ...(specialty ? [{ name: specialty.name, url: localeUrl(locale, `/specialty/${specialty.slug}`) }] : []),
  { name: treatment.name, url: localeUrl(locale, `/treatment/${slug}`) },
  { name: countryRow.name, url },
]);

// FAQs for this cost-in-country slice
const faqList = [
  {
    question: `Why is ${treatment.name} cheaper in ${countryRow.name}?`,
    answer: `Price differences are driven mainly by labour costs, surgeon fees, facility overhead, and currency effects — not equipment or outcomes. Many ${countryRow.name} centres run tier-1 platforms (da Vinci, Zeiss, Nobel) at a fraction of US or UK prices because staffing and real-estate costs are lower.`,
  },
  {
    question: `Are the hospitals we list in ${countryRow.name} internationally accredited?`,
    answer: `We only surface hospitals with active accreditation (JCI, NABH, ISO, national ministry licenses) and transparent pricing. Each listing shows the specific accreditation bodies relevant to that facility.`,
  },
  {
    question: `What's included in the ${treatment.name} package in ${countryRow.name}?`,
    answer: `A typical package covers the surgeon fee, anesthesia, standard room ward stay, routine medications, and first follow-up. Implants, ICU days beyond protocol, revisions, and extended medications are usually billed separately — your case manager itemises everything before you commit.`,
  },
  {
    question: `How long should I plan to be in ${countryRow.name}?`,
    answer: `Plan around the procedure + first follow-up happening before you fly home. For ${treatment.name}, that's typically ${treatmentRow.hospitalStayDays ? treatmentRow.hospitalStayDays + " inpatient nights + " : ""}around ${Math.max(14, (treatmentRow.hospitalStayDays ?? 0) + (treatmentRow.recoveryDays ?? 14))} days in-country before the flight home.`,
  },
  {
    question: `Can I get a second opinion before booking?`,
    answer: `Yes — free across our panel. Share imaging and current plan; we route to a multidisciplinary tumor-board or surgical panel and return a written opinion in 5–10 working days, no obligation to travel.`,
  },
];
const faqSchema = faqJsonLd(faqList);
const testimonials = await getTestimonialsForTreatment(treatmentRow.id, 3).catch(() => []);

const untranslated = isUntranslated(locale, treatmentMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      canonicalPath={`/treatment/${slug}`}
      noindex={untranslated || hospitalPricing.length === 0}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} active="treatments" />

    {/* Breadcrumb */}
    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav
        aria-label="Breadcrumb"
        class="mono mx-auto max-w-[1440px] px-7 md:px-10 flex items-center gap-2 flex-wrap"
        style="font-size: 12px; color: var(--color-ink-subtle);"
      >
        <a href={localizedPath(locale, "/treatments")} class="hover:text-ink">{tc("treatments")}</a>
        <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
        <a href={localizedPath(locale, `/treatment/${slug}`)} class="hover:text-ink">{treatment.name}</a>
        <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
        <span style="color: var(--color-ink);">{countryRow.name}</span>
      </nav>
    </div>

    {/* Hero */}
    <section style="padding: 48px 28px 0;">
      <div class="mx-auto max-w-[1440px]">
        {specialty && (
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 8px;">
            {specialty.name}
          </div>
        )}
        <div class="grid gap-10 lg:grid-cols-[2fr_1fr] lg:gap-[48px] items-start">
          <div>
            <h1
              class="display display-tight"
              style="font-size: clamp(2.5rem, 5.5vw, 4.25rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {treatment.name} {tTcy("heroCostIn")}
              <span style="font-style: italic;"> {flag} {countryRow.name}</span>
            </h1>
            <p
              class="serif mt-5"
              style="font-size: 20px; line-height: 1.45; color: var(--color-ink-muted); max-width: 680px;"
            >
              {lowestPrice
                ? `${treatment.name} in ${countryRow.name} ${tTcy("heroSubtextStartsFrom").replace("{price}", "$" + Math.round(lowestPrice).toLocaleString()).replace("{count}", String(hospitalPricing.length))}${savingsPct ? `. ${tTcy("heroSubtextSavings").replace("{pct}", String(savingsPct))}` : ""}.`
                : `${treatment.name} ${tTcy("heroSubtextNoPricing").replace("{country}", countryRow.name)}`}
            </p>

            {/* Price stat ribbon */}
            <div
              class="grid mt-8 py-5"
              style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
            >
              {[
                lowestPrice && { l: tTcy("statStartingPrice"), v: await formatUsd(Astro.cookies, lowestPrice) },
                avgPrice && { l: tTcy("statAverage"), v: await formatUsd(Astro.cookies, avgPrice) },
                { l: tTcy("statHospitalsListed"), v: hospitalPricing.length.toString() },
                treatmentRow.hospitalStayDays && { l: tTcy("statHospitalStay"), v: `${treatmentRow.hospitalStayDays} ${tTcy("statDays")}` },
                usPrice && savingsPct && { l: tTcy("statSaveVsUs"), v: `~${savingsPct}%` },
              ].filter(Boolean).slice(0, 4).map((s: any, i: number) => (
                <div style={i === 0
                  ? {paddingInline: "18px"}
                  : {paddingInline: "18px", borderInlineStart: "1px solid var(--color-border)"}
                }>
                  <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{s.l}</div>
                  <div class="display tnum" style="font-size: 28px; margin-top: 4px;">{s.v}</div>
                </div>
              ))}
            </div>
          </div>

          {/* Sticky quote panel */}
          <aside class="lg:sticky lg:top-32 lg:self-start">
            <div class="paper" style="padding: 22px;">
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                {tTcy("quoteEyebrow")}
              </div>
              <div class="display mt-1.5" style="font-size: 22px; line-height: 1.2; letter-spacing: -0.02em;">
                {tTcy("quoteHeading").replace("{treatment}", treatment.name).replace("{country}", countryRow.name)}
              </div>
              {lowestPrice && highestPrice > 0 && (
                <div class="flex items-baseline gap-2 mt-3">
                  <span class="display tnum" style="font-size: 32px; line-height: 1;"><Price usd={lowestPrice} /></span>
                  <span class="tnum" style="font-size: 13px; color: var(--color-ink-subtle);">— <Price usd={highestPrice} /></span>
                </div>
              )}
              <a
                href={localizedPath(locale, `/contact?treatment=${slug}&country=${countrySlug}`)}
                class="inline-flex items-center justify-center gap-2 w-full font-semibold mt-4"
                style="background: var(--color-accent); color: #FFF; padding: 14px 22px; font-size: 15px; border-radius: 9999px;"
              >
                {tTcy("quoteButton")}
                <ChevronRight className="h-3.5 w-3.5 mirror-x" />
              </a>
              <div class="flex items-center gap-2 mt-3 mono justify-center" style="font-size: 11px; color: var(--color-ink-subtle);">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: #10B981;" />
                {tTcy("caseManagerNote")}
              </div>
            </div>

            {/* Pricing disclaimer */}
            <div class="mt-6 paper" style="padding: 16px 20px; border: 1px solid var(--color-border-soft);">
              <div class="mono text-[10px] uppercase tracking-wider mb-2" style="color: var(--color-ink-subtle);">
                {tTcy("disclaimerEyebrow")}
              </div>
              <p class="serif" style="font-size: 13.5px; line-height: 1.6; color: var(--color-ink-muted);">
                {tTcy("disclaimerText")}
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {/* Savings band — only when US reference + destination price both known */}
    {usPrice && lowestPrice && savingsPct && savingsPct >= 20 && (
      <section style="padding: 28px 28px;">
        <div class="mx-auto max-w-[80rem]">
          <div
            class="paper grid items-center"
            style="padding: 24px 28px; grid-template-columns: 1fr; gap: 20px; border-inline-start: 4px solid var(--color-accent); background: linear-gradient(110deg, var(--color-accent-soft) 0%, var(--color-paper) 65%);"
          >
            <div class="grid gap-6 md:grid-cols-[auto_1fr_auto] md:items-center">
              <div>
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent-strong, var(--color-accent));">
                  {tTcy("savingsBandEyebrow")}
                </div>
                <div class="display tnum mt-1" style="font-size: 36px; line-height: 1; letter-spacing: -0.025em; color: var(--color-accent-strong, var(--color-accent));">
                  ~{savingsPct}%
                </div>
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle); margin-top: 2px;">
                  {tTcy("savingsBandLessThanUs")}
                </div>
              </div>
              <div>
                <p class="serif" style="font-size: 16px; line-height: 1.5; color: var(--color-ink);">
                  {tTcy("savingsBandBody1").replace("{treatment}", treatment.name)} <strong class="tnum">${Math.round(usPrice).toLocaleString()}</strong>. {tTcy("savingsBandBody2").replace("{country}", countryRow.name)} <strong class="tnum">${Math.round(lowestPrice).toLocaleString()}</strong> {tTcy("savingsBandBody3")}
                </p>
                <p class="mono uppercase mt-2" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                  {tTcy("savingsBandFootnote").replace("{country}", countryRow.name)}
                </p>
              </div>
              <a
                href={localizedPath(locale, `/contact?treatment=${slug}&country=${countrySlug}`)}
                class="inline-flex items-center justify-center gap-1.5 font-semibold whitespace-nowrap"
                style="background: var(--color-ink); color: var(--color-bg); padding: 12px 20px; border-radius: 9999px; font-size: 13.5px;"
              >
                {tTcy("savingsBandButton")}
                <ChevronRight className="h-3.5 w-3.5 mirror-x" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Ranked hospitals */}
    {hospitalPricing.length > 0 && (
      <section style="padding: 64px 28px; margin-top: 32px;">
        <div class="mx-auto max-w-[1440px]">
          <div class="flex items-end justify-between flex-wrap gap-4 mb-7">
            <h2 class="display" style="font-size: 32px; letter-spacing: -0.02em;">
              {tTcy("hospitalsHeading1").replace("{country}", countryRow.name).replace("{treatment}", treatment.name)},
              <span style="font-style: italic;"> {tTcy("hospitalsHeadingRanked")}</span>
            </h2>
            <a
              href={localizedPath(locale, `/treatment/${slug}`)}
              class="inline-flex items-center gap-1 text-sm"
              style="color: var(--color-accent);"
            >
              {tTcy("hospitalsCompareLink")}
            </a>
          </div>

          <div class="paper overflow-hidden" style="padding: 0;">
            {hospitalPricing.map((hp, i) => (
              <div
                class="grid items-center gap-4 p-5 md:p-6"
                style={i === 0
                  ? {gridTemplateColumns: "36px 1.4fr 1fr 0.8fr 0.6fr auto"}
                  : {gridTemplateColumns: "36px 1.4fr 1fr 0.8fr 0.6fr auto", borderTop: "1px solid var(--color-border-soft)"}
                }
              >
                <div class="display tnum" style="font-size: 22px; color: var(--color-ink-subtle);">
                  {String(i + 1).padStart(2, "0")}
                </div>
                <div class="min-w-0">
                  <a href={localizedPath(locale, `/hospital/${hp.hospitalSlug}`)}>
                    <div class="serif font-medium hover:text-accent truncate" style="font-size: 17px; letter-spacing: -0.005em;">
                      {hp.hospitalName}
                    </div>
                  </a>
                  <div class="mt-1 flex items-center gap-1.5" style="font-size: 12px; color: var(--color-ink-subtle);">
                    <span>{flag}</span>
                    {hp.cityName}, {countryRow.name}
                  </div>
                </div>
                <div>
                  <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{tTcy("hospitalRowFrom")}</div>
                  <div class="display tnum mt-0.5" style="font-size: 19px;">
                    {hp.costMinUsd ? <Price usd={Number(hp.costMinUsd)} /> : "—"}
                  </div>
                </div>
                <div>
                  <div class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle); text-transform: uppercase;">{tTcy("hospitalRowBeds")}</div>
                  <div class="tnum mt-1" style="font-size: 14px;">
                    {hp.hospitalBeds ? hp.hospitalBeds.toLocaleString() : "—"}
                  </div>
                </div>
                <div>
                  {hp.hospitalRating && Number(hp.hospitalRating) > 0 ? (
                    <div class="inline-flex items-center gap-1.5" style="font-size: 13px;">
                      <span style="color: var(--color-saffron);">★</span>
                      <span class="tnum">{Number(hp.hospitalRating).toFixed(1)}</span>
                    </div>
                  ) : (
                    <span style="font-size: 13px; color: var(--color-ink-subtle);">—</span>
                  )}
                </div>
                <a
                  href={localizedPath(locale, `/hospital/${hp.hospitalSlug}`)}
                  class="inline-flex items-center gap-1 font-semibold"
                  style="background: var(--color-ink); color: var(--color-bg); padding: 8px 14px; font-size: 12.5px; border-radius: 9999px;"
                >
                  {tTcy("hospitalRowQuote")}
                  <ChevronRight className="h-3.5 w-3.5 mirror-x" />
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* What's included */}
    <section style="padding: 64px 28px; background: var(--color-paper); border-top: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
          <div>
            <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tTcy("includedEyebrow")}</div>
            <h2 class="display mt-3" style="font-size: 30px; letter-spacing: -0.02em;">{tTcy("includedHeading").replace("{country}", countryRow.name)}</h2>
          </div>
          <div class="grid gap-8 md:grid-cols-2">
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">{tTcy("includedTypicallyEyebrow")}</div>
              <ul class="mt-3 space-y-2.5 serif" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink);">
                <li>{tTcy("includedItem1")}</li>
                <li>{tTcy("includedItem2")}</li>
                <li>{tTcy("includedItem3").replace("{nights}", String(treatmentRow.hospitalStayDays ?? 3))}</li>
                <li>{tTcy("includedItem4")}</li>
                <li>{tTcy("includedItem5")}</li>
              </ul>
            </div>
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-coral); text-transform: uppercase;">{tTcy("watchOutEyebrow")}</div>
              <ul class="mt-3 space-y-2.5 serif" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink);">
                <li>{tTcy("watchOutItem1")}</li>
                <li>{tTcy("watchOutItem2")}</li>
                <li>{tTcy("watchOutItem3")}</li>
                <li>{tTcy("watchOutItem4")}</li>
                <li>{tTcy("watchOutItem5")}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Why this destination — location-specific expert content */}
    <WhyCountrySection
      countryName={countryRow.name}
      countrySlug={countryRow.slug}
      treatmentName={treatment.name}
      hospitalCount={hospitalPricing.length}
      specialtyName={specialty?.name ?? null}
    />

    {/* Travel + recovery logistics */}
    <TravelLogisticsSection
      countryName={countryRow.name}
      countrySlug={countryRow.slug}
      recoveryDays={treatmentRow.recoveryDays}
      treatmentName={treatment.name}
    />

    {/* Combined treatment × country deep content */}
    {tcSections && (
      <>
        {tcSections.preparation && tcSections.preparation.length > 0 && (
          <section style="padding: 64px 28px; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto max-w-[1120px]">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    {tTcy("prepEyebrow")}
                  </div>
                  <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                    {tTcy("prepHeading").replace("{country}", countryRow.name)}
                  </h2>
                </div>
                <ol class="space-y-3">
                  {tcSections.preparation.map((step: string, i: number) => (
                    <li class="flex gap-4" style="font-size: 15.5px; line-height: 1.55;">
                      <span class="display tnum" style="font-size: 24px; line-height: 1; opacity: 0.4; min-width: 32px;">{String(i + 1).padStart(2, "0")}</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </section>
        )}

        {tcSections.recoveryTimeline && tcSections.recoveryTimeline.length > 0 && (
          <section style="padding: 64px 28px; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto max-w-[1120px]">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTcy("recoveryEyebrow")}
              </div>
              <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
                {tTcy("recoveryHeading").replace("{country}", countryRow.name)} <span style="font-style: italic;">{tTcy("recoveryHeadingItalic")}</span>
              </h2>
              <ol class="space-y-0">
                {tcSections.recoveryTimeline.map((step: any, i: number) => (
                  <li
                    class="grid items-start gap-4 md:gap-6 py-4"
                    style={`grid-template-columns: 140px 1fr; ${i > 0 ? "border-top: 1px solid var(--color-border-soft);" : ""}`}
                  >
                    <span class="mono uppercase" style="font-size: 11px; letter-spacing: 0.1em; color: var(--color-accent); padding-top: 3px;">
                      {step.week}
                    </span>
                    <span style="font-size: 15px; line-height: 1.55;">{step.milestone}</span>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}

        {tcSections.questionsToAsk && tcSections.questionsToAsk.length > 0 && (
          <section style="padding: 64px 28px; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto max-w-[1120px]">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTcy("questionsEyebrow")}
              </div>
              <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
                {tTcy("questionsHeading")} <span style="font-style: italic;">{tTcy("questionsHeadingItalic")}</span>
              </h2>
              <ol class="space-y-3">
                {tcSections.questionsToAsk.map((q: string, i: number) => (
                  <li class="flex gap-4 items-start paper" style="padding: 16px 22px;">
                    <span class="display tnum" style="font-size: 26px; line-height: 1; opacity: 0.35; min-width: 36px;">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <p style="font-size: 15.5px; line-height: 1.5;">{q}</p>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}

        {tcSections.redFlags && tcSections.redFlags.length > 0 && (
          <section style="padding: 64px 28px; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto max-w-[1120px]">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-coral, #E85A4F);">
                {tTcy("watchOutEyebrow")}
              </div>
              <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
                {tTcy("redFlagsHeading")} <span style="font-style: italic;">{tTcy("redFlagsHeadingItalic")}</span>
              </h2>
              <ul class="space-y-3">
                {tcSections.redFlags.map((rf: string) => (
                  <li
                    class="flex gap-4 items-start"
                    style="padding: 14px 18px; border: 1px solid var(--color-border-soft); border-inline-start: 3px solid var(--color-coral, #E85A4F); background: var(--color-paper);"
                  >
                    <span style="color: var(--color-coral, #E85A4F); font-weight: 700;">!</span>
                    <span style="font-size: 15px; line-height: 1.5;">{rf}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    )}

    {ccSections?.bestMonthsToTravel && (
      <section style="padding: 56px 28px; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto max-w-[1120px]">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTcy("travelTimingEyebrow")}
              </div>
              <h2 class="display mt-3" style="font-size: 24px; letter-spacing: -0.015em;">
                {tTcy("travelTimingHeading").replace("{country}", countryRow.name)}
              </h2>
            </div>
            <div class="paper" style="padding: 24px;">
              {ccSections.bestMonthsToTravel.peak && (
                <p class="mb-2" style="font-size: 15px;"><strong>{tTcy("travelTimingPeak")}</strong> {ccSections.bestMonthsToTravel.peak.join(", ")}</p>
              )}
              {ccSections.bestMonthsToTravel.avoid && ccSections.bestMonthsToTravel.avoid.length > 0 && (
                <p class="mb-2" style="font-size: 15px;"><strong>{tTcy("travelTimingAvoid")}</strong> {ccSections.bestMonthsToTravel.avoid.join(", ")}</p>
              )}
              {ccSections.bestMonthsToTravel.notes && (
                <p style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">{ccSections.bestMonthsToTravel.notes}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* FAQ */}
    <section style="padding: 64px 28px; border-top: 1px solid var(--color-border);">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
          <div>
            <div class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);">{tTcy("faqEyebrow")}</div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
              {tTcy("faqHeading")}
            </h2>
          </div>
          <div class="divide-y" style="border-color: var(--color-border-soft);">
            {faqList.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer items-start justify-between gap-6">
                  <span class="serif" style="font-size: 17px; font-weight: 500; line-height: 1.4;">{f.question}</span>
                  <span class="mt-1 shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;" aria-hidden="true">+</span>
                </summary>
                <p class="serif mt-3" style="color: var(--color-ink-muted); font-size: 15.5px; line-height: 1.6;">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* EEAT block — methodology + reviewer attribution */}
    <MethodologyBlock locale={locale}
      lastReviewed={treatmentRow.updatedAt}
      curationNote={tTcy("curationNote").replace("{count}", String(hospitalPricing.length)).replace("{treatment}", treatment.name.toLowerCase()).replace("{country}", countryRow.name).replace("{specialty}", specialty?.name ?? tTcy("specialtyFallback"))}
      dataSources={[
        "Hospital itemised quote sheets",
        "JCI accreditation registry",
        ...(countryRow.slug === "india" ? ["NABH licence register"] : []),
        "National medical council registries",
        "Peer-reviewed surgeon publication record",
      ]}
    />

    {/* Patient case studies */}
    {testimonials.length > 0 && (
      <section style="padding: 64px 28px; border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1440px]">
          <div class="flex items-baseline justify-between flex-wrap gap-4 mb-8">
            <div>
              <p class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tTcy("caseStudiesEyebrow")}</p>
              <h2 class="display mt-1" style="font-size: 28px; letter-spacing: -0.02em;">
                {tTcy("caseStudiesHeading").replace("{treatment}", treatment.name).replace("{country}", countryRow.name)}
              </h2>
            </div>
          </div>
          <div class="grid gap-5 lg:grid-cols-3">
            {testimonials.map((t) => (
              <div class="paper" style="padding: 24px 26px;">
                <div class="flex items-center gap-1.5 mb-3">
                  {Array.from({ length: t.rating }, () => (
                    <span style="color: var(--color-saffron); font-size: 14px;">&#9733;</span>
                  ))}
                  {t.isVerified && (
                    <span class="mono ml-auto" style="font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle);">{tTcy("verifiedBadge")}</span>
                  )}
                </div>
                {t.title && (
                  <p class="serif font-medium mb-2" style="font-size: 15px; line-height: 1.4; letter-spacing: -0.01em;">
                    {t.title}
                  </p>
                )}
                <p class="serif" style="font-size: 13.5px; line-height: 1.65; color: var(--color-ink-muted);">
                  {t.story.length > 220 ? t.story.slice(0, 220) + "..." : t.story}
                </p>
                <div class="flex items-center gap-2 mt-4" style="font-size: 12px; color: var(--color-ink-subtle);">
                  <span class="font-medium" style="color: var(--color-ink);">{t.patientName}</span>
                  {t.patientCountry && <span>· {t.patientCountry}</span>}
                  {t.patientAge && <span>· {t.patientAge}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* CTA */}
    <section style="padding: 72px 28px; border-top: 1px solid var(--color-border); background: var(--color-ink); color: var(--color-bg);">
      <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">{tTcy("ctaEyebrow")}</div>
          <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
            {tTcy("ctaHeading").replace("{country}", countryRow.name).replace("{treatment}", treatment.name)}
            <span style="font-style: italic;"> {tTcy("ctaHeadingItalic")}</span>
          </h2>
          <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
            {tTcy("ctaBody")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={localizedPath(locale, `/contact?treatment=${slug}&country=${countrySlug}`)}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {tTcy("ctaButtonPrimary")}
            <ChevronRight className="h-4 w-4 mirror-x" />
          </a>
          <a
            href={localizedPath(locale, "/second-opinion")}
            class="inline-flex items-center gap-2 font-semibold"
            style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
          >
            {tTcy("ctaButtonSecondary")}
          </a>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={`${treatment.name} · ${countryRow.name}`}
      heading={tTcy("exploreHeading").replace("{treatment}", treatment.name.toLowerCase())}
      lede={tTcy("exploreLede")}
      items={[
        { eyebrow: tTcy("exploreEyebrowProcedure"), label: `${tTcy("exploreLabelFullPage").replace("{treatment}", treatment.name)}`, href: `/treatment/${slug}`, hint: tTcy("exploreHintProcedure") },
        ...(specialty ? [{ eyebrow: tTcy("exploreEyebrowSpecialty"), label: `${specialty.name} ${tTcy("exploreHubSuffix")}`, href: `/specialty/${specialty.slug}`, hint: tTcy("exploreHintSpecialty").replace("{specialty}", specialty.name.toLowerCase()) }] : []),
        { eyebrow: tTcy("exploreEyebrowCost"), label: tTcy("exploreLabelCostAcross").replace("{treatment}", treatment.name), href: `/cost/${slug}`, hint: tTcy("exploreHintCost").replace("{treatment}", treatment.name.toLowerCase()) },
        { eyebrow: tTcy("exploreEyebrowDestination"), label: tTcy("exploreLabelCountryHub").replace("{country}", countryRow.name), href: `/country/${countryRow.slug}`, hint: tTcy("exploreHintCountryHub") },
        { eyebrow: tTcy("exploreEyebrowHospitals"), label: tTcy("exploreLabelHospitalsIn").replace("{country}", countryRow.name), href: `/hospitals/country/${countryRow.slug}`, hint: tTcy("exploreHintHospitals") },
        ...(specialty ? [{ eyebrow: tTcy("exploreEyebrowSurgeons"), label: tTcy("exploreLabelSurgeons").replace("{specialty}", specialty.name).replace("{country}", countryRow.name), href: `/surgeons/${specialty.slug}/${countryRow.slug}`, hint: tTcy("exploreHintSurgeons").replace("{country}", countryRow.name) }] : []),
        ...(specialty ? [{ eyebrow: tTcy("exploreEyebrowBestOf"), label: tTcy("exploreLabelBestOf").replace("{specialty}", specialty.name).replace("{country}", countryRow.name), href: `/best/${specialty.slug}-in-${countryRow.slug}`, hint: tTcy("exploreHintBestOf") }] : []),
        { eyebrow: tTcy("exploreEyebrowVisa"), label: tTcy("exploreLabelVisa").replace("{country}", countryRow.name), href: `/visa/${countryRow.slug}`, hint: tTcy("exploreHintVisa") },
        { eyebrow: tTcy("exploreEyebrowCompare"), label: tTcy("exploreLabelTreatmentsSideBySide"), href: "/compare/treatments", hint: tTcy("exploreHintTreatmentsSideBySide") },
        { eyebrow: tTcy("exploreEyebrowCompare"), label: tTcy("exploreLabelDestinationShootout"), href: "/compare/countries", hint: tTcy("exploreHintDestinationShootout") },
        { eyebrow: tTcy("exploreEyebrowTool"), label: tTcy("exploreLabelCalculator"), href: "/calculator", hint: tTcy("exploreHintCalculator") },
        { eyebrow: tTcy("exploreEyebrowOpenData"), label: tTcy("exploreLabelPricingIndex"), href: "/pricing-index", hint: tTcy("exploreHintPricingIndex") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
