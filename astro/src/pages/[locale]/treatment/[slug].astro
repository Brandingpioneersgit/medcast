---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import Price from "@/components/Price.astro";
import PriceRange from "@/components/PriceRange.astro";
import WhatsIncludedSection from "@/components/content/WhatsIncludedSection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import BeforeAfterStrip from "@/components/BeforeAfterStrip.astro";
import { sql as rawSql } from "@/lib/db";
import { getTreatmentBySlug, listFaqsFor, getReviewerFor, listConditionsForTreatment, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { getTreatmentSections } from "@/lib/content-sections";
import ReviewedBy from "@/components/ReviewedBy.astro";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
  localizedTitle,
  localizedDescription,
} from "@/lib/translate";
import { relatedToTreatment } from "@/lib/related";
import { COMPARISONS, comparisonSlug } from "@/lib/comparisons";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { treatmentJsonLd, breadcrumbJsonLd, localeUrl, faqJsonLd, withProvenance, reviewerFromDbRow } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import { heroImage, journeyScene, patientHero } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/treatment/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const [data, linkables] = await Promise.all([
  getTreatmentBySlug(slug),
  listLinkableEntities().catch(() => [] as Awaited<ReturnType<typeof listLinkableEntities>>),
]);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const tTd = getTranslator(locale, "treatmentDetailPage");

const hospitalIds = data.hospitalPricing.map((hp) => hp.hospitalId);
const specialtyIdRaw = data.treatment.specialty?.id ?? null;

// Patient-outcome before/after photos — only visible specialties (cosmetic /
// hair / dental / bariatric / orthopedic) typically populate these. Component
// renders nothing when the array is empty.
type OutcomeRow = {
  id: number;
  before_url: string;
  after_url: string;
  caption: string | null;
  weeks_post: number | null;
  patient_age_band: string | null;
  patient_country: string | null;
};

const [
  treatmentMap,
  faqRows,
  reviewer,
  specialtyMap,
  hospitalMap,
  related,
  contentRow,
  conditionsTreated,
  outcomeRows,
] = await Promise.all([
  getContent("treatment", data.treatment.id, locale),
  listFaqsFor("treatment", data.treatment.id),
  getReviewerFor("treatment", data.treatment.id),
  specialtyIdRaw ? getContent("specialty", specialtyIdRaw, locale) : Promise.resolve({} as Record<string, string>),
  getContentBatch("hospital", hospitalIds, locale),
  relatedToTreatment(data.treatment.id, 6, locale).catch(() => []),
  getTreatmentSections(data.treatment.id),
  listConditionsForTreatment(data.treatment.id, 8),
  rawSql<OutcomeRow[]>`
    SELECT id, before_url, after_url, caption, weeks_post, patient_age_band, patient_country
    FROM treatment_outcomes
    WHERE treatment_id = ${data.treatment.id} AND is_active = TRUE
    ORDER BY sort_order ASC, id ASC
    LIMIT 6
  `.catch(() => [] as OutcomeRow[]),
]);
const outcomes = outcomeRows.map((r) => ({
  id: r.id,
  beforeUrl: r.before_url,
  afterUrl: r.after_url,
  caption: r.caption,
  weeksPost: r.weeks_post,
  patientAgeBand: r.patient_age_band,
  patientCountry: r.patient_country,
}));

const sections = contentRow?.content_sections ?? null;
const dbReviewer = contentRow?.reviewer_name
  ? {
      name: contentRow.reviewer_name,
      role: contentRow.reviewer_role,
      reviewedAt: contentRow.last_reviewed_at,
    }
  : null;

const treatment = applyTranslated(data.treatment, treatmentMap, ["name", "description"]);

// Procedure comparisons that involve this treatment — links to /compare/[a]-vs-[b].
const comparisonsForThis = COMPARISONS.filter((c) => c.a === slug || c.b === slug);
const comparisonPartnerSlugs = comparisonsForThis.map((c) => (c.a === slug ? c.b : c.a));
const partnerNameRows = comparisonPartnerSlugs.length > 0
  ? await rawSql<{ slug: string; name: string }[]>`
      SELECT slug, name FROM treatments WHERE slug = ANY(${comparisonPartnerSlugs})
    `.catch(() => [] as { slug: string; name: string }[])
  : [];
const partnerNames = new Map(partnerNameRows.map((r) => [r.slug, r.name]));
const treatmentComparisons = comparisonsForThis
  .map((c) => {
    const partnerSlug = c.a === slug ? c.b : c.a;
    return { slug: comparisonSlug(c), partnerName: partnerNames.get(partnerSlug) ?? null };
  })
  .filter((x): x is { slug: string; partnerName: string } => x.partnerName != null);

// Multi-paragraph descriptions (separated by blank lines) render first
// paragraph as the hero lede and remaining paragraphs as an "About" section.
const descriptionParas = (treatment.description ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const descriptionLede = descriptionParas[0] ?? null;
const descriptionRest = descriptionParas.slice(1);

const filteredLinkables = linkables.filter(
  (e) => !(e.kind === "treatment" && e.slug === slug),
);
const descriptionLedeHtml = descriptionLede
  ? linkifyBlogHtml(
      `<p>${descriptionLede.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`,
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";
const descriptionRestHtml = descriptionRest.length > 0
  ? linkifyBlogHtml(
      descriptionRest.map((p) => `<p>${p.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`).join("\n"),
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";

const specialty = data.treatment.specialty
  ? applyTranslated(data.treatment.specialty, specialtyMap, ["name"])
  : null;

const hospitalPricing = data.hospitalPricing.map((hp) => ({
  ...hp,
  hospitalName: hospitalMap[hp.hospitalId]?.name ?? hp.hospitalName,
}));

const lowestPrice = hospitalPricing[0]?.costMinUsd
  ? Number(hospitalPricing[0].costMinUsd)
  : null;
const highestPrice = hospitalPricing.reduce((acc, hp) => {
  const v = hp.costMaxUsd ? Number(hp.costMaxUsd) : 0;
  return v > acc ? v : acc;
}, 0);

// Aggregate by country for price sidebar
type CountryRow = { slug: string; name: string; min: number; count: number };
const byCountry = new Map<string, CountryRow>();
for (const hp of hospitalPricing) {
  const k = hp.countrySlug;
  const min = Number(hp.costMinUsd ?? 0);
  if (!byCountry.has(k)) {
    byCountry.set(k, { slug: k, name: hp.countryName, min, count: 1 });
  } else {
    const cur = byCountry.get(k)!;
    cur.min = cur.min === 0 ? min : Math.min(cur.min, min || cur.min);
    cur.count += 1;
  }
}
const countryRows = Array.from(byCountry.values()).sort((a, b) => a.min - b.min);
const maxCountryMin = countryRows.reduce((m, c) => Math.max(m, c.min), 0);

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
function countryFlag(slug: string): string { return FLAG_MAP[slug] ?? "🌐"; }

// Procedure-wide success rate is the only hospital-specific-ish number we
// currently have. Volume and hospital-specific success need separate data.
const procedureSuccess = data.treatment.successRatePercent ? Number(data.treatment.successRatePercent) : null;

const stats = [
  treatment.averageDurationHours
    ? { l: tTd("statProcedureTime"), v: `${treatment.averageDurationHours} hr` }
    : null,
  treatment.hospitalStayDays
    ? { l: tTd("statHospitalStay"), v: `${treatment.hospitalStayDays} days` }
    : null,
  treatment.recoveryDays
    ? { l: tTd("statRecovery"), v: `${treatment.recoveryDays} wk` }
    : null,
  treatment.successRatePercent
    ? { l: tTd("statSuccessRate"), v: `${treatment.successRatePercent}%` }
    : null,
].filter(Boolean) as Array<{ l: string; v: string }>;

function firstWord(s: string) {
  const idx = s.indexOf(" ");
  return idx === -1 ? s : s.slice(0, idx);
}
function restOfName(s: string) {
  const idx = s.indexOf(" ");
  return idx === -1 ? "" : s.slice(idx + 1);
}

const seoFallbackDesc = `${treatment.name}${specialty ? ` — ${specialty.name}` : ""}${lowestPrice ? `, from $${Math.round(lowestPrice).toLocaleString()}` : ""}. Compare ${hospitalPricing.length} hospitals.`;
const seoTitle = localizedTitle(locale, treatment.name, treatment.metaTitle, treatmentMap);
const seoDescription = localizedDescription(
  locale,
  treatment.description,
  treatment.metaDescription,
  seoFallbackDesc,
  treatmentMap,
);

const path = `/treatment/${slug}`;
const url = localeUrl(locale, path);

const jsonLd = withProvenance(
  treatmentJsonLd({
    name: treatment.name,
    description: treatment.description,
    costMinUsd: lowestPrice ? String(lowestPrice) : undefined,
    costMaxUsd: highestPrice > 0 ? String(highestPrice) : undefined,
    url,
    hospitalStayDays: treatment.hospitalStayDays,
    successRatePercent: treatment.successRatePercent ? Number(treatment.successRatePercent) : null,
  }),
  {
    dateModified: reviewer?.reviewedAt ?? data.treatment.updatedAt,
    dateCreated: data.treatment.createdAt,
    reviewer: reviewerFromDbRow(reviewer),
  },
);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("treatments"), url: localeUrl(locale, "/treatments") },
  { name: treatment.name, url },
]);

const faqSchema = faqRows.length > 0 ? faqJsonLd(faqRows) : null;

const untranslated = isUntranslated(locale, treatmentMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    {/* Breadcrumb */}
    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/treatments")} class="hover:text-ink">{tc("treatments")}</a>
          {specialty && (
            <>
              <span class="mx-1.5">/</span>
              <a href={localizedPath(locale, `/specialty/${specialty.slug}`)} class="hover:text-ink">{specialty.name}</a>
            </>
          )}
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{treatment.name}</span>
        </nav>
      </div>
    </div>

    {/* Hero — 2 columns: title + stats (left) / price-by-country bars (right) */}
    <section class="pt-12 md:pt-14">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        {specialty && (
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
            {specialty.name}
          </p>
        )}
        <div class="grid gap-12 lg:grid-cols-[2fr_1fr] lg:gap-16 mt-3">
          <div>
            <h1
              class="display display-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.25rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {firstWord(treatment.name)}{" "}
              <span class="italic-display">{restOfName(treatment.name)}</span>
            </h1>
            {descriptionLede && (
              <div class="serif mt-5 max-w-[44rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);" set:html={descriptionLedeHtml} />
            )}
            <LastUpdated updated={data.treatment.updatedAt} locale={locale} class="mt-5" />

            {stats.length > 0 && (
              <div
                class="mt-8 grid grid-cols-2 sm:grid-cols-4"
                style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
              >
                {stats.map((s, i) => (
                  <div
                    class="px-4 md:px-5 py-5"
                    style={i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}
                  >
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {s.l}
                    </div>
                    <div class="display tnum mt-1.5" style="font-size: 28px;">{s.v}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Right — price-by-country sidebar with bars */}
          {countryRows.length > 0 && (
            <aside class="lg:sticky lg:top-32 lg:self-start">
              <div class="paper" style="padding: 22px;">
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                  {tTd("priceRangeWorldwide")}
                </div>
                {lowestPrice && (
                  <div class="mt-2.5 flex items-baseline gap-2">
                    <span class="display tnum" style="font-size: 38px; line-height: 1;">
                      ${(lowestPrice / 1000).toFixed(1)}k
                    </span>
                    {highestPrice > 0 && (
                      <span class="tnum text-[14px]" style="color: var(--color-ink-subtle);">
                        — ${highestPrice.toLocaleString()}
                      </span>
                    )}
                  </div>
                )}
                <ul class="mt-5">
                  {countryRows.slice(0, 8).map((c) => {
                    const visualPct =
                      maxCountryMin > 0
                        ? Math.max(12, 100 - (c.min / maxCountryMin) * 100 + 12)
                        : 50;
                    const barStyle =
                      "background: var(--color-accent); opacity: 0.85; width: " + visualPct + "%;";
                    return (
                      <li
                        class="grid items-center py-2"
                        style="grid-template-columns: 20px 1fr 80px; gap: 10px;"
                      >
                        <span aria-hidden="true" style="font-size: 14px;">{countryFlag(c.slug)}</span>
                        <div>
                          <div class="text-[13px] capitalize" style="color: var(--color-ink);">{c.name}</div>
                          <div class="mt-1 h-1 rounded-full" style={barStyle} />
                        </div>
                        <div class="text-end text-[12px] tnum" style="color: var(--color-ink-muted);">
                          <Price usd={c.min} />
                        </div>
                      </li>
                    );
                  })}
                </ul>
                <a
                  href={localizedPath(locale, `/contact?treatment=${slug}`)}
                  class="mt-5 block w-full text-center rounded-lg bg-accent text-accent-contrast font-semibold py-3 hover:bg-accent-hover transition"
                >
                  {tTd("getAFreeQuote")}
                </a>
              </div>
            </aside>
          )}
        </div>
      </div>
    </section>

    {/* About this procedure — long-form editorial */}
    {descriptionRest.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTd("aboutProcedureEyebrow")}
              </div>
              <h2
                class="display mt-3"
                style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;"
              >
                {tTd("aboutProcedureHeading")}
              </h2>
            </div>
            <div class="prose-editorial">
              <ReviewedBy reviewer={reviewer} locale={locale} />
              <Fragment set:html={descriptionRestHtml} />
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Real moments — patient + care imagery for this treatment */}
    <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mono uppercase mb-6" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
          {tTd("careLooksLikeEyebrow")}
        </div>
        <ul class="grid gap-3" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
          {[
            { src: heroImage(`tx-${slug}-1`), title: tTd("careMoment1Title"), sub: tTd("careMoment1Sub") },
            { src: heroImage(`tx-${slug}-2`), title: tTd("careMoment2Title"), sub: tTd("careMoment2Sub") },
            { src: journeyScene(`tx-${slug}-3`), title: tTd("careMoment3Title"), sub: tTd("careMoment3Sub") },
          ].map((m) => (
            <li class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
              <img
                src={m.src}
                alt={m.title}
                width="500"
                height="625"
                loading="lazy"
                decoding="async"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
              <div class="image-veil-strong" />
              <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 14px; inset-inline-end: 14px;">
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">
                  {m.title}
                </div>
                <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">
                  {m.sub}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Deep content sections (candidacy, recovery, questions, red flags) */}
    {sections && (
      <>
        {sections.aboutThisProcedure && sections.aboutThisProcedure.length > 0 && (
          <section style="padding: 64px 0; background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    {tTd("procedureInDetailEyebrow")}
                  </div>
                  <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
                    {tTd("procedureInDetailHeading")} <span style="font-style: italic;">{tTd("procedureInDetailHeadingItalic")}</span>
                  </h2>
                </div>
                <div class="prose-editorial">
                  {sections.aboutThisProcedure.map((p) => <p>{p}</p>)}
                </div>
              </div>
            </div>
          </section>
        )}

        {sections.whoIsACandidate && (
          <section style="padding: 64px 0;">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-4" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTd("candidacyEyebrow")}
              </div>
              <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
                {tTd("candidacyHeading")} <span style="font-style: italic;">{tTd("candidacyHeadingItalic")}</span>
              </h2>
              <div class="grid gap-8 md:grid-cols-2">
                <div class="paper" style="padding: 24px;">
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 12px;">
                    {tTd("qualifiersLabel")}
                  </div>
                  <ul class="space-y-3">
                    {sections.whoIsACandidate.qualifiers?.map((q) => (
                      <li class="flex gap-3" style="font-size: 15px; line-height: 1.55;">
                        <span style="color: var(--color-accent);">→</span>
                        <span>{q}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="paper" style="padding: 24px;">
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-coral, var(--color-coral)); margin-bottom: 12px;">
                    {tTd("disqualifiersLabel")}
                  </div>
                  <ul class="space-y-3">
                    {sections.whoIsACandidate.disqualifiers?.map((d) => (
                      <li class="flex gap-3" style="font-size: 15px; line-height: 1.55;">
                        <span style="color: var(--color-coral, var(--color-coral));">×</span>
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </section>
        )}

        {sections.preparation && sections.preparation.length > 0 && (
          <section style="padding: 64px 0; background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    {tTd("preparationEyebrow")}
                  </div>
                  <h2 class="display mt-3" style="font-size: 28px; letter-spacing: -0.015em;">
                    {tTd("preparationHeading")} <span style="font-style: italic;">{tTd("preparationHeadingItalic")}</span>
                  </h2>
                </div>
                <ol class="space-y-3.5">
                  {sections.preparation.map((step, i) => (
                    <li class="flex gap-4" style="font-size: 16px; line-height: 1.55;">
                      <span class="display tnum" style="font-size: 28px; line-height: 1; opacity: 0.4; min-width: 36px;">{String(i + 1).padStart(2, "0")}</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </section>
        )}

        {sections.recoveryTimeline && sections.recoveryTimeline.length > 0 && (
          <section style="padding: 64px 0;">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-4" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tTd("recoveryEyebrow")}
              </div>
              <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
                {tTd("recoveryHeading")} <span style="font-style: italic;">{tTd("recoveryHeadingItalic")}</span>
