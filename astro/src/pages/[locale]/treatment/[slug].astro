    {/* Recovery timeline */}
    {(treatment.hospitalStayDays || treatment.recoveryDays) && (() => {
      const stay = treatment.hospitalStayDays ?? 0;
      const recoveryWeeks = treatment.recoveryDays ?? 0;
      // Build a 4-phase timeline: hospital · early home · resume light · full activity
      const phases = [
        {
          eyebrow: tTd("phase1Eyebrow"),
          title: stay ? tTd("phase1TitleDays").replace("{n}", String(stay)).replace("{s}", stay === 1 ? "" : "s") : tTd("phase1TitleFallback"),
          body: tTd("phase1Body"),
          tone: "var(--color-coral-soft)",
          accent: "var(--color-coral)",
        },
        {
          eyebrow: tTd("phase2Eyebrow"),
          title: tTd("phase2Title").replace("{start}", String(stay + 1)).replace("{end}", String(stay + 7)),
          body: tTd("phase2Body"),
          tone: "var(--color-saffron-soft)",
          accent: "var(--color-saffron)",
        },
        {
          eyebrow: tTd("phase3Eyebrow"),
          title: recoveryWeeks > 1
            ? tTd("phase3TitleRange").replace("{end}", String(Math.max(2, Math.ceil(recoveryWeeks / 2))))
            : tTd("phase3TitleFixed"),
          body: tTd("phase3Body"),
          tone: "var(--color-accent-soft)",
          accent: "var(--color-accent)",
        },
        {
          eyebrow: tTd("phase4Eyebrow"),
          title: recoveryWeeks > 0
            ? tTd("phase4TitleRange").replace("{start}", String(Math.max(2, Math.ceil(recoveryWeeks / 2)) + 1)).replace("{end}", String(recoveryWeeks))
            : tTd("phase4TitleFallback"),
          body: tTd("phase4Body"),
          tone: "var(--color-ocean-soft, var(--color-accent-soft))",
          accent: "var(--color-accent-strong)",
        },
      ];
      return (
        <section id="recovery" style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper); scroll-margin-top: 140px;">
          <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
            <div class="flex items-end justify-between flex-wrap gap-6 mb-8">
              <div>
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tTd("recoveryTimelineEyebrow")}</div>
                <h2 class="display mt-2" style="font-size: 32px; letter-spacing: -0.02em;">
                  {tTd("recoveryTimelineHeading").replace("{weeks}", recoveryWeeks ? `${recoveryWeeks}-week ` : "")}
                  <span style="font-style: italic;"> {tTd("recoveryTimelineHeadingItalic")}</span>
                </h2>
                <p class="serif mt-3" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted); max-width: 620px;">
                  {tTd("recoveryTimelineDesc")}
                </p>
              </div>
            </div>
            <ol class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
              {phases.map((p, i) => (
                <li class="paper" style={`padding: 20px 20px 22px; border-left: 3px solid ${p.accent};`}>
                  <div class="flex items-center gap-2 mb-2">
                    <span
                      class="mono uppercase tnum"
                      style={`font-size: 9.5px; letter-spacing: 0.12em; padding: 3px 8px; border-radius: 9999px; background: ${p.tone}; color: ${p.accent};`}
                    >{p.eyebrow}</span>
                    <span class="mono tnum" style="font-size: 10px; color: var(--color-ink-subtle);">
                      {String(i + 1).padStart(2, "0")} / {String(phases.length).padStart(2, "0")}
                    </span>
                  </div>
                  <div class="serif" style="font-size: 16.5px; line-height: 1.3; font-weight: 500;">{p.title}</div>
                  <p class="serif mt-2" style="font-size: 14px; line-height: 1.55; color: var(--color-ink-muted);">{p.body}</p>
                </li>
              ))}
            </ol>
            <p class="mono uppercase mt-6" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tTd("recoveryTimelineDisclaimer")}
            </p>
          </div>
        </section>
      );
    })()}

