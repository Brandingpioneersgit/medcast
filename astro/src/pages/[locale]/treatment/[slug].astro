            <p class="serif mt-3" style="font-size: 15px; line-height: 1.55; opacity: 0.78; max-width: 560px;">
              {tTd("ctaBody")}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 md:flex-col md:items-stretch">
            <a
