                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Explore next — cross-mesh links */}
    {specialty && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="display mb-6" style="font-size: 24px;">{tTd("exploreNextHeading")}</h2>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <li>
              <a
                href={localizedPath(locale, `/surgeons/${specialty.slug}`)}
                class="group flex h-full items-start justify-between gap-3 rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
              >
                <span class="min-w-0">
                  <span class="mono uppercase block" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tTd("exploreNextSurgeonsEyebrow")}</span>
                  <span class="mt-1 block font-medium text-ink group-hover:text-accent">{tTd("exploreNextSurgeonsLabel").replace("{specialty}", specialty.name)}</span>
                  <span class="mt-1 block text-[12.5px] text-ink-subtle">{tTd("exploreNextSurgeonsHint")}</span>
                </span>
                <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x shrink-0" />
              </a>
            </li>
            <li>
              <a
                href={localizedPath(locale, `/specialty/${specialty.slug}`)}
                class="group flex h-full items-start justify-between gap-3 rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
              >
                <span class="min-w-0">
                  <span class="mono uppercase block" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tTd("exploreNextSpecialtyEyebrow")}</span>
                  <span class="mt-1 block font-medium text-ink group-hover:text-accent">{specialty.name}</span>
                  <span class="mt-1 block text-[12.5px] text-ink-subtle">{tTd("exploreNextSpecialtyHint")}</span>
                </span>
                <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x shrink-0" />
              </a>
            </li>
            {countryRows.slice(0, 1).map((c) => (
              <li>
                <a
                  href={localizedPath(locale, `/treatment/${slug}/${c.slug}`)}
                  class="group flex h-full items-start justify-between gap-3 rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <span class="min-w-0">
                    <span class="mono uppercase block" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tTd("exploreNextCostEyebrow").replace("{country}", c.name)}</span>
                    <span class="mt-1 block font-medium text-ink group-hover:text-accent">{treatment.name} in {c.name}</span>
                    <span class="mt-1 block text-[12.5px] text-ink-subtle tnum">From <Price usd={c.min} /> · {c.count} hospitals</span>
                  </span>
                  <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Conditions this treatment is indicated for — bidirectional
        treatment ↔ condition links strengthen the entity graph (§3.5). */}
    {conditionsTreated.length > 0 && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="display mb-2" style="font-size: 24px;">{tTd("conditionsHeading").replace("{name}", treatment.name)}</h2>
          <p class="mb-6" style="font-size: 14.5px; color: var(--color-ink-muted); max-width: 60ch;">
            {tTd("conditionsDesc")}
          </p>
          <ul class="flex flex-wrap gap-2">
            {conditionsTreated.map((c) => (
              <li>
                <a
                  href={localizedPath(locale, `/condition/${c.slug}`)}
                  class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 transition-colors hover:text-accent"
                  style="font-size: 13.5px; border: 1px solid var(--color-border); background: var(--color-surface);"
                >
                  <span>{c.name}</span>
                  <ChevronRight className="h-3 w-3 mirror-x opacity-50" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Related treatments */}
    {related.length > 0 && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="display mb-6" style="font-size: 24px;">{tTd("relatedTreatmentsHeading")}</h2>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li>
                <a
                  href={localizedPath(locale, r.href)}
                  class="group flex items-center justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <span class="font-medium text-ink group-hover:text-accent transition-colors">{r.name}</span>
                  <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Procedure comparisons */}
    {treatmentComparisons.length > 0 && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
          <h2 class="display mb-2" style="font-size: 24px;">{tTd("comparedHeading").replace("{name}", treatment.name)}</h2>
          <p class="mb-6 text-sm text-ink-muted max-w-[42rem]">
            {tTd("comparedDesc").replace("{name}", treatment.name.toLowerCase())}
          </p>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {treatmentComparisons.map((c) => (
              <li>
                <a
                  href={localizedPath(locale, `/compare/${c.slug}`)}
                  class="group flex items-center justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <span class="font-medium text-ink group-hover:text-accent transition-colors">
                    {tTd("comparedVsChip").replace("{a}", treatment.name).replace("{b}", c.partnerName)}
                  </span>
                  <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* What's typically included in your quote — trust + expertise content */}
    <WhatsIncludedSection
      treatmentName={treatment.name}
      hospitalStayDays={treatment.hospitalStayDays}
      recoveryDays={treatment.recoveryDays}
    />

    {/* EEAT signals — methodology + reviewer attribution */}
    <MethodologyBlock locale={locale}
      reviewerName={reviewer?.fullName ?? null}
      reviewerCredentials={reviewer?.credentials ?? null}
      reviewerSlug={reviewer?.slug ?? null}
      lastReviewed={reviewer?.reviewedAt ?? treatment.updatedAt}
      curationNote={tTd("curationNote").replace("{name}", treatment.name.toLowerCase()).replace("{count}", String(hospitalPricing.length)).replace("{specialty}", specialty?.name ?? tTd("specialtyFallback"))}
      dataSources={[
        tTd("dataSource1"),
        tTd("dataSource2"),
        tTd("dataSource3"),
        tTd("dataSource4"),
      ]}
    />

    <div class="mx-auto max-w-7xl px-6 pb-10">
      <LastUpdated
        updated={treatment.updatedAt}
        note={tTd("lastUpdatedNote")}
      />
    </div>

    <ExploreGrid
      locale={locale}
      eyebrow={tTd("exploreGridEyebrow").replace("{name}", treatment.name)}
      heading={tTd("exploreGridHeading").replace("{name}", treatment.name.toLowerCase())}
      lede={tTd("exploreGridLede")}
      items={[
        ...(specialty?.slug && specialty?.name
          ? [{ eyebrow: tTd("egSpecialtyEyebrow"), label: tTd("egSpecialtyLabel").replace("{specialty}", specialty.name), href: `/specialty/${specialty.slug}`, hint: tTd("egSpecialtyHint").replace("{specialty}", specialty.name.toLowerCase()) }] : []),
        ...(specialty?.slug && specialty?.name
          ? [{ eyebrow: tTd("egSurgeonsEyebrow"), label: tTd("egSurgeonsLabel").replace("{specialty}", specialty.name), href: `/surgeons/${specialty.slug}`, hint: tTd("egSurgeonsHint") }] : []),
        { eyebrow: tTd("egCostEyebrow"), label: tTd("egCostLabel").replace("{name}", treatment.name), href: `/cost/${slug}`, hint: tTd("egCostHint") },
        ...(treatment.recoveryDays != null
          ? [{ eyebrow: tTd("egRecoveryEyebrow"), label: tTd("egRecoveryLabel").replace("{name}", treatment.name), href: `/treatment/${slug}/recovery`, hint: tTd("egRecoveryHint") }]
          : []),
        { eyebrow: tTd("egBrowseEyebrow"), label: tTd("egAllProceduresLabel"), href: "/treatments", hint: tTd("egAllProceduresHint") },
        { eyebrow: tTd("egBrowseEyebrow"), label: tTd("egAllDestinationsLabel"), href: "/countries", hint: tTd("egAllDestinationsHint") },
        { eyebrow: tTd("egCompareEyebrow"), label: tTd("egCompareTreatmentsLabel"), href: "/compare/treatments", hint: tTd("egCompareTreatmentsHint") },
        { eyebrow: tTd("egCompareEyebrow"), label: tTd("egCompareHospitalsLabel"), href: "/compare/hospitals", hint: tTd("egCompareHospitalsHint") },
        { eyebrow: tTd("egCompareEyebrow"), label: tTd("egCompareDoctorsLabel"), href: "/compare/doctors", hint: tTd("egCompareDoctorsHint") },
        { eyebrow: tTd("egToolEyebrow"), label: tTd("egCostCalcLabel"), href: "/calculator", hint: tTd("egCostCalcHint") },
        { eyebrow: tTd("egToolEyebrow"), label: tTd("egMatchMeLabel"), href: "/match-me", hint: tTd("egMatchMeHint") },
        { eyebrow: tTd("egOpenDataEyebrow"), label: tTd("egPricingIndexLabel"), href: "/pricing-index", hint: tTd("egPricingIndexHint") },
        { eyebrow: tTd("egActionEyebrow"), label: tTd("egSecondOpinionLabel"), href: "/second-opinion", hint: tTd("egSecondOpinionHint") },
      ]}
    />

    <SiteFooter locale={locale} />
    <EngagementFab locale={locale} />
    <MobileQuoteBar
      locale={locale}
      label={treatment.name}
      sublabel={lowestPrice ? `From $${Math.round(lowestPrice).toLocaleString()} · ${hospitalPricing.length} hospitals` : `${hospitalPricing.length} hospitals`}
      whatsapp={{
        page: "treatment",
        slug,
        treatmentName: treatment.name,
        specialtyName: specialty?.name,
      }}
    />
  </main>
</BaseLayout>
