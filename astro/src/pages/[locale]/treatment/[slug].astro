          </div>
        </div>
      </div>
    </section>

    {/* Before/after outcomes — visible specialties only */}
    {outcomes.length > 0 && (
      <section style="padding: 32px 0;">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <BeforeAfterStrip
            outcomes={outcomes}
            treatmentName={treatment.name}
            specialtySlug={specialty?.slug ?? null}
            locale={locale}
          />
