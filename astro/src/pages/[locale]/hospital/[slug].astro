---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import HospitalGallery from "@/components/HospitalGallery.astro";
import LocationMap from "@/components/Map.astro";
import HospitalMap from "@/components/HospitalMap.astro";
import HospitalTour from "@/components/HospitalTour.astro";
import { getHospitalBySlug, listHospitalOffers, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import { db, sql as rawSql } from "@/lib/db";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { relatedToHospital } from "@/lib/related";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { hospitalJsonLd, breadcrumbJsonLd, localeUrl, withProvenance, faqJsonLd } from "@/lib/seo";
import LastUpdated from "@/components/LastUpdated.astro";
import AccreditationLogo from "@/components/AccreditationLogo.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import { whatsappFor } from "@/lib/whatsapp";
import { hospitalCover, hospitalLogo, hospitalInitials, doctorPortrait } from "@/lib/images";
import { pageImageFor } from "@/lib/page-images";
import { sql } from "drizzle-orm";
import {
  ChevronRight,
  MessageCircle,
  Phone,
  Mail,
  Globe,
  MapPin,
} from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospital/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;

const hospitalRaw = await getHospitalBySlug(slug);
if (!hospitalRaw) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const tHd = getTranslator(locale, "hospitalDetailPage");

const specialtyIds = (hospitalRaw.specialties ?? []).map((hs) => hs.specialty.id);
const doctorIds = (hospitalRaw.doctors ?? []).map((d) => d.id);

type PriceRow = { min: number | null; max: number | null; procedures: number };
type SpecPrice = { specialty_id: number; min_usd: number; cases: number };
type Faq = { id: number; question: string; answer: string };
type Testimonial = {
  id: number;
  patient_name: string;
  patient_country: string | null;
  patient_age: number | null;
  rating: number;
  title: string | null;
  story: string;
  treatment_date: string | Date | null;
  image_url: string | null;
  treatment_name: string | null;
};

// Everything below depends only on `hospitalRaw.id` — fan out in parallel.
const [
  hospitalMap,
  specialtyMap,
  doctorMap,
  relatedHospitals,
  priceRes,
  specialtyPricing,
  faqRes,
  offerRows,
  testimonialRes,
  newsRes,
] = await Promise.all([
  getContent("hospital", hospitalRaw.id, locale),
  getContentBatch("specialty", specialtyIds, locale),
  getContentBatch("doctor", doctorIds, locale),
  relatedToHospital(hospitalRaw.id, 6, locale).catch(() => []),
  db.execute(sql`
    SELECT MIN(cost_min_usd)::int AS min, MAX(cost_max_usd)::int AS max, COUNT(*)::int AS procedures
    FROM hospital_treatments WHERE hospital_id = ${hospitalRaw.id} AND is_active = true
  `).catch(() => [] as unknown[]),
  db.execute(sql`
    SELECT t.specialty_id, MIN(ht.cost_min_usd)::int AS min_usd, COUNT(*)::int AS cases
    FROM hospital_treatments ht
    JOIN treatments t ON t.id = ht.treatment_id
    WHERE ht.hospital_id = ${hospitalRaw.id} AND ht.is_active = true
    GROUP BY t.specialty_id
  `).catch(() => [] as unknown[]),
  db.execute(sql`
    SELECT id, question, answer FROM faqs
    WHERE entity_type = 'hospital' AND entity_id = ${hospitalRaw.id} AND is_active = true
    ORDER BY sort_order ASC
  `).catch(() => [] as unknown[]),
  listHospitalOffers(hospitalRaw.id, 20),
  db.execute(sql`
    SELECT t.id, t.patient_name, t.patient_country, t.patient_age, t.rating,
           t.title, t.story, t.treatment_date, t.image_url,
           tr.name AS treatment_name
    FROM testimonials t
    LEFT JOIN treatments tr ON tr.id = t.treatment_id
    WHERE t.hospital_id = ${hospitalRaw.id} AND t.is_active = true
    ORDER BY t.is_featured DESC NULLS LAST, t.treatment_date DESC NULLS LAST
    LIMIT 4
  `).catch(() => [] as unknown[]),
  db.execute(sql`
    SELECT id, source, headline, url, published_at
    FROM hospital_news
    WHERE hospital_id = ${hospitalRaw.id}
    ORDER BY published_at DESC NULLS LAST
    LIMIT 3
  `).catch(() => [] as unknown[]),
]);

const hospital = applyTranslated(hospitalRaw, hospitalMap, ["name", "description"]);

// Admin-set image override wins over the DB cover_image_url + fallback pools.
const coverOverride = await pageImageFor("hospital", hospitalRaw.slug, "cover");
if (coverOverride) {
  hospital.coverImageUrl = coverOverride.url;
}

// Pull deep hospital sections (top-tier hospitals only)
const hSectionRow = await rawSql`
  SELECT content_sections FROM hospitals WHERE id = ${hospitalRaw.id} LIMIT 1
`;
const hSections: any = hSectionRow[0]?.content_sections ?? null;
const hospitalSpecialties = (hospitalRaw.specialties ?? []).map((hs) => ({
  ...hs,
  specialty: applyTranslated(hs.specialty, specialtyMap[hs.specialty.id] ?? {}, ["name"]),
}));
const hospitalDoctors = (hospitalRaw.doctors ?? []).map((d) =>
  applyTranslated(d, doctorMap[d.id] ?? {}, ["name", "qualifications"]),
);
const accreditations = hospitalRaw.hospitalAccreditations ?? [];
const images = hospitalRaw.images ?? [];
const prices: PriceRow = (Array.from(priceRes as Iterable<PriceRow>)[0]) ?? { min: null, max: null, procedures: 0 };
const specialtyPriceMap = new Map<number, { min: number; cases: number }>(
  (Array.from(specialtyPricing as Iterable<SpecPrice>)).map((r) => [r.specialty_id, { min: r.min_usd, cases: r.cases }]),
);
const faqs = Array.from(faqRes as Iterable<Faq>);
const rawTestimonials = Array.from(testimonialRes as Iterable<Testimonial>);
const testimonialMap: Record<number, Record<string, string>> = await getContentBatch("testimonial", rawTestimonials.map((t) => t.id), locale).catch(() => ({}));
const testimonials = rawTestimonials.map((t) => applyTranslated(t, testimonialMap[t.id] ?? {}, ["patient_name", "title", "story"]));

// Recent news mentions — surfaced beside accreditations as a freshness signal.
type NewsRow = { id: number; source: string; headline: string; url: string; published_at: Date | null };
const newsItems = Array.from(newsRes as Iterable<NewsRow>);

// Accreditation registry deep-links (verifiable in public registries)
const ACCRED_REGISTRY: Record<string, { label: string; url: string }> = {
  jci: { label: "Search the JCI registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  nabh: { label: "NABH accredited hospital list", url: "https://nabh.co/AccreditedHospital.aspx" },
  iso: { label: "ISO certificate verification", url: "https://www.iso.org/certification.html" },
  ktq: { label: "KTQ certified facility list", url: "https://www.ktq.de/en/ktq-certificate/zertifizierte-einrichtungen.html" },
  dha: { label: "DHA Sheryan licensed-facility lookup", url: "https://services.dha.gov.ae/sheryan/wps/portal/home/individual-search" },
  doh: { label: "DOH Abu Dhabi facility register", url: "https://services.doh.gov.ae/" },
  mohap: { label: "MOHAP facility register", url: "https://mohap.gov.ae/en/services" },
  koiha: { label: "KOIHA accredited list (Korea)", url: "https://www.koiha.or.kr/" },
  msqh: { label: "MSQH accreditation list (Malaysia)", url: "https://www.msqh.com.my/" },
  cbahi: { label: "CBAHI register (Saudi Arabia)", url: "https://portal.cbahi.gov.sa/" },
  ushas: { label: "USHAŞ-licensed Turkish facilities", url: "https://www.ushas.com.tr/en/" },
  ha: { label: "HA Thailand register", url: "https://www.ha.or.th/EN" },
};
function registryFor(acronym: string | null | undefined, name: string): { label: string; url: string } | null {
  const key = (acronym ?? "").toLowerCase();
  if (ACCRED_REGISTRY[key]) return ACCRED_REGISTRY[key];
  if (/iso/i.test(name)) return ACCRED_REGISTRY.iso;
  return null;
}
function fmtMonthYear(d: Date | string | null | undefined): string | null {
  if (!d) return null;
  const dt = typeof d === "string" ? new Date(d) : d;
  if (isNaN(dt.getTime())) return null;
  return dt.toLocaleDateString(locale === "ar" ? "ar-SA" : locale, { month: "short", year: "numeric" });
}

const cityName = hospital.city?.name ?? null;
const countryName = hospital.city?.country?.name ?? null;
const countrySlug = hospital.city?.country?.slug ?? null;

const FLAG: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
const countryFlag = FLAG[countrySlug ?? ""] ?? "🌐";

// Country-capital coords — last-resort map fallback when a hospital and its city
// both lack coords (e.g. the 1.2k Thailand hospitals that landed in city "Unknown").
const COUNTRY_CAPITAL: Record<string, [number, number]> = {
  india: [28.6139, 77.2090],          // New Delhi
  turkey: [41.0082, 28.9784],         // Istanbul (largest medical-tourism hub, not Ankara)
  thailand: [13.7563, 100.5018],      // Bangkok
  uae: [25.2048, 55.2708],            // Dubai
  germany: [52.5200, 13.4050],        // Berlin
  singapore: [1.3521, 103.8198],      // Singapore
  "south-korea": [37.5665, 126.9780], // Seoul
  malaysia: [3.1390, 101.6869],       // Kuala Lumpur
  "saudi-arabia": [24.7136, 46.6753], // Riyadh
};

function n(v: unknown): number | null {
  if (v == null) return null;
  const x = typeof v === "string" ? parseFloat(v) : Number(v);
  return Number.isFinite(x) ? x : null;
}
const hLat = n(hospital.latitude);
const hLng = n(hospital.longitude);
const cLat = n(hospital.city?.latitude);
const cLng = n(hospital.city?.longitude);
const fallback = countrySlug ? COUNTRY_CAPITAL[countrySlug] ?? null : null;

const mapLat = hLat ?? cLat ?? fallback?.[0] ?? null;
const mapLng = hLng ?? cLng ?? fallback?.[1] ?? null;
type MapPrecision = "exact" | "city" | "country";
const mapPrecision: MapPrecision =
  hLat != null && hLng != null ? "exact"
  : cLat != null && cLng != null ? "city"
  : "country";

// Local-SEO title: "{Hospital}, {City}, {Country}" — geo trio anchors local
// queries ("apollo hospital delhi india") and disambiguates branches.
const localGeoSuffix = [cityName, countryName].filter(Boolean).join(", ");
const title = localGeoSuffix
  ? `${hospital.name}, ${localGeoSuffix}`
  : hospital.name;

// Description hierarchy: real DB description > local-intent specialty + city
// fallback (rather than the old "N beds, M accreditations" which buries the
// keyword). Caps at 160 chars including the trailing CTA.
const topSpecialtyName = hospitalSpecialties[0]?.specialty?.name ?? null;
const descText = (() => {
  const real = hospital.description?.trim();
  if (real && real.length >= 80) return real.slice(0, 160);
  const lead = topSpecialtyName
    ? `${topSpecialtyName} hospital in ${cityName ?? countryName ?? "your destination"}`
    : `Hospital in ${cityName ?? countryName ?? "your destination"}`;
  const trust = accreditations.length > 0
    ? ` ${accreditations.map((a) => a.accreditation.acronym ?? a.accreditation.name).slice(0, 2).join(" + ")}-accredited.`
    : "";
  const beds = hospital.bedCapacity ? ` ${hospital.bedCapacity}-bed.` : "";
  return `${hospital.name} — ${lead}.${trust}${beds} Transparent pricing, free quote.`.slice(0, 160);
})();
const path = `/hospital/${slug}`;
const url = localeUrl(locale, path);

const jsonLd = withProvenance(hospitalJsonLd({
  name: hospital.name,
  description: hospital.description,
  address: hospital.address,
  city: cityName,
  country: countryName,
  lat: hospital.latitude,
  lng: hospital.longitude,
  phone: hospital.phone,
  email: hospital.email,
  website: hospital.website,
  rating: hospital.rating,
  reviewCount: hospital.reviewCount,
  imageUrl: hospital.coverImageUrl,
  url,
  bedCapacity: hospital.bedCapacity,
  areaServed: countryName,
  medicalSpecialties: hospitalSpecialties.map((hs) => hs.specialty.name),
  offers: offerRows.map((o) => ({
    treatmentName: o.name,
    treatmentUrl: localeUrl(locale, `/treatment/${o.slug}`),
    costMinUsd: o.lo,
    costMaxUsd: o.hi,
  })),
  credentials: accreditations.map((a) => ({
    name: a.accreditation.name,
    acronym: a.accreditation.acronym,
    url: a.accreditation.website ?? null,
    validFrom: a.validFrom ?? null,
    validUntil: a.validUntil ?? null,
  })),
  // Wikidata + Wikipedia entity-link signals (populated by
  // scripts/import/backfill-wikidata-sameas.mts). Skipped when columns
  // aren't on the row yet — `hospitalJsonLd` ignores undefined entries.
  sameAs: {
    website: hospital.website,
    wikipedia: (hospitalRaw as { wikipediaUrl?: string | null }).wikipediaUrl ?? null,
    other: (hospitalRaw as unknown as { wikidataId?: string | null }).wikidataId
      ? [`https://www.wikidata.org/entity/${(hospitalRaw as unknown as { wikidataId: string }).wikidataId}`]
      : [],
  },
}), {
  dateModified: hospitalRaw.updatedAt,
  dateCreated: hospitalRaw.createdAt,
  reviewer: null,
});

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  ...(countryName && countrySlug
    ? [{ name: countryName, url: localeUrl(locale, `/country/${countrySlug}`) }]
    : []),
  ...(cityName && hospital.city?.slug
    ? [{ name: cityName, url: localeUrl(locale, `/city/${hospital.city.slug}`) }]
    : []),
  { name: hospital.name, url },
]);
const faqLd = faqs.length > 0 ? faqJsonLd(faqs) : null;

const untranslated = isUntranslated(locale, hospitalMap);
const isThin = !hospital.description || hospital.description.trim().length < 120;

const descParas = (hospital.description ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const descLede = descParas[0] ?? null;
const descRest = descParas.slice(1);

// In-prose contextual auto-linking — turn first mention of each linkable entity
// (top hospitals, treatments, specialties, conditions, glossary terms) into an
// internal anchor inside the description body. Skips current hospital + heading tags.
const linkables = await listLinkableEntities().catch(() => []);
const filteredLinkables = linkables.filter(
  (e) => !(e.kind === "hospital" && e.slug === slug),
);
const ledeHtml = descLede
  ? linkifyBlogHtml(
      `<p>${descLede.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`,
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";
const restHtml = descRest.length > 0
  ? linkifyBlogHtml(
      descRest.map((p) => `<p>${p.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`).join("\n"),
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";

// Loose proxy for "international patients/yr" when no real stat exists
const intlYear = hospital.bedCapacity ? Math.round(hospital.bedCapacity * 11.4).toLocaleString() : null;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={title}
      description={descText}
      path={path}
      locale={locale}
      image={hospital.coverImageUrl ?? undefined}
      noindex={untranslated || isThin}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} active="hospitals" />

    {/* Breadcrumb */}
    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav
        aria-label="Breadcrumb"
        class="mono mx-auto max-w-[1440px]"
        style="font-size: 12px; color: var(--color-ink-subtle);"
      >
        <a href={localizedPath(locale, "/hospitals")} class="hover:text-ink">{tc("hospitals")}</a>
        {countryName && countrySlug && (
          <>
            <span class="mx-1.5">/</span>
            <a href={localizedPath(locale, `/country/${countrySlug}`)} class="hover:text-ink">{countryName}</a>
          </>
        )}
        {cityName && hospital.city?.slug && (
          <>
            <span class="mx-1.5">/</span>
            <a href={localizedPath(locale, `/city/${hospital.city.slug}`)} class="hover:text-ink">{cityName}</a>
          </>
        )}
        <span class="mx-1.5">/</span>
        <span style="color: var(--color-ink);">{hospital.name}</span>
      </nav>
    </div>

    {/* HERO — 1.5fr / 1fr split */}
    <section style="padding: 40px 28px 0;">
      <div class="mx-auto max-w-[1440px]">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]">
          <div>
            {(() => {
              const logoSrc = hospitalLogo({
                logoUrl: hospital.logoUrl,
                website: hospital.website,
                name: hospital.name,
              });
              return (
                <div class="mb-5 flex items-center gap-3">
                  <div
                    class="inline-flex items-center justify-center shrink-0 overflow-hidden"
                    style="width: 56px; height: 56px; border-radius: 12px; background: var(--color-surface); border: 1px solid var(--color-border);"
                    aria-hidden={logoSrc ? "true" : undefined}
                  >
                    {logoSrc ? (
                      <img
                        src={logoSrc}
                        alt={`${hospital.name} logo`}
                        width="112"
                        height="112"
                        loading="eager"
                        decoding="async"
                        class="h-full w-full object-contain p-1.5"
                      />
                    ) : (
                      <span
                        class="display"
                        style="font-size: 18px; font-weight: 500; color: var(--color-ink);"
                      >
                        {hospitalInitials(hospital.name)}
                      </span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <p
                      class="mono uppercase"
                      style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);"
                    >
                      {tHd("verifiedPartner")}
                    </p>
                    {hospital.establishedYear && (
                      <p
                        class="mono tnum"
                        style="font-size: 11.5px; color: var(--color-ink-muted); margin-top: 2px;"
                      >
                        {tHd("estYear").replace("{year}", hospital.establishedYear.toString())}
                      </p>
                    )}
                  </div>
                </div>
              );
            })()}
            {accreditations.length > 0 ? (
              <div class="flex items-center gap-2 flex-wrap mb-4">
                {accreditations.slice(0, 5).map((a) => (
                  <AccreditationLogo
                    code={a.accreditation.acronym ?? a.accreditation.name}
                    title={a.accreditation.name}
                    size="md"
                  />
                ))}
              </div>
            ) : (
              <div class="mb-4 mono" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-ink-subtle); text-transform: uppercase;">
                {tHd("intlPatientsAccepted")}
              </div>
            )}

            <h1
              class="display display-tight"
              style="font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {hospital.name.split(" ").slice(0, -1).join(" ") || hospital.name}
              {hospital.name.includes(" ") && <> <span style="font-style: italic; font-weight: 300;">{hospital.name.split(" ").slice(-1).join(" ")}</span></>}
            </h1>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-4" style="color: var(--color-ink-muted);">
              <span class="flex items-center gap-1.5" style="font-size: 14px;">
                <span>{countryFlag}</span>
                {cityName}{countryName && `, ${countryName}`}
              </span>
              {hospital.rating && Number(hospital.rating) > 0 && (
                <>
                  <span style="width: 3px; height: 3px; border-radius: 50%; background: var(--color-border);" aria-hidden="true" />
                  <span class="inline-flex items-center gap-1.5">
                    <span class="inline-flex items-center gap-0.5" aria-label={`${hospital.rating} of 5`}>
                      {[0,1,2,3,4].map((i) => (
                        <svg width="13" height="13" viewBox="0 0 16 16" fill={i < Math.round(Number(hospital.rating)) ? "var(--color-saffron)" : "none"} stroke="var(--color-saffron)" stroke-width="1.6">
                          <path d="M8 1.5l2.12 4.3 4.74.69-3.43 3.35.81 4.72L8 12.31l-4.24 2.23.81-4.72L1.14 6.47l4.74-.69L8 1.5z" />
                        </svg>
                      ))}
                    </span>
                    <span class="tnum" style="font-size: 14px;">
                      {Number(hospital.rating).toFixed(1)}
                      {hospital.reviewCount && hospital.reviewCount > 0 && (
                        <span style="color: var(--color-ink-subtle);"> · {hospital.reviewCount.toLocaleString()} {tHd("reviewsLabel")}</span>
                      )}
                    </span>
                  </span>
                </>
              )}
            </div>

            <div class="mt-4"><LastUpdated updated={hospitalRaw.updatedAt} locale={locale} /></div>

            {/* Recent news mentions — auto-imported via Google News RSS.
                Adds a freshness signal alongside accreditations. */}
            {newsItems.length > 0 && (
              <aside
                class="mt-6"
                aria-label="Recent news mentions"
                style="border-inline-start: 2px solid var(--color-accent); padding-inline-start: 14px;"
              >
                <p class="mono uppercase" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tHd("inTheNews")}
                </p>
                <ul class="mt-2 space-y-2" style="font-size: 13.5px; line-height: 1.4;">
                  {newsItems.map((n) => (
                    <li>
                      <a
                        href={n.url}
                        target="_blank"
                        rel="noopener nofollow"
                        class="serif hover:underline"
                        style="color: var(--color-ink); text-underline-offset: 3px;"
                      >
                        {n.headline}
                      </a>
                      <span class="mono ms-2" style="font-size: 10.5px; color: var(--color-ink-subtle);">
                        {n.source}
                        {n.published_at && (
                          <> · {new Date(n.published_at).toLocaleDateString(locale, { month: "short", year: "numeric" })}</>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              </aside>
            )}

            {/* Hero gallery — 4-photo strip with lightbox. Cover + 3 thematic supports. */}
            <div class="mt-7">
              <HospitalGallery
                hospital={{ id: hospital.id, slug: hospital.slug, name: hospital.name, coverImageUrl: hospital.coverImageUrl }}
                countrySlug={countrySlug}
