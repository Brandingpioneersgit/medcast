                      {reg && (
                        <a
                          href={reg.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mono uppercase inline-flex items-center gap-1"
                          style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px;"
                        >{reg.label} ↗</a>
                      )}
                      {a.accreditation.website && !reg && (
                        <a
                          href={a.accreditation.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mono uppercase inline-flex items-center gap-1"
                          style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px;"
                        >{tHd("issuingBodyLink")}</a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </section>
    )}

    {testimonials.length > 0 && (
      <section
        id="outcomes"
        style="padding: 64px 28px; border-top: 1px solid var(--color-border); background: var(--color-paper); scroll-margin-top: 140px;"
      >
        <div class="mx-auto" style="max-width: 1120px;">
          <div class="flex items-end justify-between flex-wrap gap-6 mb-8">
            <div>
              <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tHd("patientStoriesEyebrow")}</div>
              <h2 class="display mt-2" style="font-size: 32px; letter-spacing: -0.02em;">
                {tHd("patientStoriesHeading")}
              </h2>
              <p class="serif mt-3" style="font-size: 16px; line-height: 1.55; color: var(--color-ink-muted); max-width: 620px;">
                {tHd("patientStoriesDesc").replace("{hospitalName}", hospital.name)}
              </p>
            </div>
          </div>
          <ul class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
            {testimonials.map((t) => {
              const when = fmtMonthYear(t.treatment_date);
              return (
                <li class="paper" style="padding: 22px; display: flex; flex-direction: column; gap: 12px;">
                  <div class="flex items-center gap-1" aria-label={`${t.rating} of 5`}>
                    {[0,1,2,3,4].map((i) => (
                      <svg width="13" height="13" viewBox="0 0 16 16" fill={i < t.rating ? "var(--color-saffron)" : "none"} stroke="var(--color-saffron)" stroke-width="1.6">
                        <path d="M8 1.5l2.12 4.3 4.74.69-3.43 3.35.81 4.72L8 12.31l-4.24 2.23.81-4.72L1.14 6.47l4.74-.69L8 1.5z" />
                      </svg>
                    ))}
                  </div>
                  {t.title && (
                    <div class="serif" style="font-size: 17px; line-height: 1.3; font-weight: 500;">
                      "{t.title}"
                    </div>
                  )}
                  <p class="serif" style="font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted); flex: 1;">
                    {t.story.length > 240 ? t.story.slice(0, 240).trimEnd() + "…" : t.story}
                  </p>
                  <div style="border-top: 1px dashed var(--color-border); padding-top: 10px;">
                    <div class="serif" style="font-size: 14px; font-weight: 500; color: var(--color-ink);">
                      {t.patient_name}{t.patient_age ? `, ${t.patient_age}` : ""}
                    </div>
                    <div class="mono uppercase mt-0.5" style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {[t.patient_country, t.treatment_name, when].filter(Boolean).join(" · ")}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    {faqs.length > 0 && (
      <section
        id="faq"
        style="padding: 56px 28px; border-top: 1px solid var(--color-border); scroll-margin-top: 140px;"
      >
        <div class="mx-auto" style="max-width: 1120px;">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);">{tHd("faqEyebrow")}</div>
              <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
                {tHd("faqHeading").replace("{hospitalName}", hospital.name)}
              </h2>
            </div>
            <div class="divide-y" style="border-color: var(--color-border-soft);">
              {faqs.map((f) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer items-start justify-between gap-6">
                    <span class="serif" style="font-size: 17px; font-weight: 500; line-height: 1.4;">{f.question}</span>
                    <span
                      class="mt-1 shrink-0 transition-transform group-open:rotate-45"
                      style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;"
                      aria-hidden="true"
                    >+</span>
                  </summary>
                  <p class="serif mt-3" style="color: var(--color-ink-muted); font-size: 15.5px; line-height: 1.6;">{f.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section id="contact" style="padding: 72px 28px; border-top: 1px solid var(--color-border); background: var(--color-ink); color: var(--color-bg); scroll-margin-top: 140px;">
      <div class="mx-auto max-w-[1120px]">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;">{tHd("readyToPlan")}</div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 400;">
              {tHd("getWrittenPlan").replace("{hospitalName}", hospital.name)}
            </h2>
            <p class="serif mt-4" style="font-size: 17px; line-height: 1.55; max-width: 560px; opacity: 0.85;">
              {tHd("contactDesc")}
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={localizedPath(locale, `/contact?hospital=${hospital.slug}`)}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-accent); color: #FFF; padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
            >
              {tHd("requestFreeQuote")}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, "/second-opinion")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: transparent; color: var(--color-bg); border: 1px solid rgba(246,241,230,0.3); padding: 13px 22px; font-size: 15px; border-radius: 9999px;"
            >
              {tHd("freeTwoOpinion")}
            </a>
          </div>
        </div>
      </div>
    </section>

    {relatedHospitals.length > 0 && (
      <section style="padding: 56px 28px; border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1120px]">
          <div class="mono mb-2" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tHd("nearbyEyebrow")}</div>
          <h2 class="display" style="font-size: 28px; letter-spacing: -0.02em;">
            {tHd("otherHospitalsIn").replace("{city}", cityName ?? "this city")}
          </h2>
          <ul class="grid mt-6 gap-3" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
            {relatedHospitals.map((r) => (
              <li>
                <a
                  href={localizedPath(locale, r.href)}
                  class="paper flex items-center justify-between transition hover:-translate-y-0.5"
                  style="padding: 14px 16px;"
                >
                  <span>
                    <span class="serif block" style="font-size: 16px; font-weight: 500;">{r.name}</span>
                    {r.subtitle && <span class="mono block mt-0.5" style="font-size: 10.5px; color: var(--color-ink-subtle);">{r.subtitle}</span>}
                  </span>
                  <ChevronRight className="h-4 w-4 mirror-x" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Deep hospital sections (top-tier hospitals only) */}
    {hSections && (
      <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tHd("programProfile")}
          </div>
          <h2 class="display mb-7" style="font-size: 30px; letter-spacing: -0.02em;">
            {tHd("whatMakesDestination").replace("{hospitalName}", hospital.name)}
          </h2>

          {hSections.programDifferentiators && hSections.programDifferentiators.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{tHd("programDifferentiators")}</h3>
              <ul class="space-y-3.5">
                {hSections.programDifferentiators.map((d: string) => (
                  <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                    <span style="color: var(--color-accent); font-weight: 600; min-width: 12px;">→</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {hSections.accreditationContext && hSections.accreditationContext.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{tHd("accreditationContext")}</h3>
              <div class="grid gap-4 md:grid-cols-2">
                {hSections.accreditationContext.map((a: any) => (
                  <div class="paper" style="padding: 20px;">
                    <div class="mono uppercase" style="font-size: 12px; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: 8px;">
                      {a.code}
                    </div>
                    <p style="font-size: 14px; line-height: 1.5;">{a.meaning}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {hSections.whatPatientsExperience && hSections.whatPatientsExperience.length > 0 && (
            <div class="mb-10">
              <h3 class="display mb-4" style="font-size: 22px;">{tHd("whatPatientsExperience")}</h3>
              <ol class="space-y-0">
                {hSections.whatPatientsExperience.map((step: string, i: number) => (
                  <li
                    class="grid items-start gap-5 py-4"
                    style={`grid-template-columns: 56px 1fr; ${i > 0 ? "border-top: 1px solid var(--color-border-soft);" : ""}`}
                  >
                    <span class="display tnum" style="font-size: 28px; line-height: 1; opacity: 0.35;">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span style="font-size: 15px; line-height: 1.55;">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {hSections.howToEvaluate && hSections.howToEvaluate.length > 0 && (
            <div>
              <h3 class="display mb-4" style="font-size: 22px;">{tHd("howToEvaluate")}</h3>
              <ol class="space-y-3">
                {hSections.howToEvaluate.map((q: string, i: number) => (
                  <li class="flex gap-4 items-start paper" style="padding: 16px 22px;">
                    <span class="display tnum" style="font-size: 24px; line-height: 1; opacity: 0.35; min-width: 36px;">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <p style="font-size: 15.5px; line-height: 1.5;">{q}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </section>
    )}

    {/* EEAT signals — methodology + reviewer attribution + last reviewed */}
    <MethodologyBlock locale={locale}
      lastReviewed={hospitalRaw.updatedAt}
      curationNote={`This profile of ${hospital.name} is rebuilt from ${accreditations.length > 0 ? `${accreditations.length} verified accreditation${accreditations.length === 1 ? "" : "s"}, ` : ""}${hospitalDoctors.length > 0 ? `${hospitalDoctors.length} surgeon credential checks, ` : ""}and the hospital's most recently issued international-patient quote sheets. Outcomes claims, where stated, are sourced from peer-reviewed publications or hospital-issued annual reports — never from marketing collateral.`}
      dataSources={[
        "JCI accreditation registry",
        ...(countrySlug === "india" ? ["NABH licence register"] : []),
        "National medical council registries",
        "Hospital-issued itemised quote sheets",
        ...(hospitalRaw.website ? [`${hospital.name} institutional records`] : []),
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tHd("exploreEyebrow").replace("{hospitalName}", hospital.name)}
      heading={tHd("exploreHeading")}
      lede={tHd("exploreLede")}
      items={[
        ...(hospitalSpecialties[0]?.specialty?.slug && hospitalSpecialties[0]?.specialty?.name
          ? [{ eyebrow: "Department", label: `${hospitalSpecialties[0].specialty.name} at ${hospital.name}`, href: `/hospital/${slug}/${hospitalSpecialties[0].specialty.slug}`, hint: "Programs, surgeons, and pricing for this specific specialty." }] : []),
        ...(hospitalSpecialties[1]?.specialty?.slug && hospitalSpecialties[1]?.specialty?.name
          ? [{ eyebrow: "Department", label: `${hospitalSpecialties[1].specialty.name} department`, href: `/hospital/${slug}/${hospitalSpecialties[1].specialty.slug}`, hint: "Sub-specialties, equipment, surgeons in this department." }] : []),
        ...(hospital.city?.slug && cityName ? [{ eyebrow: "City", label: `Hospitals in ${cityName}`, href: `/hospitals/city/${hospital.city.slug}`, hint: `Other ${cityName} programs for context and comparison.` }] : []),
        ...(countrySlug && countryName ? [{ eyebrow: "Destination", label: `${countryName} hospital hub`, href: `/country/${countrySlug}`, hint: `Featured programs and pricing benchmarks across ${countryName}.` }] : []),
        ...(countrySlug ? [{ eyebrow: "Visa", label: `${countryName} medical visa`, href: `/visa/${countrySlug}`, hint: "Documents, processing time, embassy guidance." }] : []),
        ...(hospitalSpecialties[0]?.specialty?.slug && hospitalSpecialties[0]?.specialty?.name && countrySlug
          ? [{ eyebrow: "Best of", label: `Best ${hospitalSpecialties[0].specialty.name} in ${countryName}`, href: `/best/${hospitalSpecialties[0].specialty.slug}-in-${countrySlug}`, hint: "Editorially ranked programs with methodology disclosed." }] : []),
        ...(hospitalSpecialties[0]?.specialty?.slug && hospitalSpecialties[0]?.specialty?.name
          ? [{ eyebrow: "Specialty", label: `${hospitalSpecialties[0].specialty.name} hub`, href: `/specialty/${hospitalSpecialties[0].specialty.slug}`, hint: "All programs and procedures in this specialty across destinations." }] : []),
        { eyebrow: "Compare", label: "Hospital comparison", href: "/compare/hospitals", hint: "Side-by-side accreditations, ratings, beds, pricing for up to 4 hospitals." },
        { eyebrow: "Compare", label: "Doctor comparison", href: "/compare/doctors", hint: "Surgeons compared on volume, fees, languages, video-consult availability." },
        { eyebrow: "Tool", label: "Cost calculator", href: "/calculator", hint: "Hospital-reported pricing across procedures × destinations." },
        { eyebrow: "Tool", label: "Match-me triage", href: "/match-me", hint: "Three questions, get specialty + destination + 3 hospitals." },
        { eyebrow: "Action", label: "Free second opinion", href: "/second-opinion", hint: "Independent panel review of your case in 48 hours — no charge." },
      ]}
    />

    <SiteFooter locale={locale} />
    <EngagementFab locale={locale} />
    <MobileQuoteBar
      locale={locale}
      label={hospital.name}
      sublabel={prices.min ? tHd("mobileSubLabel").replace("{price}", Math.round(prices.min).toLocaleString()) : tHd("mobileSubLabelNoPrice")}
      whatsapp={{
        page: "hospital",
        slug: hospital.slug,
        hospitalName: hospital.name,
        cityName: cityName ?? undefined,
        specialtyName: hospitalSpecialties[0]?.specialty.name,
      }}
    />
  </main>
</BaseLayout>
