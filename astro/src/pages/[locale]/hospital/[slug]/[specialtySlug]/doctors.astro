---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { listHospitalSpecialtyDoctors, listFaqsFor } from "@/lib/queries";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, hospitalJsonLd, withProvenance, faqJsonLd, surgeonNoun, titleCase } from "@/lib/seo";
import { Award, MapPin, Users } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { doctorPortrait } from "@/lib/images";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const { slug, specialtySlug } = Astro.params;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospital/${slug}/${specialtySlug}/doctors`, 308);
if (!slug || !specialtySlug) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

const data = await listHospitalSpecialtyDoctors(slug, specialtySlug);
if (!data) return new Response(`Not found: ${slug}/${specialtySlug}/doctors`, { status: 404 });
if (data.doctors.length === 0) return new Response(`No doctors listed`, { status: 404 });

const tc = getTranslator(locale, "common");
const tHsd = getTranslator(locale, "hospitalSpecialtyDoctorsPage");

const [hMap, sMap, faqs] = await Promise.all([
  getContent("hospital", data.hospital.id, locale),
  getContent("specialty", data.specialty.id, locale),
  listFaqsFor("specialty", data.specialty.id),
]);
const hospitalBase = applyTranslated(data.hospital, hMap, ["name"]);
const hospital = { ...hospitalBase, city: data.hospital.city };
const specialty = applyTranslated(data.specialty, sMap, ["name"]);

const doctorMap = await getContentBatch("doctor", data.doctors.map((d) => d.id), locale);
const doctors = data.doctors.map((d) => ({
  ...d,
  ...applyTranslated({ name: d.name, qualifications: d.qualifications }, doctorMap[d.id] ?? {}, ["name", "qualifications"]),
}));

const cityName = hospital.city?.name ?? null;
const countryName = hospital.city?.country?.name ?? null;
const citySlug = hospital.city?.slug ?? null;
const countrySlug = hospital.city?.country?.slug ?? null;

const specialistNoun = surgeonNoun(specialtySlug, specialty.name);
const seoTitle = tHsd("seoTitle").replace("{specialistNoun}", titleCase(specialistNoun)).replace("{hospitalName}", hospital.name);
const seoDescription = (
  tHsd("seoDescription")
    .replace("{count}", String(doctors.length))
    .replace("{specialistNoun}", specialistNoun)
    .replace("{hospitalName}", hospital.name)
    .replace("{cityFragment}", cityName ? tHsd("seoDescriptionCityFragment").replace("{cityName}", cityName) : "")
).slice(0, 160);

const path = `/hospital/${slug}/${specialtySlug}/doctors`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  { name: hospital.name, url: localeUrl(locale, `/hospital/${slug}`) },
  { name: specialty.name, url: localeUrl(locale, `/hospital/${slug}/${specialtySlug}`) },
  { name: tHsd("breadcrumbDoctors"), url },
]);

const itemLd = withProvenance(
  itemListJsonLd(
    doctors.slice(0, 15).map((d) => ({
      name: d.title ? `${d.title} ${d.name}`.replace(/^Dr\. Dr\./i, "Dr.") : d.name,
      url: localeUrl(locale, `/doctor/${d.slug}`),
    })),
  ),
  { dateModified: data.hospital.updatedAt },
);

// Hospital context schema — page is scoped to a specific hospital, so emit
// the parent entity alongside the doctor ItemList. Without this, search engines
// see the page as a generic doctor list and miss the hospital relationship.
const hospitalLd = withProvenance(
  hospitalJsonLd({
    name: hospital.name,
    description: hospital.description,
    address: hospital.address,
    city: hospital.city?.name ?? null,
    country: hospital.city?.country?.name ?? null,
    countryCode: hospital.city?.country?.isoCode ?? null,
    lat: hospital.city?.latitude ?? null,
    lng: hospital.city?.longitude ?? null,
    phone: hospital.phone,
    email: hospital.email,
    website: hospital.website,
    rating: hospital.rating,
    reviewCount: hospital.reviewCount,
    imageUrl: hospital.coverImageUrl,
    url: localeUrl(locale, `/hospital/${slug}`),
    bedCapacity: hospital.bedCapacity,
    medicalSpecialties: [specialty.name],
  }),
  { dateModified: data.hospital.updatedAt },
);

const faqLd = faqs.length > 0
  ? faqJsonLd(faqs.map((f) => ({ question: f.question, answer: f.answer })))
  : null;

const untranslated = isUntranslated(locale, hMap, sMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(hospitalLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />
    {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted overflow-x-auto whitespace-nowrap">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/hospitals")} class="hover:text-accent">{tc("hospitals")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/hospital/${slug}`)} class="hover:text-accent">{hospital.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/hospital/${slug}/${specialtySlug}`)} class="hover:text-accent">{specialty.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{tHsd("breadcrumbDoctors")}</span>
      </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-8">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {specialty.name} · {hospital.name}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.025em; line-height: 1.02;">
        {tHsd("h1").replace("{specialistNoun}", specialistNoun).replace("{hospitalName}", hospital.name)}
      </h1>
      <p class="lede mt-5 max-w-[44rem]">
        {tHsd("ledeParagraph")
          .replace("{count}", String(doctors.length))
          .replace("{hospitalName}", hospital.name)
          .replace("{cityFragment}", cityName ? `, ${cityName}` : "")
          .replace("{specialtyName}", specialty.name.toLowerCase())}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <LastUpdated updated={data.hospital.updatedAt} locale={locale} />
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-10 border-t border-border-soft pt-8">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {doctors.map((d) => {
          const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
          const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
          const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
          return (
            <li>
              <a
                href={localizedPath(locale, `/doctor/${d.slug}`)}
                class="group flex h-full gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
              >
                <img
                  src={doctorPortrait({ imageUrl: d.image_url, id: d.id }, 128)}
                  alt={d.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                />
                <div class="min-w-0 flex-1">
                  <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                  {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-2">{d.qualifications}</span>}
                  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                    {d.experience_years != null && (
                      <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{d.experience_years} {tHsd("yrsAbbr")}</span>
                    )}
                    {d.patients_treated != null && d.patients_treated > 0 && (
                      <span class="inline-flex items-center gap-1"><Users className="h-3 w-3 text-accent" />{d.patients_treated.toLocaleString()}</span>
                    )}
                    {d.rating && Number(d.rating) > 0 && (
                      <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                    )}
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <h2 class="sr-only">{tHsd("matchSectionSrOnly")}</h2>
      <div class="paper p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-[36rem]">
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tHsd("matchEyebrow")}</p>
          <h3 class="mt-2 font-display text-2xl md:text-3xl">
            {tHsd("matchHeading")}
          </h3>
          <p class="mt-2 text-sm text-ink-muted">
            {tHsd("matchBody").replace("{hospitalName}", hospital.name)}
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={localizedPath(locale, `/contact?hospital=${hospital.slug}&specialty=${specialtySlug}`)}
            class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            {tHsd("matchCta")}
          </a>
          <a
            href={localizedPath(locale, `/hospital/${slug}/${specialtySlug}`)}
            class="inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold hover:border-border-strong"
          >
            {tHsd("backToDepartment")}
          </a>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tHsd("howHeading")}
      italicWord={tHsd("howItalicWord")}
      eyebrow={tHsd("howEyebrow")}
      steps={[
        { title: tHsd("howStep1Title"), description: tHsd("howStep1Desc") },
        { title: tHsd("howStep2Title"), description: tHsd("howStep2Desc") },
        { title: tHsd("howStep3Title"), description: tHsd("howStep3Desc") },
        { title: tHsd("howStep4Title"), description: tHsd("howStep4Desc") },
      ]}
    />
    
    <ExploreGrid
      locale={locale}
      eyebrow={`${hospital.name} · ${specialty.name}`}
      heading={tHsd("exploreHeading")}
      lede={tHsd("exploreLede")}
      items={[
        { eyebrow: tHsd("exploreEyebrowDepartment"), label: tHsd("exploreItemDeptLabel").replace("{specialtyName}", specialty.name), href: `/hospital/${slug}/${specialtySlug}`, hint: tHsd("exploreItemDeptHint").replace("{hospitalName}", hospital.name) },
        { eyebrow: tHsd("exploreEyebrowHospital"), label: tHsd("exploreItemHospitalLabel").replace("{hospitalName}", hospital.name), href: `/hospital/${slug}`, hint: tHsd("exploreItemHospitalHint") },
        { eyebrow: tHsd("exploreEyebrowSpecialty"), label: tHsd("exploreItemSpecialtyLabel").replace("{specialtyName}", specialty.name), href: `/specialty/${specialtySlug}`, hint: tHsd("exploreItemSpecialtyHint").replace("{specialtyName}", specialty.name.toLowerCase()) },
        { eyebrow: tHsd("exploreEyebrowSurgeons"), label: tHsd("exploreItemAllSurgeonsLabel").replace("{specialtyName}", specialty.name.toLowerCase()), href: `/surgeons/${specialtySlug}`, hint: tHsd("exploreItemAllSurgeonsHint") },
        ...(countrySlug && countryName ? [{ eyebrow: tHsd("exploreEyebrowSurgeons"), label: tHsd("exploreItemCountrySurgeonsLabel").replace("{specialtyName}", specialty.name).replace("{countryName}", countryName), href: `/surgeons/${specialtySlug}/${countrySlug}`, hint: tHsd("exploreItemCountrySurgeonsHint").replace("{countryName}", countryName) }] : []),
        ...(citySlug && cityName ? [{ eyebrow: tHsd("exploreEyebrowCity"), label: tHsd("exploreItemCityLabel").replace("{cityName}", cityName), href: `/hospitals/city/${citySlug}`, hint: tHsd("exploreItemCityHint").replace("{cityName}", cityName).replace("{specialtyName}", specialty.name.toLowerCase()) }] : []),
        ...(countrySlug && countryName ? [{ eyebrow: tHsd("exploreEyebrowDestination"), label: tHsd("exploreItemDestinationLabel").replace("{countryName}", countryName), href: `/country/${countrySlug}`, hint: tHsd("exploreItemDestinationHint").replace("{countryName}", countryName) }] : []),
        ...(countrySlug ? [{ eyebrow: tHsd("exploreEyebrowBestOf"), label: tHsd("exploreItemBestLabel").replace("{specialtyName}", specialty.name).replace("{countryName}", countryName ?? ""), href: `/best/${specialtySlug}-in-${countrySlug}`, hint: tHsd("exploreItemBestHint") }] : []),
        { eyebrow: tHsd("exploreEyebrowCompare"), label: tHsd("exploreItemCompareLabel"), href: "/compare/doctors", hint: tHsd("exploreItemCompareHint") },
        { eyebrow: tHsd("exploreEyebrowTool"), label: tHsd("exploreItemMatchLabel"), href: "/match-me", hint: tHsd("exploreItemMatchHint") },
        { eyebrow: tHsd("exploreEyebrowTool"), label: tHsd("exploreItemCalcLabel"), href: "/calculator", hint: tHsd("exploreItemCalcHint") },
        { eyebrow: tHsd("exploreEyebrowAction"), label: tHsd("exploreItemOpinionLabel"), href: "/second-opinion", hint: tHsd("exploreItemOpinionHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
