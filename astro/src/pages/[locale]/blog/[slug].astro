---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import { getBlogPostBySlug, listLinkableEntities, listCitationsFor } from "@/lib/queries";
import { pageImageFor } from "@/lib/page-images";
import Citations from "@/components/content/Citations.astro";
import { linkifyBlogHtml } from "@/lib/content-linker";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_URL } from "@/lib/seo";
import {
  getContent,
  applyTranslated,
  isUntranslated,
  localizedTitle,
  localizedDescription,
} from "@/lib/translate";
import { Calendar, ChevronRight, User } from "lucide-react";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/blog/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const data = await getBlogPostBySlug(slug);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const tBp = getTranslator(locale, "blogPostPage");
const { post: postRaw, related } = data;
const blogMap = await getContent("blog_post", postRaw.id, locale);
const post = applyTranslated(postRaw, blogMap, ["title", "excerpt", "content"]);

// Admin-set image override for this blog post
const blogCoverOverride = await pageImageFor("blog", slug, "cover");
if (blogCoverOverride) {
  post.coverImageUrl = blogCoverOverride.url;
}

const citations = await listCitationsFor("blog", post.id);
const linkables = await listLinkableEntities().catch(() => []);
const { html: linkedHtml, linked: mentioned } = linkifyBlogHtml(
  post.content ?? "",
  linkables,
  (p) => localizedPath(locale, p),
);

// Extract h2/h3 headings, inject ids for anchor-linking, build TOC.
type TocEntry = { level: 2 | 3; id: string; text: string };
const tocEntries: TocEntry[] = [];
const usedIds = new Set<string>();
function slugifyHeading(s: string): string {
  const base = s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || "section";
  let candidate = base;
  let n = 2;
  while (usedIds.has(candidate)) candidate = `${base}-${n++}`;
  usedIds.add(candidate);
  return candidate;
}
const htmlWithIds = linkedHtml.replace(
  /<(h[23])\b([^>]*)>([\s\S]*?)<\/\1>/gi,
  (_match, tag: string, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]*>/g, "").trim();
    if (!text) return _match;
    if (/\bid\s*=/.test(attrs)) return _match;
    const id = slugifyHeading(text);
    tocEntries.push({ level: tag.toLowerCase() === "h2" ? 2 : 3, id, text });
    return `<${tag} id="${id}"${attrs}>${inner}</${tag}>`;
  },
);

// Key takeaways: prefer hand-authored block (look for an <h2>Key takeaways</h2>
// followed by a <ul>), else fall back to the first 4 h2 headings as a TL;DR.
function extractKeyTakeaways(): string[] {
  const re = /<h2[^>]*>\s*(?:key\s+takeaways|tl;dr|summary)\s*<\/h2>\s*<ul>([\s\S]*?)<\/ul>/i;
  const m = (post.content ?? "").match(re);
  if (m) {
    const liRe = /<li>([\s\S]*?)<\/li>/gi;
    const items: string[] = [];
    let li: RegExpExecArray | null;
    while ((li = liRe.exec(m[1])) !== null) {
      const text = li[1].replace(/<[^>]*>/g, "").trim();
      if (text) items.push(text);
    }
    if (items.length >= 2) return items.slice(0, 6);
  }
  return tocEntries.filter((t) => t.level === 2).slice(0, 4).map((t) => t.text);
}
const keyTakeaways = extractKeyTakeaways();
const groupedMentions = {
  treatment: mentioned.filter((e) => e.kind === "treatment"),
  hospital: mentioned.filter((e) => e.kind === "hospital"),
  specialty: mentioned.filter((e) => e.kind === "specialty"),
  condition: mentioned.filter((e) => e.kind === "condition"),
  glossary: mentioned.filter((e) => e.kind === "glossary"),
};
const mentionGroupLabels: Record<string, string> = {
  treatment: tBp("mentionTreatments"),
  hospital: tBp("mentionHospitals"),
  specialty: tBp("mentionSpecialties"),
  condition: tBp("mentionConditions"),
  glossary: tBp("mentionGlossary"),
};
const mentionKindOrder: Array<keyof typeof groupedMentions> = [
  "treatment",
  "hospital",
  "specialty",
  "condition",
  "glossary",
];

const seoFallbackDesc = post.excerpt ?? post.title;
const seoTitle = localizedTitle(locale, post.title, post.metaTitle, blogMap);
const seoDescription = localizedDescription(
  locale,
  post.excerpt,
  post.metaDescription,
  seoFallbackDesc,
  blogMap,
);
const blogUntranslated = isUntranslated(locale, blogMap);

const path = `/blog/${slug}`;
const url = localeUrl(locale, path);

function fmtDate(d: Date | null): string {
  if (!d) return "";
  try {
    return new Date(d).toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
  } catch {
    return new Date(d).toISOString().slice(0, 10);
  }
}

const wordCount = post.content
  ? post.content.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length
  : undefined;
const readingMinutes = wordCount ? Math.max(2, Math.round(wordCount / 220)) : undefined;
const keywordList: string[] | undefined = (() => {
  const raw = post.tags;
  if (!raw) return undefined;
  try {
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed)) return parsed.filter((x) => typeof x === "string");
  } catch {
    /* fall through */
  }
  return raw.split(",").map((k) => k.trim()).filter(Boolean);
})();

function firstWord(s: string) { const i = s.indexOf(" "); return i === -1 ? s : s.slice(0, i); }
function lastWord(s: string) {
  const parts = s.trim().split(/\s+/);
  return parts.length > 1 ? parts[parts.length - 1] : "";
}
function withoutLastWord(s: string) {
  const parts = s.trim().split(/\s+/);
  return parts.length > 1 ? parts.slice(0, -1).join(" ") : s;
}

// Parse reviewer out of authorName ("MedCasts Editorial · Reviewed by Dr. X, Specialty").
// We surface the reviewer as a separate `reviewedBy` Person so Google can
// attribute medical-review credibility to the named clinician (key for
// YMYL ranking) — distinct from the corporate `author`.
const reviewerMatch = (post.authorName ?? "").match(/Reviewed by\s+(Dr\.?\s+[^,]+?)(?:,\s*([^·]+))?\s*$/i);
const reviewerName = reviewerMatch?.[1]?.trim() ?? null;
const reviewerSpecialty = reviewerMatch?.[2]?.trim() ?? null;

// Try to find a matching doctor profile by last-name match. The blog
// reviewer field is short-form ("Dr. M. Ozdemir") so we extract the last
// token and look it up. If found, the Person schema points at the real
// /doctor/<slug> URL — best-case EEAT signal.
let reviewerDoctor: { slug: string; name: string } | null = null;
if (reviewerName) {
  try {
    const lastName = reviewerName.replace(/^Dr\.?\s*/i, "").split(/\s+/).filter(Boolean).pop();
    if (lastName && lastName.length >= 3) {
      const { db: ldb } = await import("@/lib/db");
      const { sql: lsql } = await import("drizzle-orm");
      const m = await ldb.execute<{ slug: string; name: string }>(lsql`
        SELECT slug, name FROM doctors
        WHERE is_active = true AND name ILIKE ${"%" + lastName + "%"}
        LIMIT 1
      `);
      const row = Array.from(m)[0];
      if (row) reviewerDoctor = row;
    }
  } catch {
    // best-effort lookup; never fail the page
  }
}

// Also try to match the reviewer to a /medical-board panel member, so
// the visible byline can link to the panel anchor — distinct from the
// schema-level /doctor/<slug> link above.
const { lookupReviewerByName } = await import("@/lib/queries");
const reviewerPanel = await lookupReviewerByName(reviewerName);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: seoDescription,
  ...(post.coverImageUrl ? { image: post.coverImageUrl } : {}),
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  ...(post.updatedAt ? { dateModified: post.updatedAt } : {}),
  ...(wordCount ? { wordCount } : {}),
  ...(post.category ? { articleSection: post.category } : {}),
  ...(keywordList && keywordList.length > 0 ? { keywords: keywordList } : {}),
  author: post.authorName
    ? {
        "@type": "Person",
        name: post.authorName,
        // Anchored to /about → MedCasts editorial desk so Google can attribute
        // E-E-A-T to a documented organization. Once a per-author profile
        // page exists, swap to that URL.
        url: `${SITE_URL}${localizedPath(locale, "/about")}`,
        worksFor: { "@type": "Organization", name: "MedCasts" },
      }
    : { "@type": "Organization", name: "MedCasts", url: `${SITE_URL}/about` },
  ...(reviewerName
    ? {
        reviewedBy: {
          "@type": "Person",
          name: reviewerName,
          ...(reviewerSpecialty ? { jobTitle: reviewerSpecialty } : {}),
          ...(reviewerDoctor
            ? { url: `${SITE_URL}${localizedPath(locale, `/doctor/${reviewerDoctor.slug}`)}` }
            : {}),
          worksFor: { "@type": "Organization", name: "MedCasts" },
        },
        ...(post.updatedAt ? { lastReviewed: post.updatedAt } : {}),
      }
    : {}),
  publisher: {
    "@type": "Organization",
    name: "MedCasts",
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.svg` },
  },
  mainEntityOfPage: url,
  inLanguage: "en",
  // Speakable hint — flags the article body for Google Assistant + voice readers.
  // Targets the heading + lede via CSS selectors so the assistant reads the
  // most relevant chunks aloud rather than the whole page.
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", ".lede", ".blog-prose"],
  },
};

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Blog", url: localeUrl(locale, "/blog") },
  { name: post.title, url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      image={post.coverImageUrl ?? undefined}
      noindex={blogUntranslated}
      type="article"
      publishedAt={post.publishedAt ? new Date(post.publishedAt).toISOString() : undefined}
      modifiedAt={post.updatedAt ? new Date(post.updatedAt).toISOString() : undefined}
      author={post.authorName ?? undefined}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/blog")} class="hover:text-ink">Blog</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{post.category ?? tBp("articleFallback")}</span>
        </nav>
      </div>
    </div>

    {/* Hero — editorial title block */}
    <section style="padding: 56px 0 40px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        {post.category && (
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
            {post.category}{readingMinutes ? ` ${tBp("minRead").replace("{n}", String(readingMinutes))}` : ""}
          </p>
        )}
        <h1
          class="display display-tight mt-4"
          style="font-size: clamp(2.25rem, 5.2vw, 4.5rem); line-height: 1.02; font-weight: 400; letter-spacing: -0.03em; max-width: 58rem;"
        >
          {withoutLastWord(post.title)}{" "}<span class="italic-display">{lastWord(post.title)}</span>
        </h1>
        {post.excerpt && (
          <p class="serif mt-6 max-w-[48rem]" style="font-size: 20px; line-height: 1.5; color: var(--color-ink-muted);">
            {post.excerpt}
          </p>
        )}

        {/* Byline strip */}
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border); padding: 14px 0;">
          {post.authorName && (
            <div class="flex items-center gap-2">
              <div class="flex h-9 w-9 items-center justify-center rounded-full" style="background: var(--color-accent-soft); color: var(--color-accent);">
                <User className="h-4 w-4" />
              </div>
              <div class="min-w-0">
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBp("labelAuthor")}</div>
                <div class="serif" style="font-size: 14px; color: var(--color-ink);">{post.authorName}</div>
              </div>
            </div>
          )}
          {post.publishedAt && (
            <div>
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBp("labelPublished")}</div>
              <div class="serif tnum" style="font-size: 14px; color: var(--color-ink);">{fmtDate(post.publishedAt)}</div>
            </div>
          )}
          {post.updatedAt && post.updatedAt !== post.publishedAt && (
            <div>
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBp("labelUpdated")}</div>
              <div class="serif tnum" style="font-size: 14px; color: var(--color-ink);">{fmtDate(post.updatedAt)}</div>
            </div>
          )}
          {wordCount && (
            <div>
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBp("labelLength")}</div>
              <div class="serif tnum" style="font-size: 14px; color: var(--color-ink);">{tBp("wordsCount").replace("{n}", wordCount.toLocaleString())}</div>
            </div>
          )}
        </div>

        {keywordList && keywordList.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">{tBp("labelTopics")}</span>
            {keywordList.map((tag) => (
              <span
                class="mono uppercase"
                style="font-size: 10.5px; letter-spacing: 0.06em; padding: 4px 10px; border: 1px solid var(--color-border); border-radius: 9999px; background: var(--color-surface); color: var(--color-ink-muted);"
              >
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </section>

    {post.coverImageUrl && (
      <section style="padding-bottom: 48px;">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <PhotoBlock
            aspect="16/9"
            rounded
            imgUrl={post.coverImageUrl}
            alt={post.title}
            priority
          />
        </div>
      </section>
    )}

    {/* Body + TOC-aligned layout */}
    <section style="padding-bottom: 72px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.3fr]">
          <article class="min-w-0">
            {keyTakeaways.length > 0 && (
              <aside
                class="paper mb-10"
                style="padding: 22px 26px 24px; border-left: 3px solid var(--color-accent);"
                aria-label={tBp("keyTakeawaysLabel")}
              >
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tBp("keyTakeawaysLabel")}
                </div>
                <ul class="mt-3 space-y-2">
                  {keyTakeaways.map((k, i) => (
                    <li class="serif flex gap-3" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink);">
                      <span class="display tnum shrink-0" style="font-size: 14px; color: var(--color-accent); padding-top: 2px;">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span>{k}</span>
                    </li>
                  ))}
                </ul>
              </aside>
            )}
            <div class="blog-prose prose-editorial" set:html={htmlWithIds} />
          </article>

          <aside class="hidden lg:block">
            <div class="lg:sticky lg:top-28 lg:self-start space-y-6">
              {tocEntries.length > 1 && (
                <nav aria-label={tBp("onThisPage")} style="padding: 18px 0; border-top: 1px solid var(--color-ink);">
                  <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    {tBp("onThisPage")}
                  </div>
                  <ol class="mt-3 space-y-1.5">
                    {tocEntries.slice(0, 12).map((t, i) => (
                      <li>
                        <a
                          href={`#${t.id}`}
                          class="flex gap-2 hover:text-accent transition-colors"
                          style={`font-size: 13px; line-height: 1.4; color: var(--color-ink-muted); ${t.level === 3 ? "padding-inline-start: 14px;" : ""}`}
                        >
                          <span class="mono tnum shrink-0" style="font-size: 10px; color: var(--color-ink-subtle); padding-top: 2px; min-width: 14px;">
                            {String(i + 1).padStart(2, "0")}
                          </span>
                          <span>{t.text}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )}

              <div style="padding: 18px 0; border-top: 1px solid var(--color-ink);">
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                  {tBp("reviewerDesk")}
                </div>
                <div class="serif mt-2" style="font-size: 15px; line-height: 1.4; color: var(--color-ink);">
                  {tBp("reviewedBy")}{" "}
                  {reviewerPanel ? (
                    <a
                      href={`${localizedPath(locale, "/medical-board")}#${reviewerPanel.slug}`}
                      style="color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border);"
                    >
                      {reviewerName ?? reviewerPanel.fullName}
                    </a>
                  ) : reviewerName ? (
                    <span>{reviewerName}</span>
                  ) : (
                    <span>MedCasts editorial</span>
                  )}
                </div>
                <p class="mono uppercase mt-1" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                  {tBp("namedPhysicianReview")}
                </p>
                <a
                  href={localizedPath(locale, "/editorial-policy")}
                  class="mono uppercase mt-3 inline-flex items-center gap-1 hover:text-accent transition-colors"
                  style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-muted);"
                >
                  {tBp("editorialPolicy")}
                </a>
              </div>

              <a
                href={localizedPath(locale, "/second-opinion")}
                class="paper group block transition hover:-translate-y-0.5"
                style="padding: 18px 20px;"
              >
                <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                  {tBp("freeSecondOpinion")}
                </div>
                <div class="serif mt-2" style="font-size: 16px; line-height: 1.3; color: var(--color-ink);">
                  {tBp("secondOpinionBody")}
                </div>
                <div class="mt-3 mono uppercase inline-flex items-center gap-1 group-hover:text-accent transition-colors" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-muted);">
                  {tBp("secondOpinionCta")}
                  <ChevronRight className="h-3 w-3 mirror-x" />
                </div>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <Citations citations={citations} />

    {mentioned.length > 0 && (
      <section style="padding: 48px 0 72px; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mb-6">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tBp("mentionedEyebrow")}
            </div>
            <h2 class="display mt-3" style="font-size: 24px; letter-spacing: -0.015em;">
              {tBp("mentionedHeading").replace("{n}", String(mentioned.length))}
            </h2>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {mentionKindOrder
              .filter((k) => groupedMentions[k].length > 0)
              .map((k) => (
                <div class="paper" style="padding: 20px 22px;">
                  <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
                    {mentionGroupLabels[k]}
                  </p>
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {groupedMentions[k].map((e) => {
                      const base =
                        k === "hospital" ? "/hospital" :
                        k === "treatment" ? "/treatment" :
                        k === "specialty" ? "/specialty" :
                        k === "condition" ? "/condition" :
                        "/glossary";
                      return (
                        <li>
                          <a
                            href={localizedPath(locale, `${base}/${e.slug}`)}
                            class="serif inline-flex items-center hover:text-accent transition-colors"
                            style="font-size: 13.5px; color: var(--color-ink); border-bottom: 1px dashed var(--color-border); padding-bottom: 1px;"
                          >
                            {e.name}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
          </div>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section style="padding: 56px 0 88px; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mb-6 flex items-end justify-between flex-wrap gap-4">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                {tBp("relatedEyebrow")}
              </div>
              <h2 class="display mt-3" style="font-size: 28px; letter-spacing: -0.02em;">
                {tBp("relatedHeading")}
              </h2>
            </div>
            <a
              href={localizedPath(locale, "/blog")}
              class="mono uppercase text-[11px] hover:text-accent"
              style="letter-spacing: 0.14em; color: var(--color-ink-subtle);"
            >
              {tBp("allPosts")}
            </a>
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {related.map((r) => (
              <li>
                <a
                  href={localizedPath(locale, `/blog/${r.slug}`)}
                  class="paper group flex flex-col h-full overflow-hidden transition hover:-translate-y-0.5"
                  style="padding: 0;"
                >
                  <PhotoBlock aspect="16/10" rounded={false} imgUrl={r.coverImageUrl} alt={r.title} />
                  <div class="p-5 flex-1 flex flex-col">
                    <p class="serif group-hover:text-accent transition-colors line-clamp-2" style="font-size: 17px; line-height: 1.3; letter-spacing: -0.005em; color: var(--color-ink);">
                      {r.title}
                    </p>
                    {r.excerpt && (
                      <p class="mt-2 serif line-clamp-2" style="font-size: 13.5px; line-height: 1.55; color: var(--color-ink-muted);">
                        {r.excerpt}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <style is:global>
      /* Anchor offset so jump-targets aren't hidden under the sticky header */
      .blog-prose h2[id],
      .blog-prose h3[id] { scroll-margin-top: 120px; }

      /* Drop-cap on first paragraph of the article body */
      .blog-prose > p:first-of-type::first-letter {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: 5.4em;
        line-height: 0.92;
        float: inline-start;
        margin-inline-end: 10px;
        margin-block-start: 0.08em;
        color: var(--color-ink);
      }

      /* Autolinks */
      .mc-autolink {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
        transition: color 120ms ease, text-decoration-color 120ms ease;
      }
      .mc-autolink:hover {
        color: var(--color-accent-hover, var(--color-accent));
        text-decoration-color: currentColor;
      }
    </style>

    
    <ExploreGrid
      locale={locale}
      eyebrow={tBp("exploreEyebrow")}
      heading={tBp("exploreHeading")}
      lede={tBp("exploreLede")}
      items={[
        { eyebrow: tBp("exploreItem1Eyebrow"), label: tBp("exploreItem1Label"), href: "/blog", hint: tBp("exploreItem1Hint") },
        { eyebrow: tBp("exploreItem2Eyebrow"), label: tBp("exploreItem2Label"), href: "/qa", hint: tBp("exploreItem2Hint") },
        { eyebrow: tBp("exploreItem3Eyebrow"), label: tBp("exploreItem3Label"), href: "/treatments", hint: tBp("exploreItem3Hint") },
        { eyebrow: tBp("exploreItem4Eyebrow"), label: tBp("exploreItem4Label"), href: "/specialties", hint: tBp("exploreItem4Hint") },
        { eyebrow: tBp("exploreItem5Eyebrow"), label: tBp("exploreItem5Label"), href: "/conditions", hint: tBp("exploreItem5Hint") },
        { eyebrow: tBp("exploreItem6Eyebrow"), label: tBp("exploreItem6Label"), href: "/countries", hint: tBp("exploreItem6Hint") },
        { eyebrow: tBp("exploreItem7Eyebrow"), label: tBp("exploreItem7Label"), href: "/calculator", hint: tBp("exploreItem7Hint") },
        { eyebrow: tBp("exploreItem8Eyebrow"), label: tBp("exploreItem8Label"), href: "/match-me", hint: tBp("exploreItem8Hint") },
        { eyebrow: tBp("exploreItem9Eyebrow"), label: tBp("exploreItem9Label"), href: "/compare/treatments", hint: tBp("exploreItem9Hint") },
        { eyebrow: tBp("exploreItem10Eyebrow"), label: tBp("exploreItem10Label"), href: "/glossary", hint: tBp("exploreItem10Hint") },
        { eyebrow: tBp("exploreItem11Eyebrow"), label: tBp("exploreItem11Label"), href: "/editorial-policy", hint: tBp("exploreItem11Hint") },
        { eyebrow: tBp("exploreItem12Eyebrow"), label: tBp("exploreItem12Label"), href: "/second-opinion", hint: tBp("exploreItem12Hint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
