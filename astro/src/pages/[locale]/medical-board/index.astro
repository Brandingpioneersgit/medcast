---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { listActiveReviewers } from "@/lib/queries";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, SITE_URL, SITE_NAME } from "@/lib/seo";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";
import { careTeam, heroImage } from "@/lib/images";
import { getTranslator } from "@/lib/messages";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/medical-board", 308);
const locale = rawLocale as Locale;

const reviewers = await listActiveReviewers();

const tMb = getTranslator(locale, "medicalBoardPage");

const path = "/medical-board";
const url = localeUrl(locale, path);
const title = tMb("seoTitle");
const description = reviewers.length > 0
  ? tMb("seoDescriptionWithCount").replace("{count}", String(reviewers.length))
  : tMb("seoDescriptionOnboarding");

const crumbs = breadcrumbJsonLd([
  { name: tMb("breadcrumbHome"), url: localeUrl(locale, "/") },
  { name: title, url },
]);

// Schema.org — list the panel so AEO/GEO engines can cite credentialed reviewers
const panelLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: `${SITE_NAME} Medical Review Panel`,
  url,
  parentOrganization: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  member: reviewers.map((r) => ({
    "@type": "Person",
    name: r.credentials ? `${r.fullName}, ${r.credentials}` : r.fullName,
    ...(r.jobTitle ? { jobTitle: r.jobTitle } : {}),
    ...(r.imageUrl ? { image: r.imageUrl } : {}),
    ...(r.linkedinUrl ? { sameAs: [r.linkedinUrl] } : {}),
  })),
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={title} description={description} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(panelLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <section style="border-bottom: 1px solid var(--color-border); padding: 64px 28px;">
      <div class="mx-auto max-w-[80rem]">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.55fr] lg:items-center">
          <div>
            <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
              {tMb("heroEyebrow")}
            </p>
            <h1 class="display display-tight mt-3" style="font-size: clamp(2rem, 5vw, 3.75rem); line-height: 1; font-weight: 400; letter-spacing: -0.03em;">
              {tMb("heroHeadingPlain")} <span class="italic-display">{tMb("heroHeadingItalic")}</span>
            </h1>
            <p class="lede mt-6 max-w-[46rem]">
              {tMb("heroLede")}
            </p>
          </div>
          <div class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
            <img
              src={careTeam("medical-board")}
              alt={tMb("heroImgAlt")}
              width="600"
              height="750"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
            <div class="image-veil" />
            <div class="absolute" style="inset-inline-start: 16px; inset-block-end: 16px; inset-inline-end: 16px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{tMb("heroBadge")}</div>
              <div class="serif" style="font-size: 16px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">{tMb("heroCaptionTagline")}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {reviewers.length === 0 ? (
      <section style="padding: 64px 28px;">
        <div class="mx-auto max-w-[80rem]">
          <div class="paper" style="padding: 40px; max-width: 56rem;">
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tMb("emptyEyebrow")}
            </div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.2;">
              {tMb("emptyHeading")}
            </h2>
            <p class="mt-4" style="color: var(--color-ink-muted); line-height: 1.6;">
              {tMb("emptyPara1Before")} <a href={localizedPath(locale, "/editorial-policy")} style="color: var(--color-accent); text-decoration: underline;">{tMb("emptyPara1LinkText")}</a>{tMb("emptyPara1After")}
            </p>
            <p class="mt-4" style="color: var(--color-ink-muted); line-height: 1.6;">
              {tMb("emptyPara2Before")}
              <a href="mailto:medcastsdigital@gmail.com" style="color: var(--color-ink); font-weight: 500;"> medcastsdigital@gmail.com</a> {tMb("emptyPara2After")}
            </p>
          </div>
        </div>
      </section>
    ) : (
      <section style="padding: 64px 28px;">
        <div class="mx-auto max-w-[80rem]">
          <ul class="grid gap-6" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
            {reviewers.map((r) => (
              <li id={r.slug} class="paper" style="padding: 24px;">
                <div class="flex items-start gap-4">
                  {r.imageUrl ? (
                    <img
                      src={r.imageUrl}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                      class="rounded-full object-cover shrink-0"
                      style="width: 56px; height: 56px;"
                    />
                  ) : (
                    <div
                      class="rounded-full shrink-0"
                      style="width: 56px; height: 56px; background: var(--color-accent-soft); display: flex; align-items: center; justify-content: center; color: var(--color-accent); font-weight: 600; font-size: 18px;"
                      aria-hidden="true"
                    >
                      {r.fullName.replace(/^Dr\.?\s*/i, "").split(/\s+/).map((w) => w[0]).slice(0, 2).join("")}
                    </div>
                  )}
                  <div class="min-w-0">
                    <div class="font-display" style="font-size: 17px; line-height: 1.25;">
                      {r.fullName}{r.credentials ? `, ${r.credentials}` : ""}
                    </div>
                    {r.jobTitle && (
                      <div style="font-size: 13px; color: var(--color-ink-muted); margin-top: 2px;">
                        {r.jobTitle}
                      </div>
                    )}
                  </div>
                </div>
                {r.bio && (
                  <p style="font-size: 14px; line-height: 1.55; color: var(--color-ink-muted); margin-top: 14px;">
                    {r.bio}
                  </p>
                )}
                {r.specialties && r.specialties.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {r.specialties.slice(0, 6).map((s) => (
                      <span style="padding: 3px 9px; border-radius: 9999px; font-size: 11px; background: var(--color-accent-soft); color: var(--color-accent);">
                        {s.replace(/-/g, " ")}
                      </span>
                    ))}
                  </div>
                )}
                <div class="mt-4 flex items-center gap-3" style="font-size: 12px; color: var(--color-ink-subtle);">
                  {r.licenseCountry && <span>{tMb("licensedIn").replace("{country}", r.licenseCountry)}</span>}
                  {r.linkedinUrl && (
                    <a href={r.linkedinUrl} rel="noopener" target="_blank" style="color: var(--color-accent);">
                      {tMb("linkedinLink")}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section style="padding: 48px 28px 96px; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[80rem] grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="display" style="font-size: 24px; line-height: 1.2;">{tMb("verifyHeading")}</h2>
          <ol style="margin-top: 16px; padding-inline-start: 20px; font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">
            <li>{tMb("verifyStep1")}</li>
            <li>{tMb("verifyStep2")}</li>
            <li>{tMb("verifyStep3")}</li>
            <li>{tMb("verifyStep4")}</li>
          </ol>
        </div>
        <div>
          <h2 class="display" style="font-size: 24px; line-height: 1.2;">{tMb("dontHeading")}</h2>
          <ul style="margin-top: 16px; padding-inline-start: 20px; font-size: 14.5px; line-height: 1.6; color: var(--color-ink-muted);">
            <li>{tMb("dontItem1")}</li>
            <li>{tMb("dontItem2")}</li>
            <li>{tMb("dontItem3")}</li>
            <li>{tMb("dontItem4")}</li>
          </ul>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tMb("howHeading")}
      italicWord={tMb("howItalicWord")}
      eyebrow={tMb("howEyebrow")}
      steps={[
        { title: tMb("howStep1Title"), description: tMb("howStep1Desc") },
        { title: tMb("howStep2Title"), description: tMb("howStep2Desc") },
        { title: tMb("howStep3Title"), description: tMb("howStep3Desc") },
        { title: tMb("howStep4Title"), description: tMb("howStep4Desc") },
        { title: tMb("howStep5Title"), description: tMb("howStep5Desc") },
      ]}
    />

    <WhatToExpect
      heading={tMb("whoHeading")}
      italicWord={tMb("whoItalicWord")}
      items={[
        { label: tMb("whoItem1Label"), description: tMb("whoItem1Desc") },
        { label: tMb("whoItem2Label"), description: tMb("whoItem2Desc") },
        { label: tMb("whoItem3Label"), description: tMb("whoItem3Desc") },
        { label: tMb("whoItem4Label"), description: tMb("whoItem4Desc") },
        { label: tMb("whoItem5Label"), description: tMb("whoItem5Desc") },
        { label: tMb("whoItem6Label"), description: tMb("whoItem6Desc") },
      ]}
    />
    <ExploreGrid
      locale={locale}
      eyebrow={tMb("exploreEyebrow")}
      heading={tMb("exploreHeading")}
      lede={tMb("exploreLede")}
      items={[
        { eyebrow: tMb("exploreItem1Eyebrow"), label: tMb("exploreItem1Label"), href: "/specialties", hint: tMb("exploreItem1Hint") },
        { eyebrow: tMb("exploreItem2Eyebrow"), label: tMb("exploreItem2Label"), href: "/conditions", hint: tMb("exploreItem2Hint") },
        { eyebrow: tMb("exploreItem3Eyebrow"), label: tMb("exploreItem3Label"), href: "/treatments", hint: tMb("exploreItem3Hint") },
        { eyebrow: tMb("exploreItem4Eyebrow"), label: tMb("exploreItem4Label"), href: "/editorial-policy", hint: tMb("exploreItem4Hint") },
        { eyebrow: tMb("exploreItem5Eyebrow"), label: tMb("exploreItem5Label"), href: "/second-opinion", hint: tMb("exploreItem5Hint") },
        { eyebrow: tMb("exploreItem6Eyebrow"), label: tMb("exploreItem6Label"), href: "/incident-report", hint: tMb("exploreItem6Hint") },
        { eyebrow: tMb("exploreItem7Eyebrow"), label: tMb("exploreItem7Label"), href: "/about", hint: tMb("exploreItem7Hint") },
        { eyebrow: tMb("exploreItem8Eyebrow"), label: tMb("exploreItem8Label"), href: "/glossary", hint: tMb("exploreItem8Hint") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
