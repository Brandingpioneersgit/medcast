---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import MatchMe from "@/components/MatchMe.tsx";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { listConditionsForMatching, getCalculatorMatrix } from "@/lib/queries";
import { ChevronRight } from "lucide-react";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/match-me", 308);
const locale = rawLocale as Locale;

const tc = getTranslator(locale, "common");
const tMm = getTranslator(locale, "matchMePage");

const [conditions, matrixData] = await Promise.all([
  listConditionsForMatching(),
  getCalculatorMatrix(),
]);

const seoTitle = tMm("seoTitle");
const seoDescription = tMm("seoDescription");
const path = "/match-me";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tMm("breadcrumbMatchMe"), url: localeUrl(locale, path) },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=3600",
);

const stats = [
  { l: tMm("statsQuestions"), v: "3" },
  { l: tMm("statsConditions"), v: conditions.length.toLocaleString() },
  { l: tMm("statsDestinations"), v: matrixData.countries.length.toString() },
  { l: tMm("statsFollowup"), v: "9 min" },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tMm("breadcrumbMatchMe")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tMm("eyebrow")}
      h1First={tMm("h1First")}
      h1Italic={tMm("h1Italic")}
      lede={tMm("lede")}
      stats={stats}
    />

    <section style="padding: 24px 0 56px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="paper" style="padding: 28px 28px 32px;">
          <div class="mb-6">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tMm("sectionThreeEyebrow")}
            </div>
            <h2 class="display mt-2" style="font-size: 26px; line-height: 1.1; letter-spacing: -0.015em;">
              {tMm("sectionThreeH2Part1")}<span class="italic-display">{tMm("sectionThreeH2Italic")}</span>
            </h2>
          </div>
          <MatchMe
            client:idle
            conditions={conditions}
            countries={matrixData.countries}
            matrix={matrixData.matrix}
            locale={locale}
            localeHref={(p: string) => localizedPath(locale, p)}
          />
        </div>
        <p class="mt-5 mono uppercase" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
          {tMm("disclaimerText")} ·
          <a href={localizedPath(locale, "/editorial-policy")} class="hover:text-accent" style="color: var(--color-ink-muted);">{tMm("editorialPolicyLink")} →</a>
        </p>
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 56px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-6 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              {tMm("ctaSkipEyebrow")}
            </div>
            <h2 class="display mt-2" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--color-bg);">
              {tMm("ctaSkipH2Part1")}<span class="italic-display">{tMm("ctaSkipH2Italic")}</span>
            </h2>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, "/contact")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              {tMm("ctaBtn")}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tMm("exploreEyebrow")}
      heading={tMm("exploreHeading")}
      lede={tMm("exploreLede")}
      items={[
        { eyebrow: tMm("exploreItem1Eyebrow"), label: tMm("exploreItem1Label"), href: "/calculator", hint: tMm("exploreItem1Hint") },
        { eyebrow: tMm("exploreItem2Eyebrow"), label: tMm("exploreItem2Label"), href: "/conditions", hint: tMm("exploreItem2Hint") },
        { eyebrow: tMm("exploreItem3Eyebrow"), label: tMm("exploreItem3Label"), href: "/specialties", hint: tMm("exploreItem3Hint") },
        { eyebrow: tMm("exploreItem4Eyebrow"), label: tMm("exploreItem4Label"), href: "/treatments", hint: tMm("exploreItem4Hint") },
        { eyebrow: tMm("exploreItem5Eyebrow"), label: tMm("exploreItem5Label"), href: "/countries", hint: tMm("exploreItem5Hint") },
        { eyebrow: tMm("exploreItem6Eyebrow"), label: tMm("exploreItem6Label"), href: "/compare/treatments", hint: tMm("exploreItem6Hint") },
        { eyebrow: tMm("exploreItem7Eyebrow"), label: tMm("exploreItem7Label"), href: "/compare/countries", hint: tMm("exploreItem7Hint") },
        { eyebrow: tMm("exploreItem8Eyebrow"), label: tMm("exploreItem8Label"), href: "/second-opinion", hint: tMm("exploreItem8Hint") },
        { eyebrow: tMm("exploreItem9Eyebrow"), label: tMm("exploreItem9Label"), href: "/quote", hint: tMm("exploreItem9Hint") },
        { eyebrow: tMm("exploreItem10Eyebrow"), label: tMm("exploreItem10Label"), href: "/medical-board", hint: tMm("exploreItem10Hint") },
        { eyebrow: tMm("exploreItem11Eyebrow"), label: tMm("exploreItem11Label"), href: "/editorial-policy", hint: tMm("exploreItem11Hint") },
        { eyebrow: tMm("exploreItem12Eyebrow"), label: tMm("exploreItem12Label"), href: "/qa", hint: tMm("exploreItem12Hint") },
      ]}
    />

    <HowItWorks
      heading={tMm("howHeading")}
      italicWord={tMm("howItalicWord")}
      steps={[
        { title: tMm("howStep1Title"), description: tMm("howStep1Desc") },
        { title: tMm("howStep2Title"), description: tMm("howStep2Desc") },
        { title: tMm("howStep3Title"), description: tMm("howStep3Desc") },
        { title: tMm("howStep4Title"), description: tMm("howStep4Desc") },
        { title: tMm("howStep5Title"), description: tMm("howStep5Desc") },
      ]}
      outroNote={tMm("howOutro")}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
