---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Price from "@/components/Price.astro";
import PriceRange from "@/components/PriceRange.astro";
import { getCountryBySlug, listFaqsFor } from "@/lib/queries";
import { getCountrySections } from "@/lib/content-sections";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, touristDestinationJsonLd, faqJsonLd, withProvenance } from "@/lib/seo";
import { hospitalCover, countryBanner } from "@/lib/images";
import TripStrip from "@/components/TripStrip.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import CompareToggle from "@/components/CompareToggle.astro";
import TravelLogisticsSection from "@/components/content/TravelLogisticsSection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import { ChevronRight, MapPin, Building2, Users, Globe } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/country/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const data = await getCountryBySlug(slug);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");

const rawData = data;
const countryMap = await getContent("country", rawData.country.id, locale);
const country = applyTranslated(rawData.country, countryMap, ["name"]);
// Wave 2.14 — body sections come from translations table; EN fallback below.
const introTr = countryMap.intro ?? null;
const strengthTr = countryMap.strength ?? null;
const watchOutTr = countryMap.watchOut ?? null;
const { hospitalCount, doctorCount, cityCount, topHospitals, topTreatments, cityList } = rawData;
const untranslated = isUntranslated(locale, countryMap);

const faqRows = await listFaqsFor("country", country.id);
const faqSchema = faqRows.length > 0 ? faqJsonLd(faqRows) : null;
const countryContentRow = await getCountrySections(country.id);
const countrySections = countryContentRow?.content_sections ?? null;

// Country-keyed safety + accreditation registry deep-links. Public registers; we
// re-check ours quarterly. Patients can verify any hospital independently.
type SafetyLink = { label: string; sub: string; url: string };
const SAFETY_REGISTRIES: Record<string, SafetyLink[]> = {
  india: [
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "NABH accredited hospital list", sub: "National Accreditation Board for Hospitals", url: "https://nabh.co/AccreditedHospital.aspx" },
    { label: "National Medical Commission registry", sub: "Verify any treating doctor's license", url: "https://www.nmc.org.in/information-desk/indian-medical-register/" },
  ],
  turkey: [
    { label: "USHAS-licensed facilities", sub: "Turkey's official medical-tourism authority", url: "https://www.ushas.com.tr/en/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Ministry of Health doctor lookup", sub: "Verify physician licensing", url: "https://saglikbakanligi.gov.tr/" },
  ],
  thailand: [
    { label: "HA Thailand accredited list", sub: "The Healthcare Accreditation Institute", url: "https://www.ha.or.th/EN" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Thailand Medical Council", sub: "Doctor licensing register", url: "https://www.tmc.or.th/index_en.php" },
  ],
  uae: [
    { label: "DHA Sheryan facility lookup", sub: "Dubai Health Authority licensed providers", url: "https://services.dha.gov.ae/sheryan/wps/portal/home/individual-search" },
    { label: "DOH Abu Dhabi facility register", sub: "Department of Health Abu Dhabi", url: "https://services.doh.gov.ae/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  germany: [
    { label: "KTQ certified facilities", sub: "Germany's hospital quality body", url: "https://www.ktq.de/en/ktq-certificate/zertifizierte-einrichtungen.html" },
    { label: "Bundesarztekammer doctor lookup", sub: "Federal Medical Association", url: "https://www.bundesaerztekammer.de/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  singapore: [
    { label: "Singapore Medical Council registry", sub: "Verify doctor licensing", url: "https://www.smc.gov.sg/check-a-doctors-registration" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "MOH licensed facilities", sub: "Ministry of Health Singapore", url: "https://hcidirectory.sg/hcidirectory/" },
  ],
  "south-korea": [
    { label: "KOIHA accredited list", sub: "Korean Institute for Healthcare Accreditation", url: "https://www.koiha.or.kr/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Visit Medical Korea registry", sub: "Government-registered medical-tourism providers", url: "https://english.visitmedicalkorea.com/" },
  ],
  malaysia: [
    { label: "MSQH accreditation list", sub: "Malaysian Society for Quality in Health", url: "https://www.msqh.com.my/" },
    { label: "Malaysia Medical Council registry", sub: "Verify doctor licensing", url: "https://mmc.gov.my/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  "saudi-arabia": [
    { label: "CBAHI accreditation register", sub: "Saudi Central Board for Accreditation", url: "https://portal.cbahi.gov.sa/" },
    { label: "Saudi Commission for Health Specialties", sub: "Doctor licensing register", url: "https://www.scfhs.org.sa/en/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
};
const safetyLinks: SafetyLink[] = SAFETY_REGISTRIES[country.slug] ?? [
  { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
];

const hospitalIds = topHospitals.map((h) => h.id);
const hospitalMap = await getContentBatch("hospital", hospitalIds, locale);
const hospitalsXl = topHospitals.map((h) => applyTranslated(h, hospitalMap[h.id] ?? {}, ["name", "description"]));

const treatmentIds = topTreatments.map((t) => t.id);
const treatmentMap = await getContentBatch("treatment", treatmentIds, locale);
const treatmentsXl = topTreatments.map((t) => applyTranslated(t, treatmentMap[t.id] ?? {}, ["name"]));

const seoTitle = `Medical Travel to ${country.name}: Hospitals, Costs, Visa`;
const lowPrice = topTreatments[0]?.lo ? `from $${Math.round(Number(topTreatments[0].lo)).toLocaleString()}` : "";
const seoDescription = `${country.name} has ${hospitalCount.toLocaleString()} hospitals listed on MedCasts, ${doctorCount.toLocaleString()} specialists, treatment packages ${lowPrice}. Compare and get a free quote.`.slice(0, 160);

// Country-specific copy — concrete local detail beats AI-generated blandness.
const COUNTRY_INTRO: Record<string, { intro: string; strength: string; watchOut: string }> = {
  india: {
    intro: `India handles high volumes of overseas cardiac, orthopedic, and oncology cases, with a heavy concentration around Delhi-NCR, Chennai, Mumbai and Bangalore. Prices are among the lowest for tertiary-care work worldwide.`,
    strength: `Strong in: CABG, joint replacement, liver transplants, bone-marrow work, IVF, hair restoration.`,
    watchOut: `Plan around monsoon (Jun-Sep in most cities) if mobility is a factor post-op, and confirm FRRO registration before any stay beyond 180 days.`,
  },
  thailand: {
    intro: `Thailand has been absorbing medical tourists for three decades — the market is mature, English-speaking at the major private hospitals, and the JCI network is dense.`,
    strength: `Strong in: cosmetic surgery, gender-affirming care, IVF with donor options, dental, orthopedics.`,
    watchOut: `Monsoon season (May-Oct) + heat make long recovery windows uncomfortable. Cosmetic-only visas max out at 30 days; longer surgical programmes need the Non-Immigrant MT visa.`,
  },
  turkey: {
    intro: `Turkey's grown fast as a destination for European and Gulf patients — mostly via Istanbul and Antalya. Private hospital pricing sits between Thailand and Germany.`,
    strength: `Strong in: hair transplants, bariatric surgery, dental implants, eye surgery, oncology.`,
    watchOut: `Aesthetic clinics vary wildly in quality. Only book facilities licensed by the Ministry of Health (USHAŞ-affiliated) and verify the physician's board certification, not just the "clinic" name.`,
  },
  germany: {
    intro: `Germany is where complex oncology and neurosurgery cases tend to go when budget isn't the constraint. University hospitals lead; private clinics are comparatively rare.`,
    strength: `Strong in: oncology, neurosurgery, transplants, paediatric tertiary care, rare-disease workups.`,
    watchOut: `German hospitals typically require upfront payment (Vorkasse) before visa issuance. Document turnaround from the embassy is 10-15 business days and can stretch around holiday windows.`,
  },
  "south-korea": {
    intro: `South Korea is a premium-tier Asian option, concentrated in Seoul. Strongest reputation for cosmetic and dermatological work, though oncology centres at Asan and Samsung also draw international referrals.`,
    strength: `Strong in: cosmetic/plastic surgery, dental, cancer surgery, stem-cell therapy research.`,
    watchOut: `Cosmetic clinics in Gangnam operate at scale — many outsource anaesthesia and post-op. Ask specifically who's holding the scalpel and where recovery nursing happens.`,
  },
  malaysia: {
    intro: `Malaysia is a cost-competitive Asian destination coordinated through the Malaysia Healthcare Travel Council. Kuala Lumpur and Penang take most international arrivals.`,
    strength: `Strong in: cardiology, fertility, oncology, health screening.`,
    watchOut: `The MHTC-approved hospital list is narrower than the total hospital count — stick to it for predictable pricing and paperwork.`,
  },
  singapore: {
    intro: `Singapore handles the most complex referrals out of South-East Asia, at a corresponding price point. Best fit for second opinions, rare-disease diagnostics, and transplants.`,
    strength: `Strong in: oncology, transplants, paediatric tertiary care, clinical genetics.`,
    watchOut: `Pricing runs 2-3x regional peers. If you're budget-sensitive, use Singapore for the diagnostic workup and travel elsewhere for the procedure itself.`,
  },
  uae: {
    intro: `The UAE — mostly Dubai and Abu Dhabi — has invested hard in tertiary healthcare over the last decade. Cleveland Clinic Abu Dhabi and Mediclinic are the usual referral points for regional patients.`,
    strength: `Strong in: cardiac surgery, fertility (with donor programmes), cosmetic, oncology.`,
    watchOut: `Medical-licensing frameworks differ between emirates (DHA, MOHAP, DOH) — confirm the physician is licensed in the specific emirate where your procedure takes place.`,
  },
  "saudi-arabia": {
    intro: `Saudi Arabia is the newest entrant in Gulf medical travel. Major volume concentrates in Riyadh and Jeddah; Vision 2030 has accelerated hospital investment.`,
    strength: `Strong in: cardiac surgery, urology, gynaecology, transplants within the GCC network.`,
    watchOut: `English-language paperwork isn't always standard — assume you'll need an Arabic translator for non-clinical admin.`,
  },
};

// Wave 2.14 — prefer translation rows; fall back to inline EN dict (or undefined).
const enCtx = COUNTRY_INTRO[country.slug];
const ctx = (introTr || strengthTr || watchOutTr || enCtx)
  ? {
      intro: introTr ?? enCtx?.intro ?? "",
      strength: strengthTr ?? enCtx?.strength ?? "",
      watchOut: watchOutTr ?? enCtx?.watchOut ?? "",
    }
  : undefined;

const path = `/country/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Destinations", url: localeUrl(locale, "/countries") },
  { name: country.name, url },
]);

const itemLd = hospitalsXl.length > 0
  ? itemListJsonLd(
      hospitalsXl.map((h) => ({
        name: h.name,
        url: localeUrl(locale, `/hospital/${h.slug}`),
      })),
    )
  : null;

const destinationLd = withProvenance(
  touristDestinationJsonLd({
    name: country.name,
    description: ctx?.intro ?? seoDescription,
    url,
    countryCode: country.isoCode ?? null,
    includesAttraction: hospitalsXl.slice(0, 6).map((h) => ({
      name: h.name,
      url: localeUrl(locale, `/hospital/${h.slug}`),
    })),
  }),
  {
    dateModified: rawData.country.updatedAt,
    dateCreated: rawData.country.createdAt,
    reviewer: null,
  },
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(destinationLd)} />
    {itemLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/countries")} class="hover:text-accent">Destinations</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{country.name}</span>
      </div>
    </nav>

    {/* Hero banner */}
    <section class="relative overflow-hidden" style="height: 360px;">
      <img
        src={countryBanner(country.slug, 1600, 720)}
        alt={`${country.name} skyline — medical travel destination`}
        width="1600"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          linear-gradient(180deg, rgba(14,23,19,0) 30%, rgba(14,23,19,0.45) 75%, rgba(14,23,19,0.78) 100%),
          linear-gradient(110deg, rgba(10,93,84,0.18) 0%, rgba(10,93,84,0) 55%);"
        aria-hidden="true"
      />
      <div class="relative mx-auto max-w-7xl px-6 h-full flex flex-col justify-end pb-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">
          Destination
        </p>
        <h1 class="mt-2 font-display text-3xl md:text-5xl leading-[1.05] text-white">
          Medical travel to {country.name}
        </h1>
        <p class="mt-3 text-white/85 text-sm md:text-base max-w-2xl">
          {hospitalCount.toLocaleString()} accredited hospitals · {doctorCount.toLocaleString()} specialists
        </p>
      </div>
    </section>

    {/* Intro */}
    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-10">
      <p class="lede max-w-3xl">
        {ctx?.intro ??
          `${country.name} is a destination for international medical care. ${hospitalCount.toLocaleString()} hospitals across ${cityCount} cities handle overseas patients.`}
      </p>
      {ctx && (
        <div class="mt-8 grid md:grid-cols-2 gap-4 max-w-4xl">
          <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">What it's known for</p>
            <p class="mt-2 text-sm text-ink-muted">{ctx.strength}</p>
          </div>
          <div class="rounded-xl border border-amber-300/60 bg-amber-50/60 dark:border-amber-700/40 dark:bg-amber-950/20 p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-amber-700 dark:text-amber-400">Before you book</p>
            <p class="mt-2 text-sm text-ink-muted">{ctx.watchOut}</p>
          </div>
        </div>
      )}
      <LastUpdated
        updated={new Date()}
        note={`Data sampled from ${hospitalCount.toLocaleString()} active hospital records.`}
      />

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-border bg-surface p-5">
          <Building2 className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{hospitalCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">Hospitals</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <Users className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{doctorCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">Specialists</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <MapPin className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{cityCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">Cities</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <Globe className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{topTreatments.length}+</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">Treatments</p>
        </div>
      </div>

      {/* Visa cross-link — high-intent companion query for any country search,
          and the medical-visa cluster's main inbound internal link. */}
      <a
        href={localizedPath(locale, `/visa/${slug}`)}
        class="mt-6 inline-flex items-center gap-2 group"
        style="font-size: 14px; color: var(--color-accent);"
      >
        <span class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em;">Planning the trip?</span>
        <span class="serif font-medium group-hover:underline">{country.name} medical visa guide</span>
        <ChevronRight className="h-3.5 w-3.5 mirror-x" />
      </a>
    </section>

    {/* Your trip in photos — 5-stage arrival → recovery preview */}
    <section class="border-t border-border">
      <TripStrip countrySlug={country.slug} countryName={country.name} />
    </section>

    {/* Safety & accreditation proof — country-specific verifiable links */}
    <section class="border-t border-border" style="background: var(--color-paper);">
      <div class="mx-auto max-w-7xl px-6 py-12 md:py-14">
        <div class="grid gap-8 lg:grid-cols-[0.45fr,1fr] lg:gap-12 items-start">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">Safety & accreditation</div>
            <h2 class="display mt-2" style="font-size: 28px; line-height: 1.05; letter-spacing: -0.02em;">
              Verify before
              <span style="font-style: italic; font-weight: 300;"> you commit</span>
            </h2>
            <p class="serif mt-3" style="font-size: 15px; line-height: 1.55; color: var(--color-ink-muted);">
              Every hospital we shortlist in {country.name} is checked against the public registers below. They're free to access — and we encourage patients to verify any quote independently before traveling.
            </p>
            <ul class="mt-5 grid gap-1.5 text-sm" style="color: var(--color-ink-muted);">
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> Active accreditation, not lapsed</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> Treating physician's license verified by name + ID</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> Re-checked quarterly · last sweep stamped on every hospital page</li>
            </ul>
          </div>
          <ul class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
            {safetyLinks.map((l) => (
              <li class="paper" style="padding: 16px 18px;">
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="group flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="serif" style="font-size: 14.5px; font-weight: 500; line-height: 1.3; color: var(--color-ink);">{l.label}</div>
                    <div class="mono uppercase mt-1" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">{l.sub}</div>
                  </div>
                  <span class="mono uppercase shrink-0 group-hover:text-accent transition-colors" style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">Open ↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* Top hospitals */}
    {hospitalsXl.length > 0 && (
      <section class="border-t border-border bg-surface-muted py-12">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-display text-2xl md:text-3xl mb-2">Top hospitals in {country.name}</h2>
          <p class="text-sm text-ink-muted mb-8">Curated by patient rating and review volume.</p>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {hospitalsXl.map((h) => (
              <li class="relative">
                <div class="absolute end-3 top-3 z-10">
                  <CompareToggle slug={h.slug} name={h.name} />
                </div>
                <a
                  href={localizedPath(locale, `/hospital/${h.slug}`)}
                  class="group flex flex-col h-full rounded-xl border border-border bg-surface overflow-hidden transition hover:border-border-strong hover:shadow-sm"
                >
                  <div class="relative">
                    <img
                      src={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: country.slug })}
                      alt={h.name}
                      class="h-40 w-full object-cover"
                      loading="lazy"
                    />
                    <div class="image-veil" />
                  </div>
                  <div class="p-5 flex-1">
                    <p class="font-display text-lg text-ink group-hover:text-accent transition-colors">
                      {h.name}
                    </p>
                    <p class="mt-1 text-xs text-ink-subtle flex items-center gap-1.5">
                      <MapPin className="h-3 w-3" />
                      {h.cityName}
                    </p>
                    {h.description && (
                      <p class="mt-3 text-sm text-ink-muted line-clamp-3">{h.description}</p>
                    )}
                    {h.rating && Number(h.rating) > 0 && (
                      <p class="mt-3 text-xs text-ink-muted">
                        <span class="text-gold-500">★</span> {Number(h.rating).toFixed(1)}
                        {h.reviewCount ? ` · ${h.reviewCount} reviews` : ""}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a
              href={localizedPath(locale, `/hospitals?country=${country.slug}`)}
              class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-hover"
            >
              See all {hospitalCount.toLocaleString()} hospitals in {country.name}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Inline mid-content lead capture */}
    <section class="border-t border-border" style="background: var(--color-paper);">
      <div class="mx-auto max-w-7xl px-6 py-12 md:py-14">
        <div class="paper" style="padding: 28px 28px 26px; display: grid; gap: 24px; grid-template-columns: 1fr; align-items: center; border-left: 3px solid var(--color-accent);">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
              Free quote · {country.name}
            </div>
            <h2 class="display mt-2" style="font-size: clamp(1.6rem, 3.5vw, 2rem); line-height: 1.1; letter-spacing: -0.02em;">
              Three itemised quotes from {country.name},
              <span style="font-style: italic; font-weight: 300;"> in 48 hours.</span>
            </h2>
            <p class="serif mt-3" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink-muted); max-width: 560px;">
              Send a one-line description plus your reports. A named case manager replies in ~9 minutes during working hours and lines up surgeon options before you commit.
            </p>
            <ul class="mt-4 grid gap-1.5 text-sm" style="color: var(--color-ink-muted);">
              <li class="flex items-center gap-2"><span style="color: var(--color-accent);">✓</span> No payment until you're sitting with the surgeon</li>
              <li class="flex items-center gap-2"><span style="color: var(--color-accent);">✓</span> Visa, attendant + airport pickup arranged</li>
              <li class="flex items-center gap-2"><span style="color: var(--color-accent);">✓</span> Walk away anytime — your file is your file</li>
            </ul>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={localizedPath(locale, `/contact?country=${country.slug}`)}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-ink); color: var(--color-bg); padding: 13px 22px; border-radius: 9999px; font-size: 14.5px;"
            >
              Get free quote
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, "/second-opinion")}
              class="inline-flex items-center gap-2"
              style="background: transparent; color: var(--color-ink); border: 1px solid var(--color-ink); padding: 13px 22px; border-radius: 9999px; font-size: 14.5px; font-weight: 500;"
            >
              Free 2nd opinion
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Surgeons-by-specialty deep links — cross-mesh */}
    {treatmentsXl.length > 0 && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-display text-2xl md:text-3xl mb-2">Surgeons in {country.name} by specialty</h2>
          <p class="text-sm text-ink-muted mb-8">Ranked by volume and years in practice — auto-populated from active hospital rosters.</p>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {Array.from(
              new Map(
                treatmentsXl
                  .filter((t) => t.specialty_slug && t.specialty)
                  .map((t) => [t.specialty_slug, { slug: t.specialty_slug, name: t.specialty }]),
              ).values(),
            )
              .slice(0, 9)
              .map((s) => (
                <li>
                  <a
                    href={localizedPath(locale, `/surgeons/${s.slug}/${country.slug}`)}
                    class="group flex items-center justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                  >
                    <span class="min-w-0">
                      <span class="mono uppercase block" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                        Surgeons
                      </span>
                      <span class="mt-1 block font-medium text-ink group-hover:text-accent">{s.name} · {country.name}</span>
                    </span>
                    <ChevronRight className="h-4 w-4 text-ink-subtle mirror-x shrink-0" />
                  </a>
                </li>
              ))}
          </ul>
        </div>
      </section>
    )}

    {/* Popular treatments with pricing */}
    {treatmentsXl.length > 0 && (
      <section class="border-t border-border py-12">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-display text-2xl md:text-3xl mb-2">Popular treatments in {country.name}</h2>
          <p class="text-sm text-ink-muted mb-8">Price ranges across active hospital partners.</p>
          <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">
            {treatmentsXl.map((t) => (
              <li>
                <a
                  href={localizedPath(locale, `/treatment/${t.slug}/${country.slug}`)}
                  class="group flex items-center justify-between gap-4 rounded-lg border border-border bg-surface p-4 transition hover:border-border-strong"
                >
                  <div class="min-w-0">
                    <p class="font-medium text-ink group-hover:text-accent transition-colors truncate">
                      {t.name}
                    </p>
                    {t.specialty && (
                      <p class="text-xs text-ink-subtle mt-0.5">{t.specialty}</p>
                    )}
                    <p class="text-xs text-ink-subtle mt-0.5">{t.hospital_count} hospitals</p>
                  </div>
                  {t.lo && (
                    <p class="font-display text-base text-ink shrink-0">
                      <PriceRange min={t.lo} max={t.hi} />
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Cities */}
    {cityList.length > 0 && (
      <section class="border-t border-border bg-surface-muted py-12">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-display text-2xl md:text-3xl mb-8">Cities in {country.name}</h2>
          <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
            {cityList.map((c) => (
              <li>
                <a
                  href={localizedPath(locale, `/city/${c.slug}`)}
                  class="group flex items-center justify-between rounded-lg border border-border bg-surface p-3 transition hover:border-border-strong"
                >
                  <div class="min-w-0">
                    <p class="font-medium text-ink group-hover:text-accent transition-colors truncate">
                      {c.name}
                    </p>
                    <p class="text-xs text-ink-subtle mt-0.5">{c.hospital_count} hospitals</p>
                  </div>
                  <ChevronRight className="h-4 w-4 text-ink-subtle shrink-0 mirror-x" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* FAQ */}
    {faqRows.length > 0 && (
      <section style="padding: 56px 28px; border-top: 1px solid var(--color-border);">
        <div class="mx-auto max-w-[1120px] grid gap-10 lg:grid-cols-[0.35fr,1fr]">
          <div>
            <div class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);">FAQ</div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
              Common questions about {country.name}
            </h2>
          </div>
          <div class="divide-y" style="border-color: var(--color-border-soft);">
            {faqRows.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer items-start justify-between gap-6">
                  <span class="serif" style="font-size: 17px; font-weight: 500; line-height: 1.4;">{f.question}</span>
                  <span class="mt-1 shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;" aria-hidden="true">+</span>
                </summary>
                <p class="serif mt-3" style="color: var(--color-ink-muted); font-size: 15.5px; line-height: 1.6;">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* CTA */}
    <section class="border-t border-border py-14">
      <div class="mx-auto max-w-7xl px-6">
        <div class="rounded-2xl border border-border bg-surface p-8 md:p-10 grid gap-6 md:grid-cols-[1fr,auto] md:items-center">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-ink-subtle">Considering {country.name}?</p>
            <h2 class="mt-2 font-display text-2xl md:text-3xl leading-tight">
              Compare {country.name} hospitals on price and surgeon volume
            </h2>
            <p class="mt-3 text-ink-muted leading-relaxed max-w-2xl">
              Send us your case — imaging, current plan, treatment needed. We'll shortlist 3 hospitals with transparent pricing and tell you honestly which is the best fit. No obligation to travel.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href={localizedPath(locale, `/contact?country=${country.slug}`)}
              class="inline-flex items-center gap-2 rounded-lg bg-accent text-accent-contrast font-semibold px-5 py-3 hover:bg-accent-hover transition-colors"
            >
              Request quotes
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, "/second-opinion")}
              class="inline-flex items-center gap-2 rounded-lg border border-border-strong text-ink font-semibold px-5 py-3 hover:bg-surface-muted transition-colors"
            >
              Second opinion
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-6 pb-10">
      <LastUpdated
        updated="2026-04-20"
        note="Hospital counts and pricing ranges updated monthly from our partner network."
      />
    </div>

    {/* Travel + recovery context */}
    <TravelLogisticsSection
      countryName={country.name}
      countrySlug={country.slug}
    />

    {/* Deep destination logistics from content_sections */}
    {countrySections && (
      <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            Practical destination guide
          </div>
          <h2 class="display mb-10" style="font-size: 32px; letter-spacing: -0.02em;">
            Travelling to <span style="font-style: italic;">{country.name}</span> for treatment
          </h2>

          <div class="grid gap-6 md:grid-cols-2">
            {countrySections.bestMonthsToTravel && (
              <div class="paper" style="padding: 24px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  Best months
                </div>
                {countrySections.bestMonthsToTravel.peak && (
                  <p class="mb-2" style="font-size: 15px;"><strong>Peak:</strong> {countrySections.bestMonthsToTravel.peak.join(", ")}</p>
                )}
                {countrySections.bestMonthsToTravel.avoid && countrySections.bestMonthsToTravel.avoid.length > 0 && (
                  <p class="mb-2" style="font-size: 15px;"><strong>Avoid:</strong> {countrySections.bestMonthsToTravel.avoid.join(", ")}</p>
                )}
                {countrySections.bestMonthsToTravel.notes && (
                  <p style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">{countrySections.bestMonthsToTravel.notes}</p>
                )}
              </div>
            )}

            {countrySections.paymentLogistics && (
              <div class="paper" style="padding: 24px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  Payment logistics
                </div>
                {countrySections.paymentLogistics.currency && (
                  <p class="mb-1.5" style="font-size: 14.5px;"><strong>Currency:</strong> {countrySections.paymentLogistics.currency}</p>
                )}
                {countrySections.paymentLogistics.exchange && (
                  <p class="mb-1.5" style="font-size: 14.5px; line-height: 1.5;">{countrySections.paymentLogistics.exchange}</p>
                )}
                {countrySections.paymentLogistics.deposits && (
                  <p class="mb-1.5" style="font-size: 14.5px; line-height: 1.5;"><strong>Deposits:</strong> {countrySections.paymentLogistics.deposits}</p>
                )}
                {countrySections.paymentLogistics.notes && (
                  <p style="font-size: 13.5px; line-height: 1.5; color: var(--color-ink-muted);">{countrySections.paymentLogistics.notes}</p>
                )}
              </div>
            )}

            {countrySections.attendantLogistics && (
              <div class="paper" style="padding: 24px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  Visa + attendant
                </div>
                {countrySections.attendantLogistics.visa && (
                  <p class="mb-2" style="font-size: 14.5px; line-height: 1.5;"><strong>Visa:</strong> {countrySections.attendantLogistics.visa}</p>
                )}
                {countrySections.attendantLogistics.accommodation && (
                  <p class="mb-2" style="font-size: 14.5px; line-height: 1.5;"><strong>Accommodation:</strong> {countrySections.attendantLogistics.accommodation}</p>
                )}
                {countrySections.attendantLogistics.roomingIn && (
                  <p style="font-size: 14.5px; line-height: 1.5;"><strong>Rooming-in:</strong> {countrySections.attendantLogistics.roomingIn}</p>
                )}
              </div>
            )}

            {countrySections.airportTransit && (
              <div class="paper" style="padding: 24px;">
                <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                  Airport + transit
                </div>
                {countrySections.airportTransit.majorAirports && (
                  <p class="mb-2" style="font-size: 14.5px; line-height: 1.5;"><strong>Airports:</strong> {countrySections.airportTransit.majorAirports}</p>
                )}
                {countrySections.airportTransit.hospitalTransfer && (
                  <p class="mb-2" style="font-size: 14.5px; line-height: 1.5;">{countrySections.airportTransit.hospitalTransfer}</p>
                )}
                {countrySections.airportTransit.averageTransitTime && (
                  <p style="font-size: 14.5px; line-height: 1.5;"><strong>Transit:</strong> {countrySections.airportTransit.averageTransitTime}</p>
                )}
              </div>
            )}
          </div>

          {countrySections.whatToPack && countrySections.whatToPack.length > 0 && (
            <div class="mt-8">
              <h3 class="display mb-4" style="font-size: 22px;">What to pack</h3>
              <ul class="grid gap-2 md:grid-cols-2">
                {countrySections.whatToPack.map((item) => (
                  <li class="flex gap-2.5" style="font-size: 14.5px; line-height: 1.5;">
                    <span style="color: var(--color-accent);">→</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {countrySections.afterYouFly && (
            <div class="mt-8 paper" style="padding: 24px;">
              <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 10px;">
                After you fly home
              </div>
              {countrySections.afterYouFly.followUp && <p class="mb-2" style="font-size: 14.5px; line-height: 1.55;"><strong>Follow-up:</strong> {countrySections.afterYouFly.followUp}</p>}
              {countrySections.afterYouFly.medications && <p class="mb-2" style="font-size: 14.5px; line-height: 1.55;"><strong>Medications:</strong> {countrySections.afterYouFly.medications}</p>}
              {countrySections.afterYouFly.homeCoordination && <p style="font-size: 14.5px; line-height: 1.55;"><strong>Home coordination:</strong> {countrySections.afterYouFly.homeCoordination}</p>}
            </div>
          )}

          {countrySections.emergencyInfo && (
            <div class="mt-6" style="padding: 20px 24px; border: 1px solid var(--color-border-soft); border-inline-start: 3px solid var(--color-coral, var(--color-coral)); background: white;">
              <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-coral, var(--color-coral)); margin-bottom: 8px;">
                Emergency info
              </div>
              {countrySections.emergencyInfo.nationalEmergency && <p style="font-size: 14.5px;"><strong>National emergency:</strong> {countrySections.emergencyInfo.nationalEmergency}</p>}
              {countrySections.emergencyInfo.ambulance && <p style="font-size: 14.5px;"><strong>Ambulance:</strong> {countrySections.emergencyInfo.ambulance}</p>}
              {countrySections.emergencyInfo.keyHospitals && <p class="mt-2" style="font-size: 14px; line-height: 1.5;">{countrySections.emergencyInfo.keyHospitals}</p>}
            </div>
          )}
        </div>
      </section>
    )}

    {/* EEAT signals */}
    <MethodologyBlock locale={locale}
      curationNote={`This ${country.name} destination overview is rebuilt from our active partner network of accredited hospitals in the country, plus government regulatory data and verified flight-connectivity research. Surgeon credentials, hospital accreditation, and pricing ranges are refreshed quarterly.`}
      dataSources={[
        `${country.name} ministry of health licensing register`,
        "JCI accreditation registry",
        "International airport authority data",
        "Hospital itemised quote sheets",
      ]}
    />

    <SiteFooter locale={locale} />
    <EngagementFab locale={locale} />
    <MobileQuoteBar
      locale={locale}
      label={`Care in ${country.name}`}
      sublabel="Hospitals · surgeons · visa help"
      whatsapp={{
        page: "country",
        slug,
        countryName: country.name,
      }}
    />
  </main>
</BaseLayout>
