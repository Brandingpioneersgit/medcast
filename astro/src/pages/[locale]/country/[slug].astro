---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Price from "@/components/Price.astro";
import PriceRange from "@/components/PriceRange.astro";
import { getCountryBySlug, listFaqsFor, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import { getCountrySections } from "@/lib/content-sections";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, touristDestinationJsonLd, faqJsonLd, withProvenance } from "@/lib/seo";
import { hospitalCover, countryBanner, patientHero, regionForCountry, journeyScene, heroImage } from "@/lib/images";
import { pageImageFor } from "@/lib/page-images";
import TripStrip from "@/components/TripStrip.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import CompareToggle from "@/components/CompareToggle.astro";
import TravelLogisticsSection from "@/components/content/TravelLogisticsSection.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import { ChevronRight, MapPin, Building2, Users, Globe } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/country/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const [data, heroOverride, linkables] = await Promise.all([
  getCountryBySlug(slug),
  pageImageFor("country", slug, "hero"),
  listLinkableEntities().catch(() => [] as Awaited<ReturnType<typeof listLinkableEntities>>),
]);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const tCdt = getTranslator(locale, "countryDetailPage");

const rawData = data;
const [countryMap, faqRows, countryContentRow, hospitalMap, treatmentMap] = await Promise.all([
  getContent("country", rawData.country.id, locale),
  listFaqsFor("country", rawData.country.id),
  getCountrySections(rawData.country.id),
  getContentBatch("hospital", rawData.topHospitals.map((h) => h.id), locale),
  getContentBatch("treatment", rawData.topTreatments.map((t) => t.id), locale),
]);
const country = applyTranslated(rawData.country, countryMap, ["name"]);
// Wave 2.14 — body sections come from translations table; EN fallback below.
const introTr = countryMap.intro ?? null;
const strengthTr = countryMap.strength ?? null;
const watchOutTr = countryMap.watchOut ?? null;

function linkifyText(s: string | null | undefined): string {
  if (!s) return "";
  const safe = s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return linkifyBlogHtml(`<p>${safe}</p>`, linkables, (p: string) => localizedPath(locale, p)).html;
}
const { hospitalCount, doctorCount, cityCount, topHospitals, topTreatments, cityList } = rawData;
const untranslated = isUntranslated(locale, countryMap);

const faqSchema = faqRows.length > 0 ? faqJsonLd(faqRows) : null;
const countrySections = countryContentRow?.content_sections ?? null;

// Country-keyed safety + accreditation registry deep-links. Public registers; we
// re-check ours quarterly. Patients can verify any hospital independently.
type SafetyLink = { label: string; sub: string; url: string };
const SAFETY_REGISTRIES: Record<string, SafetyLink[]> = {
  india: [
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "NABH accredited hospital list", sub: "National Accreditation Board for Hospitals", url: "https://nabh.co/AccreditedHospital.aspx" },
    { label: "National Medical Commission registry", sub: "Verify any treating doctor's license", url: "https://www.nmc.org.in/information-desk/indian-medical-register/" },
  ],
  turkey: [
    { label: "USHAS-licensed facilities", sub: "Turkey's official medical-tourism authority", url: "https://www.ushas.com.tr/en/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Ministry of Health doctor lookup", sub: "Verify physician licensing", url: "https://saglikbakanligi.gov.tr/" },
  ],
  thailand: [
    { label: "HA Thailand accredited list", sub: "The Healthcare Accreditation Institute", url: "https://www.ha.or.th/EN" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Thailand Medical Council", sub: "Doctor licensing register", url: "https://www.tmc.or.th/index_en.php" },
  ],
  uae: [
    { label: "DHA Sheryan facility lookup", sub: "Dubai Health Authority licensed providers", url: "https://services.dha.gov.ae/sheryan/wps/portal/home/individual-search" },
    { label: "DOH Abu Dhabi facility register", sub: "Department of Health Abu Dhabi", url: "https://services.doh.gov.ae/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  germany: [
    { label: "KTQ certified facilities", sub: "Germany's hospital quality body", url: "https://www.ktq.de/en/ktq-certificate/zertifizierte-einrichtungen.html" },
    { label: "Bundesarztekammer doctor lookup", sub: "Federal Medical Association", url: "https://www.bundesaerztekammer.de/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  singapore: [
    { label: "Singapore Medical Council registry", sub: "Verify doctor licensing", url: "https://www.smc.gov.sg/check-a-doctors-registration" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "MOH licensed facilities", sub: "Ministry of Health Singapore", url: "https://hcidirectory.sg/hcidirectory/" },
  ],
  "south-korea": [
    { label: "KOIHA accredited list", sub: "Korean Institute for Healthcare Accreditation", url: "https://www.koiha.or.kr/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
    { label: "Visit Medical Korea registry", sub: "Government-registered medical-tourism providers", url: "https://english.visitmedicalkorea.com/" },
  ],
  malaysia: [
    { label: "MSQH accreditation list", sub: "Malaysian Society for Quality in Health", url: "https://www.msqh.com.my/" },
    { label: "Malaysia Medical Council registry", sub: "Verify doctor licensing", url: "https://mmc.gov.my/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
  "saudi-arabia": [
    { label: "CBAHI accreditation register", sub: "Saudi Central Board for Accreditation", url: "https://portal.cbahi.gov.sa/" },
    { label: "Saudi Commission for Health Specialties", sub: "Doctor licensing register", url: "https://www.scfhs.org.sa/en/" },
    { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
  ],
};
const safetyLinks: SafetyLink[] = SAFETY_REGISTRIES[country.slug] ?? [
  { label: "JCI accredited hospitals", sub: "Joint Commission International registry", url: "https://www.jointcommissioninternational.org/who-we-are/accredited-organizations/" },
];

const hospitalsXl = topHospitals.map((h) => applyTranslated(h, hospitalMap[h.id] ?? {}, ["name", "description"]));
const treatmentsXl = topTreatments.map((t) => applyTranslated(t, treatmentMap[t.id] ?? {}, ["name"]));

// Local-SEO title: "Best Hospitals in {Country} for International Patients
// ({year})". Highest-volume local intent + fresh-year hint. Drops the
// generic "Medical Travel to" framing that doesn't match user search.
const countryYear = new Date().getFullYear();
const seoTitle = `Best Hospitals in ${country.name} for International Patients (${countryYear})`;

const lowPrice = topTreatments[0]?.lo
  ? `from $${Math.round(Number(topTreatments[0].lo)).toLocaleString()}`
  : "";
const topCountrySpecialty = (topTreatments[0] as { specialty?: string | null } | undefined)?.specialty ?? null;
const seoDescription = (
  topCountrySpecialty
    ? `Compare ${hospitalCount.toLocaleString()} accredited hospitals + ${doctorCount.toLocaleString()} specialists in ${country.name}. ${topCountrySpecialty} ${lowPrice}. JCI/NABH-credentialed. Free quote in 11 min.`
    : `Compare ${hospitalCount.toLocaleString()} accredited hospitals + ${doctorCount.toLocaleString()} specialists in ${country.name}. Treatment packages ${lowPrice}. JCI/NABH-credentialed. Free quote in 11 min.`
).slice(0, 160);

// Country-specific copy — concrete local detail beats AI-generated blandness.
const COUNTRY_INTRO: Record<string, { intro: string; strength: string; watchOut: string }> = {
  india: {
    intro: `India handles high volumes of overseas cardiac, orthopedic, and oncology cases, with a heavy concentration around Delhi-NCR, Chennai, Mumbai and Bangalore. Prices are among the lowest for tertiary-care work worldwide.`,
    strength: `Strong in: CABG, joint replacement, liver transplants, bone-marrow work, IVF, hair restoration.`,
    watchOut: `Plan around monsoon (Jun-Sep in most cities) if mobility is a factor post-op, and confirm FRRO registration before any stay beyond 180 days.`,
  },
  thailand: {
    intro: `Thailand has been absorbing medical tourists for three decades — the market is mature, English-speaking at the major private hospitals, and the JCI network is dense.`,
    strength: `Strong in: cosmetic surgery, gender-affirming care, IVF with donor options, dental, orthopedics.`,
    watchOut: `Monsoon season (May-Oct) + heat make long recovery windows uncomfortable. Cosmetic-only visas max out at 30 days; longer surgical programmes need the Non-Immigrant MT visa.`,
  },
  turkey: {
    intro: `Turkey's grown fast as a destination for European and Gulf patients — mostly via Istanbul and Antalya. Private hospital pricing sits between Thailand and Germany.`,
    strength: `Strong in: hair transplants, bariatric surgery, dental implants, eye surgery, oncology.`,
    watchOut: `Aesthetic clinics vary wildly in quality. Only book facilities licensed by the Ministry of Health (USHAŞ-affiliated) and verify the physician's board certification, not just the "clinic" name.`,
  },
  germany: {
    intro: `Germany is where complex oncology and neurosurgery cases tend to go when budget isn't the constraint. University hospitals lead; private clinics are comparatively rare.`,
    strength: `Strong in: oncology, neurosurgery, transplants, paediatric tertiary care, rare-disease workups.`,
    watchOut: `German hospitals typically require upfront payment (Vorkasse) before visa issuance. Document turnaround from the embassy is 10-15 business days and can stretch around holiday windows.`,
  },
  "south-korea": {
    intro: `South Korea is a premium-tier Asian option, concentrated in Seoul. Strongest reputation for cosmetic and dermatological work, though oncology centres at Asan and Samsung also draw international referrals.`,
    strength: `Strong in: cosmetic/plastic surgery, dental, cancer surgery, stem-cell therapy research.`,
    watchOut: `Cosmetic clinics in Gangnam operate at scale — many outsource anaesthesia and post-op. Ask specifically who's holding the scalpel and where recovery nursing happens.`,
  },
  malaysia: {
    intro: `Malaysia is a cost-competitive Asian destination coordinated through the Malaysia Healthcare Travel Council. Kuala Lumpur and Penang take most international arrivals.`,
    strength: `Strong in: cardiology, fertility, oncology, health screening.`,
    watchOut: `The MHTC-approved hospital list is narrower than the total hospital count — stick to it for predictable pricing and paperwork.`,
  },
  singapore: {
    intro: `Singapore handles the most complex referrals out of South-East Asia, at a corresponding price point. Best fit for second opinions, rare-disease diagnostics, and transplants.`,
    strength: `Strong in: oncology, transplants, paediatric tertiary care, clinical genetics.`,
    watchOut: `Pricing runs 2-3x regional peers. If you're budget-sensitive, use Singapore for the diagnostic workup and travel elsewhere for the procedure itself.`,
  },
  uae: {
    intro: `The UAE — mostly Dubai and Abu Dhabi — has invested hard in tertiary healthcare over the last decade. Cleveland Clinic Abu Dhabi and Mediclinic are the usual referral points for regional patients.`,
    strength: `Strong in: cardiac surgery, fertility (with donor programmes), cosmetic, oncology.`,
    watchOut: `Medical-licensing frameworks differ between emirates (DHA, MOHAP, DOH) — confirm the physician is licensed in the specific emirate where your procedure takes place.`,
  },
  "saudi-arabia": {
    intro: `Saudi Arabia is the newest entrant in Gulf medical travel. Major volume concentrates in Riyadh and Jeddah; Vision 2030 has accelerated hospital investment.`,
    strength: `Strong in: cardiac surgery, urology, gynaecology, transplants within the GCC network.`,
    watchOut: `English-language paperwork isn't always standard — assume you'll need an Arabic translator for non-clinical admin.`,
  },
};

// Wave 2.14 — prefer translation rows; fall back to inline EN dict (or undefined).
const enCtx = COUNTRY_INTRO[country.slug];
const ctx = (introTr || strengthTr || watchOutTr || enCtx)
  ? {
      intro: introTr ?? enCtx?.intro ?? "",
      strength: strengthTr ?? enCtx?.strength ?? "",
      watchOut: watchOutTr ?? enCtx?.watchOut ?? "",
    }
  : undefined;

const path = `/country/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tCdt("breadcrumbDestinations"), url: localeUrl(locale, "/countries") },
  { name: country.name, url },
]);

const itemLd = hospitalsXl.length > 0
  ? itemListJsonLd(
      hospitalsXl.map((h) => ({
        name: h.name,
        url: localeUrl(locale, `/hospital/${h.slug}`),
      })),
    )
  : null;

const destinationLd = withProvenance(
  touristDestinationJsonLd({
    name: country.name,
    description: ctx?.intro ?? seoDescription,
    url,
    countryCode: country.isoCode ?? null,
    includesAttraction: hospitalsXl.slice(0, 6).map((h) => ({
      name: h.name,
      url: localeUrl(locale, `/hospital/${h.slug}`),
    })),
  }),
  {
    dateModified: rawData.country.updatedAt,
    dateCreated: rawData.country.createdAt,
    reviewer: null,
  },
);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(destinationLd)} />
    {itemLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/countries")} class="hover:text-accent">{tCdt("breadcrumbDestinations")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{country.name}</span>
      </div>
    </nav>

    {/* Hero banner */}
    <section class="relative overflow-hidden" style="height: 360px;">
      <img
        src={countryBanner(country.slug, 1600, 720, heroOverride?.url)}
        alt={heroOverride?.altText ?? `${country.name} ${tCdt("heroImgAltSuffix")}`}
        width="1600"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          linear-gradient(180deg, rgba(14,23,19,0) 30%, rgba(14,23,19,0.45) 75%, rgba(14,23,19,0.78) 100%),
          linear-gradient(110deg, rgba(10,93,84,0.18) 0%, rgba(10,93,84,0) 55%);"
        aria-hidden="true"
      />
      <div class="relative mx-auto max-w-7xl px-6 h-full flex flex-col justify-end pb-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">
          {tCdt("heroEyebrow")}
        </p>
        <h1 class="mt-2 font-display text-3xl md:text-5xl leading-[1.05] text-white">
          {tCdt("heroHeading").replace("{country}", country.name)}
        </h1>
        <p class="mt-3 text-white/85 text-sm md:text-base max-w-2xl">
          {hospitalCount.toLocaleString()} {tCdt("heroStatHospitals")} · {doctorCount.toLocaleString()} {tCdt("heroStatSpecialists")}
        </p>
      </div>
    </section>

    {/* Intro */}
    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-10">
      <div class="lede max-w-3xl" set:html={ctx?.intro
          ? linkifyText(ctx.intro)
          : `<p>${tCdt("introFallback").replace("{country}", country.name).replace("{hospitalCount}", hospitalCount.toLocaleString()).replace("{cityCount}", String(cityCount))}</p>`} />
      {ctx && (
        <div class="mt-8 grid md:grid-cols-2 gap-4 max-w-4xl">
          <div class="rounded-xl border border-border bg-surface p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent">{tCdt("knownForEyebrow")}</p>
            <div class="mt-2 text-sm text-ink-muted" set:html={linkifyText(ctx.strength)} />
          </div>
          <div class="rounded-xl border border-amber-300/60 bg-amber-50/60 dark:border-amber-700/40 dark:bg-amber-950/20 p-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-amber-700 dark:text-amber-400">{tCdt("beforeYouBook")}</p>
            <div class="mt-2 text-sm text-ink-muted" set:html={linkifyText(ctx.watchOut)} />
          </div>
        </div>
      )}
      <LastUpdated
        updated={new Date()}
        note={tCdt("introLastUpdatedNote").replace("{hospitalCount}", hospitalCount.toLocaleString())}
      />

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-border bg-surface p-5">
          <Building2 className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{hospitalCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">{tCdt("statHospitals")}</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <Users className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{doctorCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">{tCdt("statSpecialists")}</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <MapPin className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{cityCount.toLocaleString()}</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">{tCdt("statCities")}</p>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <Globe className="h-5 w-5 text-accent" />
          <p class="mt-3 font-display text-2xl">{topTreatments.length}+</p>
          <p class="text-xs text-ink-subtle uppercase tracking-wider">{tCdt("statTreatments")}</p>
        </div>
      </div>

      {/* Visa cross-link — high-intent companion query for any country search,
          and the medical-visa cluster's main inbound internal link. */}
      <a
        href={localizedPath(locale, `/visa/${slug}`)}
        class="mt-6 inline-flex items-center gap-2 group"
        style="font-size: 14px; color: var(--color-accent);"
      >
        <span class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em;">{tCdt("visaLinkEyebrow")}</span>
        <span class="serif font-medium group-hover:underline">{tCdt("visaLinkText").replace("{country}", country.name)}</span>
        <ChevronRight className="h-3.5 w-3.5 mirror-x" />
      </a>
    </section>

    {/* Patients we route to this destination — origin photos */}
    <section class="border-t border-border" style="background: var(--color-paper);">
      <div class="mx-auto max-w-7xl px-6 py-12 md:py-14">
        <div class="mono uppercase mb-6" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
          {tCdt("whoTravelsEyebrow").replace("{country}", country.name)}
        </div>
        <ul class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
          {[
            { region: "africa" as const, label: tCdt("originAfricaLabel"), origins: tCdt("originAfricaOrigins") },
            { region: "middle_east" as const, label: tCdt("originMiddleEastLabel"), origins: tCdt("originMiddleEastOrigins") },
            { region: "cis" as const, label: tCdt("originCisLabel"), origins: tCdt("originCisOrigins") },
            { region: "south_asia" as const, label: tCdt("originSouthAsiaLabel"), origins: tCdt("originSouthAsiaOrigins") },
          ].map((p, i) => (
            <li class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
              <img
                src={patientHero(`${slug}-${p.region}-${i}`, p.region, 480)}
                alt={tCdt("originImgAlt").replace("{region}", p.label).replace("{country}", country.name)}
                width="480"
                height="600"
                loading="lazy"
                decoding="async"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
              <div class="image-veil-strong" />
              <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 14px; inset-inline-end: 14px;">
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">{p.origins}</div>
                <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">{p.label}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Your trip in photos — 5-stage arrival → recovery preview */}
    <section class="border-t border-border">
      <TripStrip countrySlug={country.slug} countryName={country.name} />
    </section>

    {/* Safety & accreditation proof — country-specific verifiable links */}
    <section class="border-t border-border" style="background: var(--color-paper);">
      <div class="mx-auto max-w-7xl px-6 py-12 md:py-14">
        <div class="grid gap-8 lg:grid-cols-[0.45fr_1fr] lg:gap-12 items-start">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tCdt("safetyEyebrow")}</div>
            <h2 class="display mt-2" style="font-size: 28px; line-height: 1.05; letter-spacing: -0.02em;">
              {tCdt("safetyHeading")}
              <span style="font-style: italic; font-weight: 300;"> {tCdt("safetyHeadingItalic")}</span>
            </h2>
            <p class="serif mt-3" style="font-size: 15px; line-height: 1.55; color: var(--color-ink-muted);">
              {tCdt("safetyBody").replace("{country}", country.name)}
            </p>
            <ul class="mt-5 grid gap-1.5 text-sm" style="color: var(--color-ink-muted);">
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tCdt("safetyCheck1")}</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tCdt("safetyCheck2")}</li>
              <li class="flex gap-2"><span style="color: var(--color-accent);">→</span> {tCdt("safetyCheck3")}</li>
            </ul>
          </div>
          <ul class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
            {safetyLinks.map((l) => (
              <li class="paper" style="padding: 16px 18px;">
