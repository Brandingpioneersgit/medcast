---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { getTranslator } from "@/lib/messages";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/emergency-triage", 308);
const locale = rawLocale as Locale;

const tc = getTranslator(locale, "common");
const tEt = getTranslator(locale, "emergencyTriagePage");

Astro.response.headers.set("Cache-Control", "public, s-maxage=86400, stale-while-revalidate=604800");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tEt("seoTitle")}
      description={tEt("seoDescription")}
      path="/emergency-triage"
      locale={locale}
      noindex={true}
    />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto max-w-[1440px] px-7 md:px-10 py-4">
        <nav class="mono text-[12px] flex items-center gap-2 flex-wrap" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span aria-hidden="true" class="text-[var(--color-border-strong)]">/</span>
          <span style="color: var(--color-ink);">{tEt("breadcrumbCurrent")}</span>
        </nav>
      </div>
    </div>

    <section class="mx-auto w-full max-w-[80rem] px-5 md:px-8 py-12">
      <div class="mb-8">
        <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-coral);">{tEt("eyebrowEmergency")}</p>
        <h1 class="display mt-2" style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;">
          {tEt("headingPart1")} <span class="italic-display">{tEt("headingPart2")}</span>
        </h1>
        <p class="serif mt-3 max-w-[48rem]" style="font-size: 17px; line-height: 1.55; color: var(--color-ink-muted);">
          {tEt("introPara")}
        </p>

        {/* YMYL disclaimer — informational, not medical advice. */}
        <div
          role="note"
          class="mt-5"
          style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 14px 18px; max-width: 720px;"
        >
          <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-coral); margin-bottom: 6px;">
            {tEt("disclaimerEyebrow")}
          </p>
          <p class="serif" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
            {tEt("disclaimerBody")}
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {/* GREEN — Routine */}
        <div class="paper p-6" style="border-top: 4px solid var(--color-success);">
          <div class="display tnum mb-2" style="font-size: 48px; color: var(--color-success); line-height: 1;">✓</div>
          <h2 class="serif mb-2" style="font-size: 22px; color: var(--color-success);">{tEt("greenTitle")}</h2>
          <p class="text-sm mb-4" style="color: var(--color-ink-muted);">{tEt("greenDesc")}</p>
          <ul class="space-y-2 text-sm" style="color: var(--color-ink-muted);">
            <li>{tEt("greenItem1")}</li>
            <li>{tEt("greenItem2")}</li>
            <li>{tEt("greenItem3")}</li>
            <li>{tEt("greenItem4")}</li>
            <li>{tEt("greenItem5")}</li>
          </ul>
        </div>

        {/* YELLOW — Contact coordinator */}
        <div class="paper p-6" style="border-top: 4px solid var(--color-saffron);">
          <div class="display tnum mb-2" style="font-size: 48px; color: var(--color-saffron); line-height: 1;">⚠</div>
          <h2 class="serif mb-2" style="font-size: 22px; color: var(--color-saffron);">{tEt("yellowTitle")}</h2>
          <p class="text-sm mb-4" style="color: var(--color-ink-muted);">{tEt("yellowDesc")}</p>
          <ul class="space-y-2 text-sm" style="color: var(--color-ink-muted);">
            <li>{tEt("yellowItem1")}</li>
            <li>{tEt("yellowItem2")}</li>
            <li>{tEt("yellowItem3")}</li>
            <li>{tEt("yellowItem4")}</li>
            <li>{tEt("yellowItem5")}</li>
            <li>{tEt("yellowItem6")}</li>
          </ul>
        </div>

        {/* RED — Emergency */}
        <div class="paper p-6" style="border-top: 4px solid var(--color-coral);">
          <div class="display tnum mb-2" style="font-size: 48px; color: var(--color-coral); line-height: 1;">✗</div>
          <h2 class="serif mb-2" style="font-size: 22px; color: var(--color-coral);">{tEt("redTitle")}</h2>
          <p class="text-sm mb-4" style="color: var(--color-ink-muted);">{tEt("redDesc")}</p>
          <ul class="space-y-2 text-sm" style="color: var(--color-ink-muted);">
            <li>{tEt("redItem1")}</li>
            <li>{tEt("redItem2")}</li>
            <li>{tEt("redItem3")}</li>
            <li>{tEt("redItem4")}</li>
            <li>{tEt("redItem5")}</li>
            <li>{tEt("redItem6")}</li>
          </ul>
        </div>
      </div>

      <div class="mt-10 paper p-6">
        <h2 class="serif mb-4" style="font-size: 22px;">{tEt("contactsSectionTitle")}</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {[
            { country: "India", emergency: "112", ambulance: "102", medcasts: "+91 800 621 000" },
            { country: "Turkey", emergency: "112", ambulance: "112", medcasts: "+90 850 222 0 666" },
            { country: "Thailand", emergency: "1669", ambulance: "1669", medcasts: "+66 800 111 222" },
            { country: "UAE", emergency: "998", ambulance: "998", medcasts: "+971 800 2000" },
            { country: "Germany", emergency: "112", ambulance: "112", medcasts: "+49 800 111 2222" },
          ].map((c) => (
            <div class="flex items-start justify-between border-b border-[var(--color-border-soft)] pb-3">
              <div>
                <span class="font-medium text-[15px]">{c.country}</span>
                <p class="text-xs mt-0.5" style="color: var(--color-ink-muted);">{tEt("contactsEmergencyLabel")} {c.emergency}{c.ambulance ? ` · ${tEt("contactsAmbulanceLabel")} ${c.ambulance}` : ""}</p>
              </div>
              <span class="mono text-[11px]" style="color: var(--color-accent);">
                MedCasts: {c.medcasts}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tEt("exploreEyebrow")}
      heading={tEt("exploreHeading")}
      lede={tEt("exploreLede")}
      items={[
        { eyebrow: tEt("exploreItem1Eyebrow"), label: tEt("exploreItem1Label"), href: "/emergency", hint: tEt("exploreItem1Hint") },
        { eyebrow: tEt("exploreItem2Eyebrow"), label: tEt("exploreItem2Label"), href: "/insurance", hint: tEt("exploreItem2Hint") },
        { eyebrow: tEt("exploreItem3Eyebrow"), label: tEt("exploreItem3Label"), href: "/surgeons/cardiac-surgery", hint: tEt("exploreItem3Hint") },
        { eyebrow: tEt("exploreItem4Eyebrow"), label: tEt("exploreItem4Label"), href: "/surgeons/neurosurgery", hint: tEt("exploreItem4Hint") },
        { eyebrow: tEt("exploreItem5Eyebrow"), label: tEt("exploreItem5Label"), href: "/specialty/oncology", hint: tEt("exploreItem5Hint") },
        { eyebrow: tEt("exploreItem6Eyebrow"), label: tEt("exploreItem6Label"), href: "/portal", hint: tEt("exploreItem6Hint") },
        { eyebrow: tEt("exploreItem7Eyebrow"), label: tEt("exploreItem7Label"), href: "/quote", hint: tEt("exploreItem7Hint") },
        { eyebrow: tEt("exploreItem8Eyebrow"), label: tEt("exploreItem8Label"), href: "/contact", hint: tEt("exploreItem8Hint") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
