---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Price from "@/components/Price.astro";
import { getSpecialtyPageData, listFaqsFor, getReviewerFor, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { getSpecialtySections } from "@/lib/content-sections";
import { formatUsd } from "@/lib/currency";
import ReviewedBy from "@/components/ReviewedBy.astro";
import SpecialtyDepth from "@/components/content/SpecialtyDepth.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import { hospitalCover, doctorPortrait, heroImage, journeyScene } from "@/lib/images";
import SpecialtyBanner from "@/components/SpecialtyBanner.astro";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
} from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, faqJsonLd, withProvenance, reviewerFromDbRow } from "@/lib/seo";
import { ChevronRight } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/specialty/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const data = await getSpecialtyPageData(slug);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const { specialty: specialtyRaw, agg, topHospitals, countryBreakdown, topDoctors } = data;

const tc = getTranslator(locale, "common");

const treatmentIds = (specialtyRaw.treatments ?? []).map((t) => t.id);

const [specialtyMap, treatmentMap, faqRows, reviewer, specialtyContentRow] = await Promise.all([
  getContent("specialty", specialtyRaw.id, locale),
  getContentBatch("treatment", treatmentIds, locale),
  listFaqsFor("specialty", specialtyRaw.id),
  getReviewerFor("specialty", specialtyRaw.id),
  getSpecialtySections(specialtyRaw.id),
]);

const specialtySections = specialtyContentRow?.content_sections ?? null;

const specialty = applyTranslated(specialtyRaw, specialtyMap, ["name", "description"]);
const specialtyTreatments = (specialtyRaw.treatments ?? []).map((t) =>
  applyTranslated(t, treatmentMap[t.id] ?? {}, ["name"]),
);
const faqSchema = faqRows.length > 0 ? faqJsonLd(faqRows) : null;

const descriptionParas = (specialty.description ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const descriptionLede = descriptionParas[0] ?? null;
const descriptionRest = descriptionParas.slice(1);

const linkables = await listLinkableEntities().catch(() => []);
const filteredLinkables = linkables.filter(
  (e) => !(e.kind === "specialty" && e.slug === specialty.slug),
);
const descriptionLedeHtml = descriptionLede
  ? linkifyBlogHtml(
      `<p>${descriptionLede.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`,
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";
const descriptionRestHtml = descriptionRest.length > 0
  ? linkifyBlogHtml(
      descriptionRest.map((p) => `<p>${p.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`).join("\n"),
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
function countryFlag(s: string): string { return FLAG_MAP[s] ?? "🌐"; }

function firstWord(s: string) { const i = s.indexOf(" "); return i === -1 ? s : s.slice(0, i); }
function restOfName(s: string) { const i = s.indexOf(" "); return i === -1 ? "" : s.slice(i + 1); }
function monogram(name: string) {
  return name.replace(/^Dr\.?\s*/i, "").split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]?.toUpperCase() ?? "").join("");
}

const aggFromFormatted = agg.from_usd ? await formatUsd(Astro.cookies, agg.from_usd) : null;

// Aggregate outcomes across all treatments under this specialty.
type RawTx = { successRatePercent?: string | number | null; hospitalStayDays?: number | null; recoveryDays?: number | null };
function avg(values: number[]): number | null {
  if (values.length === 0) return null;
  return values.reduce((a, b) => a + b, 0) / values.length;
}
const successRates = (specialtyRaw.treatments ?? [])
  .map((t: RawTx) => (t.successRatePercent != null ? Number(t.successRatePercent) : null))
  .filter((v): v is number => typeof v === "number" && Number.isFinite(v) && v > 0);
const stayDays = (specialtyRaw.treatments ?? [])
  .map((t: RawTx) => t.hospitalStayDays ?? null)
  .filter((v): v is number => typeof v === "number" && v > 0);
const recoveryDays = (specialtyRaw.treatments ?? [])
  .map((t: RawTx) => t.recoveryDays ?? null)
  .filter((v): v is number => typeof v === "number" && v > 0);
const avgSuccess = avg(successRates);
const avgStay = avg(stayDays);
const avgRecovery = avg(recoveryDays);

// Society guidelines — current edition dates verified periodically by editorial.
type Guideline = { name: string; acronym: string; edition: string; url: string };
const SOCIETY_GUIDELINES: Record<string, Guideline[]> = {
  "cardiac-surgery": [
    { name: "American Heart Association / American College of Cardiology", acronym: "AHA / ACC", edition: "2024 guidelines", url: "https://www.acc.org/Guidelines" },
    { name: "European Society of Cardiology", acronym: "ESC", edition: "2024 guidelines", url: "https://www.escardio.org/Guidelines" },
  ],
  "cardiology": [
    { name: "American Heart Association / American College of Cardiology", acronym: "AHA / ACC", edition: "2024 guidelines", url: "https://www.acc.org/Guidelines" },
    { name: "European Society of Cardiology", acronym: "ESC", edition: "2024 guidelines", url: "https://www.escardio.org/Guidelines" },
  ],
  "oncology": [
    { name: "European Society for Medical Oncology", acronym: "ESMO", edition: "Clinical Practice Guidelines", url: "https://www.esmo.org/guidelines" },
    { name: "National Comprehensive Cancer Network", acronym: "NCCN", edition: "Clinical Practice Guidelines", url: "https://www.nccn.org/guidelines/category_1" },
  ],
  "orthopedics": [
    { name: "American Academy of Orthopaedic Surgeons", acronym: "AAOS", edition: "Clinical Practice Guidelines", url: "https://www.aaos.org/quality/quality-programs/clinical-practice-guidelines/" },
  ],
  "neurology": [
    { name: "American Academy of Neurology", acronym: "AAN", edition: "Practice Guidelines", url: "https://www.aan.com/Guidelines/" },
  ],
  "neurosurgery": [
    { name: "Congress of Neurological Surgeons", acronym: "CNS", edition: "Clinical Guidelines", url: "https://www.cns.org/guidelines" },
  ],
  "transplant-surgery": [
    { name: "International Society for Heart and Lung Transplantation", acronym: "ISHLT", edition: "Consensus statements", url: "https://ishlt.org/publications-resources/consensus-statements" },
    { name: "American Society of Transplantation", acronym: "AST", edition: "Position statements", url: "https://www.myast.org/" },
  ],
  "fertility": [
    { name: "European Society of Human Reproduction and Embryology", acronym: "ESHRE", edition: "Guidelines", url: "https://www.eshre.eu/Guidelines-and-Legal" },
    { name: "American Society for Reproductive Medicine", acronym: "ASRM", edition: "Practice Documents", url: "https://www.asrm.org/practice-guidance/practice-committee-documents/" },
  ],
  "ophthalmology": [
    { name: "American Academy of Ophthalmology", acronym: "AAO", edition: "Preferred Practice Pattern", url: "https://www.aao.org/guidelines-browse" },
  ],
  "ent": [
    { name: "American Academy of Otolaryngology–Head and Neck Surgery", acronym: "AAO-HNS", edition: "Clinical Practice Guidelines", url: "https://www.entnet.org/quality-practice/quality-products/clinical-practice-guidelines/" },
  ],
  "urology": [
    { name: "European Association of Urology", acronym: "EAU", edition: "Guidelines", url: "https://uroweb.org/guidelines" },
    { name: "American Urological Association", acronym: "AUA", edition: "Guidelines", url: "https://www.auanet.org/guidelines-and-quality" },
  ],
  "gynecology": [
    { name: "American College of Obstetricians and Gynecologists", acronym: "ACOG", edition: "Clinical Guidance", url: "https://www.acog.org/clinical" },
  ],
  "pediatric-care": [
    { name: "American Academy of Pediatrics", acronym: "AAP", edition: "Clinical Practice Guidelines", url: "https://publications.aap.org/aapbooks/pages/clinical-practice-guidelines" },
  ],
  "pediatric-surgery": [
    { name: "American Pediatric Surgical Association", acronym: "APSA", edition: "Clinical Practice Guidelines", url: "https://www.apsapedsurg.org/" },
  ],
  "bariatric-surgery": [
    { name: "American Society for Metabolic and Bariatric Surgery", acronym: "ASMBS", edition: "Position statements", url: "https://asmbs.org/resources/position-and-consensus-statements" },
  ],
  "cosmetic-surgery": [
    { name: "International Society of Aesthetic Plastic Surgery", acronym: "ISAPS", edition: "Standards of Care", url: "https://www.isaps.org/" },
    { name: "American Society of Plastic Surgeons", acronym: "ASPS", edition: "Practice Standards", url: "https://www.plasticsurgery.org/" },
  ],
  "dental": [
    { name: "American Dental Association", acronym: "ADA", edition: "Clinical Recommendations", url: "https://www.ada.org/resources/research/science-and-research-institute/evidence-based-dental-research" },
  ],
  "dermatology": [
    { name: "American Academy of Dermatology", acronym: "AAD", edition: "Clinical Guidelines", url: "https://www.aad.org/member/clinical-quality/guidelines" },
  ],
};
const guidelines = SOCIETY_GUIDELINES[slug] ?? [];

type OutcomeCell = { l: string; v: string; sub?: string };
const outcomeCells: OutcomeCell[] = [];
if (avgSuccess) outcomeCells.push({ l: "Avg success", v: `${avgSuccess.toFixed(1)}%`, sub: `across ${successRates.length} procedures` });
if (avgStay) outcomeCells.push({ l: "Hospital stay", v: `${avgStay.toFixed(1)} days`, sub: "median across the specialty" });
if (avgRecovery) outcomeCells.push({ l: "Recovery", v: `${Math.round(avgRecovery)} wk`, sub: "to full activity" });
outcomeCells.push({ l: "Hospitals", v: agg.hospitals.toLocaleString(), sub: `in ${agg.countries} destinations` });

const stats = [
  { l: "Hospitals", v: agg.hospitals.toLocaleString() },
  { l: "Treatments", v: specialtyTreatments.length.toString() },
  { l: "Destinations", v: agg.countries.toString() },
  aggFromFormatted ? { l: "From", v: aggFromFormatted } : null,
].filter(Boolean) as Array<{ l: string; v: string }>;

const seoTitle = specialty.name;
const seoDescription =
  descriptionLede?.slice(0, 160) ??
  `${specialty.name} — ${agg.hospitals.toLocaleString()} accredited hospitals across ${agg.countries} destinations. Compare ${specialtyTreatments.length} treatments.`;

const path = `/specialty/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("specialties"), url: localeUrl(locale, "/specialties") },
  { name: specialty.name, url },
]);

const collectionLd = withProvenance(
  {
    "@context": "https://schema.org",
    "@type": "MedicalSpecialty",
    name: specialty.name,
    description: descriptionLede ?? seoDescription,
    url,
  },
  {
    dateModified: reviewer?.reviewedAt ?? specialtyRaw.updatedAt,
    dateCreated: specialtyRaw.createdAt,
    reviewer: reviewerFromDbRow(reviewer),
  },
);

const untranslated = isUntranslated(locale, specialtyMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/specialties")} class="hover:text-ink">{tc("specialties")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{specialty.name}</span>
        </nav>
      </div>
    </div>

    <section class="pt-12 md:pt-16">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
          Specialty · {agg.hospitals.toLocaleString()} accredited hospitals
        </p>
        <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14 mt-3">
          <div>
            <h1
              class="display display-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {firstWord(specialty.name)}{" "}
              <span class="italic-display">{restOfName(specialty.name) || " "}</span>
            </h1>
            {descriptionLede && (
              <div class="serif mt-5 max-w-[44rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);" set:html={descriptionLedeHtml} />
            )}
            <div class="mt-6 max-w-[44rem]">
              <ReviewedBy reviewer={reviewer} locale={locale} />
            </div>
            <LastUpdated updated={specialtyRaw.updatedAt} locale={locale} class="mt-5" />

            {stats.length > 0 && (
              <div
                class="mt-8 grid grid-cols-2 sm:grid-cols-4"
                style="border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);"
              >
                {stats.map((s, i) => (
                  <div
                    class="px-4 md:px-5 py-5"
                    style={i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}
                  >
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {s.l}
                    </div>
                    <div class="display tnum mt-1.5" style="font-size: 28px;">{s.v}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="lg:sticky lg:top-32 lg:self-start" style="max-width: 380px;">
            <SpecialtyBanner
              slug={specialty.slug}
              name={specialty.name}
              aspect="5/4"
              label={`${specialty.name} · accredited care`}
            />
            <div
              class="paper mt-4 flex items-center justify-between"
              style="padding: 14px 16px;"
            >
              <div>
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                  Free quote
                </div>
                <div class="serif" style="font-size: 15px;">Typical reply in ~9 min</div>
              </div>
              <a
                href={localizedPath(locale, `/contact?specialty=${slug}`)}
                class="inline-flex items-center gap-1 text-sm font-semibold"
                style="background: var(--color-ink); color: var(--color-bg); padding: 9px 16px; border-radius: 9999px;"
              >
                Get quote
                <ChevronRight className="h-3.5 w-3.5 mirror-x" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {descriptionRest.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft); margin-top: 56px;">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                About this specialty
              </div>
              <h2
                class="display mt-3"
                style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;"
              >
                What to expect
              </h2>
            </div>
            <div class="prose-editorial" set:html={descriptionRestHtml} />
          </div>
        </div>
      </section>
    )}

    {/* Real moments — patient + care imagery for this specialty */}
    <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mono uppercase mb-6" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
          What care looks like in {specialty.name}
        </div>
        <ul class="grid gap-3" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
          {[
            { src: heroImage(`sp-${specialty.slug}-1`), title: "Specialist consult", sub: "Senior consultant, named, in your language" },
            { src: heroImage(`sp-${specialty.slug}-2`), title: "Imaging + workup", sub: "Same-day MRI/CT review with operating team" },
            { src: journeyScene(`sp-${specialty.slug}-3`), title: "Recovery + follow-up", sub: "Weekly video check-ins after discharge" },
          ].map((m) => (
            <li class="relative paper-flat overflow-hidden" style="aspect-ratio: 4/5; border-radius: var(--radius-lg);">
              <img
                src={m.src}
                alt={m.title}
                width="500"
                height="625"
                loading="lazy"
                decoding="async"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
              <div class="image-veil-strong" />
              <div class="absolute" style="inset-inline-start: 14px; inset-block-end: 14px; inset-inline-end: 14px;">
                <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: rgba(251,248,241,0.78);">
                  {m.title}
                </div>
                <div class="serif" style="font-size: 14px; font-weight: 500; color: #FBF8F1; line-height: 1.3; margin-top: 4px;">
                  {m.sub}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Deep specialty sections */}
    {specialtySections && (
      <>
        {specialtySections.subspecialties && specialtySections.subspecialties.length > 0 && (
          <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Sub-specialties
              </div>
              <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
                Within {specialty.name.toLowerCase()}
              </h2>
              <div class="grid gap-5 md:grid-cols-2">
                {specialtySections.subspecialties.map((s: any) => (
                  <div class="paper" style="padding: 22px;">
                    <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 8px;">
                      {s.name}
                    </div>
                    <p style="font-size: 14.5px; line-height: 1.55;">{s.note}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        {specialtySections.programQualitySignals && specialtySections.programQualitySignals.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    Program quality
                  </div>
                  <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                    What to <span style="font-style: italic;">look for</span>
                  </h2>
                </div>
                <ul class="space-y-3">
                  {specialtySections.programQualitySignals.map((sig: string) => (
                    <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                      <span style="color: var(--color-accent);">→</span>
                      <span>{sig}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        )}

        {specialtySections.surgeonVolumeThresholds && specialtySections.surgeonVolumeThresholds.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Volume thresholds
              </div>
              <h2 class="display mb-7" style="font-size: 26px; letter-spacing: -0.02em;">
                Surgeon volume <span style="font-style: italic;">benchmarks</span>
              </h2>
              <div class="paper overflow-hidden" style="padding: 0;">
                {specialtySections.surgeonVolumeThresholds.map((t: any, i: number) => (
                  <div
                    class="grid items-start gap-4 p-5"
                    style={`grid-template-columns: 220px 1fr; ${i > 0 ? "border-top: 1px solid var(--color-border-soft);" : ""}`}
                  >
                    <span class="mono uppercase" style="font-size: 12px; letter-spacing: 0.08em; color: var(--color-accent);">{t.range}</span>
                    <span style="font-size: 15px; line-height: 1.5;">{t.quality}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        {specialtySections.topDestinations && specialtySections.topDestinations.length > 0 && (
          <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Destinations
              </div>
              <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
                Where this is <span style="font-style: italic;">commonly done</span>
              </h2>
              <div class="grid gap-5 md:grid-cols-2">
                {specialtySections.topDestinations.map((d: any) => (
                  <div class="paper" style="padding: 22px;">
                    <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent); margin-bottom: 8px;">
                      {d.country}
                    </div>
