---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { ChevronRight, Check } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";
import { patientHero, careTeam } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/for-hospitals`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tFh = getTranslator(locale, "forHospitalsPage");

const path = "/for-hospitals";
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tFh("forHospitalsBreadcrumb"), url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);

const stats = [
  { l: tFh("statLabelPrequalified"), v: "34%" },
  { l: tFh("statLabelLanguages"), v: "8" },
  { l: tFh("statLabelCommissionOn"), v: tFh("statValueCommission") },
  { l: tFh("statLabelRetainer"), v: tFh("statValueRetainer") },
];

const PROMISES = [
  { eyebrow: tFh("forHospitalsPromise01Eyebrow"), title: tFh("forHospitalsPromise01Title"), body: tFh("forHospitalsPromise01Body") },
  { eyebrow: tFh("forHospitalsPromise02Eyebrow"), title: tFh("forHospitalsPromise02Title"), body: tFh("forHospitalsPromise02Body") },
  { eyebrow: tFh("forHospitalsPromise03Eyebrow"), title: tFh("forHospitalsPromise03Title"), body: tFh("forHospitalsPromise03Body") },
];

const STEPS = [
  { n: "01", t: tFh("forHospitalsStep01Title"), d: tFh("forHospitalsStep01Desc") },
  { n: "02", t: tFh("forHospitalsStep02Title"), d: tFh("forHospitalsStep02Desc") },
  { n: "03", t: tFh("forHospitalsStep03Title"), d: tFh("forHospitalsStep03Desc") },
  { n: "04", t: tFh("forHospitalsStep04Title"), d: tFh("forHospitalsStep04Desc") },
  { n: "05", t: tFh("forHospitalsStep05Title"), d: tFh("forHospitalsStep05Desc") },
  { n: "06", t: tFh("forHospitalsStep06Title"), d: tFh("forHospitalsStep06Desc") },
];

const QUALIFIES = [
  tFh("forHospitalsQualify01"),
  tFh("forHospitalsQualify02"),
  tFh("forHospitalsQualify03"),
  tFh("forHospitalsQualify04"),
  tFh("forHospitalsQualify05"),
  tFh("forHospitalsQualify06"),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tFh("seoTitle")}
      description={tFh("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tFh("forHospitalsBreadcrumb")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tFh("eyebrow")}
      h1First={tFh("h1First")}
      h1Italic={tFh("h1Italic")}
      lede={tFh("lede")}
      stats={stats}
    />

    {/* Patient origin showcase — partners want to see who's coming */}
    <section style="padding: 32px 0 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mono uppercase mb-4" style="font-size: 10.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
          {tFh("patientsWeRoute")}
        </div>
        <ul class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
          {[
            { region: "africa", id: 21, label: tFh("patientRegionSubSaharanAfrica"), flow: tFh("patientFlowAfrica"), share: "31%" },
            { region: "middle_east", id: 22, label: tFh("patientRegionGulfAndLevant"), flow: tFh("patientFlowMiddleEast"), share: "27%" },
            { region: "cis", id: 23, label: tFh("patientRegionCISAndCaucasus"), flow: tFh("patientFlowCIS"), share: "19%" },
            { region: "south_asia", id: 24, label: tFh("patientRegionSouthAsia"), flow: tFh("patientFlowSouthAsia"), share: "16%" },
            { region: "africa", id: 25, label: tFh("patientRegionNorthAfrica"), flow: tFh("patientFlowNorthAfrica"), share: "7%" },
          ].map((p) => (
            <li>
              <article class="paper overflow-hidden" style="padding: 0;">
                <div class="relative" style="aspect-ratio: 1/1; overflow: hidden;">
                  <img
                    src={patientHero(p.id, p.region as any, 360)}
                    alt={tFh("patientOriginAlt").replace("{label}", p.label)}
                    width="360"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                  <div class="image-veil" />
                  <div class="absolute mono tnum" style="inset-block-start: 10px; inset-inline-end: 10px; font-size: 11px; font-weight: 600; color: #FBF8F1; background: rgba(14,23,19,0.55); padding: 2px 8px; border-radius: 9999px;">
                    {p.share}
                  </div>
                </div>
                <div style="padding: 12px 14px;">
                  <div class="serif" style="font-size: 14px; font-weight: 500; line-height: 1.3; color: var(--color-ink);">
                    {p.label}
                  </div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.1em; color: var(--color-ink-subtle); margin-top: 4px;">
                    {p.flow}
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <p class="mono uppercase" style="font-size: 10.5px; letter-spacing: 0.06em; color: var(--color-ink-subtle); margin-top: 14px;">
          {tFh("originDistributionNote")}
        </p>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); margin-top: 24px;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mb-8">
          <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tFh("forHospitalsSection01")}
          </div>
          <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
            {tFh("forHospitalsSection01Title")}
          </h2>
        </div>
        <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {PROMISES.map((p) => (
            <li class="paper" style="padding: 26px 28px;">
              <div class="display tnum" style="font-size: 40px; line-height: 0.95; color: var(--color-accent); letter-spacing: -0.02em;">
                {p.eyebrow}
              </div>
              <div class="serif mt-3" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">
                {p.title}
              </div>
              <p class="mt-2 serif" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">
                {p.body}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="mb-8">
          <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tFh("forHospitalsSection02")}
          </div>
          <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
            {tFh("forHospitalsSection02Title")}
          </h2>
        </div>
        <ol>
          {STEPS.map((s, i) => (
            <li
              class="grid gap-6 py-6"
              style={`grid-template-columns: 56px 1fr; ${i > 0 ? "border-top: 1px dashed var(--color-border);" : "border-top: 1px dashed var(--color-border);"}`}
            >
              <div class="display tnum" style="font-size: 32px; line-height: 1; color: var(--color-accent); letter-spacing: -0.02em;">
                {s.n}
              </div>
              <div>
                <div class="serif" style="font-size: 20px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">
                  {s.t}
                </div>
                <p class="mt-2 serif max-w-[52rem]" style="font-size: 15px; line-height: 1.55; color: var(--color-ink-muted);">
                  {s.d}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
          <div>
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tFh("forHospitalsSection03")}
            </div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
              {tFh("forHospitalsSection03Title")}
            </h2>
          </div>
          <ul class="space-y-3.5">
            {QUALIFIES.map((q) => (
              <li class="flex items-start gap-3 serif" style="font-size: 16px; line-height: 1.5; color: var(--color-ink);">
                <Check className="h-4 w-4 mt-1.5 shrink-0" style={{color: "var(--color-accent)"}} />
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 72px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              {tFh("forHospitalsCta")}
            </div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-bg);">
              {tFh("forHospitalsCtaTitle")}
            </h2>
            <p class="serif mt-4 max-w-[42rem]" style="font-size: 17px; line-height: 1.5; color: rgba(246,241,230,0.75);">
              {tFh("forHospitalsCtaText")}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, "/contact?type=partnership")}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              {tFh("forHospitalsCtaBtn")}
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tFh("howItWorksHeading")}
      italicWord={tFh("howItWorksItalicWord")}
      eyebrow={tFh("howItWorksEyebrow")}
      steps={[
        { title: tFh("howItWorksStep1Title"), description: tFh("howItWorksStep1Desc") },
        { title: tFh("howItWorksStep2Title"), description: tFh("howItWorksStep2Desc") },
        { title: tFh("howItWorksStep3Title"), description: tFh("howItWorksStep3Desc") },
        { title: tFh("howItWorksStep4Title"), description: tFh("howItWorksStep4Desc") },
        { title: tFh("howItWorksStep5Title"), description: tFh("howItWorksStep5Desc") },
        { title: tFh("howItWorksStep6Title"), description: tFh("howItWorksStep6Desc") },
      ]}
      outroNote={tFh("howItWorksOutroNote")}
    />

    <WhatToExpect
      heading={tFh("whatToExpectHeading")}
      italicWord={tFh("whatToExpectItalicWord")}
      items={[
        { label: tFh("whatToExpectItem1Label"), description: tFh("whatToExpectItem1Desc") },
        { label: tFh("whatToExpectItem2Label"), description: tFh("whatToExpectItem2Desc") },
        { label: tFh("whatToExpectItem3Label"), description: tFh("whatToExpectItem3Desc") },
        { label: tFh("whatToExpectItem4Label"), description: tFh("whatToExpectItem4Desc") },
        { label: tFh("whatToExpectItem5Label"), description: tFh("whatToExpectItem5Desc") },
        { label: tFh("whatToExpectItem6Label"), description: tFh("whatToExpectItem6Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tFh("exploreEyebrow")}
      heading={tFh("exploreHeading")}
      lede={tFh("exploreLede")}
      items={[
        { eyebrow: tFh("exploreItem1Eyebrow"), label: tFh("exploreItem1Label"), href: "/editorial-policy", hint: tFh("exploreItem1Hint") },
        { eyebrow: tFh("exploreItem2Eyebrow"), label: tFh("exploreItem2Label"), href: "/medical-board", hint: tFh("exploreItem2Hint") },
        { eyebrow: tFh("exploreItem3Eyebrow"), label: tFh("exploreItem3Label"), href: "/accreditation", hint: tFh("exploreItem3Hint") },
        { eyebrow: tFh("exploreItem4Eyebrow"), label: tFh("exploreItem4Label"), href: "/hospitals", hint: tFh("exploreItem4Hint") },
        { eyebrow: tFh("exploreItem5Eyebrow"), label: tFh("exploreItem5Label"), href: "/countries", hint: tFh("exploreItem5Hint") },
        { eyebrow: tFh("exploreItem6Eyebrow"), label: tFh("exploreItem6Label"), href: "/pricing-index", hint: tFh("exploreItem6Hint") },
        { eyebrow: tFh("exploreItem7Eyebrow"), label: tFh("exploreItem7Label"), href: "/about", hint: tFh("exploreItem7Hint") },
        { eyebrow: tFh("exploreItem8Eyebrow"), label: tFh("exploreItem8Label"), href: "/contact", hint: tFh("exploreItem8Hint") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
