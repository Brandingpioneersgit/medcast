---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { lookupReviewerByName, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { ChevronRight } from "lucide-react";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/qa/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tQd = getTranslator(locale, "qaDetailPage");

type Row = {
  id: number;
  slug: string;
  question: string;
  answer: string;
  category: string | null;
  author: string | null;
  reviewed_by: string | null;
  related_slugs: string[] | null;
  created_at: Date | null;
  updated_at: Date | null;
};
const res = await db
  .execute(sql`
    SELECT id, slug, question, answer, category, author, reviewed_by, related_slugs, created_at, updated_at
    FROM qa_posts WHERE slug = ${slug}
  `)
  .catch(() => [] as unknown[]);
const rawPost = Array.from(res as Iterable<Row>)[0] ?? null;
if (!rawPost) return new Response(`Not found: ${slug}`, { status: 404 });

const postMap = await getContent("qa_post", rawPost.id, locale).catch(() => ({}));
const post = applyTranslated(rawPost, postMap, ["question", "answer"]);
const untranslated = isUntranslated(locale, postMap);

const related = (post.related_slugs ?? []).filter((s): s is string => typeof s === "string");
type RelRow = { id: number; slug: string; question: string };
const rawRelated = related.length > 0
  ? Array.from(
      (await db
        .execute(sql`
          SELECT id, slug, question FROM qa_posts
          WHERE slug = ANY(${sql`ARRAY[${sql.join(related.map((s) => sql`${s}`), sql`, `)}]::text[]`})
        `)
        .catch(() => [] as unknown[])) as Iterable<RelRow>,
    )
  : [];
const relMap: Record<number, Record<string, string>> = await getContentBatch("qa_post", rawRelated.map((r) => r.id), locale).catch(() => ({}));
const relatedRows = rawRelated.map((r) => applyTranslated(r, relMap[r.id] ?? {}, ["question"]));

const reviewerLink = await lookupReviewerByName(post.reviewed_by);

const seoTitle = post.question;
const seoDescription = post.answer.slice(0, 160);
const path = `/qa/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Q&A", url: localeUrl(locale, "/qa") },
  ...(post.category ? [{ name: post.category, url: `${localeUrl(locale, "/qa")}#${post.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}` }] : []),
  { name: post.question, url },
]);

const qaLd = {
  "@context": "https://schema.org",
  "@type": "QAPage",
  mainEntity: {
    "@type": "Question",
    name: post.question,
    text: post.question,
    author: { "@type": "Organization", name: post.author ?? "MedCasts Editorial" },
    acceptedAnswer: {
      "@type": "Answer",
      text: post.answer,
      author: post.reviewed_by
        ? { "@type": "Person", name: post.reviewed_by }
        : { "@type": "Organization", name: post.author ?? "MedCasts Editorial" },
      ...(post.created_at ? { datePublished: new Date(post.created_at).toISOString() } : {}),
      ...(post.updated_at && post.created_at && new Date(post.updated_at).getTime() > new Date(post.created_at).getTime()
        ? { dateModified: new Date(post.updated_at).toISOString() }
        : {}),
    },
  },
  ...(post.updated_at ? { dateModified: new Date(post.updated_at).toISOString() } : {}),
  url,
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");

const answerParas = post.answer.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const linkables = await listLinkableEntities().catch(() => []);
const answerHtml = answerParas.length > 0
  ? linkifyBlogHtml(
      answerParas.map((p) => `<p>${p.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`).join("\n"),
      linkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(qaLd)} />
  </Fragment>

  <main id="main" class="min-h-dvh" style="background: var(--color-bg); color: var(--color-ink);">
    <SiteHeader locale={locale} />

    <div style="padding: 18px 28px; border-bottom: 1px solid var(--color-border-soft); background: var(--color-paper);">
      <nav class="mono mx-auto max-w-[1440px]" style="font-size: 12px; color: var(--color-ink-subtle);" aria-label="Breadcrumb">
        <a href={localizedPath(locale, "/qa")} class="hover:text-ink">Q&amp;A</a>
        {post.category && (
          <>
            <span class="mx-1.5">/</span>
            <a href={`${localizedPath(locale, "/qa")}#${post.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`} class="hover:text-ink">
              {post.category}
            </a>
          </>
        )}
      </nav>
    </div>

    <section style="padding: 56px 28px;">
      <div class="mx-auto" style="max-width: 760px;">
        {post.category && (
          <div class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{post.category}</div>
        )}
        <h1
          class="display display-tight mt-3"
          style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; font-weight: 400; letter-spacing: -0.03em;"
        >
          {post.question}
        </h1>

        <div class="mt-6 flex flex-wrap items-center gap-3" style="font-size: 12.5px; color: var(--color-ink-subtle);">
          <span>{post.author ?? "MedCasts Editorial"}</span>
          {post.reviewed_by && (
            <>
              <span>·</span>
              <span>
                {tQd("reviewedBy")}{" "}
                {reviewerLink ? (
                  <a
                    href={`${localizedPath(locale, "/medical-board")}#${reviewerLink.slug}`}
                    style="color: var(--color-ink); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border);"
                  >
                    {post.reviewed_by}
                  </a>
                ) : (
                  <strong style="color: var(--color-ink); font-weight: 500;">{post.reviewed_by}</strong>
                )}
              </span>
            </>
          )}
          {post.updated_at && (
            <>
              <span>·</span>
              <span class="mono">{tQd("updatedPrefix")} {new Date(post.updated_at).toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
            </>
          )}
        </div>

        <div class="prose-editorial mt-10" style="max-width: none;" set:html={answerHtml} />

        {relatedRows.length > 0 && (
          <section class="mt-12 pt-10" style="border-top: 1px solid var(--color-border);">
            <h2 class="mono" style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink-subtle);">{tQd("relatedQuestionsHeading")}</h2>
            <ul class="mt-5 grid gap-2">
              {relatedRows.map((r) => (
                <li>
                  <a
                    href={localizedPath(locale, `/qa/${r.slug}`)}
                    class="flex items-start justify-between gap-4 py-3 hover:text-accent"
                    style="border-bottom: 1px solid var(--color-border-soft);"
                  >
                    <span class="serif" style="font-size: 15.5px; font-weight: 500;">{r.question}</span>
                    <ChevronRight className="h-4 w-4 mirror-x shrink-0 mt-1" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section
          class="mt-12 p-6"
          style="background: var(--color-accent-mist); border: 1px solid var(--color-accent-soft); border-radius: var(--radius-lg);"
        >
          <div class="mono" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent); text-transform: uppercase;">{tQd("specificCaseEyebrow")}</div>
          <p class="serif mt-2" style="font-size: 15.5px; line-height: 1.55; color: var(--color-ink);">
            {tQd("specificCaseBody")}
          </p>
          <a
            href={localizedPath(locale, "/contact")}
            class="inline-flex items-center gap-1 mt-3 font-semibold"
            style="background: var(--color-ink); color: var(--color-bg); padding: 10px 18px; font-size: 14px; border-radius: 9999px;"
          >
            {tQd("askAboutMyCase")} <ChevronRight className="h-3.5 w-3.5 mirror-x" />
          </a>
        </section>
      </div>
    </section>

    <ExploreGrid
      locale={locale}
      eyebrow={tQd("exploreEyebrow")}
      heading={tQd("exploreHeading")}
      lede={tQd("exploreLede")}
      items={[
        { eyebrow: tQd("item1Eyebrow"), label: tQd("item1Label"), href: "/qa", hint: tQd("item1Hint") },
        { eyebrow: tQd("item2Eyebrow"), label: tQd("item2Label"), href: "/treatments", hint: tQd("item2Hint") },
        { eyebrow: tQd("item3Eyebrow"), label: tQd("item3Label"), href: "/specialties", hint: tQd("item3Hint") },
        { eyebrow: tQd("item4Eyebrow"), label: tQd("item4Label"), href: "/conditions", hint: tQd("item4Hint") },
        { eyebrow: tQd("item5Eyebrow"), label: tQd("item5Label"), href: "/countries", hint: tQd("item5Hint") },
        { eyebrow: tQd("item6Eyebrow"), label: tQd("item6Label"), href: "/calculator", hint: tQd("item6Hint") },
        { eyebrow: tQd("item7Eyebrow"), label: tQd("item7Label"), href: "/match-me", hint: tQd("item7Hint") },
        { eyebrow: tQd("item8Eyebrow"), label: tQd("item8Label"), href: "/glossary", hint: tQd("item8Hint") },
        { eyebrow: tQd("item9Eyebrow"), label: tQd("item9Label"), href: "/medical-board", hint: tQd("item9Hint") },
        { eyebrow: tQd("item10Eyebrow"), label: tQd("item10Label"), href: "/editorial-policy", hint: tQd("item10Hint") },
        { eyebrow: tQd("item11Eyebrow"), label: tQd("item11Label"), href: "/second-opinion", hint: tQd("item11Hint") },
        { eyebrow: tQd("item12Eyebrow"), label: tQd("item12Label"), href: "/quote", hint: tQd("item12Hint") },
      ]}
    />

    {/* EEAT signals */}
    <MethodologyBlock locale={locale}
      curationNote={tQd("curationNote")}
      dataSources={[
        tQd("dataSource1"),
        tQd("dataSource2"),
        tQd("dataSource3"),
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
