---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import { compareCountries } from "@/lib/queries";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/compare/countries`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tCc = getTranslator(locale, "compareCountriesPage");

const rows = await compareCountries();

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
function countryFlag(s: string): string { return FLAG_MAP[s] ?? "🌐"; }

const path = "/compare/countries";
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tCc("breadcrumbLabel"), url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);

const totalHospitals = rows.reduce((s, r) => s + r.hospital_count, 0);
const totalDoctors = rows.reduce((s, r) => s + r.doctor_count, 0);

const stats = [
  { l: tCc("statDestinations"), v: rows.length.toString() },
  { l: tCc("statHospitals"), v: totalHospitals.toLocaleString() },
  { l: tCc("statSpecialists"), v: totalDoctors.toLocaleString() },
  { l: tCc("statTreatments"), v: rows.reduce((s, r) => s + r.treatment_count, 0).toLocaleString() },
];

const maxHospitals = rows.reduce((m, r) => Math.max(m, r.hospital_count), 0);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tCc("seoTitle")}
      description={tCc("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tCc("breadcrumbLabel")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tCc("eyebrowHero").replace("{count}", rows.length.toString())}
      h1First={tCc("h1FirstHero")}
      h1Italic={tCc("h1ItalicHero")}
      lede={tCc("ledeHero").replace("{count}", rows.length.toString())}
      stats={stats}
    />

    <section style="padding: 32px 0 88px;">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <div class="paper overflow-x-auto" style="padding: 0;">
          <table class="w-full" style="border-collapse: collapse; min-width: 780px;">
            <thead>
              <tr style="border-bottom: 1px solid var(--color-ink);">
                <th class="text-start mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal; width: 36px;">#</th>
                <th class="text-start mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tCc("colDestination")}</th>
                <th class="text-start mono uppercase whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal; min-width: 220px;">{tCc("colHospitalsScale")}</th>
                <th class="text-start mono uppercase whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tCc("colSpecialists")}</th>
                <th class="text-start mono uppercase whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tCc("colTreatments")}</th>
                <th class="text-start mono uppercase whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle); padding: 16px 20px; font-weight: normal;">{tCc("colCities")}</th>
                <th style="padding: 16px 20px;"></th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r, i) => {
                const widthPct = maxHospitals > 0 ? Math.max(8, (r.hospital_count / maxHospitals) * 100) : 50;
                const topRow = rows[0];
                const ratioVsTop = topRow && i > 0 && topRow.hospital_count > 0
                  ? r.hospital_count / topRow.hospital_count
                  : null;
                const ratioLabel = i === 0
                  ? tCc("topDestination")
                  : ratioVsTop != null
                    ? `${ratioVsTop.toFixed(2)}× ${topRow.name.toLowerCase()}`
                    : null;
                return (
                  <tr
                    class="group"
                    style={`${i > 0 ? "border-top: 1px dashed var(--color-border);" : ""}`}
                  >
                    <td class="display tnum" style="font-size: 18px; color: var(--color-ink-subtle); padding: 16px 20px;">
                      {String(i + 1).padStart(2, "0")}
                    </td>
                    <td style="padding: 16px 20px;">
                      <div class="flex items-center gap-2.5">
                        <span aria-hidden="true" style="font-size: 20px;">{countryFlag(r.slug)}</span>
                        <a
                          href={localizedPath(locale, `/country/${r.slug}`)}
                          class="serif group-hover:text-accent transition-colors"
                          style="font-size: 17px; letter-spacing: -0.005em; color: var(--color-ink);"
                        >
                          {r.name}
                        </a>
                      </div>
                    </td>
                    <td style="padding: 16px 20px;">
                      <div class="display tnum" style="font-size: 22px; line-height: 1; letter-spacing: -0.015em; color: var(--color-ink);">
                        {r.hospital_count.toLocaleString()}
                      </div>
                      <div class="mt-2 h-1.5 rounded-full" style="background: var(--color-border-soft); overflow: hidden;">
                        <div class="h-full rounded-full" style={`background: var(--color-accent); width: ${widthPct}%;`} />
                      </div>
                      {ratioLabel && (
                        <div class="mono mt-1.5" style="font-size: 10px; letter-spacing: 0.06em; color: var(--color-ink-subtle);">
                          {ratioLabel}
                        </div>
                      )}
                    </td>
                    <td class="tnum whitespace-nowrap" style="font-size: 14px; color: var(--color-ink-muted); padding: 16px 20px;">
                      {r.doctor_count.toLocaleString()}
                    </td>
                    <td class="tnum whitespace-nowrap" style="font-size: 14px; color: var(--color-ink-muted); padding: 16px 20px;">
                      {r.treatment_count.toLocaleString()}
                    </td>
                    <td class="tnum whitespace-nowrap" style="font-size: 14px; color: var(--color-ink-muted); padding: 16px 20px;">
                      {r.city_count.toLocaleString()}
                    </td>
                    <td style="padding: 16px 20px; text-align: end;">
                      <a
                        href={localizedPath(locale, `/country/${r.slug}`)}
                        class="inline-flex items-center gap-1 mono uppercase"
                        style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);"
                      >
                        {tCc("openLink")}
                        <ChevronRight className="h-3 w-3 mirror-x" />
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <p class="mt-4 mono uppercase" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
          {tCc("footerNote")}
        </p>
      </div>
    </section>

    <HowItWorks
      heading={tCc("howHeading")}
      italicWord={tCc("howItalicWord")}
      eyebrow={tCc("howEyebrow")}
      steps={[
        { title: tCc("howStep1Title"), description: tCc("howStep1Desc") },
        { title: tCc("howStep2Title"), description: tCc("howStep2Desc") },
        { title: tCc("howStep3Title"), description: tCc("howStep3Desc") },
        { title: tCc("howStep4Title"), description: tCc("howStep4Desc") },
        { title: tCc("howStep5Title"), description: tCc("howStep5Desc") },
      ]}
    />

    <WhatToExpect
      heading={tCc("wteHeading")}
      italicWord={tCc("wteItalicWord")}
      items={[
        { label: tCc("wteItem1Label"), description: tCc("wteItem1Desc") },
        { label: tCc("wteItem2Label"), description: tCc("wteItem2Desc") },
        { label: tCc("wteItem3Label"), description: tCc("wteItem3Desc") },
        { label: tCc("wteItem4Label"), description: tCc("wteItem4Desc") },
        { label: tCc("wteItem5Label"), description: tCc("wteItem5Desc") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
