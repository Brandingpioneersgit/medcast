---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PriceRange from "@/components/PriceRange.astro";
import { compareTreatments } from "@/lib/queries";
import { formatUsd } from "@/lib/currency";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect(`/en/compare/treatments`, 308);
const locale = rawLocale as Locale;
const tc = getTranslator(locale, "common");
const tCtr = getTranslator(locale, "compareTreatmentsPage");

const rows = await compareTreatments();

const path = "/compare/treatments";
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tCtr("breadcrumbCompareTreatments"), url },
]);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);

const specialtyCount = new Set(rows.map((r) => r.specialty).filter(Boolean)).size;
const withPrice = rows.filter((r) => r.lo != null);
const lowestFrom = withPrice.reduce(
  (m, r) => (!m || (Number(r.lo) < m)) ? Number(r.lo) : m,
  null as number | null,
);
const withSuccess = rows.filter((r) => r.success_rate_percent != null);
const avgSuccess = withSuccess.length > 0
  ? withSuccess.reduce((s, r) => s + Number(r.success_rate_percent), 0) / withSuccess.length
  : null;

const lowestFromFormatted = lowestFrom ? await formatUsd(Astro.cookies, lowestFrom) : null;

const stats = [
  { l: tCtr("statProcedures"), v: rows.length.toString() },
  { l: tCtr("statSpecialties"), v: specialtyCount.toString() },
  lowestFromFormatted ? { l: tCtr("statFrom"), v: lowestFromFormatted } : null,
  avgSuccess ? { l: tCtr("statAvgSuccess"), v: `${avgSuccess.toFixed(0)}%` } : null,
].filter(Boolean) as Array<{ l: string; v: string }>;

// Success-rate color thresholds — calibrated against the surgical-travel
// procedure mix represented in the catalog: median CABG/TAVR/TKR success
// runs ~92–98% at high-volume programs, mid-tier elective surgical ~75–90%,
// complex oncology / late-stage transplant trail < 75%. Bands chosen to
// communicate "expected for the procedure category" at a glance.
function successTone(pct: number | null): string {
  if (pct == null) return "color: var(--color-ink-subtle);";
  if (pct >= 90) return "color: var(--color-accent);";
  if (pct >= 75) return "color: var(--color-saffron);";
  return "color: var(--color-coral);";
}
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={tCtr("seoTitle")}
      description={tCtr("seoDescription")}
      path={path}
      locale={locale}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{tCtr("breadcrumbCompareTreatments")}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tCtr("heroEyebrow").replace("{count}", rows.length.toString())}
      h1First={tCtr("heroH1First")}
      h1Italic={tCtr("heroH1Italic")}
      lede={tCtr("heroLede").replace("{count}", rows.length.toString())}
      stats={stats}
    />

    <section style="padding: 32px 0 88px;">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <ul class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));">
          {rows.map((r, i) => (
            <li>
              <a
                href={localizedPath(locale, `/treatment/${r.slug}`)}
                class="paper group block transition hover:-translate-y-0.5"
                style="padding: 22px 22px 18px;"
              >
                {/* Top row: index + name + arrow */}
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="mono uppercase tnum" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                      {String(i + 1).padStart(2, "0")} · {r.specialty ?? "Other"}
                    </div>
                    <div class="serif mt-1.5 group-hover:text-accent transition-colors" style="font-size: 19px; letter-spacing: -0.005em; line-height: 1.25; color: var(--color-ink); font-weight: 500;">
                      {r.name}
                    </div>
                  </div>
                  <ChevronRight className="h-4 w-4 mirror-x mt-2.5 shrink-0 text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                </div>

                {/* Price range — most-prominent metric */}
                <div class="mt-4 pt-4" style="border-top: 1px dashed var(--color-border);">
                  <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                    {tCtr("cardPackageRange")}
                  </div>
                  <div class="display tnum mt-1" style="font-size: 22px; line-height: 1; letter-spacing: -0.015em; color: var(--color-ink);">
                    {r.lo ? (
                      <PriceRange min={r.lo} max={r.hi} />
                    ) : (
                      <span style="color: var(--color-ink-subtle); font-size: 17px;">{tCtr("cardNotYetPriced")}</span>
                    )}
                  </div>
                  {r.hospital_count > 0 && (
                    <div class="mono mt-1" style="font-size: 10.5px; color: var(--color-ink-subtle);">
                      {r.hospital_count === 1
                        ? tCtr("cardAcrossHospitalSingular").replace("{count}", r.hospital_count.toLocaleString())
                        : tCtr("cardAcrossHospitalPlural").replace("{count}", r.hospital_count.toLocaleString())}
                    </div>
                  )}
                </div>

                {/* 3-stat ribbon: stay, recovery, success */}
                <div class="mt-4 grid grid-cols-3 gap-3">
                  <div>
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {tCtr("cardStay")}
                    </div>
                    <div class="tnum mt-0.5" style="font-size: 15px; color: var(--color-ink);">
                      {r.hospital_stay_days != null ? `${r.hospital_stay_days}d` : "—"}
                    </div>
                  </div>
                  <div>
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {tCtr("cardRecovery")}
                    </div>
                    <div class="tnum mt-0.5" style="font-size: 15px; color: var(--color-ink);">
                      {r.recovery_days ? `${r.recovery_days}d` : "—"}
                    </div>
                  </div>
                  <div>
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {tCtr("cardSuccess")}
                    </div>
                    <div class="tnum mt-0.5" style={`font-size: 15px; ${r.success_rate_percent != null ? successTone(Number(r.success_rate_percent)) : "color: var(--color-ink-subtle);"}`}>
                      {r.success_rate_percent != null ? `${Number(r.success_rate_percent).toFixed(0)}%` : "—"}
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-6 mono uppercase" style="font-size: 10.5px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
          {tCtr("footerNote")}
        </p>
      </div>
    </section>

    <HowItWorks
      heading={tCtr("howHeading")}
      italicWord={tCtr("howItalicWord")}
      eyebrow={tCtr("howEyebrow")}
      steps={[
        { title: tCtr("howStep1Title"), description: tCtr("howStep1Desc") },
        { title: tCtr("howStep2Title"), description: tCtr("howStep2Desc") },
        { title: tCtr("howStep3Title"), description: tCtr("howStep3Desc") },
        { title: tCtr("howStep4Title"), description: tCtr("howStep4Desc") },
      ]}
    />

    <WhatToExpect
      heading={tCtr("wteHeading")}
      italicWord={tCtr("wteItalicWord")}
      items={[
        { label: tCtr("wteItem1Label"), description: tCtr("wteItem1Desc") },
        { label: tCtr("wteItem2Label"), description: tCtr("wteItem2Desc") },
        { label: tCtr("wteItem3Label"), description: tCtr("wteItem3Desc") },
        { label: tCtr("wteItem4Label"), description: tCtr("wteItem4Desc") },
        { label: tCtr("wteItem5Label"), description: tCtr("wteItem5Desc") },
        { label: tCtr("wteItem6Label"), description: tCtr("wteItem6Desc") },
        { label: tCtr("wteItem7Label"), description: tCtr("wteItem7Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tCtr("exploreEyebrow")}
      heading={tCtr("exploreHeading")}
      lede={tCtr("exploreLede")}
      items={[
        { eyebrow: tCtr("exploreItem1Eyebrow"), label: tCtr("exploreItem1Label"), href: "/compare/hospitals", hint: tCtr("exploreItem1Hint") },
        { eyebrow: tCtr("exploreItem2Eyebrow"), label: tCtr("exploreItem2Label"), href: "/compare/doctors", hint: tCtr("exploreItem2Hint") },
        { eyebrow: tCtr("exploreItem3Eyebrow"), label: tCtr("exploreItem3Label"), href: "/compare/countries", hint: tCtr("exploreItem3Hint") },
        { eyebrow: tCtr("exploreItem4Eyebrow"), label: tCtr("exploreItem4Label"), href: "/calculator", hint: tCtr("exploreItem4Hint") },
        { eyebrow: tCtr("exploreItem5Eyebrow"), label: tCtr("exploreItem5Label"), href: "/pricing-index", hint: tCtr("exploreItem5Hint") },
        { eyebrow: tCtr("exploreItem6Eyebrow"), label: tCtr("exploreItem6Label"), href: "/treatments", hint: tCtr("exploreItem6Hint") },
        { eyebrow: tCtr("exploreItem7Eyebrow"), label: tCtr("exploreItem7Label"), href: "/specialties", hint: tCtr("exploreItem7Hint") },
        { eyebrow: tCtr("exploreItem8Eyebrow"), label: tCtr("exploreItem8Label"), href: "/match-me", hint: tCtr("exploreItem8Hint") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
