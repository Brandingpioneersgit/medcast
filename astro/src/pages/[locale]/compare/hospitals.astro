---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getHospitalsForCompare } from "@/lib/queries";
import { formatUsd } from "@/lib/currency";
import { getContentBatch, applyTranslated } from "@/lib/translate";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { hospitalCover } from "@/lib/images";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import PageCta from "@/components/PageCta.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
if (!isLocale(rawLocale)) return Astro.redirect("/en/compare/hospitals", 308);
const locale = rawLocale as Locale;

const url = new URL(Astro.request.url);
const idsParam = url.searchParams.get("ids") ?? "";
const slugs = idsParam
  .split(",")
  .map((s) => s.trim())
  .filter(Boolean)
  .slice(0, 4);

const hospitalsRaw = slugs.length > 0 ? await getHospitalsForCompare(slugs) : [];

// Translate hospital names (DB overrides per-locale)
const tMap = hospitalsRaw.length > 0
  ? await getContentBatch("hospital", hospitalsRaw.map((h) => h.id), locale)
  : {};
const hospitals = hospitalsRaw.map((h) => ({
  ...h,
  ...applyTranslated({ name: h.name }, tMap[h.id] ?? {}, ["name"]),
}));

const tc = getTranslator(locale, "common");
const tCh = getTranslator(locale, "compareHospitalsPage");

const seoTitle = hospitals.length > 0
  ? `Compare ${hospitals.map((h) => h.name).join(" vs ")}`
  : tCh("seoTitle");
const seoDescription = hospitals.length > 0
  ? tCh("seoDescWithCount").replace("{count}", String(hospitals.length))
  : tCh("seoDescription");
const path = "/compare/hospitals";

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  { name: tCh("breadcrumbCompare"), url: localeUrl(locale, path) },
]);

// Never cache — result depends on user's slug list
Astro.response.headers.set("Cache-Control", "private, no-store");

// Pre-format pricing per hospital using the user's currency cookie. We can't
// `await` inside the sync `render` callbacks below, so build the map up-front.
const pricingByHospital = new Map<number, string>();
for (const h of hospitals) {
  if (!h.pricing) continue;
  const lo = await formatUsd(Astro.cookies, h.pricing.lo);
  const hi = await formatUsd(Astro.cookies, h.pricing.hi);
  pricingByHospital.set(h.id, `${lo} — ${hi} · ${h.pricing.n} procedures`);
}

// Rows configuration — one row per comparable attribute.
type Row = {
  key: string;
  label: string;
  render: (h: (typeof hospitals)[number]) => string;
};
const rows: Row[] = [
  {
    key: "location",
    label: tCh("rowLocation"),
    render: (h) => `${h.cityName}, ${h.countryName}`,
  },
  {
    key: "rating",
    label: tCh("rowRating"),
    render: (h) => h.rating && Number(h.rating) > 0
      ? `★ ${Number(h.rating).toFixed(1)}${h.reviewCount ? ` (${h.reviewCount.toLocaleString()})` : ""}`
      : "—",
  },
  {
    key: "accreditations",
    label: tCh("rowAccreditations"),
    render: (h) => (h.accreditations.length > 0 ? h.accreditations.join(", ") : "—"),
  },
  {
    key: "beds",
    label: tCh("rowBeds"),
    render: (h) => h.bedCapacity ? h.bedCapacity.toLocaleString() : "—",
  },
  {
    key: "established",
    label: tCh("rowEstablished"),
    render: (h) => h.establishedYear ? String(h.establishedYear) : "—",
  },
  {
    key: "airport",
    label: tCh("rowAirportDistance"),
    render: (h) => h.airportDistanceKm != null ? `${h.airportDistanceKm} km` : "—",
  },
  {
    key: "pricing",
    label: tCh("rowTreatmentPricing"),
    render: (h) => pricingByHospital.get(h.id) ?? "—",
  },
  {
    key: "specialties",
    label: tCh("rowSpecialties"),
    render: (h) => h.specialties.length > 0
      ? h.specialties.slice(0, 10).map((s) => s.name).join(", ")
      : "—",
  },
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/hospitals")} class="hover:text-accent">{tc("hospitals")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{tCh("breadcrumbCompare")}</span>
      </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-6">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {tCh("eyebrowSideBySide")}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.025em;">
        {tCh("h1")}
      </h1>
      <p class="lede mt-4 max-w-[42rem]">
        {hospitals.length > 0
          ? tCh("ledeWithCount").replace("{count}", String(hospitals.length))
          : tCh("ledeEmpty")}
      </p>

      {hospitals.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2 mono uppercase" style="font-size: 11px; letter-spacing: 0.1em;">
          <a
            href={`mailto:?subject=${encodeURIComponent("MedCasts hospital shortlist")}&body=${encodeURIComponent(
              `My shortlist (${hospitals.length} ${hospitals.length === 1 ? "hospital" : "hospitals"}):\n\n` +
              hospitals.map((h, i) => {
                const country = h.countryName ?? "";
                const lo = h.pricing ? `from $${h.pricing.lo.toLocaleString()}` : "";
                return `${i + 1}. ${h.name}${h.cityName ? ` — ${h.cityName}` : ""}${country ? `, ${country}` : ""}${lo ? `\n   ${lo}` : ""}\n   https://medcasts.com${localizedPath(locale, `/hospital/${h.slug}`)}`;
              }).join("\n\n") +
              `\n\n— Compare side-by-side: https://medcasts.com${localizedPath(locale, path)}?ids=${hospitals.map((h) => h.slug).join(",")}`,
            )}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 hover:border-ink"
            style="color: var(--color-ink);"
          >
            <span aria-hidden="true">✉</span>
            {tCh("emailThisList")}
          </a>
          <button
            type="button"
            data-share-list
            data-list-url={`https://medcasts.com${localizedPath(locale, path)}?ids=${hospitals.map((h) => h.slug).join(",")}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 hover:border-ink"
            style="color: var(--color-ink); background: none; cursor: pointer;"
          >
            <span aria-hidden="true">🔗</span>
            {tCh("copyLink")}
          </button>
        </div>
      )}
    </section>

    <script is:inline>
      (function () {
        var btn = document.querySelector("[data-share-list]");
        if (!btn) return;
        btn.addEventListener("click", async function () {
          var url = btn.getAttribute("data-list-url");
          if (!url) return;
          try {
            await navigator.clipboard.writeText(url);
            var orig = btn.innerHTML;
            btn.innerHTML = '<span aria-hidden="true">✓</span> Copied';
            setTimeout(function () { btn.innerHTML = orig; }, 1800);
          } catch (e) {
            // Clipboard blocked — fall back to a window prompt for manual copy.
            window.prompt("Copy your shortlist URL:", url);
          }
        });
      })();
    </script>

    {hospitals.length === 0 && (
      <section class="mx-auto max-w-3xl px-6 pb-20">
        <div class="paper p-8 text-center" style="color: var(--color-ink-muted);">
          <p class="serif text-lg mb-3">{tCh("emptyHeading")}</p>
          <p class="text-sm mb-5">
            {tCh("emptyBody")}
          </p>
          <a
            href={localizedPath(locale, "/hospitals")}
            class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            {tCh("emptyBrowseCta")}
          </a>
        </div>
      </section>
    )}

    {hospitals.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 md:px-6 pb-20">
        <div class="overflow-x-auto -mx-4 md:mx-0">
          <table class="min-w-full border-separate" style="border-spacing: 0;">
            <caption class="sr-only">{tCh("tableCaption")}</caption>
            <thead>
              <tr>
                <th scope="col" class="w-36 md:w-44 text-start align-top p-3 md:p-4"></th>
                {hospitals.map((h) => (
                  <th scope="col" class="min-w-[15rem] p-3 md:p-4 text-start align-top" style="border-bottom: 1px solid var(--color-border);">
                    <div class="rounded-xl overflow-hidden border border-border bg-surface">
                      <div class="relative aspect-[16/9] bg-subtle">
                        <img src={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: h.countrySlug })} alt={`${h.name} — ${h.cityName ?? ""}`} width="480" height="270" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                        <div class="image-veil" />
                      </div>
                      <div class="p-3.5">
                        <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                          {h.cityName}, {h.countryName}
                        </p>
                        <a href={localizedPath(locale, `/hospital/${h.slug}`)} class="mt-1 block font-display text-[17px] leading-snug text-ink hover:text-accent line-clamp-2">
                          {h.name}
                        </a>
                        <div class="mt-3 flex items-center gap-3">
                          <a
                            href={localizedPath(locale, `/hospital/${h.slug}`)}
                            class="inline-flex items-center rounded-lg bg-accent px-3 py-1.5 text-[12px] font-semibold text-accent-contrast hover:bg-accent-hover"
                          >
                            {tCh("cardOpen")}
                          </a>
                          <a
                            href={localizedPath(locale, `/contact?hospital=${h.slug}`)}
                            class="inline-flex items-center rounded-lg border border-border px-3 py-1.5 text-[12px] font-semibold hover:border-border-strong"
                          >
                            {tCh("cardQuote")}
                          </a>
                        </div>
                      </div>
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row" class="align-top p-3 md:p-4 text-start" style="border-bottom: 1px solid var(--color-border-soft); color: var(--color-ink-subtle);">
                    <span class="mono uppercase" style="font-size: 10.5px; letter-spacing: 0.14em;">
                      {r.label}
                    </span>
                  </th>
                  {hospitals.map((h) => (
                    <td class="align-top p-3 md:p-4 text-[14px] text-ink" style="border-bottom: 1px solid var(--color-border-soft);">
                      {r.render(h)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-[12.5px] text-ink-subtle">
          {tCh("footerNeedHelp")}{" "}
          <a href={localizedPath(locale, "/calculator")} class="underline hover:text-accent">{tCh("footerRunCalculator")}</a>{" "}
          {tCh("footerOr")}{" "}
          <a href={localizedPath(locale, "/contact")} class="underline hover:text-accent">{tCh("footerRequestShortlist")}</a>{" "}
          {tCh("footerCaseManager")}
        </p>
      </section>
    )}

    <HowItWorks
      heading={tCh("howItWorksHeading")}
      italicWord={tCh("howItWorksItalic")}
      eyebrow={tCh("howItWorksEyebrow")}
      steps={[
        { title: tCh("howStep1Title"), description: tCh("howStep1Desc") },
        { title: tCh("howStep2Title"), description: tCh("howStep2Desc") },
        { title: tCh("howStep3Title"), description: tCh("howStep3Desc") },
        { title: tCh("howStep4Title"), description: tCh("howStep4Desc") },
        { title: tCh("howStep5Title"), description: tCh("howStep5Desc") },
      ]}
    />

    <WhatToExpect
      heading={tCh("whatHeading")}
      italicWord={tCh("whatItalic")}
      items={[
        { label: tCh("whatLabel1"), description: tCh("whatDesc1") },
        { label: tCh("whatLabel2"), description: tCh("whatDesc2") },
        { label: tCh("whatLabel3"), description: tCh("whatDesc3") },
        { label: tCh("whatLabel4"), description: tCh("whatDesc4") },
        { label: tCh("whatLabel5"), description: tCh("whatDesc5") },
      ]}
    />

    
    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
