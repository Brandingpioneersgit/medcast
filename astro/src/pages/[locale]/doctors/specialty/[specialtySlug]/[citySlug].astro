---
import { isLocale, localizedPath } from "@/lib/i18n";

export const prerender = false;

// Legacy path. /surgeons/[specialty]/[city] is now a real page (it accepts
// both country and city slugs), so this just 308s straight there — the target
// page handles the thin-inventory fallback to the country list itself.
const rawLocale = Astro.params.locale ?? "en";
const specialtySlug = Astro.params.specialtySlug;
const citySlug = Astro.params.citySlug;
if (!specialtySlug || !citySlug) return new Response("Not found", { status: 404 });
const locale = isLocale(rawLocale) ? rawLocale : "en";

const target = localizedPath(
  locale,
  `/surgeons/${encodeURIComponent(specialtySlug)}/${encodeURIComponent(citySlug)}`,
);
return new Response(null, {
  status: 308,
  headers: { Location: target, "Cache-Control": "public, max-age=86400, s-maxage=604800" },
});
---
