---
import { isLocale, localizedPath } from "@/lib/i18n";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const citySlug = Astro.params.citySlug;
if (!citySlug) return new Response("Not found", { status: 404 });
const locale = isLocale(rawLocale) ? rawLocale : "en";
const target = localizedPath(locale, `/city/${encodeURIComponent(citySlug)}`);
return new Response(null, {
  status: 308,
  headers: { Location: target, "Cache-Control": "public, max-age=86400, s-maxage=604800" },
});
---
