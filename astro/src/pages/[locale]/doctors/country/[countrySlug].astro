---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsAppDoctorCta from "@/components/WhatsAppDoctorCta.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import Pagination from "@/components/Pagination.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listDoctors, listDoctorSpecialtiesForPlace, getGeoCountry } from "@/lib/queries";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { ChevronRight } from "lucide-react";
import { doctorPortrait, countryBanner } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const countrySlug = Astro.params.countrySlug;
if (!countrySlug) return new Response("Not found", { status: 404 });
if (!isLocale(rawLocale)) return Astro.redirect(`/en/doctors/country/${countrySlug}`, 308);
const locale = rawLocale as Locale;

const countryRow = await getGeoCountry(countrySlug);
if (!countryRow) return new Response(`Not found: ${countrySlug}`, { status: 404 });

const url = new URL(Astro.request.url);
const pageParam = parseInt(url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const sortParam = url.searchParams.get("sort");
const sort: "featured" | "rating" | "experience" | "reviews" =
  sortParam === "rating" || sortParam === "experience" || sortParam === "reviews"
    ? sortParam
    : "featured";
const specialtyFilter = url.searchParams.get("specialty")?.trim() || "";

const [{ rows: rawRows, total, totalPages }, rawSpecialties] = await Promise.all([
  listDoctors({
    page,
    sort,
    country: [countrySlug],
    specialty: specialtyFilter ? [specialtyFilter] : undefined,
  }),
  listDoctorSpecialtiesForPlace({ countrySlug }),
]);

// Localize DB content for non-default locales (getContent/getContentBatch
// return {} on `en`, so applyTranslated is a no-op there).
const countryMap = await getContent("country", countryRow.id, locale);
const country = applyTranslated(countryRow, countryMap, ["name"]);
const doctorTx = await getContentBatch("doctor", rawRows.map((d) => d.id), locale);
const rows = rawRows.map((d) => applyTranslated(d, doctorTx[d.id] ?? {}, ["name", "qualifications"]));
const specialtyTx = await getContentBatch("specialty", rawSpecialties.map((s) => s.id), locale);
const placeSpecialties = rawSpecialties.map((s) => applyTranslated(s, specialtyTx[s.id] ?? {}, ["name"]));

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  "united-arab-emirates": "🇦🇪", germany: "🇩🇪", singapore: "🇸🇬",
  "south-korea": "🇰🇷", malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
const flag = FLAG_MAP[countrySlug] ?? "🌐";

const tc = getTranslator(locale, "common");
const tDco = getTranslator(locale, "doctorsCountryPage");
const countText = total.toLocaleString();
const activeSpecialty = placeSpecialties.find((s) => s.slug === specialtyFilter) ?? null;
const specialtyLabel = activeSpecialty ? `${activeSpecialty.name} ` : "";

const path = `/doctors/country/${countrySlug}`;
const seoTitle = activeSpecialty
  ? tDco("seoTitleWithSpecialty").replace("{specialty}", activeSpecialty.name).replace("{country}", country.name).replace("{count}", countText)
  : tDco("seoTitleDefault").replace("{country}", country.name).replace("{count}", countText);
const seoDescription = tDco("seoDescription")
  .replace("{count}", countText)
  .replace("{specialtyLabel}", specialtyLabel)
  .replace("{country}", country.name)
  .slice(0, 160);

// Filtered + paged states are noindex; the clean country URL is the canonical.
const shouldNoindex = page > 1 || specialtyFilter.length > 0 || total === 0 || isUntranslated(locale, countryMap);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("doctors"), url: localeUrl(locale, "/doctors") },
  { name: country.name, url: localeUrl(locale, path) },
]);

const collectionLd =
  page === 1 && !specialtyFilter && rows.length > 0
    ? withProvenance(
        collectionPageJsonLd({
          name: `Doctors in ${country.name}`,
          description: seoDescription,
          url: localeUrl(locale, path),
          items: rows.map((d) => ({
            name: `${d.title ?? "Dr."} ${d.name}`.replace(/^Dr\.?\s+Dr\.?/i, "Dr."),
            url: localeUrl(locale, `/doctor/${d.slug}`),
          })),
        }),
        { dateModified: new Date() },
      )
    : null;

function buildHref(patch: { sort?: string; specialty?: string | null; page?: number }): string {
  const params = new URLSearchParams();
  const s = patch.sort ?? sort;
  const sp = patch.specialty !== undefined ? patch.specialty : specialtyFilter;
  const p = patch.page ?? 1;
  if (s && s !== "featured") params.set("sort", s);
  if (sp) params.set("specialty", sp);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  const base = localizedPath(locale, path);
  return qs ? `${base}?${qs}` : base;
}

const prevUrl = page > 1 ? buildHref({ page: page - 1 }) : undefined;
const nextUrl = page < totalPages ? buildHref({ page: page + 1 }) : undefined;

const SORTS = [
  { value: "featured", label: tDco("sortFeatured") },
  { value: "rating", label: tDco("sortTopRated") },
  { value: "experience", label: tDco("sortMostExperienced") },
  { value: "reviews", label: tDco("sortMostReviewed") },
];

const stats =
  page === 1 && !specialtyFilter
    ? [
        { l: tDco("statSpecialists"), v: countText },
        { l: tDco("statSpecialties"), v: placeSpecialties.length.toLocaleString() },
        { l: tDco("statDestination"), v: country.name },
        { l: tDco("statReplyTime"), v: tDco("statReplyTimeValue") },
      ]
    : [];

function cleanName(name: string) {
  return name.replace(/^Dr\.?\s*/i, "");
}
function firstWord(s: string) { const i = s.indexOf(" "); return i === -1 ? s : s.slice(0, i); }
function restOfName(s: string) { const i = s.indexOf(" "); return i === -1 ? "" : s.slice(i + 1); }

Astro.response.headers.set("Cache-Control", "public, s-maxage=1800, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      noindex={shouldNoindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {collectionLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/doctors")} class="hover:text-ink">{tDco("breadcrumbDoctors")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{country.name}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tDco("heroEyebrow").replace("{flag}", flag).replace("{count}", countText).replace("{country}", country.name)}
      h1First={tDco("heroH1First")}
      h1Italic={country.name}
      lede={tDco("heroLede").replace("{country}", country.name)}
      stats={stats}
      locale={locale}
      image={countryBanner(countrySlug)}
      imageAlt={tDco("heroImageAlt").replace("{country}", country.name)}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-6 pb-20">
      {placeSpecialties.length > 0 && (
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span class="mono uppercase pe-1" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tDco("filterSpecialtyLabel")}
          </span>
          <a
            href={buildHref({ specialty: null })}
            class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
            style={!specialtyFilter
              ? "background: var(--color-ink); color: var(--color-bg);"
              : "color: var(--color-ink-muted); border: 1px solid var(--color-border);"}
          >
            {tDco("filterAll")}
          </a>
          {placeSpecialties.map((s) => (
            <a
              href={buildHref({ specialty: s.slug })}
              class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
              style={specialtyFilter === s.slug
                ? "background: var(--color-ink); color: var(--color-bg);"
                : "color: var(--color-ink-muted); border: 1px solid var(--color-border);"}
            >
              {s.name} <span class="tnum" style="opacity: 0.6;">{s.n}</span>
            </a>
          ))}
        </div>
      )}

      <div
        class="mb-6 flex flex-wrap items-center justify-between gap-3 pb-4"
        style="border-bottom: 1px solid var(--color-border);"
      >
        <span class="serif text-[14px]" style="color: var(--color-ink-muted);">
          <span class="display tnum text-ink">{countText}</span> {activeSpecialty ? `${activeSpecialty.name.toLowerCase()} ` : ""}{total === 1 ? tDco("resultsSpecialist") : tDco("resultsSpecialists")}
          {totalPages > 1 && (
            <span class="ms-2 mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
              {tDco("resultsPage")} {page} {tDco("resultsOf")} {totalPages}
            </span>
          )}
        </span>
        <div class="flex items-center gap-1 -mx-1 overflow-x-auto">
          <span class="mono uppercase px-1 whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
            {tDco("sortLabel")}
          </span>
          {SORTS.map((o) => {
            const active = sort === o.value;
            return (
              <a
                href={buildHref({ sort: o.value })}
                class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
                style={active
                  ? "background: var(--color-ink); color: var(--color-bg);"
                  : "color: var(--color-ink-muted);"}
              >
                {o.label}
              </a>
            );
          })}
        </div>
      </div>

      <h2 class="sr-only">{tDco("srHeading").replace("{country}", country.name)}</h2>

      {rows.length === 0 ? (
        <div class="paper text-center py-20" style="color: var(--color-ink-muted);">
          <p class="serif text-lg mb-3">{activeSpecialty ? tDco("emptyTitleWithSpecialty").replace("{country}", country.name).replace("{specialty}", activeSpecialty.name.toLowerCase()) : tDco("emptyTitle").replace("{country}", country.name)}</p>
          <p class="text-sm mb-5">{tDco("emptyBody")}</p>
          <div class="flex items-center justify-center gap-3">
            <a
              href={localizedPath(locale, "/doctors/country/" + countrySlug)}
              class="mono uppercase"
              style="font-size: 11px; letter-spacing: 0.12em; border: 1px solid var(--color-border); padding: 9px 16px; border-radius: 9999px; color: var(--color-ink);"
            >
              {tDco("emptyAllDoctors").replace("{country}", country.name)}
            </a>
            <a
              href={localizedPath(locale, "/match-me")}
              class="mono uppercase"
              style="font-size: 11px; letter-spacing: 0.12em; background: var(--color-ink); color: var(--color-bg); padding: 9px 16px; border-radius: 9999px;"
            >
              {tDco("emptyMatchMe")}
            </a>
          </div>
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {rows.map((d) => {
            const clean = cleanName(d.name);
            return (
              <li class="flex flex-col gap-2.5">
                <a
                  href={localizedPath(locale, `/doctor/${d.slug}`)}
                  class="paper group flex flex-1 flex-col overflow-hidden transition hover:-translate-y-0.5"
                  style="padding: 0;"
                >
                  <div class="w-full overflow-hidden" style="aspect-ratio: 4/5; background: linear-gradient(135deg, #0A5D54 0%, #0D7C70 60%, #1C2A25 100%);">
                    <img
                      src={doctorPortrait({ imageUrl: d.imageUrl, id: d.id }, 400)}
                      alt={d.name}
                      width="320"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div class="p-5 flex flex-col flex-1">
                    {d.title && (
                      <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-accent);">
                        {d.title}
                      </div>
                    )}
                    <div class="serif mt-1" style="font-size: 19px; line-height: 1.2; letter-spacing: -0.005em; color: var(--color-ink);">
                      {firstWord(clean)}{restOfName(clean) && <> <span class="italic-display">{restOfName(clean)}</span></>}
                    </div>
                    {d.qualifications && (
                      <div class="mt-2 mono text-[10px] uppercase tracking-wider line-clamp-1" style="color: var(--color-ink-subtle);">
                        {d.qualifications}
                      </div>
                    )}
                    {d.hospitalName && (
                      <div class="mt-2 text-[12.5px] line-clamp-1" style="color: var(--color-ink-muted);">
                        {d.hospitalName}{d.cityName && <> · {d.cityName}</>}
                      </div>
                    )}
                    <div
                      class="mt-auto flex items-center justify-between"
                      style="border-top: 1px dashed var(--color-border); margin-top: 12px; padding-top: 10px;"
                    >
                      <div class="flex items-center gap-3 text-[12px]" style="color: var(--color-ink-subtle);">
                        {d.experienceYears && <span class="tnum">{d.experienceYears}yr</span>}
                        {d.rating && Number(d.rating) > 0 && (
                          <span class="tnum inline-flex items-center gap-1">
                            <span style="color: var(--color-saffron);">★</span>
                            {Number(d.rating).toFixed(1)}
                          </span>
                        )}
                        {d.reviewCount && d.reviewCount > 0 && (
                          <span class="tnum" style="color: var(--color-ink-subtle); opacity: 0.7;">
                            ({d.reviewCount.toLocaleString()})
                          </span>
                        )}
                      </div>
                      <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                    </div>
                  </div>
                </a>
                <WhatsAppDoctorCta doctorName={d.name} doctorSlug={d.slug} hospitalName={d.hospitalName} />
              </li>
            );
          })}
        </ul>
      )}

      <Pagination page={page} totalPages={totalPages} basePath={buildHref({})} />
    </section>

    <HowItWorks
      heading={tDco("howHeading").replace("{country}", country.name)}
      italicWord={country.name}
      eyebrow={tDco("howEyebrow")}
      steps={[
        { title: tDco("howStep1Title"), description: tDco("howStep1Desc") },
        { title: tDco("howStep2Title"), description: tDco("howStep2Desc") },
        { title: tDco("howStep3Title"), description: tDco("howStep3Desc") },
        { title: tDco("howStep4Title"), description: tDco("howStep4Desc").replace("{country}", country.name) },
        { title: tDco("howStep5Title"), description: tDco("howStep5Desc") },
      ]}
      outroNote={tDco("howOutroNote")}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tDco("exploreEyebrow").replace("{country}", country.name)}
      heading={tDco("exploreHeading").replace("{country}", country.name)}
      lede={tDco("exploreLede")}
      items={[
        { eyebrow: tDco("exploreEyebrowSurgeons"), label: tDco("exploreLabelSurgeons").replace("{country}", country.name), href: `/surgeons/country/${countrySlug}`, hint: tDco("exploreHintSurgeons") },
        { eyebrow: tDco("exploreEyebrowDestination"), label: tDco("exploreLabelDestination").replace("{country}", country.name), href: `/country/${countrySlug}`, hint: tDco("exploreHintDestination").replace("{country}", country.name) },
        { eyebrow: tDco("exploreEyebrowHospitals"), label: tDco("exploreLabelHospitals").replace("{country}", country.name), href: `/hospitals/country/${countrySlug}`, hint: tDco("exploreHintHospitals") },
        { eyebrow: tDco("exploreEyebrowCosts"), label: tDco("exploreLabelCosts").replace("{country}", country.name), href: `/treatments/country/${countrySlug}`, hint: tDco("exploreHintCosts") },
        { eyebrow: tDco("exploreEyebrowVisa"), label: tDco("exploreLabelVisa").replace("{country}", country.name), href: `/visa/${countrySlug}`, hint: tDco("exploreHintVisa") },
        ...(placeSpecialties[0] ? [{ eyebrow: tDco("exploreEyebrowSpecialty"), label: tDco("exploreLabelSpecialty").replace("{specialty}", placeSpecialties[0].name), href: `/specialty/${placeSpecialties[0].slug}`, hint: tDco("exploreHintSpecialty").replace("{count}", String(placeSpecialties[0].n)) }] : []),
        { eyebrow: tDco("exploreEyebrowBrowse"), label: tDco("exploreLabelAllDoctors"), href: "/doctors", hint: tDco("exploreHintAllDoctors") },
        { eyebrow: tDco("exploreEyebrowCompare"), label: tDco("exploreLabelDoctorComparison"), href: "/compare/doctors", hint: tDco("exploreHintDoctorComparison") },
        { eyebrow: tDco("exploreEyebrowTool"), label: tDco("exploreLabelMatchMe"), href: "/match-me", hint: tDco("exploreHintMatchMe") },
        { eyebrow: tDco("exploreEyebrowAction"), label: tDco("exploreLabelSecondOpinion"), href: "/second-opinion", hint: tDco("exploreHintSecondOpinion") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
