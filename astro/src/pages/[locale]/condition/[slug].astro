---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import SpecialtyBanner from "@/components/SpecialtyBanner.astro";
import { getConditionBySlug, listFaqsFor, getReviewerFor, listCitationsFor, listLinkableEntities } from "@/lib/queries";
import { linkifyBlogHtml } from "@/lib/content-linker";
import ExploreGrid from "@/components/ExploreGrid.astro";
import Citations from "@/components/content/Citations.astro";
import { getConditionSections } from "@/lib/content-sections";
import ReviewedBy from "@/components/ReviewedBy.astro";
import ConditionContext from "@/components/content/ConditionContext.astro";
import MethodologyBlock from "@/components/content/MethodologyBlock.astro";
import MobileQuoteBar from "@/components/MobileQuoteBar.astro";
import EngagementFab from "@/components/EngagementFab.astro";
import {
  getContent,
  getContentBatch,
  applyTranslated,
  isUntranslated,
  localizedTitle,
  localizedDescription,
} from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, medicalConditionJsonLd, withProvenance, faqJsonLd, reviewerFromDbRow } from "@/lib/seo";
import { ChevronRight } from "lucide-react";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/condition/${slug}`, 308);
if (!slug) return new Response("Not found", { status: 404 });

const locale = rawLocale as Locale;
const [conditionRaw, linkables] = await Promise.all([
  getConditionBySlug(slug),
  listLinkableEntities().catch(() => [] as Awaited<ReturnType<typeof listLinkableEntities>>),
]);
if (!conditionRaw) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");

const specialtyIds = (conditionRaw.specialties ?? []).map((cs) => cs.specialty.id);
const treatmentIds = (conditionRaw.treatments ?? []).map((ct) => ct.treatment.id);
const [conditionMap, specialtyMap, treatmentMap, faqRows, reviewer, citations, conditionContentRow] = await Promise.all([
  getContent("condition", conditionRaw.id, locale),
  getContentBatch("specialty", specialtyIds, locale),
  getContentBatch("treatment", treatmentIds, locale),
  listFaqsFor("condition", conditionRaw.id),
  getReviewerFor("condition", conditionRaw.id),
  listCitationsFor("condition", conditionRaw.id),
  getConditionSections(conditionRaw.id),
]);
const condition = applyTranslated(conditionRaw, conditionMap, ["name", "description"]);
const conditionSpecialties = (conditionRaw.specialties ?? []).map((cs) => ({
  ...cs,
  specialty: applyTranslated(cs.specialty, specialtyMap[cs.specialty.id] ?? {}, ["name"]),
}));
const conditionTreatments = (conditionRaw.treatments ?? []).map((ct) => ({
  ...ct,
  treatment: applyTranslated(ct.treatment, treatmentMap[ct.treatment.id] ?? {}, ["name"]),
}));
const condSections = conditionContentRow?.content_sections ?? null;
const faqSchema = faqRows.length > 0 ? faqJsonLd(faqRows) : null;

const descriptionParas = (condition.description ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const descriptionLede = descriptionParas[0] ?? null;
const descriptionRest = descriptionParas.slice(1);

const filteredLinkables = linkables.filter(
  (e) => !(e.kind === "condition" && e.slug === conditionRaw.slug),
);
const descriptionLedeHtml = descriptionLede
  ? linkifyBlogHtml(
      `<p>${descriptionLede.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`,
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";
const descriptionRestHtml = descriptionRest.length > 0
  ? linkifyBlogHtml(
      descriptionRest.map((p) => `<p>${p.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>`).join("\n"),
      filteredLinkables,
      (p: string) => localizedPath(locale, p),
    ).html
  : "";

function firstWord(s: string) { const i = s.indexOf(" "); return i === -1 ? s : s.slice(0, i); }
function restOfName(s: string) { const i = s.indexOf(" "); return i === -1 ? "" : s.slice(i + 1); }

const severity = condition.severityLevel?.toLowerCase() ?? null;
const severityLabel = severity ? severity.charAt(0).toUpperCase() + severity.slice(1) : null;
const severityStyle = severity === "severe"
  ? "border-color: color-mix(in srgb, var(--color-coral) 45%, transparent); background: color-mix(in srgb, var(--color-coral) 14%, transparent); color: var(--color-coral);"
  : severity === "moderate"
  ? "border-color: color-mix(in srgb, var(--color-saffron) 55%, transparent); background: color-mix(in srgb, var(--color-saffron) 16%, transparent); color: var(--color-ink);"
  : "border-color: var(--color-border); background: var(--color-paper); color: var(--color-ink-muted);";

const stats = [
  { l: "Treatment paths", v: conditionTreatments.length.toString() },
  { l: "Specialties", v: conditionSpecialties.length.toString() },
  severityLabel ? { l: "Typical severity", v: severityLabel } : null,
].filter(Boolean) as Array<{ l: string; v: string }>;

const seoFallbackDesc = `${condition.name} — overview, treatment paths, and ${conditionTreatments.length} options across accredited hospitals.`;
const seoTitle = localizedTitle(locale, condition.name, condition.metaTitle, conditionMap);
const seoDescription = localizedDescription(
  locale,
  descriptionLede,
  condition.metaDescription,
  seoFallbackDesc,
  conditionMap,
);

const path = `/condition/${slug}`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: "Conditions", url: localeUrl(locale, "/conditions") },
  { name: condition.name, url },
]);

const conditionLd = withProvenance(
  medicalConditionJsonLd({
    name: condition.name,
    description: condition.description,
    url,
    possibleTreatment: conditionTreatments.map((ct) => ({
      name: ct.treatment.name,
      url: localeUrl(locale, `/treatment/${ct.treatment.slug}`),
    })),
    relevantSpecialty: conditionSpecialties.map((cs) => ({
      name: cs.specialty.name,
      url: localeUrl(locale, `/specialty/${cs.specialty.slug}`),
    })),
  }),
  {
    dateModified: reviewer?.reviewedAt ?? conditionRaw.updatedAt,
    dateCreated: conditionRaw.createdAt,
    reviewer: reviewerFromDbRow(reviewer),
  },
);

const untranslated = isUntranslated(locale, conditionMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(conditionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/conditions")} class="hover:text-ink">Conditions</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{condition.name}</span>
        </nav>
      </div>
    </div>

    <section class="pt-12 md:pt-16">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8">
        <div class="flex items-center gap-3 flex-wrap">
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">
            Condition · {conditionTreatments.length} treatment path{conditionTreatments.length === 1 ? "" : "s"}
          </p>
          {severityLabel && (
            <span
              class="inline-flex items-center gap-1.5 mono uppercase"
              style={`font-size: 9.5px; letter-spacing: 0.14em; padding: 3px 10px; border-radius: 9999px; border: 1px solid; ${severityStyle}`}
            >
              <span class="h-1.5 w-1.5 rounded-full" style="background: currentColor;" aria-hidden="true" />
              {severityLabel}
            </span>
          )}
        </div>
        <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14 mt-3">
          <div>
            <h1
              class="display display-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.03em;"
            >
              {firstWord(condition.name)}{" "}
              <span class="italic-display">{restOfName(condition.name) || " "}</span>
            </h1>
            {descriptionLede && (
              <div class="serif mt-5 max-w-[44rem]" style="font-size: 19px; line-height: 1.5; color: var(--color-ink-muted);" set:html={descriptionLedeHtml} />
            )}
            <LastUpdated updated={conditionRaw.updatedAt} locale={locale} class="mt-5" />
            <div class="mt-3"><ReviewedBy reviewer={reviewer} locale={locale} /></div>

            {stats.length > 0 && (
              <div
                class="mt-8 grid"
                style={`grid-template-columns: repeat(${stats.length}, minmax(0,1fr)); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border);`}
              >
                {stats.map((s, i) => (
                  <div
                    class="px-4 md:px-5 py-5"
                    style={i > 0 ? "border-inline-start: 1px solid var(--color-border);" : ""}
                  >
                    <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-ink-subtle);">
                      {s.l}
                    </div>
                    <div class="display mt-1.5" style="font-size: 28px;">{s.v}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="lg:sticky lg:top-32 lg:self-start" style="max-width: 380px;">
            <SpecialtyBanner
              slug={conditionSpecialties[0]?.specialty?.slug ?? null}
              name={conditionSpecialties[0]?.specialty?.name ?? condition.name}
              aspect="5/4"
              label={`${condition.name} · case review`}
            />
            <div class="paper mt-4" style="padding: 16px 18px;">
              <div class="mono uppercase" style="font-size: 9.5px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Free second opinion
              </div>
              <div class="serif mt-1.5" style="font-size: 16px; line-height: 1.4;">
                Send your imaging + plan. Board-reviewed opinion in 5–10 working days.
              </div>
              <a
                href={localizedPath(locale, `/second-opinion?condition=${slug}`)}
                class="mt-3 inline-flex items-center gap-1 text-sm font-semibold"
                style="background: var(--color-ink); color: var(--color-bg); padding: 10px 16px; border-radius: 9999px;"
              >
                Request opinion
                <ChevronRight className="h-3.5 w-3.5 mirror-x" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {descriptionRest.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft); margin-top: 56px;">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                About {condition.name.toLowerCase()}
              </div>
              <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
                What to know
              </h2>
            </div>
            <div class="prose-editorial" set:html={descriptionRestHtml} />
          </div>
        </div>
      </section>
    )}

    {/* Deep condition sections (workup, second-opinion triggers, prompts, destinations) */}
    {condSections && (
      <>
        {condSections.workupBeforeYouFly && condSections.workupBeforeYouFly.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    Pre-flight workup
                  </div>
                  <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                    Tests to <span style="font-style: italic;">have already done</span>
                  </h2>
                </div>
                <ul class="space-y-3">
                  {condSections.workupBeforeYouFly.map((w) => (
                    <li class="flex gap-3" style="font-size: 15.5px; line-height: 1.55;">
                      <span style="color: var(--color-accent);">→</span>
                      <span>{w}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        )}

        {condSections.whenToSecondOpinion && condSections.whenToSecondOpinion.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    Second opinion
                  </div>
                  <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                    When to <span style="font-style: italic;">get a second look</span>
                  </h2>
                </div>
                <ul class="space-y-3">
                  {condSections.whenToSecondOpinion.map((w) => (
                    <li class="flex gap-3 items-start" style="font-size: 15.5px; line-height: 1.55;">
                      <span style="color: var(--color-coral, var(--color-coral));">!</span>
                      <span>{w}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        )}

        {condSections.patientPrompts && condSections.patientPrompts.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    Talking to your doctor
                  </div>
                  <h2 class="display mt-3" style="font-size: 26px; letter-spacing: -0.015em;">
                    Questions to <span style="font-style: italic;">ask</span>
                  </h2>
                </div>
                <ol class="space-y-3.5">
                  {condSections.patientPrompts.map((p, i) => (
                    <li class="flex gap-4" style="font-size: 16px; line-height: 1.55;">
                      <span class="display tnum" style="font-size: 24px; line-height: 1; opacity: 0.4; min-width: 32px;">{i + 1}.</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </section>
        )}

        {condSections.destinationNotes && condSections.destinationNotes.length > 0 && (
          <section style="padding: 56px 0; border-top: 1px solid var(--color-border-soft);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="mono uppercase mb-4" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                Destinations
              </div>
              <h2 class="display mb-7" style="font-size: 28px; letter-spacing: -0.02em;">
                Where this is <span style="font-style: italic;">commonly treated</span>
              </h2>
              <div class="grid gap-5 md:grid-cols-2">
                {condSections.destinationNotes.map((d) => (
                  <div class="paper" style="padding: 22px;">
                    <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.12em; color: var(--color-accent);">
                      {d.country}
                    </div>
                    <p class="mt-2.5" style="font-size: 15px; line-height: 1.55;">{d.note}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        {condSections.expectedPrognosis && (
          <section style="padding: 48px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper);">
            <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
              <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
                <div>
                  <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                    Outlook
                  </div>
                  <h2 class="display mt-3" style="font-size: 24px; letter-spacing: -0.015em;">Realistic prognosis</h2>
                </div>
                <p class="serif" style="font-size: 16.5px; line-height: 1.6;">{condSections.expectedPrognosis}</p>
              </div>
            </div>
          </section>
        )}
      </>
    )}

    {conditionSpecialties.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);" class:list={[descriptionRest.length === 0 && "mt-14"]}>
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="mb-6">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              01 · Specialties
            </div>
            <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
              Specialties that treat <span class="italic-display">{firstWord(condition.name)}</span>
            </h2>
          </div>
          <ul class="flex flex-wrap gap-2.5">
            {conditionSpecialties.map((cs) => (
              <li>
                <a
                  href={localizedPath(locale, `/specialty/${cs.specialty.slug}`)}
                  class="inline-flex items-center gap-2 mono uppercase hover:-translate-y-0.5 transition"
                  style="font-size: 11px; letter-spacing: 0.1em; border: 1px solid var(--color-accent); color: var(--color-accent); padding: 8px 14px; border-radius: 9999px;"
                >
                  {cs.specialty.name}
                  <ChevronRight className="h-3 w-3 mirror-x" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Doctors-for-condition teaser */}
    <section style="padding: 48px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <a
          href={localizedPath(locale, `/condition/${slug}/doctors`)}
          class="paper group flex items-center justify-between gap-4 transition hover:-translate-y-0.5"
          style="padding: 22px 26px;"
        >
          <div class="min-w-0">
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
              Specialists
            </div>
            <div class="serif mt-1" style="font-size: 21px; line-height: 1.3; color: var(--color-ink);">
              Doctors who treat {condition.name.toLowerCase()}
            </div>
            <div class="mt-1 text-[12.5px]" style="color: var(--color-ink-subtle);">
              Cross-hospital roster across {conditionSpecialties.length || 3}+ relevant specialties.
            </div>
          </div>
          <span
            class="inline-flex items-center gap-1.5 text-[12px] font-semibold shrink-0"
            style="background: var(--color-ink); color: var(--color-bg); padding: 9px 16px; border-radius: 9999px;"
          >
            View roster
            <ChevronRight className="h-3.5 w-3.5 mirror-x" />
          </span>
        </a>
      </div>
    </section>

    {/* Diagnostic workup — what to do BEFORE choosing a treatment */}
    {(() => {
      const tone = severity === "severe"
        ? { eyebrow: "var(--color-coral)", soft: "var(--color-coral-soft)", urgency: "Severe — workup typically within 48–72 hours" }
        : severity === "moderate"
        ? { eyebrow: "var(--color-saffron)", soft: "var(--color-saffron-soft)", urgency: "Moderate — workup within 1–2 weeks" }
        : { eyebrow: "var(--color-accent)", soft: "var(--color-accent-soft)", urgency: "Elective — workup at your pace" };
      const primarySpecialty = conditionSpecialties[0]?.specialty;
      const steps = [
        {
          n: "01",
          title: "Confirm the diagnosis on imaging or labs",
          body: `For ${condition.name.toLowerCase()}, plan on the workup your home doctor would order anyway — typically a recent specialist consult plus the imaging / labs the destination team will need to quote accurately. Anything older than 90 days usually gets re-done.`,
        },
        {
          n: "02",
          title: primarySpecialty ? `See a ${primarySpecialty.name.toLowerCase()} specialist locally first` : "See the relevant specialist locally first",
          body: "An in-person clinical exam at home — even a single consult — costs little and dramatically improves the destination plan. Bring back: written impression, recommended procedure, surgical-risk class, and any contra-indications.",
        },
        {
          n: "03",
          title: "Send us the file for a free second opinion",
          body: "Two surgeons in our medical panel review the workup independently. They tell you whether they'd operate, watch, or refer — even if that means recommending against travel. About 28% of cases we see end up not needing surgery at all.",
        },
        {
          n: "04",
          title: "Pick a path with timeline + cost in writing",
          body: "Once a treatment is the right call, we line up 2–3 hospital options with itemized quotes, surgeon profiles, and a travel timeline. You hold the file — switch hospitals or step away at any point.",
        },
      ];
      return (
        <section id="workup" style="padding: 72px 0; border-top: 1px solid var(--color-border-soft); background: var(--color-paper); scroll-margin-top: 140px;">
          <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
            <div class="grid gap-10 lg:grid-cols-[0.4fr_1fr]">
              <div>
                <div class="mono uppercase" style={`font-size: 11px; letter-spacing: 0.14em; color: ${tone.eyebrow};`}>
                  Diagnostic workup
                </div>
                <h2 class="display mt-3" style="font-size: 30px; letter-spacing: -0.02em; line-height: 1.05;">
                  Before you pick a hospital,
                  <span style="font-style: italic; font-weight: 300;"> get the workup right</span>
                </h2>
                <span
                  class="mono uppercase tnum mt-5 inline-block"
                  style={`font-size: 10px; letter-spacing: 0.12em; padding: 5px 12px; border-radius: 9999px; background: ${tone.soft}; color: ${tone.eyebrow};`}
                >{tone.urgency}</span>
                <p class="serif mt-5" style="font-size: 15px; line-height: 1.6; color: var(--color-ink-muted);">
                  Picking the right treatment is downstream of a complete diagnosis. Skip steps here and the destination surgeon usually re-orders them anyway — at higher cost and another week on the ground.
                </p>
              </div>
              <ol class="space-y-3">
                {steps.map((s) => (
                  <li class="paper" style="padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start;">
                    <div class="display tnum" style={`font-size: 26px; line-height: 1; color: ${tone.eyebrow}; opacity: 0.55;`}>{s.n}</div>
                    <div>
                      <div class="serif" style="font-size: 16.5px; line-height: 1.3; font-weight: 500; color: var(--color-ink);">{s.title}</div>
                      <p class="serif mt-1.5" style="font-size: 14.5px; line-height: 1.55; color: var(--color-ink-muted);">{s.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      );
    })()}

    {conditionTreatments.length > 0 && (
      <section style="padding: 72px 0; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                03 · Treatment paths
              </div>
              <h2 class="display mt-3" style="font-size: 32px; letter-spacing: -0.02em;">
                Treatment options
              </h2>
            </div>
            <a
              href={localizedPath(locale, "/treatments")}
              class="mono text-[11px] uppercase tracking-wider hover:text-accent"
              style="color: var(--color-ink-subtle);"
            >
              All treatments →
            </a>
          </div>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {conditionTreatments.map((ct) => (
              <li>
                <a
                  href={localizedPath(locale, `/treatment/${ct.treatment.slug}`)}
                  class="paper group flex h-full flex-col transition hover:-translate-y-0.5"
                  style="padding: 20px 22px;"
                >
                  {ct.treatment.specialty?.name && (
                    <div class="mono uppercase mb-2" style="font-size: 9.5px; letter-spacing: 0.12em; color: var(--color-accent);">
                      {ct.treatment.specialty.name}
                    </div>
                  )}
                  <div class="serif" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.005em; color: var(--color-ink);">
                    {ct.treatment.name}
                  </div>
                  {(ct.treatment.hospitalStayDays || ct.treatment.recoveryDays || ct.treatment.successRatePercent) && (
                    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[12px]" style="color: var(--color-ink-subtle);">
                      {ct.treatment.hospitalStayDays && <span class="tnum">{ct.treatment.hospitalStayDays}d stay</span>}
                      {ct.treatment.recoveryDays && <span class="tnum">{ct.treatment.recoveryDays}wk recovery</span>}
                      {ct.treatment.successRatePercent && <span class="tnum">{Number(ct.treatment.successRatePercent).toFixed(0)}% success</span>}
                    </div>
                  )}
                  <div
                    class="mt-auto flex items-center justify-between"
                    style="border-top: 1px dashed var(--color-border); margin-top: 16px; padding-top: 12px;"
                  >
                    <span class="mono text-[10px] uppercase tracking-wider" style="color: var(--color-ink-subtle);">
                      Compare hospitals
                    </span>
                    <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Where to be treated — links to /condition/[slug]/[country] */}
    <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="flex items-end justify-between flex-wrap gap-4 mb-7">
          <div>
            <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-accent);">
              Where to be treated
            </div>
            <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
              {condition.name} treatment <span style="font-style: italic;">by destination</span>
            </h2>
          </div>
          <a
            href={localizedPath(locale, `/contact?condition=${slug}`)}
            class="inline-flex items-center gap-1 text-sm"
            style="color: var(--color-accent);"
          >
            Get a panel match →
          </a>
        </div>
        <ul class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
          {[
            { slug: "india", name: "India", flag: "🇮🇳", note: "Best value · English" },
            { slug: "turkey", name: "Turkey", flag: "🇹🇷", note: "Cosmetic · cardiac" },
            { slug: "thailand", name: "Thailand", flag: "🇹🇭", note: "Wellness · dental" },
            { slug: "uae", name: "UAE", flag: "🇦🇪", note: "Premium · Arabic" },
            { slug: "germany", name: "Germany", flag: "🇩🇪", note: "Neuro · orthopedics" },
            { slug: "singapore", name: "Singapore", flag: "🇸🇬", note: "Complex oncology" },
            { slug: "south-korea", name: "South Korea", flag: "🇰🇷", note: "Aesthetic · stem cell" },
            { slug: "malaysia", name: "Malaysia", flag: "🇲🇾", note: "Mid-cost Asia" },
            { slug: "saudi-arabia", name: "Saudi Arabia", flag: "🇸🇦", note: "Gulf patients" },
          ].map((c) => (
            <li>
              <a
                href={localizedPath(locale, `/condition/${slug}/${c.slug}`)}
                class="paper block transition hover:-translate-y-0.5"
                style="padding: 16px 18px; box-shadow: var(--shadow-xs);"
              >
                <div class="flex items-center justify-between">
                  <span style="font-size: 22px;">{c.flag}</span>
                  <span class="mono" style="font-size: 9.5px; letter-spacing: 0.1em; color: var(--color-accent); text-transform: uppercase;">
                    Open →
                  </span>
                </div>
                <div class="serif mt-3" style="font-size: 17px; font-weight: 500; color: var(--color-ink);">
                  {c.name}
                </div>
                <div style="font-size: 12px; color: var(--color-ink-subtle); margin-top: 2px;">
                  {c.note}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {faqRows.length > 0 && (
      <section style="padding: 64px 0; border-top: 1px solid var(--color-border-soft);">
        <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
          <div class="grid gap-10 lg:grid-cols-[0.35fr_1fr]">
            <div>
              <div class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                04 · FAQ
              </div>
              <h2 class="display mt-3" style="font-size: 28px; line-height: 1.1; letter-spacing: -0.015em;">
                Common questions about {condition.name.toLowerCase()}
              </h2>
            </div>
            <div class="divide-y divide-[var(--color-border-soft)]">
              {faqRows.map((f) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer items-start justify-between gap-6 list-none" style="color: var(--color-ink);">
                    <span class="serif" style="font-size: 18px; line-height: 1.4; font-weight: 500;">{f.question}</span>
                    <span class="mt-1 shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-ink-subtle); font-size: 20px; line-height: 1;" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-3 serif" style="color: var(--color-ink-muted); font-size: 16px; line-height: 1.6;">{f.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section style="background: var(--color-ink); color: var(--color-bg); padding: 72px 0;">
      <div class="mx-auto w-full max-w-[80rem] px-5 md:px-8">
        <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr] items-end">
          <div>
            <div class="mono uppercase" style="font-size: 11px; letter-spacing: 0.16em; color: rgba(246,241,230,0.55);">
              Not sure which treatment fits
            </div>
            <h2 class="display mt-3" style="font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -0.02em; color: var(--color-bg);">
              Free second opinion on your <span class="italic-display">{firstWord(condition.name)}</span> case.
            </h2>
            <p class="serif mt-4 max-w-[42rem]" style="font-size: 17px; line-height: 1.5; color: rgba(246,241,230,0.75);">
              Share imaging and the current plan. Multidisciplinary board returns a written opinion within 5–10 working days — no obligation to travel.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <a
              href={localizedPath(locale, `/second-opinion?condition=${slug}`)}
              class="inline-flex items-center gap-2 font-semibold"
              style="background: var(--color-bg); color: var(--color-ink); padding: 14px 22px; border-radius: 9999px;"
            >
              Request opinion
              <ChevronRight className="h-4 w-4 mirror-x" />
            </a>
            <a
              href={localizedPath(locale, `/contact?condition=${slug}`)}
              class="inline-flex items-center gap-2 font-semibold"
              style="border: 1px solid rgba(246,241,230,0.35); color: var(--color-bg); padding: 13px 22px; border-radius: 9999px;"
            >
              Get a full quote
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Diagnostic workup + escalation guidance */}
    <ConditionContext
      conditionName={condition.name}
      specialtyName={conditionSpecialties[0]?.specialty?.name ?? null}
      severityLevel={condition.severityLevel}
    />

    {/* Outbound authoritative citations — populated by editorial team */}
    <Citations citations={citations} />

    {/* EEAT signals */}
    <MethodologyBlock locale={locale}
      reviewerName={reviewer?.fullName ?? null}
      reviewerCredentials={reviewer?.credentials ?? null}
      reviewerSlug={reviewer?.slug ?? null}
      lastReviewed={reviewer?.reviewedAt ?? conditionRaw.updatedAt}
      curationNote={`This ${condition.name.toLowerCase()} overview is reviewed against current ${conditionSpecialties[0]?.specialty?.name ?? "specialty"} guidelines and lists ${conditionTreatments.length} treatment options actively offered by accredited hospitals on our network. Clinical descriptions are editorial — your treating clinician confirms what's right for your specific case.`}
      dataSources={[
        "Peer-reviewed clinical guidelines (NCCN, ESMO, ESC, AHA, NICE — by indication)",
        "WHO ICD-11 condition classification",
        "National medical society treatment protocols",
        "JCI accreditation registry",
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={`${condition.name}`}
      heading={`Continue evaluating ${condition.name.toLowerCase()} care`}
      lede={`Condition overview is one entry. These hubs route the same care decision via specialty, surgeon, treatment, and destination — including the doctors actively treating ${condition.name.toLowerCase()}.`}
      items={[
        { eyebrow: "Surgeons", label: `Doctors treating ${condition.name}`, href: `/condition/${conditionRaw.slug}/doctors`, hint: "Volume-ranked specialists across all relevant specialties." },
        ...(conditionSpecialties[0]?.specialty?.slug && conditionSpecialties[0]?.specialty?.name
          ? [{ eyebrow: "Specialty", label: `${conditionSpecialties[0].specialty.name} hub`, href: `/specialty/${conditionSpecialties[0].specialty.slug}`, hint: `Programs, surgeons, hospitals across ${conditionSpecialties[0].specialty.name.toLowerCase()}.` }] : []),
        ...(conditionSpecialties[1]?.specialty?.slug && conditionSpecialties[1]?.specialty?.name
          ? [{ eyebrow: "Specialty", label: `${conditionSpecialties[1].specialty.name}`, href: `/specialty/${conditionSpecialties[1].specialty.slug}`, hint: "Alternative specialty involved in care for this condition." }] : []),
        ...(conditionTreatments[0]?.treatment?.slug && conditionTreatments[0]?.treatment?.name
          ? [{ eyebrow: "Procedure", label: `${conditionTreatments[0].treatment.name}`, href: `/treatment/${conditionTreatments[0].treatment.slug}`, hint: "First-line treatment with success rates, recovery, hospital pricing." }] : []),
        ...(conditionTreatments[1]?.treatment?.slug && conditionTreatments[1]?.treatment?.name
          ? [{ eyebrow: "Procedure", label: `${conditionTreatments[1].treatment.name}`, href: `/treatment/${conditionTreatments[1].treatment.slug}`, hint: "Alternative treatment path with cost and recovery data." }] : []),
        { eyebrow: "Browse", label: "All 79 conditions", href: "/conditions", hint: "Map condition → specialty → first-line treatment." },
        { eyebrow: "Browse", label: "9 destination countries", href: "/countries", hint: "Cost-of-care profiles, hospital programs, visa playbooks." },
        { eyebrow: "Compare", label: "Hospital comparison", href: "/compare/hospitals", hint: "Side-by-side accreditations, ratings, beds, and pricing." },
        { eyebrow: "Compare", label: "Doctor comparison", href: "/compare/doctors", hint: "Surgeons compared on volume, fees, languages, video-consult availability." },
        { eyebrow: "Tool", label: "Match-me triage", href: "/match-me", hint: "Three questions, get a specialty + destination + 3-hospital shortlist." },
        { eyebrow: "Tool", label: "Cost calculator", href: "/calculator", hint: "Hospital-reported pricing across procedures × destinations." },
        { eyebrow: "Action", label: "Free second opinion", href: "/second-opinion", hint: "Independent panel review of your case in 48 hours — no charge." },
      ]}
    />

    <SiteFooter locale={locale} />
    <EngagementFab locale={locale} />
    <MobileQuoteBar
      locale={locale}
      label={condition.name}
      sublabel={conditionSpecialties[0]?.specialty.name ? `Care via ${conditionSpecialties[0].specialty.name}` : "Free 2nd opinion"}
      whatsapp={{
        page: "specialty",
        slug,
        specialtyName: conditionSpecialties[0]?.specialty.name ?? condition.name,
      }}
    />
  </main>
</BaseLayout>
