---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { listConditionDoctors, listFaqsFor } from "@/lib/queries";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { getTranslator } from "@/lib/messages";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd, medicalConditionJsonLd, withProvenance, faqJsonLd } from "@/lib/seo";
import { Award, ChevronRight, MapPin, Users } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import { doctorPortrait } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const slug = Astro.params.slug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/condition/${slug}/doctors`, 308);
if (!slug) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

const data = await listConditionDoctors(slug, 30);
if (!data) return new Response(`Not found: ${slug}`, { status: 404 });

const tc = getTranslator(locale, "common");
const tCndoc = getTranslator(locale, "conditionDoctorsPage");

const [conditionMap, doctorMap, faqs] = await Promise.all([
  getContent("condition", data.condition.id, locale),
  getContentBatch("doctor", data.doctors.map((d) => d.id), locale),
  listFaqsFor("condition", data.condition.id),
]);
const condition = applyTranslated(data.condition, conditionMap, ["name", "description"]);
const doctors = data.doctors.map((d) => ({
  ...d,
  ...applyTranslated({ name: d.name, qualifications: d.qualifications }, doctorMap[d.id] ?? {}, ["name", "qualifications"]),
}));

// Distinct destinations among the listed doctors — for "by destination" chips
// that link to the country-scoped /condition/[slug]/doctors/[country] pages.
const byCountry = Array.from(
  new Map(
    data.doctors
      .filter((d) => d.country_slug)
      .map((d) => [d.country_slug, { slug: d.country_slug, name: d.country }]),
  ).values(),
).sort((a, b) => a.name.localeCompare(b.name));

const seoTitle = tCndoc("seoTitle").replace("{conditionName}", condition.name);
const seoDescription = tCndoc("seoDescription")
  .replace("{conditionName}", condition.name.toLowerCase())
  .replace("{total}", data.total.toLocaleString())
  .replace("{specialtyCount}", data.specialties.length.toString())
  .replace("{specialtyWord}", data.specialties.length === 1 ? tCndoc("specialtyWordSingular") : tCndoc("specialtyWordPlural"))
  .slice(0, 160);

const path = `/condition/${slug}/doctors`;
const url = localeUrl(locale, path);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tCndoc("breadcrumbConditions"), url: localeUrl(locale, "/conditions") },
  { name: condition.name, url: localeUrl(locale, `/condition/${slug}`) },
  { name: tCndoc("breadcrumbDoctors"), url },
]);

const itemLd = withProvenance(
  itemListJsonLd(
    doctors.slice(0, 15).map((d) => ({
      name: d.title ? `${d.title} ${d.name}`.replace(/^Dr\. Dr\./i, "Dr.") : d.name,
      url: localeUrl(locale, `/doctor/${d.slug}`),
    })),
  ),
  { dateModified: new Date() },
);

// Condition context schema — page is condition-scoped, so emit MedicalCondition
// alongside the doctor ItemList. Helps Google associate the page with the
// condition entity rather than treating it as a generic doctor directory.
const conditionLd = withProvenance(
  medicalConditionJsonLd({
    name: condition.name,
    description: condition.description,
    url: localeUrl(locale, `/condition/${slug}`),
    relevantSpecialty: data.specialties.map((s) => ({
      name: s.name,
      url: localeUrl(locale, `/specialty/${s.slug}`),
    })),
  }),
  { dateModified: data.condition.updatedAt ?? new Date() },
);

const faqLd = faqs.length > 0
  ? faqJsonLd(faqs.map((f) => ({ question: f.question, answer: f.answer })))
  : null;

const untranslated = isUntranslated(locale, conditionMap);

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={untranslated || doctors.length === 0} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(conditionLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />
    {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <nav aria-label="Breadcrumb" class="border-b border-border bg-bg">
      <div class="mx-auto max-w-7xl px-6 py-3.5 text-sm text-ink-muted overflow-x-auto whitespace-nowrap">
        <a href={localizedPath(locale, "/")} class="hover:text-accent">{tc("home")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, "/conditions")} class="hover:text-accent">{tCndoc("breadcrumbConditions")}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <a href={localizedPath(locale, `/condition/${slug}`)} class="hover:text-accent">{condition.name}</a>
        <span class="mx-2 text-ink-subtle">/</span>
        <span class="text-ink" aria-current="page">{tCndoc("breadcrumbDoctors")}</span>
      </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-14 pb-8">
      <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-accent);">
        {condition.name}
      </p>
      <h1 class="mt-2 display display-tight" style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.025em; line-height: 1.02;">
        {tCndoc("h1").replace("{conditionName}", condition.name.toLowerCase())}
      </h1>
      <p class="lede mt-5 max-w-[44rem]">
        {tCndoc("lede")
          .replace("{total}", data.total.toLocaleString())
          .replace("{specialtyCount}", data.specialties.length.toString())
          .replace("{specialtyWord}", data.specialties.length === 1 ? tCndoc("specialtyWordSingular") : tCndoc("specialtyWordPlural"))
          .replace("{conditionName}", condition.name.toLowerCase())}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <LastUpdated updated={new Date()} locale={locale} />
      </div>

      {data.specialties.length > 0 && (
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="mono uppercase text-[11px]" style="letter-spacing: 0.12em; color: var(--color-ink-subtle);">{tCndoc("relevantSpecialties")}</span>
          {data.specialties.map((s) => (
            <a
              href={localizedPath(locale, `/surgeons/${s.slug}`)}
              class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
            >
              {s.name}
            </a>
          ))}
        </div>
      )}

      {byCountry.length > 0 && (
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="mono uppercase text-[11px]" style="letter-spacing: 0.12em; color: var(--color-ink-subtle);">{tCndoc("byDestination")}</span>
          {byCountry.map((c) => (
            <a
              href={localizedPath(locale, `/condition/${slug}/doctors/${c.slug}`)}
              class="rounded-full border border-border bg-surface px-3 py-1 text-[13px] font-medium text-ink hover:border-border-strong"
            >
              {c.name}
            </a>
          ))}
        </div>
      )}
    </section>

    <section style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft); padding: 48px 0;">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto" style="max-width: 1100px;">
          <p class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tCndoc("findingDoctorEyebrow").replace("{conditionName}", condition.name.toLowerCase())}</p>
          <h2 class="display mt-2" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.15;">{tCndoc("choosingSpecialistHeading").replace("{conditionName}", condition.name.toLowerCase())}</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle);">{tCndoc("cardSubspecialtyTitle")}</div>
              <p class="serif mt-2" style="font-size: 15px; line-height: 1.6; color: var(--color-ink-muted);">{tCndoc("cardSubspecialtyBody").replace("{conditionName}", condition.name)}</p>
            </div>
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle);">{tCndoc("cardOutcomesTitle")}</div>
              <p class="serif mt-2" style="font-size: 15px; line-height: 1.6; color: var(--color-ink-muted);">{tCndoc("cardOutcomesBody").replace("{conditionName}", condition.name.toLowerCase())}</p>
            </div>
            <div>
              <div class="mono" style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle);">{tCndoc("cardMdtTitle")}</div>
              <p class="serif mt-2" style="font-size: 15px; line-height: 1.6; color: var(--color-ink-muted);">{tCndoc("cardMdtBody").replace("{conditionName}", condition.name.toLowerCase())}</p>
            </div>
          </div>
          <div class="mt-10 flex flex-col sm:flex-row gap-4 items-start" style="border-top: 1px solid var(--color-border); padding-top: 32px;">
            <div class="flex-1">
              <p class="mono" style="font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent);">{tCndoc("shortlistEyebrow").replace("{conditionName}", condition.name.toLowerCase())}</p>
              <p class="serif mt-2" style="font-size: 15px; line-height: 1.6; color: var(--color-ink-muted);">{tCndoc("shortlistBody").replace("{conditionName}", condition.name.toLowerCase())}</p>
            </div>
            <div class="flex gap-3 shrink-0">
              <a
                href={localizedPath(locale, "/calculator")}
                class="inline-flex items-center gap-2 font-semibold"
                style="background: var(--color-accent); color: var(--color-accent-contrast); padding: 11px 20px; font-size: 13px; border-radius: 9999px;"
              >
                {tCndoc("ctaGetMatched")}
              </a>
              <a
                href={localizedPath(locale, "/contact")}
                class="inline-flex items-center gap-2"
                style="border: 1px solid var(--color-border); color: var(--color-ink); padding: 11px 20px; font-size: 13px; border-radius: 9999px;"
              >
                {tCndoc("ctaTalkCaseManager")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {doctors.length === 0 ? (
      <section class="mx-auto max-w-3xl px-6 pb-20">
        <div class="paper p-8 text-center" style="color: var(--color-ink-muted);">
          <p class="serif text-lg mb-3">{tCndoc("emptyStateHeading")}</p>
          <p class="text-sm mb-5">{tCndoc("emptyStateBody")}</p>
          <a
            href={localizedPath(locale, `/contact?condition=${slug}`)}
            class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            {tCndoc("emptyStateCta")}
          </a>
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-7xl px-6 pb-10 border-t border-border-soft pt-8">
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {doctors.map((d) => {
            const nameHasTitle = /^(dr\.?|prof\.?|mr\.?|ms\.?|mrs\.?)\s/i.test(d.name);
            const titlePrefix = nameHasTitle ? "" : (d.title ?? "Dr.");
            const fullName = titlePrefix ? `${titlePrefix} ${d.name}` : d.name;
            return (
              <li>
                <a
                  href={localizedPath(locale, `/doctor/${d.slug}`)}
                  class="group flex h-full gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-border-strong"
                >
                  <img
                    src={doctorPortrait({ imageUrl: d.image_url, id: d.id }, 128)}
                    alt={d.name}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="h-16 w-16 shrink-0 rounded-full object-cover ring-1 ring-border"
                  />
                  <div class="min-w-0 flex-1">
                    <span class="block font-display text-[17px] leading-tight text-ink group-hover:text-accent line-clamp-1">{fullName}</span>
                    {d.qualifications && <span class="mt-1 block text-[12.5px] text-ink-muted line-clamp-1">{d.qualifications}</span>}
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-subtle">
                      {d.experience_years != null && (
                        <span class="inline-flex items-center gap-1"><Award className="h-3 w-3 text-accent" />{d.experience_years} {tCndoc("yrs")}</span>
                      )}
                      {d.patients_treated != null && d.patients_treated > 0 && (
                        <span class="inline-flex items-center gap-1"><Users className="h-3 w-3 text-accent" />{d.patients_treated.toLocaleString()}</span>
                      )}
                      {d.rating && Number(d.rating) > 0 && (
                        <span class="inline-flex items-center gap-1"><span class="text-gold-500">★</span><span class="tnum">{Number(d.rating).toFixed(1)}</span></span>
                      )}
                    </div>
                    <div class="mt-2 text-[12px] text-ink-subtle inline-flex items-center gap-1">
                      <MapPin className="h-3 w-3" />{d.hospital_name} · {d.city}, {d.country}
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="mx-auto max-w-7xl px-6 pb-20">
      <div class="paper p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div class="max-w-[36rem]">
          <p class="mono uppercase" style="font-size: 11px; letter-spacing: 0.14em; color: var(--color-accent);">{tCndoc("matchEyebrow")}</p>
          <h3 class="mt-2 font-display text-2xl md:text-3xl">
            {tCndoc("matchHeading").replace("{conditionName}", condition.name.toLowerCase())}
          </h3>
          <p class="mt-2 text-sm text-ink-muted">
            {tCndoc("matchBody")}
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={localizedPath(locale, `/second-opinion`)}
            class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:bg-accent-hover"
          >
            {tCndoc("ctaGetSecondOpinion")}
          </a>
          <a
            href={localizedPath(locale, `/condition/${slug}`)}
            class="inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold hover:border-border-strong"
          >
            {tCndoc("ctaBackToCondition").replace("{conditionName}", condition.name)}
            <ChevronRight className="ml-1 h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    <HowItWorks
      heading={tCndoc("howItWorksHeading")}
      italicWord={tCndoc("howItWorksItalicWord")}
      eyebrow={tCndoc("howItWorksEyebrow")}
      steps={[
        { title: tCndoc("step1Title"), description: tCndoc("step1Desc") },
        { title: tCndoc("step2Title"), description: tCndoc("step2Desc") },
        { title: tCndoc("step3Title"), description: tCndoc("step3Desc") },
        { title: tCndoc("step4Title"), description: tCndoc("step4Desc") },
      ]}
    />
    <ExploreGrid
      locale={locale}
      eyebrow={tCndoc("exploreEyebrow").replace("{conditionName}", condition.name)}
      heading={tCndoc("exploreHeading").replace("{conditionName}", condition.name.toLowerCase())}
      lede={tCndoc("exploreLede")}
      items={[
        { eyebrow: tCndoc("exploreItem1Eyebrow"), label: tCndoc("exploreItem1Label").replace("{conditionName}", condition.name), href: `/condition/${slug}`, hint: tCndoc("exploreItem1Hint") },
        ...(data.specialties[0] ? [{ eyebrow: tCndoc("exploreItem2Eyebrow"), label: tCndoc("exploreItem2Label").replace("{specialtyName}", data.specialties[0].name), href: `/specialty/${data.specialties[0].slug}`, hint: tCndoc("exploreItem2Hint").replace("{specialtyName}", data.specialties[0].name.toLowerCase()) }] : []),
        ...(data.specialties[1] ? [{ eyebrow: tCndoc("exploreItem3Eyebrow"), label: data.specialties[1].name, href: `/specialty/${data.specialties[1].slug}`, hint: tCndoc("exploreItem3Hint") }] : []),
        ...(data.specialties[0] ? [{ eyebrow: tCndoc("exploreItem4Eyebrow"), label: tCndoc("exploreItem4Label").replace("{specialtyName}", data.specialties[0].name.toLowerCase()), href: `/surgeons/${data.specialties[0].slug}`, hint: tCndoc("exploreItem4Hint") }] : []),
        { eyebrow: tCndoc("exploreItem5Eyebrow"), label: tCndoc("exploreItem5Label"), href: "/conditions", hint: tCndoc("exploreItem5Hint") },
        { eyebrow: tCndoc("exploreItem6Eyebrow"), label: tCndoc("exploreItem6Label"), href: "/treatments", hint: tCndoc("exploreItem6Hint") },
        { eyebrow: tCndoc("exploreItem7Eyebrow"), label: tCndoc("exploreItem7Label"), href: "/compare/doctors", hint: tCndoc("exploreItem7Hint") },
        { eyebrow: tCndoc("exploreItem8Eyebrow"), label: tCndoc("exploreItem8Label"), href: "/compare/hospitals", hint: tCndoc("exploreItem8Hint") },
        { eyebrow: tCndoc("exploreItem9Eyebrow"), label: tCndoc("exploreItem9Label"), href: "/match-me", hint: tCndoc("exploreItem9Hint") },
        { eyebrow: tCndoc("exploreItem10Eyebrow"), label: tCndoc("exploreItem10Label"), href: "/calculator", hint: tCndoc("exploreItem10Hint") },
        { eyebrow: tCndoc("exploreItem11Eyebrow"), label: tCndoc("exploreItem11Label"), href: "/second-opinion", hint: tCndoc("exploreItem11Hint") },
        { eyebrow: tCndoc("exploreItem12Eyebrow"), label: tCndoc("exploreItem12Label"), href: "/editorial-policy", hint: tCndoc("exploreItem12Hint") },
      ]}
    />

    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
