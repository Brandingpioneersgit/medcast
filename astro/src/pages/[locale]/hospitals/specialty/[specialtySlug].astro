---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Pagination from "@/components/Pagination.astro";
import CompareToggle from "@/components/CompareToggle.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listHospitals, getGeoSpecialty, getSpecialtyHospitalBreakdown } from "@/lib/queries";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { ChevronRight } from "lucide-react";
import { hospitalCover, specialtyBanner } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const specialtySlug = Astro.params.specialtySlug;
if (!specialtySlug) return new Response("Not found", { status: 404 });
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospitals/specialty/${specialtySlug}`, 308);
const locale = rawLocale as Locale;

const specialtyRow = await getGeoSpecialty(specialtySlug);
if (!specialtyRow) return new Response(`Not found: ${specialtySlug}`, { status: 404 });

const url = new URL(Astro.request.url);
const pageParam = parseInt(url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const sortParam = url.searchParams.get("sort");
const sort: "featured" | "rating" | "reviews" | "beds" =
  sortParam === "rating" || sortParam === "reviews" || sortParam === "beds"
    ? sortParam
    : "featured";

const [{ rows: rawRows, total, totalPages }, breakdown] = await Promise.all([
  listHospitals({ page, sort, specialty: [specialtySlug] }),
  getSpecialtyHospitalBreakdown(specialtySlug),
]);

// Localize DB content for non-default locales (getContent/getContentBatch
// return {} on `en`, so applyTranslated is a no-op there).
const specialtyMap = await getContent("specialty", specialtyRow.id, locale);
const specialty = applyTranslated(specialtyRow, specialtyMap, ["name"]);
const hospitalTx = await getContentBatch("hospital", rawRows.map((h) => h.id), locale);
const rows = rawRows.map((h) => applyTranslated(h, hospitalTx[h.id] ?? {}, ["name"]));

// Batch-fetch accreditation chips for the visible rows.
const hospitalIds = rows.map((h) => h.id);
const accreditationMap = new Map<number, string[]>();
if (hospitalIds.length > 0) {
  try {
    const accr = await db.execute<{ hospital_id: number; codes: string[] }>(sql`
      SELECT ha.hospital_id, ARRAY_AGG(DISTINCT COALESCE(a.acronym, a.name)) AS codes
      FROM hospital_accreditations ha
      INNER JOIN accreditations a ON a.id = ha.accreditation_id
      WHERE ha.hospital_id IN ${hospitalIds}
      GROUP BY ha.hospital_id
    `);
    for (const r of Array.from(accr)) accreditationMap.set(r.hospital_id, r.codes);
  } catch {
    // non-fatal
  }
}

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  "united-arab-emirates": "🇦🇪", germany: "🇩🇪", singapore: "🇸🇬",
  "south-korea": "🇰🇷", malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
function countryFlag(s: string | null | undefined): string { return s ? (FLAG_MAP[s] ?? "🌐") : "🌐"; }

const tc = getTranslator(locale, "common");
const tHs = getTranslator(locale, "hospitalsSpecialtyPage");
const specialtyName = specialty.name;
const countText = total.toLocaleString();
const path = `/hospitals/specialty/${specialtySlug}`;
const seoTitle = tHs("seoTitle").replace("{specialtyName}", specialtyName).replace("{countText}", countText);
const seoDescription = tHs("seoDescription")
  .replace("{countText}", countText)
  .replace("{specialtyName}", specialtyName.toLowerCase())
  .slice(0, 160);

const shouldNoindex = page > 1 || total === 0 || isUntranslated(locale, specialtyMap);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  { name: specialtyName, url: localeUrl(locale, path) },
]);

const collectionLd =
  page === 1 && rows.length > 0
    ? withProvenance(
        collectionPageJsonLd({
          name: `${specialtyName} hospitals`,
          description: seoDescription,
          url: localeUrl(locale, path),
          items: rows.map((h) => ({ name: h.name, url: localeUrl(locale, `/hospital/${h.slug}`) })),
        }),
        { dateModified: new Date() },
      )
    : null;

function buildHref(patch: { sort?: string; page?: number }): string {
  const params = new URLSearchParams();
  const s = patch.sort ?? sort;
  const p = patch.page ?? 1;
  if (s && s !== "featured") params.set("sort", s);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  const base = localizedPath(locale, path);
  return qs ? `${base}?${qs}` : base;
}

const prevUrl = page > 1 ? buildHref({ page: page - 1 }) : undefined;
const nextUrl = page < totalPages ? buildHref({ page: page + 1 }) : undefined;

const SORTS = [
  { value: "featured", label: tHs("sortFeatured") },
  { value: "rating", label: tHs("sortRating") },
  { value: "reviews", label: tHs("sortReviews") },
  { value: "beds", label: tHs("sortBeds") },
];

const stats =
  page === 1
    ? [
        { l: tHs("statHospitalsLabel"), v: countText },
        { l: tHs("statSpecialtyLabel"), v: specialtyName },
        { l: tHs("statAccreditedLabel"), v: tHs("statAccreditedValue") },
        { l: tHs("statReplyLabel"), v: tHs("statReplyValue") },
      ]
    : [];

Astro.response.headers.set("Cache-Control", "public, s-maxage=600, stale-while-revalidate=3600");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      noindex={shouldNoindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {collectionLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label={tHs("breadcrumbAriaLabel")}>
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/hospitals")} class="hover:text-ink">{tc("hospitals")}</a>
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{specialtyName}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tHs("heroEyebrow").replace("{countText}", countText).replace("{specialtyName}", specialtyName)}
      h1First={tHs("heroH1First").replace("{specialtyName}", specialtyName)}
      h1Italic={tHs("heroH1Italic")}
      lede={tHs("heroLede").replace("{specialtyName}", specialtyName.toLowerCase())}
      stats={stats}
      locale={locale}
      image={specialtyBanner(specialtySlug)}
      imageAlt={tHs("heroH1First").replace("{specialtyName}", specialtyName) + " " + tHs("heroH1Italic")}
    />

    {(breakdown.countries.length > 0 || breakdown.cities.length > 0) && (
      <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-8">
        <div class="mono uppercase mb-3" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
          {tHs("browseByDestination").replace("{specialtyName}", specialtyName.toLowerCase())}
        </div>
        <div class="flex flex-wrap gap-2">
          {breakdown.countries.map((c) => (
            <a
              href={localizedPath(locale, `/hospitals/specialty/${specialtySlug}/${c.slug}`)}
              class="rounded-full border px-3 py-1.5 text-[13px] font-medium hover:border-ink transition-colors"
              style="border-color: var(--color-border); color: var(--color-ink);"
            >
              {tHs("countryPillLabel").replace("{specialtyName}", specialtyName).replace("{place}", c.name)}
              <span class="tnum" style="opacity: 0.55; margin-inline-start: 5px;">{c.n}</span>
            </a>
          ))}
          {breakdown.cities.map((c) => (
            <a
              href={localizedPath(locale, `/hospitals/specialty/${specialtySlug}/${c.slug}`)}
              class="rounded-full border px-3 py-1.5 text-[13px] font-medium hover:border-ink transition-colors"
              style="border-color: var(--color-border); color: var(--color-ink-muted);"
            >
              {c.name}
              <span class="tnum" style="opacity: 0.55; margin-inline-start: 5px;">{c.n}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-8 pb-12">
      <h2 class="display-tight mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tHs("sectionHeading").replace("{specialtyName}", specialtyName.toLowerCase())}
      </h2>
      <div class="min-w-0">
        <div
          class="mb-6 flex flex-wrap items-center justify-between gap-3 pb-4"
          style="border-bottom: 1px solid var(--color-border);"
        >
          <span class="serif text-[14px]" style="color: var(--color-ink-muted);">
            <span class="display tnum text-ink">{countText}</span> {total === 1 ? tHs("resultSingular") : tHs("resultPlural")}
            {totalPages > 1 && (
              <span class="ms-2 mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                {tHs("paginationLabel").replace("{page}", String(page)).replace("{total}", String(totalPages))}
              </span>
            )}
          </span>
          <div class="flex items-center gap-1 -mx-1 overflow-x-auto">
            <span class="mono uppercase px-1 whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tHs("sortLabel")}
            </span>
            {SORTS.map((o) => {
              const active = sort === o.value;
              return (
                <a
                  href={buildHref({ sort: o.value })}
                  class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
                  style={active
                    ? "background: var(--color-ink); color: var(--color-bg);"
                    : "color: var(--color-ink-muted);"}
                >
                  {o.label}
                </a>
              );
            })}
          </div>
        </div>

        {rows.length === 0 ? (
          <div class="paper text-center py-20" style="color: var(--color-ink-muted);">
            <p class="serif text-lg mb-2">{tHs("emptyState").replace("{specialtyName}", specialtyName.toLowerCase())}</p>
            <a
              href={localizedPath(locale, `/specialty/${specialtySlug}`)}
              class="inline-block mt-2 mono uppercase text-[11px]"
              style="color: var(--color-accent); letter-spacing: 0.12em;"
            >
              {tHs("emptyStateLink").replace("{specialtyName}", specialtyName)}
            </a>
          </div>
        ) : (
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {rows.map((h) => {
              const codes = accreditationMap.get(h.id) ?? [];
              return (
                <li class="relative h-full">
                  <a
                    href={localizedPath(locale, `/hospital/${h.slug}`)}
                    class="paper group block h-full overflow-hidden transition hover:-translate-y-0.5"
                    style="padding: 0;"
                  >
                    <PhotoBlock
                      aspect="4/3"
                      rounded={false}
                      imgUrl={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: h.countrySlug })}
                      alt={h.name}
                    >
                      {h.rating && Number(h.rating) > 0 && (
                        <div
                          class="absolute"
                          style="top: 12px; inset-inline-start: 12px; background: rgba(246,241,230,0.95); color: var(--color-ink); padding: 4px 10px; border-radius: 9999px; font-size: 11px; backdrop-filter: blur(4px);"
                        >
                          <span style="color: var(--color-saffron);">★</span>
                          <span class="tnum ms-1">{Number(h.rating).toFixed(1)}</span>
                        </div>
                      )}
                    </PhotoBlock>
                    <div class="p-5">
                      <p class="mono uppercase flex items-center gap-1.5" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                        <span aria-hidden="true">{countryFlag(h.countrySlug)}</span>
                        {h.cityName}{h.cityName && h.countryName ? ", " : ""}{h.countryName}
                      </p>
                      <h3 class="mt-1.5 serif group-hover:text-accent transition-colors line-clamp-2" style="font-size: 19px; line-height: 1.22; letter-spacing: -0.005em; color: var(--color-ink);">
                        {h.name}
                      </h3>
                      {codes.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {codes.slice(0, 3).map((c) => (
                            <span
                              class="mono uppercase"
                              style="font-size: 9.5px; letter-spacing: 0.1em; border: 1px solid var(--color-accent); color: var(--color-accent); padding: 2px 7px; border-radius: 9999px;"
                            >
                              {c}
                            </span>
                          ))}
                        </div>
                      )}
                      <div
                        class="mt-auto flex items-center justify-between"
                        style="border-top: 1px dashed var(--color-border); margin-top: 14px; padding-top: 12px;"
                      >
                        <div class="flex items-center gap-3 text-[12px]" style="color: var(--color-ink-muted);">
                          {h.bedCapacity && <span class="tnum">{tHs("bedCount").replace("{n}", h.bedCapacity.toLocaleString())}</span>}
                          {h.reviewCount && h.reviewCount > 0 && (
                            <span class="tnum">{tHs("reviewCount").replace("{n}", h.reviewCount.toLocaleString())}</span>
                          )}
                        </div>
                        <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                      </div>
                    </div>
                  </a>
                  <div class="absolute end-3 top-3 z-10">
                    <CompareToggle slug={h.slug} name={h.name} />
                  </div>
                </li>
              );
            })}
          </ul>
        )}

        <Pagination page={page} totalPages={totalPages} basePath={buildHref({})} />
      </div>
    </section>

    <HowItWorks
      heading={tHs("howItWorksHeading").replace("{specialtyName}", specialtyName.toLowerCase())}
      italicWord={tHs("howItWorksItalic").replace("{specialtyName}", specialtyName.toLowerCase())}
      eyebrow={tHs("howItWorksEyebrow")}
      steps={[
        { title: tHs("step1Title"), description: tHs("step1Desc").replace("{specialtyName}", specialtyName.toLowerCase()) },
        { title: tHs("step2Title"), description: tHs("step2Desc") },
        { title: tHs("step3Title"), description: tHs("step3Desc") },
        { title: tHs("step4Title"), description: tHs("step4Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tHs("exploreEyebrow").replace("{specialtyName}", specialtyName)}
      heading={tHs("exploreHeading").replace("{specialtyName}", specialtyName.toLowerCase())}
      lede={tHs("exploreLede")}
      items={[
        { eyebrow: tHs("exploreItem1Eyebrow"), label: tHs("exploreItem1Label").replace("{specialtyName}", specialtyName), href: `/specialty/${specialtySlug}`, hint: tHs("exploreItem1Hint").replace("{specialtyName}", specialtyName.toLowerCase()) },
        { eyebrow: tHs("exploreItem2Eyebrow"), label: tHs("exploreItem2Label").replace("{specialtyName}", specialtyName), href: `/surgeons/${specialtySlug}`, hint: tHs("exploreItem2Hint") },
        { eyebrow: tHs("exploreItem3Eyebrow"), label: tHs("exploreItem3Label").replace("{specialtyName}", specialtyName.toLowerCase()), href: "/best", hint: tHs("exploreItem3Hint") },
        { eyebrow: tHs("exploreItem4Eyebrow"), label: tHs("exploreItem4Label"), href: "/hospitals", hint: tHs("exploreItem4Hint") },
        { eyebrow: tHs("exploreItem5Eyebrow"), label: tHs("exploreItem5Label"), href: "/specialties", hint: tHs("exploreItem5Hint") },
        { eyebrow: tHs("exploreItem6Eyebrow"), label: tHs("exploreItem6Label"), href: "/compare/hospitals", hint: tHs("exploreItem6Hint") },
        { eyebrow: tHs("exploreItem7Eyebrow"), label: tHs("exploreItem7Label"), href: "/calculator", hint: tHs("exploreItem7Hint") },
        { eyebrow: tHs("exploreItem8Eyebrow"), label: tHs("exploreItem8Label"), href: "/match-me", hint: tHs("exploreItem8Hint") },
        { eyebrow: tHs("exploreItem9Eyebrow"), label: tHs("exploreItem9Label"), href: "/second-opinion", hint: tHs("exploreItem9Hint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
