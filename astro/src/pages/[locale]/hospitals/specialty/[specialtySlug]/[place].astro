---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Pagination from "@/components/Pagination.astro";
import CompareToggle from "@/components/CompareToggle.astro";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";
import HowItWorks from "@/components/content/HowItWorks.astro";
import { listHospitals, getGeoSpecialty, getGeoCountry, getGeoCity, getSpecialtyHospitalBreakdown } from "@/lib/queries";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, collectionPageJsonLd, withProvenance } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { getContent, getContentBatch, applyTranslated, isUntranslated } from "@/lib/translate";
import { ChevronRight } from "lucide-react";
import { hospitalCover, specialtyBanner } from "@/lib/images";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const specialtyParam = Astro.params.specialtySlug;
const placeParam = Astro.params.place;
if (!specialtyParam || !placeParam) return new Response("Not found", { status: 404 });
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospitals/specialty/${specialtyParam}/${placeParam}`, 308);
const locale = rawLocale as Locale;

const specialtyRow = await getGeoSpecialty(specialtyParam);
if (!specialtyRow) return new Response(`Not found: ${specialtyParam}`, { status: 404 });

// Place-aware: resolve as a country first, fall back to a city. (Astro can't
// have two dynamic files at one depth — same pattern as /surgeons/[specialty]/[place].)
const countryRow = await getGeoCountry(placeParam);
const cityRow = countryRow ? null : await getGeoCity(placeParam);
if (!countryRow && !cityRow) return new Response(`Not found: ${placeParam}`, { status: 404 });
const mode: "country" | "city" = countryRow ? "country" : "city";
const rawCountry = countryRow ?? cityRow!.country ?? null;

// Localize the place country (city names have no DB translations — proper
// nouns, left as-is). getContent returns {} on `en`, so this is a no-op there.
const countryMap = rawCountry ? await getContent("country", rawCountry.id, locale) : {};
const country = rawCountry ? applyTranslated(rawCountry, countryMap, ["name"]) : null;

const url = new URL(Astro.request.url);
const pageParam = parseInt(url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const sortParam = url.searchParams.get("sort");
const sort: "featured" | "rating" | "reviews" | "beds" =
  sortParam === "rating" || sortParam === "reviews" || sortParam === "beds"
    ? sortParam
    : "featured";

const { rows: rawRows, total, totalPages } = await listHospitals({
  page,
  sort,
  specialty: [specialtyParam],
  ...(mode === "country" ? { country: [placeParam] } : { city: placeParam }),
});

// Inventory floor: a city with fewer than 3 credentialed hospitals isn't worth
// its own indexable page — send it up to the country listing.
if (mode === "city" && total < 3 && country) {
  return Astro.redirect(localizedPath(locale, `/hospitals/specialty/${specialtyParam}/${country.slug}`), 301);
}
if (total === 0) return new Response(`No hospitals for ${specialtyParam}/${placeParam}`, { status: 404 });

// Localize DB content for non-default locales (no-op on `en`).
const specialtyMap = await getContent("specialty", specialtyRow.id, locale);
const specialty = applyTranslated(specialtyRow, specialtyMap, ["name"]);
const hospitalTx = await getContentBatch("hospital", rawRows.map((h) => h.id), locale);
const rows = rawRows.map((h) => applyTranslated(h, hospitalTx[h.id] ?? {}, ["name"]));

const breakdown = await getSpecialtyHospitalBreakdown(specialtyParam);

// Accreditation chips for visible rows.
const hospitalIds = rows.map((h) => h.id);
const accreditationMap = new Map<number, string[]>();
if (hospitalIds.length > 0) {
  try {
    const accr = await db.execute<{ hospital_id: number; codes: string[] }>(sql`
      SELECT ha.hospital_id, ARRAY_AGG(DISTINCT COALESCE(a.acronym, a.name)) AS codes
      FROM hospital_accreditations ha
      INNER JOIN accreditations a ON a.id = ha.accreditation_id
      WHERE ha.hospital_id IN ${hospitalIds}
      GROUP BY ha.hospital_id
    `);
    for (const r of Array.from(accr)) accreditationMap.set(r.hospital_id, r.codes);
  } catch {
    // non-fatal
  }
}

const tc = getTranslator(locale, "common");
const tHsp = getTranslator(locale, "hospitalsSpecialtyPlacePage");
const specialtyName = specialty.name;
const placeName = mode === "city" ? cityRow!.name : country!.name;
const placeLabel = mode === "city" && country ? `${cityRow!.name}, ${country.name}` : placeName;
const countText = total.toLocaleString();
const path = `/hospitals/specialty/${specialtyParam}/${placeParam}`;

const seoTitle = tHsp("seoTitle")
  .replace("{specialty}", specialtyName)
  .replace("{place}", placeName)
  .replace("{count}", countText);
const seoDescription = tHsp("seoDescription")
  .replace("{count}", countText)
  .replace("{specialty}", specialtyName.toLowerCase())
  .replace("{place}", placeLabel)
  .slice(0, 160);

const shouldNoindex = page > 1 || total < 3 || isUntranslated(locale, specialtyMap);

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  { name: tHsp("breadcrumbSpecialtyHospitals").replace("{specialty}", specialtyName), url: localeUrl(locale, `/hospitals/specialty/${specialtyParam}`) },
  ...(mode === "city" && country
    ? [{ name: country.name, url: localeUrl(locale, `/hospitals/specialty/${specialtyParam}/${country.slug}`) }]
    : []),
  { name: placeName, url: localeUrl(locale, path) },
]);

const collectionLd =
  page === 1 && rows.length > 0
    ? withProvenance(
        collectionPageJsonLd({
          name: `${specialtyName} hospitals in ${placeLabel}`,
          description: seoDescription,
          url: localeUrl(locale, path),
          items: rows.map((h) => ({ name: h.name, url: localeUrl(locale, `/hospital/${h.slug}`) })),
        }),
        { dateModified: new Date() },
      )
    : null;

function buildHref(patch: { sort?: string; page?: number }): string {
  const params = new URLSearchParams();
  const s = patch.sort ?? sort;
  const p = patch.page ?? 1;
  if (s && s !== "featured") params.set("sort", s);
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  const base = localizedPath(locale, path);
  return qs ? `${base}?${qs}` : base;
}

const prevUrl = page > 1 ? buildHref({ page: page - 1 }) : undefined;
const nextUrl = page < totalPages ? buildHref({ page: page + 1 }) : undefined;

const SORTS = [
  { value: "featured", label: tHsp("sortFeatured") },
  { value: "rating", label: tHsp("sortTopRated") },
  { value: "reviews", label: tHsp("sortMostReviewed") },
  { value: "beds", label: tHsp("sortLargest") },
];

// Scope selector — countries with this specialty + sibling cities.
const otherCountries = breakdown.countries.filter((c) => c.slug !== (country?.slug ?? ""));
const scopeCities = breakdown.cities
  .filter((c) => (mode === "city" ? c.slug !== cityRow!.slug : true))
  .filter((c) => (mode === "city" && country ? c.countrySlug === country.slug : true));

const stats =
  page === 1
    ? [
        { l: tHsp("statHospitals"), v: countText },
        { l: tHsp("statSpecialty"), v: specialtyName },
        { l: mode === "city" ? tHsp("statCity") : tHsp("statDestination"), v: placeName },
        { l: tHsp("statReplyTime"), v: tHsp("statReplyValue") },
      ]
    : [];

Astro.response.headers.set("Cache-Control", "public, s-maxage=1800, stale-while-revalidate=86400");
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta
      title={seoTitle}
      description={seoDescription}
      path={path}
      locale={locale}
      noindex={shouldNoindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
    {collectionLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
    )}
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/hospitals")} class="hover:text-ink">{tHsp("breadcrumbHospitals")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}`)} class="hover:text-ink">{specialtyName}</a>
          {mode === "city" && country && (
            <>
              <span class="mx-1.5">/</span>
              <a href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}/${country.slug}`)} class="hover:text-ink">{country.name}</a>
            </>
          )}
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{placeName}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tHsp("heroEyebrow").replace("{count}", countText).replace("{specialty}", specialtyName).replace("{place}", placeLabel)}
      h1First={tHsp("heroH1First").replace("{specialty}", specialtyName)}
      h1Italic={placeName}
      lede={tHsp("heroLede").replace("{specialty}", specialtyName.toLowerCase()).replace("{place}", placeLabel)}
      stats={stats}
      locale={locale}
      image={specialtyBanner(specialtyParam)}
      imageAlt={tHsp("heroImageAlt").replace("{specialty}", specialtyName).replace("{place}", placeName)}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-6 pb-12">
      {/* Scope selector */}
      <div class="mb-6 flex flex-wrap items-center gap-2">
        <span class="mono uppercase pe-1" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
          {tHsp("scopeLabel")}
        </span>
        <a
          href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}`)}
          class="rounded-full border px-3 py-1 text-[13px] font-medium hover:border-ink"
          style="border-color: var(--color-border); color: var(--color-ink);"
        >
          {tHsp("scopeAllDestinations")}
        </a>
        {mode === "city" && country && (
          <a
            href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}/${country.slug}`)}
            class="rounded-full border px-3 py-1 text-[13px] font-medium hover:border-ink"
            style="border-color: var(--color-accent); color: var(--color-ink);"
          >
            {tHsp("scopeAllCountry").replace("{country}", country.name)}
          </a>
        )}
        {mode === "country" && otherCountries.map((c) => (
          <a
            href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}/${c.slug}`)}
            class="rounded-full border px-3 py-1 text-[13px] font-medium hover:border-ink"
            style="border-color: var(--color-border); color: var(--color-ink-muted);"
          >
            {c.name} <span class="tnum" style="opacity: 0.6;">{c.n}</span>
          </a>
        ))}
        {scopeCities.map((c) => (
          <a
            href={localizedPath(locale, `/hospitals/specialty/${specialtyParam}/${c.slug}`)}
            class="rounded-full border px-3 py-1 text-[13px] font-medium hover:border-ink"
            style="border-color: var(--color-border); color: var(--color-ink-muted);"
          >
            {c.name} <span class="tnum" style="opacity: 0.6;">{c.n}</span>
          </a>
        ))}
      </div>

      <h2 class="display-tight mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tHsp("listHeading").replace("{specialty}", specialtyName).replace("{place}", placeName)}
      </h2>
      <div class="min-w-0">
        <div
          class="mb-6 flex flex-wrap items-center justify-between gap-3 pb-4"
          style="border-bottom: 1px solid var(--color-border);"
        >
          <span class="serif text-[14px]" style="color: var(--color-ink-muted);">
            <span class="display tnum text-ink">{countText}</span> {total === 1 ? tHsp("hospitalSingular") : tHsp("hospitalPlural")}
            {totalPages > 1 && (
              <span class="ms-2 mono uppercase" style="font-size: 10px; letter-spacing: 0.12em; color: var(--color-ink-subtle);">
                {tHsp("paginationPage").replace("{page}", String(page)).replace("{total}", String(totalPages))}
              </span>
            )}
          </span>
          <div class="flex items-center gap-1 -mx-1 overflow-x-auto">
            <span class="mono uppercase px-1 whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tHsp("sortLabel")}
            </span>
            {SORTS.map((o) => {
              const active = sort === o.value;
              return (
                <a
                  href={buildHref({ sort: o.value })}
                  class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
                  style={active
                    ? "background: var(--color-ink); color: var(--color-bg);"
                    : "color: var(--color-ink-muted);"}
                >
                  {o.label}
                </a>
              );
            })}
          </div>
        </div>

        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {rows.map((h) => {
            const codes = accreditationMap.get(h.id) ?? [];
            return (
              <li class="relative h-full">
                <a
                  href={localizedPath(locale, `/hospital/${h.slug}`)}
                  class="paper group block h-full overflow-hidden transition hover:-translate-y-0.5"
                  style="padding: 0;"
                >
                  <PhotoBlock
                    aspect="4/3"
                    rounded={false}
                    imgUrl={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: h.countrySlug, topSpecialtySlug: specialtyParam })}
                    alt={h.name}
                  >
                    {h.rating && Number(h.rating) > 0 && (
                      <div
                        class="absolute"
                        style="top: 12px; inset-inline-start: 12px; background: rgba(246,241,230,0.95); color: var(--color-ink); padding: 4px 10px; border-radius: 9999px; font-size: 11px; backdrop-filter: blur(4px);"
                      >
                        <span style="color: var(--color-saffron);">★</span>
                        <span class="tnum ms-1">{Number(h.rating).toFixed(1)}</span>
                      </div>
                    )}
                  </PhotoBlock>
                  <div class="p-5">
                    <p class="mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                      {h.cityName}{h.cityName && h.countryName ? ", " : ""}{h.countryName}
                    </p>
                    <h3 class="mt-1.5 serif group-hover:text-accent transition-colors line-clamp-2" style="font-size: 19px; line-height: 1.22; letter-spacing: -0.005em; color: var(--color-ink);">
                      {h.name}
                    </h3>
                    {codes.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {codes.slice(0, 3).map((c) => (
                          <span
                            class="mono uppercase"
                            style="font-size: 9.5px; letter-spacing: 0.1em; border: 1px solid var(--color-accent); color: var(--color-accent); padding: 2px 7px; border-radius: 9999px;"
                          >
                            {c}
                          </span>
                        ))}
                      </div>
                    )}
                    <div
                      class="mt-auto flex items-center justify-between"
                      style="border-top: 1px dashed var(--color-border); margin-top: 14px; padding-top: 12px;"
                    >
                      <div class="flex items-center gap-3 text-[12px]" style="color: var(--color-ink-muted);">
                        {h.bedCapacity && <span class="tnum">{h.bedCapacity.toLocaleString()} {tHsp("beds")}</span>}
                        {h.reviewCount && h.reviewCount > 0 && (
                          <span class="tnum">{h.reviewCount.toLocaleString()} {tHsp("reviews")}</span>
                        )}
                      </div>
                      <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                    </div>
                  </div>
                </a>
                <div class="absolute end-3 top-3 z-10">
                  <CompareToggle slug={h.slug} name={h.name} />
                </div>
              </li>
            );
          })}
        </ul>

        <Pagination page={page} totalPages={totalPages} basePath={buildHref({})} />
      </div>
    </section>

    <HowItWorks
      heading={tHsp("howItWorksHeading").replace("{specialty}", specialtyName.toLowerCase()).replace("{place}", placeName)}
      italicWord={placeName}
      eyebrow={tHsp("howItWorksEyebrow")}
      steps={[
        { title: tHsp("howStep1Title"), description: tHsp("howStep1Desc").replace("{specialty}", specialtyName.toLowerCase()) },
        { title: tHsp("howStep2Title"), description: tHsp("howStep2Desc") },
        { title: tHsp("howStep3Title"), description: tHsp("howStep3Desc") },
        { title: tHsp("howStep4Title"), description: tHsp("howStep4Desc") },
      ]}
    />

    <ExploreGrid
      locale={locale}
      eyebrow={tHsp("exploreEyebrow").replace("{specialty}", specialtyName).replace("{place}", placeName)}
      heading={tHsp("exploreHeading").replace("{specialty}", specialtyName.toLowerCase()).replace("{place}", placeName)}
      lede={tHsp("exploreLede")}
      items={[
        { eyebrow: tHsp("exploreEyebrowSurgeons"), label: tHsp("exploreItemSurgeonsLabel").replace("{specialty}", specialtyName).replace("{place}", placeName), href: `/surgeons/${specialtyParam}/${placeParam}`, hint: tHsp("exploreItemSurgeonsHint") },
        ...(mode === "country" || country
          ? [{ eyebrow: tHsp("exploreEyebrowSpecialty"), label: tHsp("exploreItemSpecialtyCountryLabel").replace("{specialty}", specialtyName).replace("{country}", country!.name), href: `/specialty/${specialtyParam}/${country!.slug}`, hint: tHsp("exploreItemSpecialtyCountryHint") }]
          : []),
        { eyebrow: tHsp("exploreEyebrowSpecialty"), label: tHsp("exploreItemSpecialtyHubLabel").replace("{specialty}", specialtyName), href: `/specialty/${specialtyParam}`, hint: tHsp("exploreItemSpecialtyHubHint").replace("{specialty}", specialtyName.toLowerCase()) },
        { eyebrow: tHsp("exploreEyebrowHospitals"), label: tHsp("exploreItemAllSpecialtyHospitalsLabel").replace("{specialty}", specialtyName.toLowerCase()), href: `/hospitals/specialty/${specialtyParam}`, hint: tHsp("exploreItemAllSpecialtyHospitalsHint") },
        { eyebrow: mode === "city" ? tHsp("exploreEyebrowCity") : tHsp("exploreEyebrowDestination"), label: tHsp("exploreItemPlaceHospitalsLabel").replace("{place}", placeName), href: mode === "city" ? `/hospitals/city/${placeParam}` : `/hospitals/country/${placeParam}`, hint: tHsp("exploreItemPlaceHospitalsHint").replace("{place}", placeName) },
        ...(country ? [{ eyebrow: tHsp("exploreEyebrowDestination"), label: tHsp("exploreItemCountryHubLabel").replace("{country}", country.name), href: `/country/${country.slug}`, hint: tHsp("exploreItemCountryHubHint").replace("{country}", country.name) }] : []),
        { eyebrow: tHsp("exploreEyebrowCompare"), label: tHsp("exploreItemHospitalCompareLabel"), href: "/compare/hospitals", hint: tHsp("exploreItemHospitalCompareHint") },
        { eyebrow: tHsp("exploreEyebrowTool"), label: tHsp("exploreItemCalculatorLabel"), href: "/calculator", hint: tHsp("exploreItemCalculatorHint") },
        { eyebrow: tHsp("exploreEyebrowTool"), label: tHsp("exploreItemMatchMeLabel"), href: "/match-me", hint: tHsp("exploreItemMatchMeHint") },
        { eyebrow: tHsp("exploreEyebrowAction"), label: tHsp("exploreItemSecondOpinionLabel"), href: "/second-opinion", hint: tHsp("exploreItemSecondOpinionHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
