---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeadMeta from "@/components/HeadMeta.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import EntityListingHero from "@/components/EntityListingHero.astro";
import PhotoBlock from "@/components/PhotoBlock.astro";
import Pagination from "@/components/Pagination.astro";
import CompareToggle from "@/components/CompareToggle.astro";
import { listHospitals, getCityBySlug } from "@/lib/queries";
import { db } from "@/lib/db";
import { sql } from "drizzle-orm";
import { isLocale, localizedPath, type Locale } from "@/lib/i18n";
import { breadcrumbJsonLd, localeUrl, itemListJsonLd } from "@/lib/seo";
import { getTranslator } from "@/lib/messages";
import { ChevronRight } from "lucide-react";
import HowItWorks from "@/components/content/HowItWorks.astro";
import WhatToExpect from "@/components/content/WhatToExpect.astro";
import { hospitalCover } from "@/lib/images";
import PageCta from "@/components/PageCta.astro";
import ExploreGrid from "@/components/ExploreGrid.astro";

export const prerender = false;

const rawLocale = Astro.params.locale ?? "en";
const citySlug = Astro.params.citySlug;
if (!isLocale(rawLocale)) return Astro.redirect(`/en/hospitals/city/${citySlug}`, 308);
if (!citySlug) return new Response("Not found", { status: 404 });
const locale = rawLocale as Locale;

const cityData = await getCityBySlug(citySlug);
if (!cityData) return new Response("Not found", { status: 404 });
const { city, specialtyCounts } = cityData;

const url = new URL(Astro.request.url);
const pageParam = parseInt(url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const sortParam = url.searchParams.get("sort");
const sort =
  sortParam === "rating" || sortParam === "reviews" || sortParam === "beds"
    ? sortParam
    : "featured";

const { rows, total, totalPages } = await listHospitals({ page, sort, city: citySlug });
const hospitalIds = rows.map((h) => h.id);
const accreditationMap = new Map<number, string[]>();
if (hospitalIds.length > 0) {
  try {
    const accr = await db.execute<{ hospital_id: number; codes: string[] }>(sql`
      SELECT ha.hospital_id, ARRAY_AGG(DISTINCT COALESCE(a.acronym, a.name)) AS codes
      FROM hospital_accreditations ha
      INNER JOIN accreditations a ON a.id = ha.accreditation_id
      WHERE ha.hospital_id IN ${hospitalIds}
      GROUP BY ha.hospital_id
    `);
    for (const r of Array.from(accr)) accreditationMap.set(r.hospital_id, r.codes);
  } catch {
    // non-fatal
  }
}

const FLAG_MAP: Record<string, string> = {
  india: "🇮🇳", turkey: "🇹🇷", thailand: "🇹🇭", uae: "🇦🇪",
  germany: "🇩🇪", singapore: "🇸🇬", "south-korea": "🇰🇷",
  malaysia: "🇲🇾", "saudi-arabia": "🇸🇦",
};
function countryFlag(s: string | null | undefined): string { return s ? (FLAG_MAP[s] ?? "🌐") : "🌐"; }

const tc = getTranslator(locale, "common");
const tHc = getTranslator(locale, "hospitalsCityPage");
const seoTitle = tHc("seoTitle").replace("{cityName}", city.name).replace("{countryName}", city.country?.name ?? "").trim();
const seoDescription = tHc("seoDescription").replace("{total}", total.toLocaleString()).replace("{cityName}", city.name);
const path = `/hospitals/city/${citySlug}`;

const crumbs = breadcrumbJsonLd([
  { name: tc("home"), url: localeUrl(locale, "/") },
  { name: tc("hospitals"), url: localeUrl(locale, "/hospitals") },
  ...(city.country ? [{ name: city.country.name, url: localeUrl(locale, `/hospitals/country/${city.country.slug}`) }] : []),
  { name: city.name, url: localeUrl(locale, path) },
]);

const itemLd = page === 1 && rows.length > 0
  ? itemListJsonLd(rows.map((h) => ({ name: h.name, url: localeUrl(locale, `/hospital/${h.slug}`) })))
  : null;

Astro.response.headers.set("Cache-Control", "public, s-maxage=600, stale-while-revalidate=3600");

function buildHref(patch: { sort?: string }): string {
  const params = new URLSearchParams();
  const s = patch.sort ?? sort;
  if (s && s !== "featured") params.set("sort", s);
  const qs = params.toString();
  const base = localizedPath(locale, path);
  return qs ? `${base}?${qs}` : base;
}

const SORTS = [
  { value: "featured", label: tHc("sortFeatured") },
  { value: "rating", label: tHc("sortTopRated") },
  { value: "reviews", label: tHc("sortMostReviewed") },
  { value: "beds", label: tHc("sortLargest") },
];

const paginationBase = buildHref({});
const topSpecialty = specialtyCounts[0]?.name ?? "—";

const stats = page === 1 ? [
  { l: tHc("statHospitals"), v: total.toLocaleString() },
  { l: tHc("statTopSpecialty"), v: topSpecialty },
  { l: tHc("statCountry"), v: city.country?.name ?? "—" },
] : [];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <HeadMeta title={seoTitle} description={seoDescription} path={path} locale={locale} noindex={page > 1} />
    {itemLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(itemLd)} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <main id="main" class="min-h-dvh bg-bg text-ink">
    <SiteHeader locale={locale} />

    <div style="background: var(--color-paper); border-bottom: 1px solid var(--color-border-soft);">
      <div class="mx-auto w-full max-w-[90rem] px-5 md:px-8 py-4">
        <nav class="mono text-[12px]" style="color: var(--color-ink-subtle);" aria-label="Breadcrumb">
          <a href={localizedPath(locale, "/")} class="hover:text-ink">{tc("home")}</a>
          <span class="mx-1.5">/</span>
          <a href={localizedPath(locale, "/hospitals")} class="hover:text-ink">{tc("hospitals")}</a>
          {city.country && (
            <>
              <span class="mx-1.5">/</span>
              <a href={localizedPath(locale, `/hospitals/country/${city.country.slug}`)} class="hover:text-ink">{city.country.name}</a>
            </>
          )}
          <span class="mx-1.5">/</span>
          <span style="color: var(--color-ink);">{city.name}</span>
        </nav>
      </div>
    </div>

    <EntityListingHero
      eyebrow={tHc("heroEyebrow").replace("{total}", total.toLocaleString()).replace("{countryName}", city.country?.name ?? "")}
      h1First={tHc("heroH1First")}
      h1Italic={city.name}
      lede={tHc("heroLede").replace("{cityName}", city.name)}
      stats={stats}
    />

    <section class="mx-auto w-full max-w-[90rem] px-5 md:px-8 pt-8 pb-12">
      <h2 class="display-tight mb-6" style="font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;">
        {tHc("sectionHeading").replace("{cityName}", city.name)}
      </h2>
      <div class="min-w-0">
        <div
          class="mb-6 flex flex-wrap items-center justify-between gap-3 pb-4"
          style="border-bottom: 1px solid var(--color-border);"
        >
          <span class="serif text-[14px]" style="color: var(--color-ink-muted);">
            <span class="display tnum text-ink">{total.toLocaleString()}</span> {total === 1 ? tHc("resultCountSingular") : tHc("resultCountPlural")}
          </span>
          <div class="flex items-center gap-1 -mx-1 overflow-x-auto">
            <span class="mono uppercase px-1 whitespace-nowrap" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
              {tHc("sortLabel")}
            </span>
            {SORTS.map((o) => {
              const active = sort === o.value;
              return (
                <a
                  href={buildHref({ sort: o.value })}
                  class="rounded-full px-3 py-1 text-xs font-medium transition-colors whitespace-nowrap"
                  style={active
                    ? "background: var(--color-ink); color: var(--color-bg);"
                    : "color: var(--color-ink-muted);"}
                >
                  {o.label}
                </a>
              );
            })}
          </div>
        </div>

        {rows.length === 0 ? (
          <div class="paper text-center py-20" style="color: var(--color-ink-muted);">
            <p class="serif text-lg mb-2">{tHc("emptyState").replace("{cityName}", city.name)}</p>
            {city.country && (
              <a
                href={localizedPath(locale, `/hospitals/country/${city.country.slug}`)}
                class="inline-block mt-2 mono uppercase text-[11px]"
                style="color: var(--color-accent); letter-spacing: 0.12em;"
              >
                {tHc("emptyStateBrowse").replace("{countryName}", city.country.name)}
              </a>
            )}
          </div>
        ) : (
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {rows.map((h) => {
              const codes = accreditationMap.get(h.id) ?? [];
              return (
                <li class="relative h-full">
                  <a
                    href={localizedPath(locale, `/hospital/${h.slug}`)}
                    class="paper group block h-full overflow-hidden transition hover:-translate-y-0.5"
                    style="padding: 0;"
                  >
                    <PhotoBlock
                      aspect="4/3"
                      rounded={false}
                      imgUrl={hospitalCover({ coverImageUrl: h.coverImageUrl, countrySlug: h.countrySlug })}
                      alt={h.name}
                    >
                      {h.rating && Number(h.rating) > 0 && (
                        <div
                          class="absolute"
                          style="top: 12px; inset-inline-start: 12px; background: rgba(246,241,230,0.95); color: var(--color-ink); padding: 4px 10px; border-radius: 9999px; font-size: 11px; backdrop-filter: blur(4px);"
                        >
                          <span style="color: var(--color-saffron);">★</span>
                          <span class="tnum ms-1">{Number(h.rating).toFixed(1)}</span>
                        </div>
                      )}
                    </PhotoBlock>
                    <div class="p-5">
                      <p class="mono uppercase flex items-center gap-1.5" style="font-size: 10px; letter-spacing: 0.14em; color: var(--color-ink-subtle);">
                        <span aria-hidden="true">{countryFlag(h.countrySlug)}</span>
                        {h.cityName}, {h.countryName}
                      </p>
                      <h3 class="mt-1.5 serif group-hover:text-accent transition-colors line-clamp-2" style="font-size: 19px; line-height: 1.22; letter-spacing: -0.005em; color: var(--color-ink);">
                        {h.name}
                      </h3>
                      {codes.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {codes.slice(0, 3).map((c) => (
                            <span
                              class="mono uppercase"
                              style="font-size: 9.5px; letter-spacing: 0.1em; border: 1px solid var(--color-accent); color: var(--color-accent); padding: 2px 7px; border-radius: 9999px;"
                            >
                              {c}
                            </span>
                          ))}
                        </div>
                      )}
                      <div
                        class="mt-auto flex items-center justify-between"
                        style="border-top: 1px dashed var(--color-border); margin-top: 14px; padding-top: 12px;"
                      >
                        <div class="flex items-center gap-3 text-[12px]" style="color: var(--color-ink-muted);">
                          {h.bedCapacity && <span class="tnum">{h.bedCapacity.toLocaleString()} {tHc("cardBeds")}</span>}
                          {h.reviewCount && h.reviewCount > 0 && (
                            <span class="tnum">{h.reviewCount.toLocaleString()} {tHc("cardReviews")}</span>
                          )}
                        </div>
                        <ChevronRight className="h-3.5 w-3.5 mirror-x text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)] transition-colors" />
                      </div>
                    </div>
                  </a>
                  <div class="absolute end-3 top-3 z-10">
                    <CompareToggle slug={h.slug} name={h.name} />
                  </div>
                </li>
              );
            })}
          </ul>
        )}

        <Pagination page={page} totalPages={totalPages} basePath={paginationBase} />
      </div>
    </section>

    <HowItWorks
      heading={tHc("howHeading")}
      italicWord={tHc("howItalicWord")}
      eyebrow={tHc("howEyebrow")}
      steps={[
        { title: tHc("howStep1Title"), description: tHc("howStep1Desc") },
        { title: tHc("howStep2Title"), description: tHc("howStep2Desc") },
        { title: tHc("howStep3Title"), description: tHc("howStep3Desc") },
        { title: tHc("howStep4Title"), description: tHc("howStep4Desc") },
      ]}
    />
    
    <ExploreGrid
      locale={locale}
      eyebrow={tHc("exploreEyebrow").replace("{cityName}", city.name)}
      heading={tHc("exploreHeading").replace("{cityName}", city.name)}
      lede={tHc("exploreLede")}
      items={[
        { eyebrow: tHc("exploreItemCityEyebrow"), label: tHc("exploreItemCityLabel").replace("{cityName}", city.name), href: `/city/${citySlug}`, hint: tHc("exploreItemCityHint") },
        ...(city.country?.slug && city.country?.name ? [{ eyebrow: tHc("exploreItemDestEyebrow"), label: tHc("exploreItemDestLabel").replace("{countryName}", city.country.name), href: `/country/${city.country.slug}`, hint: tHc("exploreItemDestHint").replace("{countryName}", city.country.name) }] : []),
        ...(city.country?.slug ? [{ eyebrow: tHc("exploreItemVisaEyebrow"), label: tHc("exploreItemVisaLabel").replace("{countryName}", city.country?.name ?? ""), href: `/visa/${city.country.slug}`, hint: tHc("exploreItemVisaHint") }] : []),
        ...(specialtyCounts[0] ? [{ eyebrow: tHc("exploreItemSpecEyebrow"), label: `${specialtyCounts[0].name} hub`, href: `/specialty/${specialtyCounts[0].slug}`, hint: tHc("exploreItemSpec1Hint").replace("{count}", String(specialtyCounts[0].hospital_count)) }] : []),
        ...(specialtyCounts[1] ? [{ eyebrow: tHc("exploreItemSpecEyebrow"), label: `${specialtyCounts[1].name}`, href: `/specialty/${specialtyCounts[1].slug}`, hint: tHc("exploreItemSpec2Hint").replace("{count}", String(specialtyCounts[1].hospital_count)) }] : []),
        ...(specialtyCounts[2] ? [{ eyebrow: tHc("exploreItemSpecEyebrow"), label: `${specialtyCounts[2].name}`, href: `/specialty/${specialtyCounts[2].slug}`, hint: tHc("exploreItemSpec3Hint").replace("{count}", String(specialtyCounts[2].hospital_count)) }] : []),
        ...(city.country?.slug ? [{ eyebrow: tHc("exploreItemDoctorsEyebrow"), label: tHc("exploreItemDoctorsLabel").replace("{countryName}", city.country?.name ?? ""), href: `/doctors/country/${city.country.slug}`, hint: tHc("exploreItemDoctorsHint") }] : []),
        { eyebrow: tHc("exploreItemBrowseEyebrow"), label: tHc("exploreItemBrowseLabel"), href: "/treatments", hint: tHc("exploreItemBrowseHint") },
        { eyebrow: tHc("exploreItemCompareEyebrow"), label: tHc("exploreItemCompareLabel"), href: "/compare/hospitals", hint: tHc("exploreItemCompareHint") },
        { eyebrow: tHc("exploreItemToolEyebrow"), label: tHc("exploreItemCalcLabel"), href: "/calculator", hint: tHc("exploreItemCalcHint") },
        { eyebrow: tHc("exploreItemToolEyebrow"), label: tHc("exploreItemMatchLabel"), href: "/match-me", hint: tHc("exploreItemMatchHint") },
        { eyebrow: tHc("exploreItemActionEyebrow"), label: tHc("exploreItemOpinionLabel"), href: "/second-opinion", hint: tHc("exploreItemOpinionHint") },
      ]}
    />

    <PageCta locale={locale} />
    <SiteFooter locale={locale} />
  </main>
</BaseLayout>
